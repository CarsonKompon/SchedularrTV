@* The shared images window (kept with the scheduler, as overlays use shared images too), with files chosen kept with templates'. *@
<SharedImagesWindow Focus="@Focus" Changed="Changed" OnClose="OnClose" AssetCategory="@GeneratedPromoPackages.AssetCategory" />

@code {
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>The shared image to open out when the dialog opens, if any.</summary>
    [Parameter] public string? Focus { get; set; }
}
