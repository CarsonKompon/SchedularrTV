@* Generated promo templates for a channel or block, with one template open for editing. *@
@inject TemplateAssets TemplateFiles
@inject ConfigEditor Editor

@if (Config is not { } generated)
{
    <div class="card">
        <div class="card-head"><h2>Templates</h2></div>
        <p class="hint">
            Render promos from the schedule, with a voice-over and background music: Up Next,
            Now Playing, This Has Been, Coming Up, Eventually, New Episode (for shows that drop new episodes), and
            We'll Be Right Back, You're Watching and Back to the Show for mid-show breaks.
            They fill in when a show has no promo clip,
            or mix in with the clips it has.
        </p>
        <div class="row row-wrap">
            <label class="inline-field">
                <span>Type</span>
                <select aria-label="New template type" @bind="_newType">
                    @foreach (GeneratedPromoType type in Enum.GetValues<GeneratedPromoType>())
                    {
                        <option value="@type">@TypeName(type)</option>
                    }
                </select>
            </label>
            <button class="btn btn-primary" type="button" @onclick="Enable">Create a template</button>
            <TemplatePackageButtons Kind="@GeneratedPromoPackages.Kind" What="generated promo template" ImportText="Import a template…"
                                    OnImport="ImportPackage" />
        </div>
    </div>
}
else
{
    <section class="generated" aria-label="Generated promos">
        <div class="generated-heading">
            <h2>Templates</h2>
            <label class="check">
                <input type="checkbox" checked="@generated.Enabled"
                       @onchange="e => { generated.Enabled = e.Value is true; Changed.InvokeAsync(); }" />
                <span>Use in @Scope</span>
            </label>
            <div class="spacer"></div>
            <label class="inline-field">
                <span>Type</span>
                <select aria-label="New template type" @bind="_newType">
                    @foreach (GeneratedPromoType type in Enum.GetValues<GeneratedPromoType>())
                    {
                        <option value="@type">@TypeName(type)</option>
                    }
                </select>
            </label>
            <EditorIconButton Icon="plus" Label="New template" OnClick="Add" />
            <EditorIconButton Icon="copy" Label="Duplicate template" Disabled="@(_selected is null)" OnClick="Duplicate" />
            <EditorIconButton Icon="trash" Label="Remove all templates" Danger="true" OnClick="Disable" />
        </div>
        <TemplatePackageButtons Kind="@GeneratedPromoPackages.Kind" What="generated promo template"
                                ExportText="@(_selected is null ? "Export" : $"Export “{(string.IsNullOrWhiteSpace(_selected.Name) ? "Untitled" : _selected.Name)}”")"
                                ExportTitle="Save the selected template with its pictures, songs and generator folder as a .zip to share"
                                CanExport="@(_selected is not null)" OnExport="ExportSelected" OnImport="ImportPackage"
                                ExportOptions="ExportChoices" ChoiceTitle="Export with its voice pack?"
                                ChoiceHint="This template's voice-over uses a voice pack. Include it so the template works anywhere, leave it out for a smaller file where the pack is installed already, or export the pack on its own." />

        <nav class="template-list" aria-label="Templates">
            @foreach (GeneratedPromoTemplate template in generated.Templates)
            {
                <button type="button" class="template-choice @(ReferenceEquals(template, _selected) ? "selected" : "")" @key="template"
                        aria-pressed="@(ReferenceEquals(template, _selected) ? "true" : "false")" @onclick="() => _selected = template">
                    <strong>@(string.IsNullOrWhiteSpace(template.Name) ? "Untitled" : template.Name)</strong>
                    <span title="@Summary(template)">@Summary(template)</span>
                </button>
            }
            @if (generated.Templates.Count == 0)
            {
                <p class="hint">No templates yet.</p>
            }
        </nav>

        @if (_selected is { } selected)
        {
            <GeneratedPromoTemplateEditor @key="selected" Template="selected" Channel="Channel" Changed="Changed"
                                          ErrorScope="@ErrorScope" OnRemove="() => Remove(selected)" />
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public ChannelConfig Channel { get; set; } = new() { Id = "", Name = "" };
    [Parameter] public GeneratedPromosConfig? Config { get; set; }
    [Parameter] public EventCallback<GeneratedPromosConfig?> ConfigChanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter, EditorRequired] public string ErrorScope { get; set; } = "";
    [Parameter] public string Scope { get; set; } = "this channel";

    private GeneratedPromoTemplate? _selected;
    private GeneratedPromoType _newType = GeneratedPromoType.UpNext;

    private static string TypeName(GeneratedPromoType type) => type switch
    {
        GeneratedPromoType.UpNext => "Up Next",
        GeneratedPromoType.NowPlaying => "Now Playing",
        GeneratedPromoType.ThisHasBeen => "This Has Been",
        GeneratedPromoType.ComingUp => "Coming Up",
        GeneratedPromoType.YoureWatching => "You're Watching",
        GeneratedPromoType.BackToTheShow => "Back to the Show",
        GeneratedPromoType.NewEpisode => "New Episode",
        GeneratedPromoType.RightBack => "We'll Be Right Back",
        _ => "Eventually"
    };

    protected override void OnParametersSet()
    {
        List<GeneratedPromoTemplate> templates = Config?.Templates ?? [];
        if (_selected is null || !templates.Contains(_selected))
        {
            _selected = templates.FirstOrDefault();
        }
    }

    private static string Summary(GeneratedPromoTemplate template) =>
        $"{TypeName(template.Type)} · {(template.Usage == GeneratedPromoUsage.Mixed ? $"Mixed {template.MixChance:P0}" : "Fallback")} · {template.Duration.TotalSeconds:0.#}s"
        + (template.Episodes switch { GeneratedEpisodeFilter.New => " · new episodes", GeneratedEpisodeFilter.Repeats => " · repeats", _ => "" })
        + (template.Generator is null ? "" : " · external")
        + (template.Enabled ? "" : " · off");

    private async Task Enable()
    {
        _selected = GeneratedPromoTemplates.ForType(_newType);
        await ConfigChanged.InvokeAsync(new GeneratedPromosConfig { Templates = [_selected] });
        await Changed.InvokeAsync();
    }

    private async Task Add()
    {
        List<GeneratedPromoTemplate> templates = Config!.Templates;
        _selected = GeneratedPromoTemplates.ForType(_newType,
            GeneratedPromoEditing.UniqueName(templates.Select(template => template.Name), TypeName(_newType)));
        templates.Add(_selected);
        await Changed.InvokeAsync();
    }

    private async Task Duplicate()
    {
        List<GeneratedPromoTemplate> templates = Config!.Templates;
        GeneratedPromoTemplate copy = GeneratedPromoEditing.Copy(_selected!);
        copy.Name = GeneratedPromoEditing.UniqueName(templates.Select(template => template.Name), $"{_selected!.Name} copy");
        templates.Insert(templates.IndexOf(_selected) + 1, copy);
        _selected = copy;
        await Changed.InvokeAsync();
    }

    private Task<string> ExportSelected(TemplatePackageWriter writer) =>
        _selected is { } template
            ? GeneratedPromoPackages.ExportAsync(template, writer, Editor.Working.Settings.GeneratedPromosSharedImages, Editor.Working.Settings.GeneratedPromosVoicePacks)
            : throw new InvalidOperationException("Choose a template to export.");

    // A template whose voice-over uses a voice pack offers it with or without the pack, or the pack alone, with sizes.
    private Task<IReadOnlyList<TemplateExportOption>?> ExportChoices() =>
        _selected is { } template
            ? GeneratedPromoPackages.ExportOptionsAsync(template, Editor.Working.Settings.GeneratedPromosSharedImages, Editor.Working.Settings.GeneratedPromosVoicePacks)
            : Task.FromResult<IReadOnlyList<TemplateExportOption>?>(null);

    private async Task<string> ImportPackage(TemplatePackageReader reader)
    {
        GeneratedSharedImport shared = new();
        GeneratedVoicePackImport voice = new();
        GeneratedPromoTemplate template = await GeneratedPromoPackages.ImportAsync(reader, TemplateFiles,
            Config?.Templates.Select(existing => existing.Name) ?? [], Editor.Working.Settings.GeneratedPromosSharedImages, shared,
            Editor.Working.Settings.GeneratedPromosVoicePacks, voice);
        string sharedNote = (shared.Summary.Length == 0 ? "" : " " + shared.Summary) + (voice.Pack is null ? "" : " " + voice.Summary);
        if (Config is { } config)
        {
            config.Templates.Add(template);
        }
        else
        {
            await ConfigChanged.InvokeAsync(new GeneratedPromosConfig { Templates = [template] });
        }

        _selected = template;
        await Changed.InvokeAsync();
        StateHasChanged();
        return template.Generator is { } generator && GeneratorSetup.Needs(generator)
            ? $"Imported “{template.Name}”. Its setup command runs the first time it's used.{sharedNote} Save to keep it."
            : $"Imported “{template.Name}”.{sharedNote} Save to keep it.";
    }

    private async Task Remove(GeneratedPromoTemplate template)
    {
        List<GeneratedPromoTemplate> templates = Config!.Templates;
        int index = templates.IndexOf(template);
        templates.Remove(template);
        _selected = templates.Count == 0 ? null : templates[Math.Clamp(index, 0, templates.Count - 1)];
        await Changed.InvokeAsync();
    }

    private async Task Disable()
    {
        _selected = null;
        await ConfigChanged.InvokeAsync(null);
        await Changed.InvokeAsync();
    }
}
