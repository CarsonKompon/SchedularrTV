@* Voice packs: pre-recorded phrases (fixed lines, show names, days, times, each with several takes) and the templates
   that put them together into a promo's voice-over. Kept once for every generated promo template. *@
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject ConfigEditor Editor
@inject GeneratedPromoPreview Preview
@inject IServiceProvider Services

<div class="modal-backdrop" @onclick="Close">
    <div class="modal modal-wide voice-packs" role="dialog" aria-modal="true" aria-labelledby="voice-packs-title" @onclick:stopPropagation="true">
        <div class="modal-head">
            <h2 id="voice-packs-title">Voice packs</h2>
            <div class="spacer"></div>
            <button class="btn btn-ghost btn-icon btn-sm" type="button" title="Close" aria-label="Close" @onclick="Close"><Icon Name="x" Size="16" /></button>
        </div>

        <div class="row row-wrap">
            <label class="field" style="flex: 1 1 260px; margin: 0;">
                <span>Voice pack</span>
                <select value="@(Pack?.Id ?? string.Empty)" @onchange="e => SelectPack(e.Value?.ToString())">
                    @if (Library.Count == 0)
                    {
                        <option value="">No voice packs yet</option>
                    }
                    @foreach (GeneratedVoicePack pack in Library)
                    {
                        <option value="@pack.Id">@(string.IsNullOrWhiteSpace(pack.Name) ? "Untitled" : pack.Name)</option>
                    }
                </select>
            </label>
            <button class="btn btn-sm" type="button" @onclick="AddPack"><Icon Name="plus" Size="15" />New voice pack</button>
        </div>

        @if (Pack is { } current)
        {
            <div class="row" role="tablist" aria-label="Voice pack sections">
                <button class="btn btn-sm @(_tab == Tab.Phrases ? "btn-primary" : "")" type="button" role="tab" aria-selected="@(_tab == Tab.Phrases)"
                        @onclick="() => _tab = Tab.Phrases">Phrases (@current.Phrases.Count)</button>
                <button class="btn btn-sm @(_tab == Tab.Templates ? "btn-primary" : "")" type="button" role="tab" aria-selected="@(_tab == Tab.Templates)"
                        @onclick="() => _tab = Tab.Templates">Templates (@current.Templates.Count)</button>
                <button class="btn btn-sm @(_tab == Tab.Settings ? "btn-primary" : "")" type="button" role="tab" aria-selected="@(_tab == Tab.Settings)"
                        @onclick="() => _tab = Tab.Settings">Pack settings</button>
            </div>

            @switch (_tab)
            {
                case Tab.Phrases:
                    @(PhrasesTab(current))
                    break;
                case Tab.Templates:
                    @(TemplatesTab(current))
                    break;
                default:
                    @(SettingsTab(current))
                    break;
            }
        }
        else
        {
            <p class="hint">A voice pack holds lines recorded ahead of time—fixed phrases like “Coming up next…”, every show's name, days and
                times—and templates that string them together. Make one to get started.</p>
        }

        <div class="row">
            <div class="spacer"></div>
            <button class="btn btn-primary" type="button" @onclick="Close">Done</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>The pack to show when the dialog opens.</summary>
    [Parameter] public string? Focus { get; set; }

    /// <summary>Shows to try templates with (the template being edited's preview shows), the first being the promo's own.</summary>
    [Parameter] public IReadOnlyList<UpNextListing> Shows { get; set; } = [];
    [Parameter] public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Local;
    [Parameter] public DateTimeOffset AirsAt { get; set; } = DateTimeOffset.Now;

    /// <summary>The channel of the template the dialog was opened from, which "add shows" starts on.</summary>
    [Parameter] public string? ChannelId { get; set; }

    /// <summary>Where a promo of that template would air right now (channel and block), for trying channel name phrases.</summary>
    [Parameter] public GeneratedVoiceContext? Where { get; set; }

    /// <summary>How much time the voice-over has, for trying templates.</summary>
    [Parameter] public TimeSpan Room { get; set; } = TimeSpan.FromSeconds(9);

    /// <summary>Raised with the pack chosen in the dialog, so the template being edited can pick it up.</summary>
    [Parameter] public EventCallback<string> PackChosen { get; set; }

    private enum Tab { Phrases, Templates, Settings }

    private const string DayHelp = "A show airing today says “tonight” from 5pm when that's recorded, else “today”; tomorrow likewise. "
        + "Otherwise its weekday is said, which also stands in for any of these that aren't recorded.";

    private const string TimeHelp = "8:30 PM is said as “8” “:30” “PM”; 8:00 PM as “8” “PM”. Noon and midnight are said instead of 12:00 when they're recorded. "
        + "A time whose parts aren't all recorded can't be said, so templates that say it are skipped for that promo.";

    private Tab _tab = Tab.Phrases;
    private string? _packId;
    private readonly HashSet<string> _open = new(StringComparer.OrdinalIgnoreCase);
    private string _newText = string.Empty;
    private GeneratedVoicePhraseKind _newKind = GeneratedVoicePhraseKind.Text;
    private readonly Dictionary<string, string> _newShow = new(StringComparer.Ordinal);
    private bool _trimSilence = true;

    // Trying a template: which one, its clip, what it said, or why it couldn't.
    private string? _tryingId;
    private string? _tryUrl;
    private string? _tryNote;
    private bool _tryBusy;
    private int _tries;

    private List<GeneratedVoicePack> Library => Editor.Working.Settings.GeneratedPromosVoicePacks;

    private GeneratedVoicePack? Pack => GeneratedVoicePacks.Find(Library, _packId) ?? Library.FirstOrDefault();

    protected override void OnInitialized()
    {
        _packId = GeneratedVoicePacks.Find(Library, Focus)?.Id ?? Library.FirstOrDefault()?.Id;
    }

    // Edits change the pack straight away, but are reported (marking the schedule unsaved, redrawing the template
    // editor) once things settle, so removing many shows one after another doesn't redraw everything each time.
    private CancellationTokenSource? _notifySoon;
    private const int NotifyDelayMs = 400;

    private Task Notify()
    {
        _notifySoon?.Cancel();
        var soon = new CancellationTokenSource();
        _notifySoon = soon;
        _ = NotifyLaterAsync(soon);
        return Task.CompletedTask;
    }

    private async Task NotifyLaterAsync(CancellationTokenSource soon)
    {
        try
        {
            await Task.Delay(NotifyDelayMs, soon.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (ReferenceEquals(_notifySoon, soon))
        {
            _notifySoon = null;
            await InvokeAsync(() => Changed.InvokeAsync());
        }
    }

    /// <summary>Reports an edit still waiting to be, now.</summary>
    private async Task FlushAsync()
    {
        if (_notifySoon is { } pending)
        {
            pending.Cancel();
            _notifySoon = null;
            await Changed.InvokeAsync();
        }
    }

    public void Dispose()
    {
        // Closed some other way (the page left): the edit still counts as unsaved.
        if (_notifySoon is { } pending)
        {
            pending.Cancel();
            _notifySoon = null;
            Editor.MarkDirty();
        }
    }

    private Task Set(Action change)
    {
        change();
        return Notify();
    }

    private async Task Close()
    {
        await FlushAsync();
        await OnClose.InvokeAsync();
    }

    private void SelectPack(string? id)
    {
        _packId = id;
        _open.Clear();
        ClearTry();
    }

    private async Task AddPack()
    {
        GeneratedVoicePack created = new()
        {
            Name = GeneratedPromoEditing.UniqueName(Library.Select(pack => pack.Name), "Voice pack"),
            Phrases =
            [
                new GeneratedVoicePhrase { Name = "Coming up next…", Kind = GeneratedVoicePhraseKind.Text },
                new GeneratedVoicePhrase { Name = "Show name", Kind = GeneratedVoicePhraseKind.ShowName },
                new GeneratedVoicePhrase { Name = "Day", Kind = GeneratedVoicePhraseKind.Day },
                new GeneratedVoicePhrase { Name = "Time", Kind = GeneratedVoicePhraseKind.Time }
            ]
        };
        created.Templates.Add(new GeneratedVoicePackTemplate
        {
            Name = "Coming up next",
            Parts = [new GeneratedVoicePart { Phrase = created.Phrases[0].Id }, new GeneratedVoicePart { Phrase = created.Phrases[1].Id }]
        });
        Library.Add(created);
        _packId = created.Id;
        _tab = Tab.Phrases;
        await Notify();
        await PackChosen.InvokeAsync(created.Id);
    }

    private Task RemovePack(GeneratedVoicePack pack)
    {
        if (GeneratedVoicePacks.Uses(Editor.Working, pack.Id) > 0) return Task.CompletedTask;
        Library.Remove(pack);
        _packId = Library.FirstOrDefault()?.Id;
        return Notify();
    }

    private void Toggle(string key)
    {
        if (!_open.Remove(key)) _open.Add(key);
    }

    private static string KindName(GeneratedVoicePhraseKind kind) => kind switch
    {
        GeneratedVoicePhraseKind.ShowName => "Show name",
        GeneratedVoicePhraseKind.Day => "Day",
        GeneratedVoicePhraseKind.Time => "Time",
        GeneratedVoicePhraseKind.DayTime => "Day & time",
        GeneratedVoicePhraseKind.ChannelName => "Channel name",
        _ => "Text"
    };

    private static int TakeCount(GeneratedVoicePhrase phrase) =>
        phrase.Kind == GeneratedVoicePhraseKind.Text ? phrase.Takes.Count : phrase.Entries.Sum(entry => entry.Takes.Count);

    private static string Summary(GeneratedVoicePhrase phrase)
    {
        int takes = TakeCount(phrase);
        string recorded = takes == 1 ? "1 take" : $"{takes} takes";
        if (phrase.Kind == GeneratedVoicePhraseKind.Text) return recorded;
        int values = phrase.Entries.Count(entry => entry.Takes.Count > 0);
        string noun = phrase.Kind switch
        {
            GeneratedVoicePhraseKind.ShowName => values == 1 ? "show" : "shows",
            GeneratedVoicePhraseKind.Day => values == 1 ? "day" : "days",
            GeneratedVoicePhraseKind.DayTime => values == 1 ? "day & time" : "days & times",
            GeneratedVoicePhraseKind.ChannelName => values == 1 ? "channel or block" : "channels & blocks",
            GeneratedVoicePhraseKind.Time when phrase.Combined => values == 1 ? "time or part" : "times & parts",
            _ => values == 1 ? "part" : "parts"
        };
        return $"{values} {noun} · {recorded}";
    }

    // ---- Phrases ----------------------------------------------------------------------------------------------

    private RenderFragment PhrasesTab(GeneratedVoicePack pack) => __builder =>
    {
        <p class="hint">
            Each phrase has one or more takes; a promo picks one at random, preferring shorter takes when time is tight. Show name, day and time
            phrases have takes for each value: every show's name, each day, and the hours, minutes and am/pm a time is said from.
        </p>
        // Promos' own (inline) templates count as uses too.
        List<GeneratedVoicePackTemplate> inlineTemplates = [.. GeneratedVoicePacks.InlineTemplates(Editor.Working, pack.Id)];
        @foreach (GeneratedVoicePhrase phrase in pack.Phrases)
        {
            string key = $"phrase:{phrase.Id}";
            bool open = _open.Contains(key);
            int uses = pack.Templates.Concat(inlineTemplates).Sum(template => template.Parts.Count(part => part.Phrase == phrase.Id));
            <div class="card voice-phrase" @key="phrase">
                <div class="card-head">
                    <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-expanded="@(open ? "true" : "false")"
                            aria-label="@(open ? "Collapse" : "Expand")" @onclick="() => Toggle(key)">
                        <Icon Name="@(open ? "chevron-down" : "chevron-right")" Size="16" />
                    </button>
                    <span class="pill">@KindName(phrase.Kind)</span>
                    <strong style="cursor: pointer;" @onclick="() => Toggle(key)">@(string.IsNullOrWhiteSpace(phrase.Name) ? "Untitled" : phrase.Name)</strong>
                    <span class="hint">@Summary(phrase)@(uses == 0 ? " · not in a template" : uses == 1 ? " · in 1 template" : $" · in {uses} templates")</span>
                    <div class="spacer"></div>
                    <button class="btn btn-sm" type="button" title="Make a copy of this phrase, recordings and all"
                            @onclick="() => DuplicatePhrase(pack, phrase, keepTakes: true)">Duplicate</button>
                    <button class="btn btn-sm" type="button"
                            title="@(phrase.Kind == GeneratedVoicePhraseKind.Text ? "Make a copy with no recordings, to record again" : "Make a copy with the same shows, days, times or channels but no recordings, to record again")"
                            @onclick="() => DuplicatePhrase(pack, phrase, keepTakes: false)">Duplicate without takes</button>
                    <button class="btn btn-sm btn-danger" type="button" title="Delete this phrase (and its parts in templates)"
                            @onclick="() => RemovePhrase(pack, phrase)">Delete</button>
                </div>
                @if (open)
                {
                    <label class="field">
                        <span>@(phrase.Kind == GeneratedVoicePhraseKind.Text ? "What it says" : "Name")</span>
                        <input type="text" value="@phrase.Name" @onchange="e => Set(() => phrase.Name = e.Value?.ToString() ?? string.Empty)" />
                    </label>
                    @switch (phrase.Kind)
                    {
                        case GeneratedVoicePhraseKind.Text:
                            <VoiceTakesEditor Takes="phrase.Takes" Changed="Notify" Prompt="@phrase.Name" TrimSilence="_trimSilence" />
                            break;
                        case GeneratedVoicePhraseKind.ShowName:
                            @(ShowEntries(phrase))
                            break;
                        case GeneratedVoicePhraseKind.Day:
                            @(KeyedEntries(phrase, GeneratedVoiceKeys.Days, GeneratedVoiceKeys.DayLabel, DayHelp))
                            break;
                        case GeneratedVoicePhraseKind.Time:
                            @(TimeSettings(phrase))
                            @if (phrase.Combined)
                            {
                                @(KeyedEntries(phrase, GeneratedVoiceKeys.WholeTimes(phrase.TwentyFourHour, phrase.AmPmInTake && !phrase.TwentyFourHour, phrase.MinuteStep),
                                    GeneratedVoiceKeys.TimeLabel, WholeTimeHelp(phrase)))
                                <details class="voice-parts-fallback">
                                    <summary>Separate parts (@PartsSummary(phrase))</summary>
                                    @(KeyedEntries(phrase, GeneratedVoiceKeys.TimeParts(phrase.TwentyFourHour, phrase.SayAmPm), GeneratedVoiceKeys.TimeLabel,
                                        "Used for any time that isn't recorded whole above" + (!phrase.TwentyFourHour && !phrase.AmPmInTake && phrase.SayAmPm ? ", and AM/PM here is said after every whole time." : ".")))
                                </details>
                            }
                            else
                            {
                                @(KeyedEntries(phrase, GeneratedVoiceKeys.TimeParts(phrase.TwentyFourHour, phrase.SayAmPm), GeneratedVoiceKeys.TimeLabel, TimeHelp))
                            }
                            break;
                        case GeneratedVoicePhraseKind.DayTime:
                            @(TimeSettings(phrase))
                            @(DayTimeEntries(phrase))
                            break;
                        case GeneratedVoicePhraseKind.ChannelName:
                            @(ChannelEntries(phrase))
                            break;
                    }
                }
            </div>
        }

        <div class="row row-wrap voice-add-phrase">
            <select value="@_newKind" aria-label="Kind of phrase" @onchange="e => _newKind = Enum.Parse<GeneratedVoicePhraseKind>(e.Value?.ToString() ?? nameof(GeneratedVoicePhraseKind.Text))">
                @foreach (GeneratedVoicePhraseKind kind in Enum.GetValues<GeneratedVoicePhraseKind>())
                {
                    <option value="@kind">@KindName(kind)</option>
                }
            </select>
            <input type="text" value="@_newText" aria-label="What the phrase says"
                   placeholder="@(_newKind == GeneratedVoicePhraseKind.Text ? "What it says, e.g. Only on Nick!" : $"Name, e.g. {KindName(_newKind)}")"
                   @oninput="e => _newText = e.Value?.ToString() ?? string.Empty" />
            <button class="btn btn-sm" type="button" disabled="@(_newKind == GeneratedVoicePhraseKind.Text && string.IsNullOrWhiteSpace(_newText))"
                    @onclick="() => AddPhrase(pack)"><Icon Name="plus" Size="15" />Add phrase</button>
        </div>
    };

    private RenderFragment ShowEntries(GeneratedVoicePhrase phrase) => __builder =>
    {
        string typed = _newShow.GetValueOrDefault(phrase.Id, string.Empty);

        // The shows already here by their normalised words, so checking lists of hundreds against them is quick.
        HashSet<string> here = new(phrase.Entries.Select(entry => ShowTitleMatcher.Words(entry.Key)), StringComparer.Ordinal);
        bool Here(string title) => here.Contains(ShowTitleMatcher.Words(title));
        SourceTitles scheduledEverywhere = ScheduledShows(null);
        List<string> unrecorded = [.. scheduledEverywhere.Shows.Concat(scheduledEverywhere.Movies).Where(title => !Here(title))];
        SourceTitles source = SourceShows(ShowSource);
        IReadOnlyList<string> fromSource = source.Shows;
        IReadOnlyList<string> sourceMovies = source.Movies;
        bool loadingSource = _loadingShows || !string.Equals(_loadedSource, ShowSource, StringComparison.Ordinal);
        List<string> sourceMissing = [.. fromSource.Where(title => !Here(title))];
        List<string> moviesMissing = [.. sourceMovies.Where(title => !Here(title))];
        string sourceName = SourceName(ShowSource);

        // Only a page of shows is drawn at a time, narrowed by the search box; several can be ticked and removed at once.
        string filter = _showFilter.GetValueOrDefault(phrase.Id, string.Empty).Trim();
        List<GeneratedVoiceEntry> matching = filter.Length == 0 ? phrase.Entries
            : [.. phrase.Entries.Where(entry => entry.Key.Contains(filter, StringComparison.OrdinalIgnoreCase))];
        int limit = _showLimit.GetValueOrDefault(phrase.Id, ShowPage);
        HashSet<GeneratedVoiceEntry> selected = SelectedShows(phrase);
        int withoutTakes = phrase.Entries.Count(entry => entry.Takes.Count == 0);
        <p class="hint">Show names are matched loosely (case, punctuation, a missing “The” and small typos are forgiven). A promo about a show with
            no recording here skips the templates that say its name.</p>
        @if (phrase.Entries.Count > 0)
        {
            <div class="row row-wrap voice-entry-tools">
                <input type="search" value="@filter" placeholder="@($"Find among {phrase.Entries.Count} shows…")" aria-label="Find a show"
                       @oninput="e => FilterShows(phrase, e.Value?.ToString())" />
                <label class="check" style="margin: 0;">
                    <input type="checkbox" checked="@(matching.Count > 0 && matching.All(selected.Contains))"
                           @onchange="e => SelectShows(phrase, matching, e.Value is true)" />
                    <span>Select @(filter.Length == 0 ? "all" : "matching") (@matching.Count)</span>
                </label>
                <button class="btn btn-sm btn-danger" type="button" disabled="@(selected.Count == 0)"
                        title="Removes the shows from this phrase; their recordings stay on disk" @onclick="() => RemoveSelectedShows(phrase)">
                    Remove selected (@selected.Count)
                </button>
                @if (withoutTakes > 0)
                {
                    <button class="btn btn-sm" type="button" title="Removes every show here that hasn't been recorded yet"
                            @onclick="() => RemoveShowsWithoutTakes(phrase)">Remove the @withoutTakes without takes</button>
                }
            </div>
        }
        @foreach (GeneratedVoiceEntry entry in matching.Take(limit))
        {
            string key = $"entry:{phrase.Id}:{entry.Key}";
            bool open = _open.Contains(key);
            <div class="voice-entry" @key="entry">
                <div class="voice-entry-head">
                    <input type="checkbox" checked="@selected.Contains(entry)" aria-label="@($"Select {entry.Key}")"
                           @onchange="e => { if (e.Value is true) selected.Add(entry); else selected.Remove(entry); }" />
                    <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="@(open ? "Collapse" : "Expand")" @onclick="() => Toggle(key)">
                        <Icon Name="@(open ? "chevron-down" : "chevron-right")" Size="14" />
                    </button>
                    <input type="text" value="@entry.Key" aria-label="Show title" @onchange="e => Rename(phrase, entry, e.Value?.ToString())" />
                    <span class="hint">@(entry.Takes.Count == 0 ? "not recorded" : entry.Takes.Count == 1 ? "1 take" : $"{entry.Takes.Count} takes")</span>
                    <div class="spacer"></div>
                    <button class="btn btn-ghost btn-icon btn-sm" type="button" title="Remove this show" aria-label="@($"Remove {entry.Key}")"
                            @onclick="() => Set(() => { phrase.Entries.Remove(entry); selected.Remove(entry); })"><Icon Name="x" Size="14" /></button>
                </div>
                @if (open)
                {
                    <VoiceTakesEditor Takes="entry.Takes" Changed="Notify" Prompt="@entry.Key" TrimSilence="_trimSilence" />
                }
            </div>
        }
        @if (matching.Count > limit)
        {
            <div class="row">
                <button class="btn btn-sm" type="button" @onclick="() => _showLimit[phrase.Id] = limit + ShowPage">
                    Show @Math.Min(ShowPage, matching.Count - limit) more (@(matching.Count - limit) not shown)
                </button>
            </div>
        }
        else if (filter.Length > 0 && matching.Count == 0)
        {
            <p class="hint">No show here matches “@filter”.</p>
        }
        <div class="row row-wrap">
            <input type="text" value="@typed" placeholder="Show title" aria-label="Show title to add" list="@($"voice-shows-{phrase.Id}")"
                   @oninput="e => _newShow[phrase.Id] = e.Value?.ToString() ?? string.Empty" />
            <datalist id="@($"voice-shows-{phrase.Id}")">
                @foreach (string title in unrecorded)
                {
                    <option value="@title"></option>
                }
            </datalist>
            <button class="btn btn-sm" type="button" disabled="@string.IsNullOrWhiteSpace(typed)" @onclick="() => AddShow(phrase, typed)">Add show</button>
        </div>
        <div class="row row-wrap voice-show-source">
            <select value="@ShowSource" aria-label="Channel or block to add shows from" @onchange="e => ChooseSource(e.Value?.ToString())">
                <option value="@AllChannels">All channels</option>
                @foreach (ChannelConfig channel in Editor.Working.Channels)
                {
                    <option value="@ChannelSource(channel.Id)">@ChannelLabel(channel)</option>
                    @foreach (BlockConfig block in channel.Blocks.Where(block => !string.IsNullOrWhiteSpace(block.Name)))
                    {
                        <option value="@BlockSource(channel.Id, block.Name)">&nbsp;&nbsp;› @block.Name</option>
                    }
                }
            </select>
            @if (fromSource.Count == 0 && loadingSource)
            {
                <button class="btn btn-sm" type="button" disabled>Finding the shows in @sourceName…</button>
            }
            else if (fromSource.Count == 0)
            {
                @if (sourceMovies.Count == 0)
                {
                    <button class="btn btn-sm" type="button" disabled title="Its rotation, blocks and anchors match nothing in the library, and nothing from it is scheduled">No shows in @sourceName</button>
                }
            }
            else if (sourceMissing.Count == fromSource.Count)
            {
                <button class="btn btn-sm" type="button" title="@(string.Join(", ", fromSource.Take(30)))"
                        @onclick="() => AddShows(phrase, fromSource)">Add all @fromSource.Count @(fromSource.Count == 1 ? "show" : "shows") from @sourceName</button>
            }
            else if (sourceMissing.Count > 0)
            {
                <button class="btn btn-sm" type="button" title="@(string.Join(", ", sourceMissing.Take(30)))"
                        @onclick="() => AddShows(phrase, sourceMissing)">Add the remaining @sourceMissing.Count @(sourceMissing.Count == 1 ? "show" : "shows") not here yet</button>
            }
            else
            {
                <button class="btn btn-sm" type="button" disabled>All @fromSource.Count @(fromSource.Count == 1 ? "show" : "shows") from @sourceName are here</button>
            }

            @* Movies are kept apart, as a channel can have hundreds that a voice-over would rarely name. *@
            @if (sourceMovies.Count > 0)
            {
                @if (moviesMissing.Count == sourceMovies.Count)
                {
                    <button class="btn btn-sm" type="button" title="@(string.Join(", ", sourceMovies.Take(30)))"
                            @onclick="() => AddShows(phrase, sourceMovies)">Add all @sourceMovies.Count @(sourceMovies.Count == 1 ? "movie" : "movies") from @sourceName</button>
                }
                else if (moviesMissing.Count > 0)
                {
                    <button class="btn btn-sm" type="button" title="@(string.Join(", ", moviesMissing.Take(30)))"
                            @onclick="() => AddShows(phrase, moviesMissing)">Add the remaining @moviesMissing.Count @(moviesMissing.Count == 1 ? "movie" : "movies") not here yet</button>
                }
                else
                {
                    <button class="btn btn-sm" type="button" disabled>All @sourceMovies.Count @(sourceMovies.Count == 1 ? "movie" : "movies") from @sourceName are here</button>
                }
            }
        </div>
        <p class="hint">
            Shows and movies come from the channel's or block's own programming (its base rotation, block shows and anchors, matched against the library)
            plus anything already on the schedule there. Movies have a button of their own, so a channel full of them doesn't crowd out its shows.@(loadingSource && fromSource.Count > 0 ? " Still reading the library…" : "")
            @if (_showsProblem is not null)
            {
                <span class="warn"> @_showsProblem</span>
            }
        </p>
        @if (unrecorded.Count > 0 && phrase.Entries.Count > 0)
        {
            <p class="hint">@unrecorded.Count scheduled @(unrecorded.Count == 1 ? "show has" : "shows have") no recording here across all channels.</p>
        }
    };

    private RenderFragment KeyedEntries(GeneratedVoicePhrase phrase, IReadOnlyList<string> keys, Func<string, string> label, string help) => __builder =>
    {
        <p class="hint">@help</p>
        <div class="voice-keyed">
            @foreach (string value in keys)
            {
                GeneratedVoiceEntry? entry = phrase.Entries.FirstOrDefault(candidate => string.Equals(candidate.Key, value, StringComparison.OrdinalIgnoreCase));
                string key = $"entry:{phrase.Id}:{value}";
                bool open = _open.Contains(key);
                int count = entry?.Takes.Count ?? 0;
                <div class="voice-entry @(count == 0 ? "voice-entry-empty" : null)" @key="value">
                    <div class="voice-entry-head">
                        <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="@(open ? "Collapse" : "Expand")" @onclick="() => Open(phrase, value, key)">
                            <Icon Name="@(open ? "chevron-down" : "chevron-right")" Size="14" />
                        </button>
                        <strong style="cursor: pointer;" @onclick="() => Open(phrase, value, key)">@label(value)</strong>
                        <span class="hint">@(count == 0 ? "not recorded" : count == 1 ? "1 take" : $"{count} takes")</span>
                    </div>
                    @if (open && entry is not null)
                    {
                        <VoiceTakesEditor Takes="entry.Takes" Changed="Notify" Prompt="@label(value)" TrimSilence="_trimSilence" />
                    }
                </div>
            }
        </div>
    };

    private RenderFragment TimeSettings(GeneratedVoicePhrase phrase) => __builder =>
    {
        bool dayTime = phrase.Kind == GeneratedVoicePhraseKind.DayTime;
        bool whole = dayTime || phrase.Combined;
        <div class="row row-wrap">
            @if (!dayTime)
            {
                <label class="check">
                    <input type="checkbox" checked="@phrase.Combined" @onchange="e => Set(() => phrase.Combined = e.Value is true)" />
                    <span>Say the whole time in one take (“2:45”): more to record, more natural</span>
                </label>
            }
            <label class="check">
                <input type="checkbox" checked="@phrase.TwentyFourHour" @onchange="e => Set(() => phrase.TwentyFourHour = e.Value is true)" />
                <span>24-hour clock (no AM/PM)</span>
            </label>
            @if (!phrase.TwentyFourHour && whole)
            {
                <label class="check">
                    <input type="checkbox" checked="@phrase.AmPmInTake" @onchange="e => Set(() => phrase.AmPmInTake = e.Value is true)" />
                    <span>Include AM/PM in the take (“@(dayTime ? "Monday at 2:45 PM" : "2:45 PM")”)</span>
                </label>
            }
            @if (!phrase.TwentyFourHour && (!whole || (!dayTime && !phrase.AmPmInTake)))
            {
                <label class="check">
                    <input type="checkbox" checked="@phrase.SayAmPm" @onchange="e => Set(() => phrase.SayAmPm = e.Value is true)" />
                    <span>Say “AM” / “PM” after the time@(whole ? " (as a separate take)" : "")</span>
                </label>
            }
            @if (whole)
            {
                <label class="field voice-step" style="margin: 0;">
                    <span>Times every</span>
                    <select value="@GeneratedVoiceKeys.Step(phrase.MinuteStep)" @onchange="e => Set(() => phrase.MinuteStep = GeneratedVoiceKeys.Step(int.TryParse(e.Value?.ToString(), out int every) ? every : 15))">
                        @foreach (int step in GeneratedVoiceKeys.MinuteSteps)
                        {
                            <option value="@step">@(step == 60 ? "hour" : $"{step} minutes")</option>
                        }
                    </select>
                </label>
            }
        </div>
    };

    private string WholeTimeHelp(GeneratedVoicePhrase phrase) =>
        $"Record each time whole, e.g. “{GeneratedVoiceKeys.TimeLabel(GeneratedVoiceKeys.WholeTime(14, 45, phrase.TwentyFourHour, phrase.AmPmInTake && !phrase.TwentyFourHour))}”. "
        + "Noon and midnight are said instead of 12:00 when recorded. A show at a time that isn't listed or recorded here is said from the separate parts below, "
        + "if those are recorded; otherwise templates that say it are skipped for that promo. Times on other minutes than these can't be said whole.";

    private static string PartsSummary(GeneratedVoicePhrase phrase)
    {
        int recorded = GeneratedVoiceKeys.TimeParts(phrase.TwentyFourHour, phrase.SayAmPm)
            .Count(key => phrase.Entries.Any(entry => string.Equals(entry.Key, key, StringComparison.OrdinalIgnoreCase) && entry.Takes.Count > 0));
        return recorded == 0 ? "none recorded" : $"{recorded} recorded";
    }

    private RenderFragment ChannelEntries(GeneratedVoicePhrase phrase) => __builder =>
    {
        // Every channel's key, then (with block names on) each of its named blocks, labelled for the list.
        Dictionary<string, string> labels = new(StringComparer.OrdinalIgnoreCase);
        foreach (ChannelConfig channel in Editor.Working.Channels)
        {
            labels[GeneratedVoiceKeys.Channel(channel.Id)] = ChannelLabel(channel);
            if (!phrase.UseBlockNames) continue;
            foreach (BlockConfig block in channel.Blocks.Where(block => !string.IsNullOrWhiteSpace(block.Name)))
            {
                labels.TryAdd(GeneratedVoiceKeys.Block(channel.Id, block.Name), $"{ChannelLabel(channel)} › {block.Name}");
            }
        }

        <label class="check">
            <input type="checkbox" checked="@phrase.UseBlockNames" @onchange="e => Set(() => phrase.UseBlockNames = e.Value is true)" />
            <span>Say the block's name instead while a promo airs in a block (when that block is recorded)</span>
        </label>
        @if (Editor.Working.Channels.Count == 0)
        {
            <p class="hint warn">There are no channels yet.</p>
        }
        else
        {
            @(KeyedEntries(phrase, [.. labels.Keys], key => labels.GetValueOrDefault(key, key),
                phrase.UseBlockNames
                    ? "Record each channel's name, and the name of any block that should be said instead while it's on (“Saturday Morning Cartoons”). A block without a recording says its channel's name."
                    : "Record each channel's name as it should be said (“Nick”, “Nickelodeon”). A promo says the name of the channel it airs on; a channel without a recording skips templates that say it."))
        }
    };

    // The day whose times the day-and-time phrase is showing, by phrase.
    private readonly Dictionary<string, string> _dayTimeDay = new(StringComparer.Ordinal);

    private RenderFragment DayTimeEntries(GeneratedVoicePhrase phrase) => __builder =>
    {
        IReadOnlyList<string> times = GeneratedVoiceKeys.WholeTimes(phrase.TwentyFourHour, phrase.AmPmInTake && !phrase.TwentyFourHour, phrase.MinuteStep);
        string day = _dayTimeDay.GetValueOrDefault(phrase.Id, GeneratedVoiceKeys.Days[0]);
        int Recorded(string candidate) => times.Count(time => phrase.Entries.Any(entry =>
            string.Equals(entry.Key, GeneratedVoiceKeys.DayTime(candidate, time), StringComparison.OrdinalIgnoreCase) && entry.Takes.Count > 0));
        <div class="row row-wrap">
            <label class="field" style="margin: 0;">
                <span>Day</span>
                <select value="@day" @onchange="e => _dayTimeDay[phrase.Id] = e.Value?.ToString() ?? GeneratedVoiceKeys.Days[0]">
                    @foreach (string option in GeneratedVoiceKeys.Days)
                    {
                        int count = Recorded(option);
                        <option value="@option">@GeneratedVoiceKeys.DayLabel(option)@(count > 0 ? $" ({count} recorded)" : "")</option>
                    }
                </select>
            </label>
        </div>
        @(KeyedEntries(phrase, [.. times.Select(time => GeneratedVoiceKeys.DayTime(day, time))], GeneratedVoiceKeys.DayTimeLabel,
            "One take per day and time, e.g. “Monday at 11:30” or “tonight at 8:00 PM”. A show today says “tonight” from 5pm when that's recorded, else “today”; "
            + "tomorrow likewise; otherwise its weekday, which also stands in when those aren't recorded at that time. Noon and midnight are said instead of 12:00 when recorded."))
    };

    private async Task Open(GeneratedVoicePhrase phrase, string value, string key)
    {
        if (_open.Remove(key)) return;
        _open.Add(key);
        if (!phrase.Entries.Any(candidate => string.Equals(candidate.Key, value, StringComparison.OrdinalIgnoreCase)))
        {
            phrase.Entries.Add(new GeneratedVoiceEntry { Key = value });
            await Notify();
        }
    }

    private Task Rename(GeneratedVoicePhrase phrase, GeneratedVoiceEntry entry, string? title)
    {
        string trimmed = title?.Trim() ?? string.Empty;
        if (trimmed.Length == 0) return Task.CompletedTask;
        bool open = _open.Remove($"entry:{phrase.Id}:{entry.Key}");
        entry.Key = trimmed;
        if (open) _open.Add($"entry:{phrase.Id}:{trimmed}");
        return Notify();
    }

    private Task AddShow(GeneratedVoicePhrase phrase, string title)
    {
        string trimmed = title.Trim();
        if (trimmed.Length == 0) return Task.CompletedTask;
        _newShow[phrase.Id] = string.Empty;
        if (phrase.Entries.Any(entry => string.Equals(entry.Key, trimmed, StringComparison.OrdinalIgnoreCase))) return Task.CompletedTask;
        phrase.Entries.Add(new GeneratedVoiceEntry { Key = trimmed });
        _open.Add($"entry:{phrase.Id}:{trimmed}");
        return Notify();
    }

    private Task AddShows(GeneratedVoicePhrase phrase, IEnumerable<string> titles) => Set(() =>
    {
        HashSet<string> existing = new(phrase.Entries.Select(entry => entry.Key), StringComparer.OrdinalIgnoreCase);
        foreach (string title in titles)
        {
            if (existing.Add(title)) phrase.Entries.Add(new GeneratedVoiceEntry { Key = title });
        }

        phrase.Entries.Sort((a, b) => string.Compare(a.Key, b.Key, StringComparison.OrdinalIgnoreCase));
    });

    // How many shows are drawn at a time; more come with "Show more".
    private const int ShowPage = 50;
    private readonly Dictionary<string, string> _showFilter = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _showLimit = new(StringComparer.Ordinal);
    private readonly Dictionary<string, HashSet<GeneratedVoiceEntry>> _selectedShows = new(StringComparer.Ordinal);

    /// <summary>The shows ticked in a show name phrase, less any that have since gone.</summary>
    private HashSet<GeneratedVoiceEntry> SelectedShows(GeneratedVoicePhrase phrase)
    {
        if (!_selectedShows.TryGetValue(phrase.Id, out HashSet<GeneratedVoiceEntry>? selected))
        {
            selected = new HashSet<GeneratedVoiceEntry>(ReferenceEqualityComparer.Instance);
            _selectedShows[phrase.Id] = selected;
        }
        else if (selected.Count > 0)
        {
            HashSet<GeneratedVoiceEntry> present = new(phrase.Entries, ReferenceEqualityComparer.Instance);
            selected.RemoveWhere(entry => !present.Contains(entry));
        }

        return selected;
    }

    private void FilterShows(GeneratedVoicePhrase phrase, string? filter)
    {
        _showFilter[phrase.Id] = filter ?? string.Empty;
        _showLimit.Remove(phrase.Id);
    }

    private void SelectShows(GeneratedVoicePhrase phrase, IEnumerable<GeneratedVoiceEntry> shows, bool select)
    {
        HashSet<GeneratedVoiceEntry> selected = SelectedShows(phrase);
        if (select) selected.UnionWith(shows);
        else selected.ExceptWith(shows);
    }

    private Task RemoveSelectedShows(GeneratedVoicePhrase phrase)
    {
        HashSet<GeneratedVoiceEntry> selected = SelectedShows(phrase);
        if (selected.Count == 0) return Task.CompletedTask;
        return Set(() =>
        {
            phrase.Entries.RemoveAll(selected.Contains);
            selected.Clear();
            _showLimit.Remove(phrase.Id);
        });
    }

    private Task RemoveShowsWithoutTakes(GeneratedVoicePhrase phrase) => Set(() =>
    {
        phrase.Entries.RemoveAll(entry => entry.Takes.Count == 0);
        _showLimit.Remove(phrase.Id);
    });

    // Where "add shows" takes them from: every channel, one channel ("channel:<id>") or one of its blocks ("block:<id>|<name>";
    // the first bar ends the id, as channel ids don't normally contain one).
    private const string AllChannels = "all";
    private string? _showSource;

    /// <summary>The chosen source, at first the channel of the template the dialog was opened from.</summary>
    private string ShowSource => _showSource ?? (string.IsNullOrWhiteSpace(ChannelId) ? AllChannels : ChannelSource(ChannelId));

    private static string ChannelSource(string channelId) => $"channel:{channelId}";

    private static string BlockSource(string channelId, string block) => $"block:{channelId}|{block}";

    private static string ChannelLabel(ChannelConfig channel) => string.IsNullOrWhiteSpace(channel.Name) ? channel.Id : channel.Name;

    private string SourceName(string source)
    {
        (string? channelId, string? block) = ParseSource(source);
        if (channelId is null) return "all channels";
        ChannelConfig? channel = Editor.Working.Channels.FirstOrDefault(candidate => string.Equals(candidate.Id, channelId, StringComparison.OrdinalIgnoreCase));
        string name = channel is null ? channelId : ChannelLabel(channel);
        return block is null ? name : $"{name} › {block}";
    }

    private static (string? ChannelId, string? Block) ParseSource(string? source)
    {
        if (source?.StartsWith("channel:", StringComparison.Ordinal) == true) return (source["channel:".Length..], null);
        if (source?.StartsWith("block:", StringComparison.Ordinal) == true && source.IndexOf('|') is var split and > 0)
            return (source["block:".Length..split], source[(split + 1)..]);
        return (null, null);
    }

    // The library titles the chosen source programmes, read in the background (the library can be large).
    private string? _loadedSource;
    private SourceTitles _rotation = SourceTitles.None;
    private bool _loadingShows;

    /// <summary>A source's show (series) titles and movie titles, each sorted.</summary>
    private sealed record SourceTitles(IReadOnlyList<string> Shows, IReadOnlyList<string> Movies)
    {
        public static readonly SourceTitles None = new(Array.Empty<string>(), Array.Empty<string>());
    }
    private string? _showsProblem;

    protected override Task OnInitializedAsync() => LoadRotationShows(ShowSource);

    private async Task ChooseSource(string? source)
    {
        _showSource = string.IsNullOrWhiteSpace(source) ? AllChannels : source;
        await LoadRotationShows(_showSource);
    }

    /// <summary>
    /// What <paramref name="source"/> could play, from its programming rather than the built schedule: its base rotation,
    /// block shows and anchors (just the block's, for a block), matched against the library the way a build matches them.
    /// </summary>
    private async Task LoadRotationShows(string source)
    {
        if (string.Equals(_loadedSource, source, StringComparison.Ordinal) || Services.GetService<LibraryBrowser>() is not { } library)
        {
            _loadedSource = source;
            return;
        }

        _loadingShows = true;
        _showsProblem = null;
        try
        {
            (string? channelId, string? blockName) = ParseSource(source);
            List<ContentSelector> selectors = [];
            foreach (ChannelConfig channel in Editor.Working.Channels.Where(channel =>
                         channelId is null || string.Equals(channel.Id, channelId, StringComparison.OrdinalIgnoreCase)))
            {
                BlockConfig? block = blockName is null ? null
                    : channel.Blocks.FirstOrDefault(candidate => string.Equals(candidate.Name, blockName, StringComparison.OrdinalIgnoreCase));
                selectors.AddRange(blockName is null ? ContentSelectorQuery.Of(channel)
                    : block is null ? Enumerable.Empty<ContentSelector>() : ContentSelectorQuery.Of(block));
            }

            IReadOnlyList<MediaItem> programmes = await library.GetProgrammesAsync();
            SchedulerConfig config = Editor.Working;
            (IReadOnlyList<string> shows, IReadOnlyList<string> movies) = await Task.Run(() => ContentSelectorQuery.ShowsAndMovies(config, selectors, programmes));
            if (string.Equals(ShowSource, source, StringComparison.Ordinal))
            {
                _rotation = new SourceTitles(shows, movies);
                _loadedSource = source;
            }
        }
        catch (Exception ex) when (ex is not OutOfMemoryException and not OperationCanceledException)
        {
            _showsProblem = $"Couldn't read the library ({ex.GetBaseException().Message}), so only scheduled shows are listed.";
            _rotation = SourceTitles.None;
            _loadedSource = source;
        }
        finally
        {
            _loadingShows = false;
        }
    }

    /// <summary>
    /// The shows and movies <paramref name="source"/> programmes (once read from the library) and has on the schedule,
    /// together. Remembered until either changes.
    /// </summary>
    private SourceTitles SourceShows(string source)
    {
        SourceTitles rotation = string.Equals(_loadedSource, source, StringComparison.Ordinal) ? _rotation : SourceTitles.None;
        SourceTitles scheduled = ScheduledShows(source);
        if (_merged is { } merged && ReferenceEquals(merged.Rotation, rotation) && ReferenceEquals(merged.Scheduled, scheduled))
        {
            return merged.Titles;
        }

        static IReadOnlyList<string> Merge(IEnumerable<string> first, IEnumerable<string> second) =>
            first.Concat(second).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToList();

        // A title can't be both: one the library calls a movie isn't also listed as a show.
        IReadOnlyList<string> movies = Merge(rotation.Movies, scheduled.Movies);
        HashSet<string> movieTitles = new(movies, StringComparer.OrdinalIgnoreCase);
        SourceTitles titles = new([.. Merge(rotation.Shows, scheduled.Shows).Where(title => !movieTitles.Contains(title))], movies);
        _merged = (rotation, scheduled, titles);
        return titles;
    }

    private (SourceTitles Rotation, SourceTitles Scheduled, SourceTitles Titles)? _merged;

    /// <summary>
    /// The shows the current schedule airs on <paramref name="source"/> (a channel, one of its blocks, or every channel when
    /// null or "all"), for adding show names quickly.
    /// </summary>
    private SourceTitles ScheduledShows(string? source)
    {
        if (Services.GetService<ScheduleCoordinator>() is not { } coordinator) return SourceTitles.None;

        // Worked out once per source until the schedule is rebuilt, rather than on every redraw.
        IReadOnlyList<ChannelSchedule> latest = coordinator.Latest;
        if (!ReferenceEquals(latest, _scheduledFor))
        {
            _scheduledFor = latest;
            _scheduled.Clear();
        }

        string cacheKey = source ?? AllChannels;
        if (!_scheduled.TryGetValue(cacheKey, out SourceTitles? titles))
        {
            titles = ScheduledShowsIn(latest, source);
            _scheduled[cacheKey] = titles;
        }

        return titles;
    }

    private IReadOnlyList<ChannelSchedule>? _scheduledFor;
    private readonly Dictionary<string, SourceTitles> _scheduled = new(StringComparer.Ordinal);

    private static SourceTitles ScheduledShowsIn(IReadOnlyList<ChannelSchedule> latest, string? source)
    {
        (string? channelId, string? block) = ParseSource(source);
        List<MediaItem> items = [.. latest
            .Where(schedule => channelId is null || string.Equals(schedule.ChannelId, channelId, StringComparison.OrdinalIgnoreCase))
            .SelectMany(schedule => schedule.Entries)
            .Where(entry => entry.Kind == ScheduleEntryKind.Program && entry.Item is not null && !entry.IsSlotIntro && !entry.IsSlotOutro)
            .Where(entry => block is null || string.Equals(entry.BlockName, block, StringComparison.OrdinalIgnoreCase))
            .Select(entry => entry.Item!)];

        IReadOnlyList<string> Titles(bool movies) => items
            .Where(item => ContentSelectorQuery.IsMovie(item) == movies)
            .Select(ContentSelectorQuery.TitleOf)
            .Where(title => title.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return new SourceTitles(Titles(movies: false), Titles(movies: true));
    }

    private Task AddPhrase(GeneratedVoicePack pack)
    {
        string text = _newText.Trim();
        if (_newKind == GeneratedVoicePhraseKind.Text && text.Length == 0) return Task.CompletedTask;
        GeneratedVoicePhrase phrase = new() { Kind = _newKind, Name = text.Length > 0 ? text : KindName(_newKind) };
        pack.Phrases.Add(phrase);
        _open.Add($"phrase:{phrase.Id}");
        _newText = string.Empty;
        return Notify();
    }

    /// <summary>
    /// A copy of the phrase just after it, opened out: the same kind, settings and values (show names, days, times,
    /// channels), with its recordings too, or with none so it can be recorded again (another voice, say). Templates keep
    /// using the original.
    /// </summary>
    private Task DuplicatePhrase(GeneratedVoicePack pack, GeneratedVoicePhrase phrase, bool keepTakes)
    {
        static List<GeneratedVoiceTake> Takes(IEnumerable<GeneratedVoiceTake> takes, bool keep) =>
            keep ? takes.Select(take => new GeneratedVoiceTake { Path = take.Path, Length = take.Length }).ToList() : new List<GeneratedVoiceTake>();

        GeneratedVoicePhrase copy = new()
        {
            Name = UniquePhraseName(pack, phrase.Name),
            Kind = phrase.Kind,
            Takes = Takes(phrase.Takes, keepTakes),
            Entries = [.. phrase.Entries.Select(entry => new GeneratedVoiceEntry { Key = entry.Key, Takes = Takes(entry.Takes, keepTakes) })],
            TwentyFourHour = phrase.TwentyFourHour,
            SayAmPm = phrase.SayAmPm,
            Combined = phrase.Combined,
            AmPmInTake = phrase.AmPmInTake,
            MinuteStep = phrase.MinuteStep,
            UseBlockNames = phrase.UseBlockNames
        };

        int at = pack.Phrases.IndexOf(phrase);
        pack.Phrases.Insert(at < 0 ? pack.Phrases.Count : at + 1, copy);
        _open.Add($"phrase:{copy.Id}");
        if (_dayTimeDay.TryGetValue(phrase.Id, out string? day)) _dayTimeDay[copy.Id] = day;
        return Notify();
    }

    /// <summary><paramref name="name"/> with " (copy)", numbered when that's taken too.</summary>
    private static string UniquePhraseName(GeneratedVoicePack pack, string name) =>
        GeneratedPromoEditing.UniqueName(pack.Phrases.Select(existing => existing.Name), $"{(string.IsNullOrWhiteSpace(name) ? "Phrase" : name.Trim())} (copy)");

    private Task RemovePhrase(GeneratedVoicePack pack, GeneratedVoicePhrase phrase) => Set(() =>
    {
        pack.Phrases.Remove(phrase);
        foreach (GeneratedVoicePackTemplate template in pack.Templates.Concat(GeneratedVoicePacks.InlineTemplates(Editor.Working, pack.Id)))
        {
            template.Parts.RemoveAll(part => part.Phrase == phrase.Id);
        }
    });

    // ---- Templates --------------------------------------------------------------------------------------------

    private RenderFragment TemplatesTab(GeneratedVoicePack pack) => __builder =>
    {
        <p class="hint">
            A template says its parts in order, one take of each, to make a promo's voice-over. A promo uses one of the templates it's allowed
            whose recordings cover its show (its name, day and time), choosing shorter takes when time is tight; if even the shortest runs long it
            can be sped up. Add a short fallback template so every promo has something to say.
        </p>
        @if (pack.Phrases.Count == 0)
        {
            <p class="hint warn">Add some phrases first.</p>
        }
        <div class="row row-wrap voice-gap-row">
            <label class="field" style="flex: 1 1 280px; margin: 0;">
                <span>Pause between parts: @GapLabel(pack.Gap)</span>
                <input type="range" min="-300" max="500" step="10" value="@Math.Round(pack.Gap.TotalMilliseconds)"
                       aria-label="Pause between parts in milliseconds; negative overlaps them"
                       @onchange="e => Set(() => pack.Gap = ParseGap(e.Value) ?? pack.Gap)" />
            </label>
            <label class="check" style="margin: 0;">
                <input type="checkbox" checked="@pack.TrimSilence" @onchange="e => Set(() => pack.TrimSilence = e.Value is true)" />
                <span>Trim silence from takes</span>
            </label>
        </div>
        <p class="hint">Below zero overlaps the parts slightly (crossfaded) for a sentence that runs on naturally. Each part below can have its own pause
            before it instead; leave it empty to use this one.</p>
        @foreach (GeneratedVoicePackTemplate template in pack.Templates)
        {
            IReadOnlyList<string> missing = Shows.Count == 0 ? Array.Empty<string>() : PrerecordedVoice.Missing(pack, template, Shows, Zone, AirsAt, Where);
            <div class="card voice-template" @key="template">
                <div class="card-head">
                    <input type="text" class="voice-template-name" value="@template.Name" aria-label="Template name"
                           @onchange="e => Set(() => template.Name = e.Value?.ToString() ?? string.Empty)" />
                    <label class="check" style="margin: 0;">
                        <input type="checkbox" checked="@template.Enabled" @onchange="e => Set(() => template.Enabled = e.Value is true)" />
                        <span>On</span>
                    </label>
                    <div class="spacer"></div>
                    <button class="btn btn-sm" type="button" disabled="@(_tryBusy || template.Parts.Count == 0)"
                            title="Say it for the preview's shows (a new random pick of takes each time)" @onclick="() => Try(pack, template)">
                        @(_tryBusy && _tryingId == template.Id ? "…" : "▶ Try")
                    </button>
                    <button class="btn btn-sm" type="button" title="Make a copy" @onclick="() => Duplicate(pack, template)">Duplicate</button>
                    <button class="btn btn-sm btn-danger" type="button" @onclick="() => Set(() => pack.Templates.Remove(template))">Delete</button>
                </div>
                <VoiceTemplateParts Pack="pack" Template="template" Changed="Notify" />
                @if (missing.Count > 0 && template.Parts.Count > 0)
                {
                    <p class="hint warn">Can't be said for the preview's shows: @(string.Join("; ", missing)).</p>
                }
                @if (_tryingId == template.Id)
                {
                    @if (_tryNote is not null)
                    {
                        <p class="hint" role="status">@_tryNote</p>
                    }
                    @if (_tryUrl is not null)
                    {
                        <audio src="@_tryUrl" autoplay controls class="voice-take-audio voice-try-audio"></audio>
                    }
                }
            </div>
        }
        <button class="btn btn-sm" type="button" @onclick="() => AddTemplate(pack)"><Icon Name="plus" Size="15" />New template</button>
    };

    private static string GapLabel(TimeSpan gap) =>
        gap < TimeSpan.Zero ? $"{-gap.TotalMilliseconds:0} ms overlap" : gap == TimeSpan.Zero ? "none" : $"{gap.TotalMilliseconds:0} ms";

    /// <summary>A pause typed or slid in milliseconds, kept within what a pack allows; null when it isn't a number.</summary>
    private static TimeSpan? ParseGap(object? value) =>
        double.TryParse(value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double ms)
            ? GeneratedVoicePack.ClampGap(TimeSpan.FromMilliseconds(ms))
            : null;

    private Task AddTemplate(GeneratedVoicePack pack) => Set(() => pack.Templates.Add(new GeneratedVoicePackTemplate
    {
        Name = GeneratedPromoEditing.UniqueName(pack.Templates.Select(template => template.Name), "Template")
    }));

    private Task Duplicate(GeneratedVoicePack pack, GeneratedVoicePackTemplate template) => Set(() =>
        pack.Templates.Insert(pack.Templates.IndexOf(template) + 1, new GeneratedVoicePackTemplate
        {
            Name = GeneratedPromoEditing.UniqueName(pack.Templates.Select(existing => existing.Name), template.Name),
            Enabled = template.Enabled,
            Parts = [.. template.Parts.Select(part => new GeneratedVoicePart { Phrase = part.Phrase, Show = part.Show, Gap = part.Gap })]
        }));

    private void ClearTry()
    {
        _tryingId = null;
        _tryUrl = null;
        _tryNote = null;
    }

    private async Task Try(GeneratedVoicePack pack, GeneratedVoicePackTemplate template)
    {
        ClearTry();
        _tryingId = template.Id;
        if (Shows.Count == 0)
        {
            _tryNote = "Open this from a template's voice-over to try it with that template's shows.";
            return;
        }

        GeneratedVoiceConfig voice = new()
        {
            Mode = GeneratedVoiceMode.Prerecorded,
            Prerecorded = new GeneratedPrerecordedVoiceConfig { Pack = pack.Id, Templates = [template.Id], Linked = pack }
        };
        if (PrerecordedVoice.Plan(voice, Shows, Zone, AirsAt, $"try|{++_tries}|{DateTime.UtcNow.Ticks}", Where) is not { } request)
        {
            _tryNote = $"It can't be said for these shows: {string.Join("; ", PrerecordedVoice.Missing(pack, template, Shows, Zone, AirsAt, Where))}.";
            return;
        }

        _tryBusy = true;
        try
        {
            (string clip, PrerecordedChoice choice, double tempo) = await Preview.SayAsync(request, Room);
            _tryUrl = $"{Preview.FileUrl(clip)}?v={DateTime.UtcNow.Ticks}";
            _tryNote = $"{choice.Candidate.Describe()} — {PrerecordedVoice.Seconds(choice.Length)} of {PrerecordedVoice.Seconds(Room)}"
                       + (tempo > 1.001 ? $"; a promo would speed it up {tempo:0.00}×." : choice.Length > Room ? "; too long, and speeding up is off." : ".");
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            _tryNote = $"Couldn't put it together: {ex.GetBaseException().Message}";
        }
        finally
        {
            _tryBusy = false;
        }
    }

    // ---- Settings ---------------------------------------------------------------------------------------------

    private RenderFragment SettingsTab(GeneratedVoicePack pack) => __builder =>
    {
        int uses = GeneratedVoicePacks.Uses(Editor.Working, pack.Id);
        <div class="grid grid-2">
            <label class="field">
                <span>Name</span>
                <input type="text" value="@pack.Name" @onchange="e => Set(() => pack.Name = e.Value?.ToString() ?? string.Empty)" />
            </label>
            <label class="field">
                <span>Pause between parts: @GapLabel(pack.Gap)</span>
                <input type="range" min="-300" max="500" step="10" value="@Math.Round(pack.Gap.TotalMilliseconds)"
                       aria-label="Pause between parts in milliseconds; negative overlaps them"
                       @onchange="e => Set(() => pack.Gap = ParseGap(e.Value) ?? pack.Gap)" />
            </label>
        </div>
        <p class="hint">Below zero, each part starts before the one before it finishes, crossfaded, so the sentence runs on like it was said in one go
            (an overlap never takes more than 40% of the shorter take). Around −40 to −80 ms usually sounds natural once silence is trimmed.
            A template part can have its own pause, in the Templates tab.</p>
        <label class="check">
            <input type="checkbox" checked="@pack.TrimSilence" @onchange="e => Set(() => pack.TrimSilence = e.Value is true)" />
            <span>Trim the silence at the start and end of every take before joining them (recommended, so the only pause is the one set here)</span>
        </label>
        <label class="check">
            <input type="checkbox" checked="@_trimSilence" @onchange="e => _trimSilence = e.Value is true" />
            <span>Also trim new microphone recordings when they're saved</span>
        </label>
        <p class="hint">Recording uses this computer's microphone through the browser, which only allows it on a secure page (https, or
            http://localhost on the computer running SchedularrTV). Takes can also be recorded elsewhere and added as files.</p>
        <div class="row">
            <span class="hint">@(uses == 0 ? "No template uses this pack." : uses == 1 ? "Used by 1 template." : $"Used by {uses} templates.")</span>
            <div class="spacer"></div>
            <button class="btn btn-sm btn-danger" type="button" disabled="@(uses > 0)"
                    title="@(uses > 0 ? "Still used by a template" : "Delete this voice pack")" @onclick="() => RemovePack(pack)">Delete voice pack</button>
        </div>
    };
}
