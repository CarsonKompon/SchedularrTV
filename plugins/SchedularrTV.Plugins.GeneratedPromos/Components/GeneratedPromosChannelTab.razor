@* The Generated promos plugin's channel tab. The editor's styles are served from the plugin's wwwroot. *@

@if (Context.Channel is { } channel)
{
    <link rel="stylesheet" href="plugins/generated-promos/generated-promos.css?v=@StyleVersion" />
    <div class="gp-scope">
        <GeneratedPromosTab Channel="channel" Changed="Context.NotifyChanged" />
    </div>
}

@code {
    [Parameter, EditorRequired] public PluginEditorContext Context { get; set; } = default!;

    // Static files go out without a version, so a browser can keep using an older stylesheet after an update (new
    // markup, old rules). Each build of the plugin gets a new module id, which makes it fetch the stylesheet again.
    private static readonly string StyleVersion =
        typeof(GeneratedPromosChannelTab).Assembly.ManifestModule.ModuleVersionId.ToString("N")[..12];
}
