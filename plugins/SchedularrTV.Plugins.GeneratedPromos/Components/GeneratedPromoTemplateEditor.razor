    private GeneratedBackgroundRule EditableBackgroundRule(string background)
    {
        if (GeneratedPromoBackgrounds.Rule(Template, background) is { } rule) return rule;
        rule = new GeneratedBackgroundRule { Background = background, MatchShows = false };
        (Template.BackgroundRules ??= []).Add(rule);
        return rule;
