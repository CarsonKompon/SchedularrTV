    /// <summary>
    /// Output size, frame rate and background: under the preview when the canvas is used, or on their own when an
    /// external program makes the video.
    /// </summary>
    private RenderFragment CanvasSettings => @<div class="ed-settings">
        <div class="grid grid-3">
            <label class="field">
                <span>Output size</span>
                <select value="@(CustomSize ? CustomValue : $"{Template.Width}x{Template.Height}")" @onchange="SetSize">
                    @foreach ((int width, int height, string label) in Sizes)
                    {
                        <option value="@($"{width}x{height}")">@label</option>
                    }
                    <option value="@CustomValue">Custom size…</option>
                </select>
            </label>
            <label class="field">
                <span>Frame rate</span>
                <select value="@Template.Fps" @onchange="e => Set(() => Template.Fps = int.Parse(Text(e), CultureInfo.InvariantCulture))">
                    @foreach (int fps in (int[])[24, 25, 30, 60])
                    {
                        <option value="@fps">@fps fps</option>
                    }
                </select>
            </label>
            <div class="field">
                <span>Background colour</span>
                <input type="color" class="ed-colour" aria-label="Background colour" value="@GeneratedPromoEditing.SplitColor(Template.BackgroundColor).Rgb"
                       @onchange="e => Set(() => Template.BackgroundColor = GeneratedPromoEditing.JoinColor(Text(e), 100))" />
            </div>
        </div>
        @if (CustomSize)
        {
            <div class="grid grid-3">
                <label class="field">
                    <span>Width (px)</span>
                    <input type="number" min="16" max="3840" step="2" value="@Template.Width" @onchange="e => SetCustomSize(e, width: true, max: 3840)" />
                </label>
                <label class="field">
                    <span>Height (px)</span>
                    <input type="number" min="16" max="2160" step="2" value="@Template.Height" @onchange="e => SetCustomSize(e, width: false, max: 2160)" />
                </label>
            </div>
        }
        <LowPowerNotice Inline="true" Advice="LowPowerTemplateWarnings" />
        <div class="field">
            <span>
                @(Template.BackgroundClip is null || GeneratedPromoResolver.UsesClip(Template.Generator) ? "Background images or videos" : "Fallback background images or videos (when the episode file can't be read)")
                (optional; videos loop; with several, one is picked at random for each promo)
            </span>
            <ol class="song-list background-list">
                @foreach ((string background, int position) in BackgroundList.Select((path, index) => (path, index)))
                {
                    bool previewing = string.Equals(_previewBackground, background, StringComparison.OrdinalIgnoreCase);
                    <li @key="position">
                        <div class="song-row">
                            <FilePathPicker Value="@background" ValueChanged="value => SetBackground(position, value)" KeepCopyIn="@GeneratedPromoPackages.AssetCategory"
                                            Extensions="BackgroundExtensions" Label="background image or video" Placeholder="D:\Media\Promos\Backgrounds\loop.mp4" />
                            @if (Template.Generator is null)
                            {
                                bool editing = string.Equals(_editBackground, background, StringComparison.OrdinalIgnoreCase);
                                int placed = GeneratedPromoEditing.PlacedCount(Template, background);
                                <button class="btn btn-sm @(editing ? "btn-primary" : "")" type="button" aria-pressed="@(editing ? "true" : "false")"
                                        title="@(editing ? "Back to editing the template's own layout" : "Place and animate layers for this background only")"
                                        @onclick="() => EditBackground(editing ? null : background)">
                                    @(editing ? "Done" : placed > 0 ? $"Edit ({placed})" : "Edit")
                                </button>
                            }
                            @if (BackgroundList.Count > 1 && Template.Generator is null && !string.Equals(_editBackground, background, StringComparison.OrdinalIgnoreCase))
                            {
                                <button class="btn btn-sm" type="button" aria-pressed="@(previewing ? "true" : "false")"
                                        title="@(previewing ? "Go back to the background this promo picks" : "Show this background in the canvas preview")"
                                        @onclick="() => PreviewBackground(previewing ? null : background)">
                                    @(previewing ? "Previewing" : "Preview")
                                </button>
                            }
                            <button class="btn btn-sm btn-danger" type="button" aria-label="@($"Remove {Path.GetFileName(background)}")"
                                    @onclick="() => SetBackground(position, null)">Remove</button>
                        </div>
                        @if (Missing(background))
                        {
                            <p class="hint warn">The scheduler can't find this file.</p>
                        }
                        @{
                            GeneratedBackgroundRule? rule = GeneratedPromoBackgrounds.Rule(Template, background);
                            bool matchShows = rule is not null && rule.MatchShows != false;
                        }
                        <details class="ed-background-rules">
                            <summary>Background selection · @(matchShows ? "show matching on" : "show matching off") · @(rule?.TimeRange is { } hours ? $"{BackgroundTime(hours.Start)}–{BackgroundTime(hours.End)}" : "any time")</summary>
                        <label class="check">
                            <input type="checkbox" checked="@matchShows" @onchange="e => ToggleBackgroundRule(background, e.Value is true)" />
                            <span>@(Template.Type == GeneratedPromoType.NowPlaying ? "Choose based on the Now Playing show" : "Choose based on upcoming shows")</span>
                        </label>
                        @if (matchShows && rule is not null)
                        {
                            <div class="grid grid-2">
                                <label class="field">
                                    <span>Matching shows (one per line; any can match)</span>
                                    <textarea rows="3" placeholder="SpongeBob SquarePants&#10;Rugrats"
                                              @onchange="e => Set(() => rule.Shows = Text(e).Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList())">@string.Join('\n', rule.Shows)</textarea>
                                </label>
                                <label class="field">
                                    <span>When no show matches</span>
                                    <select value="@(rule.OnlyWhenMatching ? "exclude" : "normal")"
                                            @onchange='e => Set(() => rule.OnlyWhenMatching = Text(e) == "exclude")'>
                                        <option value="normal">Still eligible at normal chance (prefer on match)</option>
                                        <option value="exclude">Never use this background (only when matching)</option>
                                    </select>
                                </label>
                                @if (Template.Type != GeneratedPromoType.NowPlaying)
                                {
                                <label class="field">
                                    <span>Look ahead by</span>
                                    <select value="@(rule.Within is null ? "shows" : "time")"
                                            @onchange='e => Set(() => rule.Within = Text(e) == "time" ? TimeSpan.FromMinutes(60) : null)'>
                                        <option value="shows">Number of upcoming shows</option>
                                        <option value="time">Time from the promo's start</option>
                                    </select>
                                </label>
                                @if (rule.Within is { } within)
                                {
                                    <label class="field">
                                        <span>Within the next (minutes)</span>
                                        <input type="number" min="1" max="1440" step="1" value="@Number(within.TotalMinutes)"
                                               @onchange="e => SetNumber(e, value => rule.Within = TimeSpan.FromMinutes(Math.Clamp(value, 1, 1440)))" />
                                    </label>
                                }
                                else
                                {
                                    <label class="field">
                                        <span>Next shows (1 = only the next show)</span>
                                        <input type="number" min="1" max="10" value="@rule.NextShows"
                                               @onchange="e => SetNumber(e, value => rule.NextShows = (int)Math.Clamp(value, 1, 10))" />
                                    </label>
                                }
                                }
                                <label class="field">
                                    <span>Relative chance when matching</span>
                                    <input type="number" min="1" max="1000" step="1" value="@Number(rule.MatchWeight)"
                                           @onchange="e => SetNumber(e, value => rule.MatchWeight = Math.Clamp(value, 1, 1000))" />
                                </label>
                            </div>
                            @if (Template.Type == GeneratedPromoType.NowPlaying)
                            {
                                <p class="hint">Matches the show this Now Playing promo identifies, including a show that has already started. Lookahead settings aren't used for this promo type.</p>
                            }
                            <p class="hint">Normal chance is 1. A weight of 5 gives five times the chance of an ordinary background. “Only when matching” restricts this background; other eligible backgrounds can still be picked. Names use the same loose matching as variable images. These rules don't add shows to the text or voice-over.</p>
                            @if (rule.Shows.Count == 0)
                            {
                                <p class="hint warn">Add at least one show for this rule to match.</p>
                            }
                        }
                        <label class="check">
                            <input type="checkbox" checked="@(rule?.TimeRange is not null)" @onchange="e => ToggleBackgroundTimeRange(background, e.Value is true)" />
                            <span>Only choose during a daily time range</span>
                        </label>
                        @if (rule?.TimeRange is { } range)
                        {
                            <div class="grid grid-2">
                                <label class="field">
                                    <span>From (channel-local time, inclusive)</span>
                                    <input type="time" step="60" value="@BackgroundTime(range.Start)" @onchange="e => SetBackgroundTime(e, value => range.Start = value)" />
                                </label>
                                <label class="field">
                                    <span>Until (exclusive)</span>
                                    <input type="time" step="60" value="@BackgroundTime(range.End)" @onchange="e => SetBackgroundTime(e, value => range.End = value)" />
                                </label>
                            </div>
                            <p class="hint">Uses the promo's scheduled start in @Zone.Id. An earlier end crosses midnight, such as 22:00–06:00. Outside this range the background cannot be chosen, even when its show matches. Show matching is optional.</p>
                            @if (range.Start == range.End)
                            {
                                <p class="hint warn">Start and end must differ. Turn off the time range to allow any time.</p>
                            }
                        }
                        </details>
                    </li>
                }
            </ol>
            <div class="row row-wrap">
                <FilePathPicker Multiple="true" ButtonText="@(BackgroundList.Count == 0 ? "Add a background…" : "Add more backgrounds…")" Extensions="BackgroundExtensions"
                                Label="backgrounds" KeepCopyIn="@GeneratedPromoPackages.AssetCategory" OnPicked="AddBackgrounds" />
                @if (BackgroundList.Count > 1 && Template.Generator is null)
                {
                    <span class="hint" style="margin:0;">@(_previewBackground is null ? "The canvas shows the one these shows would get." : "The canvas shows the one you're previewing.")</span>
                }
            </div>
            @if (Template.BackgroundRules is { Count: > 0 })
            {
                <p class="hint">If no background is eligible, the background colour is used. Preview/Edit buttons let you inspect a background regardless of its rule.</p>
            }
        </div>
        @if (BackgroundList.Any(background => !PromoRenderer.IsImage(background)))
        {
            GeneratedBackgroundSoundConfig sound = GeneratedPromoResolver.BackgroundSound(Template);
            <div class="grid grid-3">
                <label class="check template-enabled">
                    <input type="checkbox" checked="@sound.Enabled" @onchange="e => Set(() => EditBackgroundSound().Enabled = e.Value is true)" />
                    <span>Play the background video's sound</span>
                </label>
                @if (sound.Enabled)
                {
                    <label class="field">
                        <span>Background volume: @($"{sound.Volume:P0}")</span>
                        <input type="range" min="0" max="100" value="@Number(sound.Volume * 100)"
                               @onchange="e => SetNumber(e, value => EditBackgroundSound().Volume = Math.Clamp(value / 100, 0, 1))" />
                    </label>
                    <label class="check template-enabled">
                        <input type="checkbox" checked="@sound.DuckUnderVoice" @onchange="e => Set(() => EditBackgroundSound().DuckUnderVoice = e.Value is true)" />
                        <span>Lower it while the voice speaks</span>
                    </label>
                }
            </div>
            @if (sound.Enabled)
            {
                <p class="hint">Videos without a sound track play silently. @(BackgroundList.Any(PromoRenderer.IsImage) ? "Pictures have no sound, so promos that pick one are quiet here." : "")</p>
            }
        }
        <label class="check">
            <input type="checkbox" checked="@(Template.BackgroundClip is not null)"
                   @onchange="e => Set(() => Template.BackgroundClip = e.Value is true ? Template.BackgroundClip ?? new GeneratedClipConfig() : null)" />
            <span>Play a clip from the promoted episode behind the promo</span>
        </label>
        @if (Template.BackgroundClip is { } clip)
        {
            <div class="grid grid-3">
                <label class="field">
                    <span>Start into the episode (s; blank picks a spot in the middle)</span>
                    <input type="number" min="0" step="1" value="@(clip.StartAt is { } clipStart ? Number(clipStart.TotalSeconds) : "")"
                           placeholder="Middle of the episode" @onchange="e => SetOptionalSeconds(e, value => clip.StartAt = value)" />
                </label>
                <label class="check template-enabled">
                    <input type="checkbox" checked="@clip.IncludeAudio" @onchange="e => Set(() => clip.IncludeAudio = e.Value is true)" />
                    <span>Include the episode's sound</span>
                </label>
                @if (clip.IncludeAudio)
                {
                    <label class="field">
                        <span>Episode volume: @($"{clip.Volume:P0}")</span>
                        <input type="range" min="0" max="100" value="@Number(clip.Volume * 100)"
                               @onchange="e => SetNumber(e, value => clip.Volume = Math.Clamp(value / 100, 0, 1))" />
                    </label>
                }
            </div>
            @if (clip.IncludeAudio)
            {
                <label class="check">
                    <input type="checkbox" checked="@clip.DuckUnderVoice" @onchange="e => Set(() => clip.DuckUnderVoice = e.Value is true)" />
                    <span>Lower the episode's sound while the voice speaks</span>
                </label>
            }
            <p class="hint">
                Uses the episode this promo is for (the first show listed on Up Next).
                @(GeneratedPromoResolver.UsesClip(Template.Generator) ? "The program below is handed this clip, so it isn't played behind; only the start time applies." : "")
                @(_sample ? "The preview shows the fallback background until the channel's schedule is built." : "")
            </p>
        }
    </div>;
}
