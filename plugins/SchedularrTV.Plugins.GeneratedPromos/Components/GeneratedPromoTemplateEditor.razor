    private string QuadPoints(GeneratedLayer layer) => string.Join(' ',
        GeneratedPromoHierarchy.WorldQuad(Template, layer, Pose, Time).Select(point => $"{Number(point.X)},{Number(point.Y)}"));

    /// <summary>Starts dragging one of the layer's corners (0 top left, clockwise).</summary>
    private void StartPin(PointerEventArgs e, GeneratedLayer layer, int corner)
    {
        if (e.Button != 0 || IsLocked(layer))
        {
            return;
        }

        _layer = layer;
        _chosen.Add(layer);
        LayerPose pose = GeneratedPromoEditing.PoseAt(Pose(layer), Time);
        _drag = new DragState(layer, PinHandle, e.ClientX, e.ClientY, pose.X, pose.Y, pose.Width, pose.Height)
        {
            OwnRotation = pose.Rotation ?? 0,
            SpaceRotation = GeneratedPromoHierarchy.SpaceAngle(Template, layer, Pose, Time),
            Corner = corner,
            PinStart = pose.Corners ?? default
        };
        _ = MeasureCanvas();
        _ = FocusRuler();
    }

