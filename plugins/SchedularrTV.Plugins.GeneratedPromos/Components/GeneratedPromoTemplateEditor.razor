    {
        get
        {
            PreviewListings(out bool sample);
            return sample;
        }
    }

    private async Task PrepareStandIn()
    {
        if (!NeedsClip)
        {
            return;
        }

        PreviewListings(out bool sample);
        if (!sample)
        {
            return;
        }

        try
        {
            await Preview.PrepareStandInAsync(Channel, _life.Token);
        }
        catch (Exception)
        {
            // Without a stand-in the preview keeps its sample shows.
            return;
        }

        await InvokeAsync(StateHasChanged);
        _ = RefreshStill();
    }

    private Task Set(Action change)
    {
        change();
        return Commit();
    }

    private Task SetNumber(ChangeEventArgs e, Action<double> apply) =>
        double.TryParse(Text(e), NumberStyles.Float, CultureInfo.InvariantCulture, out double value) ? Set(() => apply(value)) : Task.CompletedTask;

    private Task SetSeconds(ChangeEventArgs e, Action<TimeSpan> apply, double min = 0) =>
        SetNumber(e, value => apply(TimeSpan.FromSeconds(Math.Round(Math.Max(min, value), 3))));

    /// <summary>
    /// A setting that's left out when blank or set to its <paramref name="neutral"/> value (so templates that don't use
    /// it keep their render keys), else kept within its range.
    /// </summary>
    private Task SetOptionalNumber(ChangeEventArgs e, Action<float?> apply, float neutral, float min, float max) =>
        string.IsNullOrWhiteSpace(Text(e)) ? Set(() => apply(null))
        : float.TryParse(Text(e), NumberStyles.Float, CultureInfo.InvariantCulture, out float value) && float.IsFinite(value)
            ? Set(() => apply(Math.Abs(Math.Clamp(value, min, max) - neutral) < 0.0001f ? null : Math.Clamp(value, min, max)))
            : Task.CompletedTask;

    private static string OptionalNumber(float? value) => value is { } set ? Number(set) : string.Empty;

    private static string OptionalSeconds(TimeSpan? value) => value is { } set ? Number(set.TotalSeconds) : string.Empty;

    private Task SetOptionalSeconds(ChangeEventArgs e, Action<TimeSpan?> apply) =>
        string.IsNullOrWhiteSpace(Text(e)) ? Set(() => apply(null)) : SetSeconds(e, value => apply(value));

    private Task RefreshStill()
    {
        RequestStill();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Asks for the preview to be redrawn. At most one still is drawn at a time and the newest request wins, so
    /// scrubbing or dragging shows frames as fast as they can be drawn rather than waiting for the pointer to stop.
    /// </summary>
    /// <param name="fast">Draws it smaller, for while the pointer is moving; a full-size one follows when it stops.</param>
    private void RequestStill(bool fast = false)
    {
        if (Template.Generator is not null)
        {
            return;
        }

        _stillWanted = true;
        _stillFast = fast;
        if (!_stillRunning)
        {
            _ = DrawStills();
        }
    }

    private async Task DrawStills()
    {
        _stillRunning = true;
        try
        {
            // Let a burst of changes (typing, a pointer event) settle into one drawing.
            await Task.Yield();
            while (_stillWanted && !_life.IsCancellationRequested && Template.Generator is null)
            {
                _stillWanted = false;
                bool fast = _stillFast;
                try
                {
                    IReadOnlyList<UpNextListing> listings = PreviewListings(out _sample);
                    // The canvas fills the editor's width, so the still is drawn about as wide as a large screen shows it.
                    // Zoomed in, the canvas is drawn wider than the window, so the frame is drawn up to full size to stay sharp.
                    int width = Math.Min(fast ? ScrubWidth : Math.Max(1600, (int)_canvasPixels), Template.Width);
                    byte[] jpeg = await Preview.RenderStillAsync(StillTemplate(), Channel.Name, listings, Zone, TimeSpan.FromSeconds(_time), width, _life.Token,
                        imageSubjects: Preview.ImageSubjects(Channel, Template));
                    _still = $"data:image/jpeg;base64,{Convert.ToBase64String(jpeg)}";
                    _stillError = null;
                    // Waits until the browser has the frame on screen, which also keeps frames from piling up.
                    await ShowStill();
                }
                catch (OperationCanceledException) when (_life.IsCancellationRequested)
                {
                    return;
                }
                catch (Exception ex)
                {
                    _stillError = ex.GetBaseException().Message;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _stillRunning = false;
        }
    }

    private readonly string _stillId = $"promo-still-{Guid.NewGuid():N}";

    // ---- Zooming and panning the canvas ----

    private readonly string _viewportId = $"promo-viewport-{Guid.NewGuid():N}";

    /// <summary>
    /// Zoom and pan live in the page: the canvas is scaled and moved inside its frame with a CSS transform. Everything
    /// that turns the pointer into template pixels measures the canvas as drawn, so drags stay exact at any zoom.
    /// Ctrl (⌘) + wheel zooms about the pointer (1× to 16×); the middle button drags it around; Ctrl + 0 fits it again.
    /// </summary>
    private const string ZoomScript = """
        window.schedularrPromoZoom ??= (viewportId, canvasId) => {
            const viewport = document.getElementById(viewportId);
            const canvas = document.getElementById(canvasId);
            if (!viewport || !canvas || viewport.promoZoom) return;
            const badge = viewport.querySelector('.ed-zoom-badge');
            let zoom = 1, x = 0, y = 0, pan = null;
            const clamp = () => {
                const width = viewport.clientWidth, height = viewport.clientHeight;
                x = Math.min(0, Math.max(width - width * zoom, x));
                y = Math.min(0, Math.max(height - height * zoom, y));
            };
            const apply = () => {
                clamp();
                canvas.style.transformOrigin = '0 0';
                canvas.style.transform = zoom === 1 ? '' : `translate(${x}px, ${y}px) scale(${zoom})`;
                canvas.style.setProperty('--zoom', zoom);
                viewport.classList.toggle('zoomed', zoom !== 1);
                if (badge) badge.textContent = zoom === 1 ? '' : `${Math.round(zoom * 100)}%`;
            };
            const zoomAt = (next, px, py) => {
                next = Math.min(16, Math.max(1, next));
                x = px - (px - x) * next / zoom;
                y = py - (py - y) * next / zoom;
                zoom = next;
                if (zoom === 1) { x = 0; y = 0; }
                apply();
            };
            viewport.addEventListener('wheel', e => {
                if (!e.ctrlKey && !e.metaKey) return;
                e.preventDefault();
                const r = viewport.getBoundingClientRect();
                zoomAt(zoom * Math.exp(-e.deltaY * (e.deltaMode === 1 ? 0.05 : 0.0015)), e.clientX - r.left, e.clientY - r.top);
            }, { passive: false });
            // Middle button: pan, and keep the browser's autoscroll (and the editor's box dragging) out of it.
            viewport.addEventListener('pointerdown', e => {
                if (e.button !== 1) return;
                e.preventDefault();
                e.stopPropagation();
                pan = { sx: e.clientX, sy: e.clientY, x, y };
                viewport.setPointerCapture(e.pointerId);
                viewport.classList.add('panning');
            }, true);
            viewport.addEventListener('mousedown', e => { if (e.button === 1) e.preventDefault(); }, true);
            viewport.addEventListener('auxclick', e => { if (e.button === 1) e.preventDefault(); }, true);
            viewport.addEventListener('pointermove', e => {
                if (!pan) return;
                x = pan.x + e.clientX - pan.sx;
                y = pan.y + e.clientY - pan.sy;
                apply();
            });
            const end = () => { pan = null; viewport.classList.remove('panning'); };
            viewport.addEventListener('pointerup', end);
            viewport.addEventListener('pointercancel', end);
            document.addEventListener('keydown', e => {
                if ((e.ctrlKey || e.metaKey) && e.key === '0' && viewport.isConnected && viewport.matches(':hover')) {
                    e.preventDefault();
                    zoomAt(1, 0, 0);
                }
            });
            window.addEventListener('resize', apply);
            viewport.promoZoom = { reset: () => zoomAt(1, 0, 0) };
        };
        window.schedularrPromoZoomReset ??= viewportId => document.getElementById(viewportId)?.promoZoom?.reset();
        """;

    private bool _zoomScriptReady;
    private bool _zoomWired;

    /// <summary>Wires zooming and panning up to the canvas (once per canvas; it's safe to call again).</summary>
    private async Task<bool> SetUpZoom()
    {
        try
        {
            if (!_zoomScriptReady)
            {
                await JS.InvokeVoidAsync("eval", ZoomScript);
                _zoomScriptReady = true;
            }

            await JS.InvokeVoidAsync("schedularrPromoZoom", _viewportId, _canvasId);
            return true;
        }
        catch (Exception)
        {
            // Disconnected or still prerendering: wired up after the next render.
            return false;
        }
    }

    private async Task ResetZoom()
    {
        try
        {
            await JS.InvokeVoidAsync("schedularrPromoZoomReset", _viewportId);
        }
        catch (Exception)
        {
            // Nothing to reset.
        }

        await MeasureCanvas();
    }
    // The frame the page is showing, so it's only sent again when it changes or the canvas comes back.
    private string? _shownStill;
    private bool _stillScriptReady;

    // Decodes the new frame off screen and only then swaps it in. Setting a new background image directly blanks the
    // canvas until it's decoded, which flickers badly while scrubbing or dragging. Returns false without the element.
    private const string StillScript = """
        window.schedularrPromoStill ??= async (id, url) => {
            const element = document.getElementById(id);
            if (!element) return false;
            const image = new Image();
            image.src = url;
            try { await image.decode(); } catch { }
            if (!element.isConnected) return false;
            element.style.backgroundImage = `url("${url}")`;
            return true;
        };
        """;

    /// <summary>Puts <see cref="_still"/> on the canvas, without a blank frame in between.</summary>
    private async Task ShowStill()
    {
        if (_still is not { } still || ReferenceEquals(still, _shownStill) || Template.Generator is not null)
        {
            return;
        }

        try
        {
            if (!_stillScriptReady)
            {
                await JS.InvokeVoidAsync("eval", StillScript);
                _stillScriptReady = true;
            }

            if (await JS.InvokeAsync<bool>("schedularrPromoStill", _stillId, still))
            {
                _shownStill = still;
            }
        }
        catch (Exception)
        {
            // Disconnected, still prerendering or without script: tried again after the next render.
        }
    }

    /// <summary>
    /// The template as the preview draws it: as the edited variant (or the default look) always, whatever its
    /// availability, chance or rules say, with only the background chosen to preview when one is.
    /// </summary>
    private GeneratedPromoTemplate StillTemplate()
    {
        if (_previewBackground is { } chosen && !BackgroundList.Contains(chosen, StringComparer.OrdinalIgnoreCase))
        {
            _previewBackground = null;
        }

        if (_previewBackground is null && !Template.HasVariants)
        {
            return Template;
        }

        GeneratedPromoTemplate copy = GeneratedPromoEditing.Copy(Template);
        GeneratedPromoVariant? editing = copy.Variant(_editVariant);
        if (editing is null)
        {
            // The default look: no variants to pick.
            copy.Variants = null;
            copy.DefaultWeight = null;
        }
        else
        {
            // Only this variant, always picked.
            editing.Enabled = true;
            editing.Weight = 1;
            editing.Availability = null;
            copy.Variants = [editing];
            copy.DefaultWeight = 0;
        }

        // The edited variant is shown even when none of its backgrounds could be picked right now; an explicitly
        // previewed background is shown whatever its rule says. Otherwise the canvas shows the one these shows would get.
        IGeneratedBackgrounds host = editing is { BackgroundChoices.Count: > 0 } ? editing : copy;
        if (editing is not null) editing.BackgroundRules = null;
        if (_previewBackground is { } background)
        {
            host.BackgroundRules = null;
            GeneratedPromoEditing.SetBackgrounds(host, [background]);
        }

        return copy;
    }

    private const int ScrubWidth = 800;

    private TimeSpan Time => TimeSpan.FromSeconds(_time);

    private double DurationSeconds => Math.Max(0.01, Template.Duration.TotalSeconds);

    private int Fps => Math.Max(1, Template.Fps);

    /// <summary>Frames in the promo, as the render draws them.</summary>
    private int FrameCount => Math.Max(1, (int)Math.Ceiling(Template.Duration.TotalSeconds * Fps));

    /// <summary>The frame shown at <paramref name="seconds"/>.</summary>
    private int FrameAt(double seconds) => Math.Clamp((int)Math.Round(Math.Clamp(seconds, 0, 86_400) * Fps), 0, FrameCount - 1);

    /// <summary>The start of the frame nearest <paramref name="seconds"/>, so the preview always shows a whole frame.</summary>
    private double SnapToFrame(double seconds) => Math.Round(FrameAt(seconds) / (double)Fps, 4);

    /// <summary>The latest time the preview can show: the promo's last frame.</summary>
    private double LastTime => Math.Round((FrameCount - 1) / (double)Fps, 4);

    private int CurrentFrame => FrameAt(_time);

    private void StepFrames(int frames) => SetTimeTo((CurrentFrame + frames) / (double)Fps);

    private void SetTimeTo(double seconds, bool fast = false)
    {
        double time = SnapToFrame(Math.Clamp(seconds, 0, Template.Duration.TotalSeconds));
        if (fast && Math.Abs(time - _time) < 0.0001)
        {
            // The pointer moved within the same moment; nothing new to draw.
            return;
        }

        _time = time;
        RequestStill(fast);
    }

    /// <summary>Second marks along the timeline, spaced so their labels don't crowd.</summary>
    private IEnumerable<double> Ticks()
    {
        double step = DurationSeconds <= 12 ? 1 : DurationSeconds <= 30 ? 2 : DurationSeconds <= 60 ? 5 : 10;
        for (double tick = 0; tick <= DurationSeconds + 0.0001; tick += step)
        {
            yield return tick;
        }
    }

    // ---- Timeline: scrubbing and keyframes ----

    private sealed record KeyDragState(GeneratedLayer Layer, GeneratedKeyframe Key, double StartX, TimeSpan StartAt)
    {
        public bool Moved { get; set; }

        /// <summary>What the move goes into, and the keyframe there, once it has moved.</summary>
        public IGeneratedPose? Target { get; set; }

        public GeneratedKeyframe? Editing { get; set; }

        public List<(GeneratedKeyframe Key, double At)> Starts { get; set; } = [];
    }

    private readonly string _rulerId = $"promo-ruler-{Guid.NewGuid():N}";
    private double _rulerLeft;
    private double _rulerWidth;
    private bool _scrubbing;
    private KeyDragState? _keyDrag;

    private readonly SchedularrTV.Core.Editing.KeyframeSelection<GeneratedKeyframe> _keys = new(key => key.At.TotalSeconds);
    private IReadOnlyList<GeneratedKeyframe> SelectedKeys
    {
        get
        {
            IGeneratedPose? pose = _layer is { } layer ? Pose(layer) : null;
            _keys.Bind(pose, pose?.Keyframes ?? []);
            return _keys.Selected;
        }
    }
    private GeneratedKeyframe? EditingKeyframe => SelectedKeys.LastOrDefault() ?? CurrentKeyframe;
    private string SelectedEasing => SelectedKeys.Select(key => key.Easing).Distinct().ToArray() is [var easing] ? easing.ToString() : "";

    /// <summary>The selected layer's keyframe under the playhead, which the keyframe bar edits.</summary>
    private GeneratedKeyframe? CurrentKeyframe => _layer is { } layer ? GeneratedPromoEditing.KeyframeAt(Pose(layer), Time) : null;

    /// <summary>Where the timeline is on screen, for turning the pointer into a time.</summary>
    private async Task MeasureRuler()
    {
        try
        {
            double[] box = await JS.InvokeAsync<double[]>("eval",
                $"(r => r ? [r.left, r.width] : [0, 0])(document.getElementById('{_rulerId}')?.getBoundingClientRect())");
            if (box is [var left, var width] && width > 0)
            {
                (_rulerLeft, _rulerWidth) = (left, width);
            }
        }
        catch (Exception)
        {
            // Disconnected or still prerendering: the last measurement stands in.
        }
    }

    private double TimeAtPointer(double clientX) =>
        _rulerWidth <= 0 ? _time : (clientX - _rulerLeft) / _rulerWidth * DurationSeconds;

    /// <summary>
    /// Gives the timeline the keyboard, so frame stepping works straight after scrubbing or dragging a box (pressing
    /// the pointer doesn't focus it, as that's cancelled to stop text being selected).
    /// </summary>
    private async Task FocusRuler()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementById('{_rulerId}')?.focus({{ preventScroll: true }})");
        }
        catch (Exception)
        {
            // Disconnected or still prerendering: the keys work once the timeline is clicked again.
        }
    }

    private async Task StartScrub(PointerEventArgs e)
    {
        if (e.Button != 0) return;
        _keys.Clear();
        _scrubbing = true;
        _ = FocusRuler();
        await MeasureRuler();
        if (_scrubbing)
        {
            SetTimeTo(TimeAtPointer(e.ClientX), fast: true);
        }
    }

    private async Task StartKeyDrag(PointerEventArgs e, GeneratedLayer layer, GeneratedKeyframe key)
    {
        if (e.Button != 0) return;
        _ = SelectedKeys;
        _ = FocusRuler();
        if (!_keys.Click(key, Pose(layer).Keyframes ?? [], e.CtrlKey || e.MetaKey, e.ShiftKey)) return;
        _keyDrag = new KeyDragState(layer, key, e.ClientX, key.At)
        {
            Starts = [.. SelectedKeys.Select(frame => (frame, frame.At.TotalSeconds))]
        };
        // Jump to the keyframe, so its pose is what the canvas shows and the keyframe bar edits.
        SetTimeTo(key.At.TotalSeconds);
        _ = FocusRuler();
        await MeasureRuler();
    }

    private void OverlayMove(PointerEventArgs e)
    {
        if (_drag is not null)
        {
            Drag(e);
        }
        else if (_keyDrag is { } keyDrag)
        {
            MoveKeyDrag(keyDrag, e);
        }
        else if (_scrubbing)
        {
            SetTimeTo(TimeAtPointer(e.ClientX), fast: true);
        }
    }

    private async Task OverlayEnd(PointerEventArgs e)
    {
        if (_drag is not null)
        {
            await EndDrag(e);
        }
        else if (_keyDrag is { } keyDrag)
        {
            MoveKeyDrag(keyDrag, e);
            _keyDrag = null;
            if (keyDrag.Moved)
            {
                await Commit();
            }
        }
        else if (_scrubbing)
        {
            _scrubbing = false;
            // A full-size still of where the scrub stopped.
            SetTimeTo(TimeAtPointer(e.ClientX));
        }
    }

    private void MoveKeyDrag(KeyDragState drag, PointerEventArgs e)
    {
        if (_rulerWidth <= 0)
        {
            return;
        }

        double seconds = (e.ClientX - drag.StartX) / _rulerWidth * DurationSeconds;
        drag.Moved |= Math.Abs(e.ClientX - drag.StartX) >= 2;
        if (!drag.Moved)
        {
            return;
        }

        // Found once the diamond really moves, so clicking one doesn't place the layer for the edited background.
        if (drag.Target is null)
        {
            IGeneratedPose shown = Pose(drag.Layer);
            drag.Target = Editable(drag.Layer);
            if (!ReferenceEquals(shown, drag.Target))
            {
                drag.Starts = [.. drag.Starts.Select(start => (Key: GeneratedPromoEditing.KeyframeAt(drag.Target, TimeSpan.FromSeconds(start.At)), start.At))
                    .Where(start => start.Key is not null).Select(start => (start.Key!, start.At))];
                drag.Editing = GeneratedPromoEditing.KeyframeAt(drag.Target, drag.StartAt);
            }
            else drag.Editing = drag.Key;
            _keys.Replace(drag.Target, drag.Starts.Select(start => start.Key), drag.Editing);
        }

        if (drag.Editing is not { } key)
        {
            return;
        }

        // Keyframes land on whole frames, like the playhead.
        double delta = SchedularrTV.Core.Editing.KeyframeMoves.Delta(drag.Starts.Select(start => start.At), seconds, LastTime, Fps);
        foreach (var start in drag.Starts)
            start.Key.At = TimeSpan.FromSeconds(Math.Round(start.At + delta, 4));
        GeneratedPromoEditing.SortKeyframes(drag.Target);
        // The playhead follows the keyframe, so it stays the one being edited.
        SetTimeTo(key.At.TotalSeconds, fast: true);
    }

    /// <summary>
    /// Timeline shortcuts: ←/→ or ,/. step one frame (Shift: a second), Home/End jump to either end, [/] to the
    /// selected layer's previous or next keyframe, K adds a keyframe and Delete removes the one under the playhead.
    /// </summary>
    private Task RulerKey(KeyboardEventArgs e)
    {
        int step = e.ShiftKey ? Fps : 1;
        switch (e.Key)
        {
            case "ArrowLeft" or "," or "<":
                StepFrames(-step);
                break;
            case "ArrowRight" or "." or ">":
                StepFrames(step);
                break;
            case "Home":
                SetTimeTo(0);
                break;
            case "End":
                SetTimeTo(LastTime);
                break;
            case "[" when _layer is { } layer:
                GoToKeyframe(layer, -1);
                break;
            case "]" when _layer is { } layer:
                GoToKeyframe(layer, 1);
                break;
            case "Escape":
                _keys.Clear();
                break;
            case "Delete" or "Backspace" when _layer is { } layer && SelectedKeys.Count > 0:
                return RemoveSelectedKeys(layer);
            case "Delete" or "Backspace" when _layer is { } layer && CurrentKeyframe is { } key:
                return RemoveKeyframe(layer, key);
            case "k" or "K" when _layer is { } layer:
                return AddKeyframe(layer);
            case "p" or "P":
                _pinTool = !_pinTool;
                break;
        }

        return Task.CompletedTask;
    }

    private Task StartKeyframes(GeneratedLayer layer) => Set(() => GeneratedPromoEditing.StartKeyframes(Editable(layer), Time));

    private Task StopKeyframes(GeneratedLayer layer) => Set(() => GeneratedPromoEditing.StopKeyframes(Editable(layer), Time));

    private Task AddKeyframe(GeneratedLayer layer) => Set(() =>
    {
        IGeneratedPose target = Editable(layer);
        if (!GeneratedPromoEditing.HasKeyframes(target))
        {
            GeneratedPromoEditing.StartKeyframes(target, Time);
        }
        else
        {
            GeneratedPromoEditing.AddKeyframe(target, Time);
        }
    });

    private Task RemoveKeyframe(GeneratedLayer layer, GeneratedKeyframe key) => Set(() =>
    {
        (IGeneratedPose target, GeneratedKeyframe? editable) = EditableKey(layer, key);
        if (editable is not null) GeneratedPromoEditing.RemoveKeyframe(target, editable);
    });

    private Task SetEasing(GeneratedLayer layer, GeneratedKeyframe key, GeneratedEasing easing) => Set(() =>
    {
        if (EditableKey(layer, key).Key is { } editable) editable.Easing = easing;
    });

    private (IGeneratedPose Target, List<GeneratedKeyframe> Keys) EditableSelectedKeys(GeneratedLayer layer)
    {
        var selected = SelectedKeys.ToArray();
        IGeneratedPose shown = Pose(layer);
        IGeneratedPose target = Editable(layer);
        List<GeneratedKeyframe> keys = ReferenceEquals(shown, target) ? [.. selected]
            : [.. selected.Select(key => GeneratedPromoEditing.KeyframeAt(target, key.At)).OfType<GeneratedKeyframe>()];
        _keys.Replace(target, keys);
        return (target, keys);
    }

    private Task RemoveSelectedKeys(GeneratedLayer layer) => Set(() =>
    {
        var (target, keys) = EditableSelectedKeys(layer);
        foreach (GeneratedKeyframe key in keys) GeneratedPromoEditing.RemoveKeyframe(target, key);
        _keys.Clear();
    });

    private Task SetSelectedEasing(GeneratedLayer layer, ChangeEventArgs e) => Set(() =>
    {
        if (!Enum.TryParse<GeneratedEasing>(e.Value?.ToString(), out var easing)) return;
        foreach (GeneratedKeyframe key in EditableSelectedKeys(layer).Keys) key.Easing = easing;
    });

    private Task SetKeyframeTime(ChangeEventArgs e, GeneratedLayer layer, GeneratedKeyframe key) => SetNumber(e, value =>
    {
        (IGeneratedPose target, GeneratedKeyframe? editable) = EditableKey(layer, key);
        if (editable is null) return;
        GeneratedPromoEditing.MoveKeyframe(target, editable, TimeSpan.FromSeconds(SnapToFrame(value)), TimeSpan.FromSeconds(LastTime));
        _time = SnapToFrame(editable.At.TotalSeconds);
    });

    /// <summary>The selected layer's keyframe before (-1) or after (1) the playhead.</summary>
    private GeneratedKeyframe? NextKeyframe(GeneratedLayer layer, int direction) =>
        direction < 0
            ? Pose(layer).Keyframes?.Where(key => key.At.TotalSeconds < _time - GeneratedPromoEditing.KeyframeTolerance).OrderBy(key => key.At).LastOrDefault()
            : Pose(layer).Keyframes?.Where(key => key.At.TotalSeconds > _time + GeneratedPromoEditing.KeyframeTolerance).OrderBy(key => key.At).FirstOrDefault();

    private void GoToKeyframe(GeneratedLayer layer, int direction)
    {
        if (NextKeyframe(layer, direction) is { } key)
        {
            SetTimeTo(key.At.TotalSeconds);
        }
    }

    private Task SetPoseValue(ChangeEventArgs e, GeneratedLayer layer, Func<LayerPose, float, LayerPose> change) =>
        SetNumber(e, value =>
        {
            IGeneratedPose target = Editable(layer);
            GeneratedPromoEditing.SetPose(target, Time, change(GeneratedPromoEditing.PoseAt(target, Time), (float)value));
        });

    // ---- Variants ----

    // The variant being edited (its id); null edits the template's own (default) look.
    private string? _editVariant;

    /// <summary>The variant being edited, or null for the default look.</summary>
    private GeneratedPromoVariant? EditingVariant => Template.Variant(_editVariant);

    /// <summary>
    /// Whether changes to the layer's place, timing and colour go into the edited variant's own edits: for the template's
    /// layers while editing a variant. A variant's own layers (and everything in the default look) change the layer itself.
    /// </summary>
    private bool OverridesFor(GeneratedLayer layer) => EditingVariant is not null && layer.Variant is null;

    /// <summary>Whether the layer is drawn in what's being edited (the default look, or the edited variant).</summary>
    private bool VisibleHere(GeneratedLayer layer) => GeneratedPromoVariants.Visible(Template, _editVariant, layer);

    /// <summary>A variant's name, or the default look's.</summary>
    private string VariantLabel(string? id) =>
        Template.Variant(id) is { } variant ? (string.IsNullOrWhiteSpace(variant.Name) ? "Untitled variant" : variant.Name) : GeneratedPromoVariants.DefaultName(Template);

    /// <summary>Where the layer is in what the canvas shows: the edited variant's placement of it, or the template's.</summary>
    private IGeneratedPose Pose(GeneratedLayer layer) => GeneratedPromoResolver.Pose(Template, _editVariant, layer);

    /// <summary>What a move, resize or keyframe change goes into: the edited variant's placement (made on first change), or the layer.</summary>
    private IGeneratedPose Editable(GeneratedLayer layer) =>
        _editVariant is { } background && OverridesFor(layer) ? GeneratedPromoEditing.Place(Template, background, layer) : layer;

    /// <summary>
    /// <paramref name="key"/> (one of what <see cref="Pose"/> shows) in what gets edited: the same keyframe, or its copy in
    /// the edited background's placement once one is made from the template's.
    /// </summary>
    private (IGeneratedPose Target, GeneratedKeyframe? Key) EditableKey(GeneratedLayer layer, GeneratedKeyframe key)
    {
        IGeneratedPose shown = Pose(layer);
        IGeneratedPose target = Editable(layer);
        return ReferenceEquals(shown, target) ? (target, key) : (target, GeneratedPromoEditing.KeyframeAt(target, key.At));
    }

    private bool PlacedHere(GeneratedLayer layer) => GeneratedPromoEditing.Customised(Template, _editVariant, layer);

    /// <summary>When the layer shows in what the canvas shows: the edited background's own timing, or the layer's.</summary>
    private IGeneratedTiming Timing(GeneratedLayer layer) => GeneratedPromoResolver.TimingFor(Template, _editVariant, layer);

    /// <summary>What a timing change goes into: the edited background's timing (made on first change), or the layer.</summary>
    private IGeneratedTiming EditableTiming(GeneratedLayer layer) =>
        _editVariant is { } background && OverridesFor(layer) ? GeneratedPromoEditing.Retime(Template, background, layer) : layer;

    /// <summary>"Placed", "Timed and coloured" and the like: what <paramref name="background"/> sets its own way for the layer.</summary>
    private string CustomisedParts(GeneratedLayer layer, string background)
    {
        List<string> parts = [];
        if (GeneratedPromoResolver.Placement(Template, background, layer) is not null) parts.Add("placed");
        if (GeneratedPromoResolver.Retiming(Template, background, layer) is not null) parts.Add("timed");
        if (GeneratedPromoResolver.Recolour(Template, background, layer) is not null) parts.Add("coloured");
        string text = parts.Count switch
        {
            0 => "set",
            1 => parts[0],
            _ => $"{string.Join(", ", parts.Take(parts.Count - 1))} and {parts[^1]}"
        };
        return char.ToUpperInvariant(text[0]) + text[1..];
    }

    private Task ResetTiming(GeneratedLayer layer) =>
        _editVariant is { } background ? Set(() => GeneratedPromoEditing.Untime(Template, background, layer)) : Task.CompletedTask;

    /// <summary>The layer's colour in what the canvas shows: the edited background's own, or the layer's.</summary>
    private string ColorOf(GeneratedLayer layer) => GeneratedPromoResolver.ColorFor(Template, _editVariant, layer);

    /// <summary>Sets the layer's colour: for the edited background only while placing layers for one, otherwise everywhere.</summary>
    private Task SetColor(GeneratedLayer layer, string color) => Set(() =>
    {
        if (_editVariant is { } background && OverridesFor(layer))
        {
            GeneratedPromoEditing.Recolour(Template, background, layer, color);
        }
        else
        {
            layer.Color = color;
        }
    });

    /// <summary>
    /// Switches to editing a variant (or, with null, the default look): the canvas and layer list show it, and changes to
    /// the template's layers' place, timing and colour go into it. New layers belong to it.
    /// </summary>
    private void EditVariant(string? id)
    {
        _keys.Clear();
        _editVariant = Template.Variant(id)?.Id;
        _previewBackground = null;
        // A selection the variant doesn't show would be edited out of sight.
        if (_layer is { } current && !VisibleHere(current))
        {
            _layer = Template.Layers.LastOrDefault(VisibleHere);
            _chosen.Clear();
            if (_layer is not null) _chosen.Add(_layer);
        }

        RequestStill();
    }

    /// <summary>
    /// Under the canvas, above the backgrounds: the default look and each variant, to switch what's being edited, and to add one. While a
    /// variant is edited, a line says what changes go where.
    /// </summary>
    private RenderFragment VariantBar() => __builder =>
    {
        <div class="vt-variant-bar" role="tablist" aria-label="Variants">
            <span class="ed-toolbar-label">Variant</span>
            <button type="button" role="tab" class="vt-variant-tab @(_editVariant is null ? "active" : "")" aria-selected="@(_editVariant is null ? "true" : "false")"
                    title="The template's own look: its layers, backgrounds and placements" @onclick="() => EditVariant(null)">
                @GeneratedPromoVariants.DefaultName(Template)
                @if (Template.HasVariants && (Template.DefaultWeight ?? 1) <= 0)
                {
                    <span class="vt-variant-note">fallback</span>
                }
            </button>
            @foreach (GeneratedPromoVariant variant in Template.Variants ?? [])
            {
                bool active = _editVariant == variant.Id;
                <button type="button" role="tab" class="vt-variant-tab @(active ? "active" : "") @(variant.Enabled ? "" : "off")" @key="variant.Id"
                        aria-selected="@(active ? "true" : "false")" @onclick="() => EditVariant(variant.Id)">
                    @(string.IsNullOrWhiteSpace(variant.Name) ? "Untitled variant" : variant.Name)
                    @if (!variant.Enabled)
                    {
                        <span class="vt-variant-note">off</span>
                    }
                    else if (variant.Availability is not null)
                    {
                        <span class="vt-variant-note" title="Has its own availability">⏱</span>
                    }
                </button>
            }
            <button type="button" class="btn btn-sm" title="A new variant of this promo, starting from the default look" @onclick="() => AddVariant(false)">+ Variant</button>
            @if (EditingVariant is not null)
            {
                <button type="button" class="btn btn-sm" title="A new variant starting as a copy of this one (its backgrounds, placements and own layers)"
                        @onclick="() => AddVariant(true)">Duplicate</button>
            }
        </div>
        @if (EditingVariant is { } editing)
        {
            <p class="hint vt-variant-hint" role="status">
                Editing <strong>@VariantLabel(editing.Id)</strong>: moving, resizing, keyframes, colour and timing of the default's layers change this
                variant only (⌖ marks them; @GeneratedPromoEditing.PlacedCount(Template, editing.Id) so far), 👁 hides one here, and new layers belong to this
                variant (<span class="vt-own-badge">only here</span>). Text, files and other settings of the default's layers still apply to every variant.
            </p>
        }
    };

    /// <summary>
    /// The settings of what's being edited, as a variant among the others: its name, whether it's used, its relative
    /// chance and its own availability (on top of the template's). For the default look, its name and chance.
    /// </summary>
    private RenderFragment VariantSettings() => __builder =>
    {
        if (EditingVariant is { } variant)
        {
            <div class="card vt-variant-settings">
                <div class="grid grid-3">
                    <label class="field">
                        <span>Variant name</span>
                        <input type="text" value="@variant.Name" @onchange="e => Set(() => variant.Name = Text(e).Trim())" />
                    </label>
                    <label class="field">
                        <span>Relative chance (1 is normal)</span>
                        <input type="number" min="0.1" max="1000" step="0.1" value="@Number(variant.Weight)"
                               @onchange="e => SetNumber(e, value => variant.Weight = Math.Clamp(value, 0.1, 1000))" />
                    </label>
                    <label class="check template-enabled">
                        <input type="checkbox" checked="@variant.Enabled" @onchange="e => Set(() => variant.Enabled = e.Value is true)" />
                        <span>Use this variant</span>
                    </label>
                </div>
                <h4>Variant availability <span class="ed-meta">on top of the promo's own</span></h4>
                <label class="check">
                    <input type="checkbox" checked="@(variant.Availability?.TimeRange is not null)"
                           @onchange="e => SetVariantAvailability(variant, a => a.TimeRange = e.Value is true ? a.TimeRange ?? new GeneratedBackgroundTimeRange() : null)" />
                    <span>Only during a daily time range</span>
                </label>
                @if (variant.Availability?.TimeRange is { } hours)
                {
                    <div class="grid grid-2">
                        <label class="field">
                            <span>From (channel-local time, inclusive)</span>
                            <input type="time" step="60" value="@BackgroundTime(hours.Start)" @onchange="e => SetBackgroundTime(e, value => hours.Start = value)" />
                        </label>
                        <label class="field">
                            <span>Until (exclusive)</span>
                            <input type="time" step="60" value="@BackgroundTime(hours.End)" @onchange="e => SetBackgroundTime(e, value => hours.End = value)" />
                        </label>
                    </div>
                }
                <label class="check">
                    <input type="checkbox" checked="@(variant.Availability?.DateRange is not null)"
                           @onchange="e => SetVariantAvailability(variant, a => a.DateRange = e.Value is true ? a.DateRange ?? new GeneratedAnnualDateRange() : null)" />
                    <span>Only during dates each year</span>
                </label>
                @if (variant.Availability?.DateRange is { } dates)
                {
                    <div class="grid grid-2">
                        @foreach (bool start in new[] { true, false })
                        {
                            string date = start ? dates.Start : dates.End;
                            <div class="field">
                                <span>@(start ? "From (inclusive)" : "Through (inclusive)")</span>
                                <div class="row">
                                    <select aria-label="@(start ? "Start month" : "End month")" value="@AvailabilityDatePart(date, month: true)"
                                            @onchange="e => SetAvailabilityDate(dates, start, month: true, e)">
                                        @for (int month = 1; month <= 12; month++)
                                        {
                                            <option value="@month">@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month)</option>
                                        }
                                    </select>
                                    <input type="number" aria-label="@(start ? "Start day" : "End day")" min="1" max="31" value="@AvailabilityDatePart(date, month: false)"
                                           @onchange="e => SetAvailabilityDate(dates, start, month: false, e)" />
                                </div>
                            </div>
                        }
                    </div>
                }
                <label class="field">
                    <span>Only for programmes matching (library query, optional)</span>
                    <input type="text" value="@variant.Availability?.Query" spellcheck="false" placeholder="genre:'Action'"
                           @onchange="e => SetVariantAvailability(variant, a => a.Query = string.IsNullOrWhiteSpace(Text(e)) ? null : Text(e).Trim())" />
                </label>
                @if (variant.Availability is not null && !GeneratedPromoEligibility.IsAvailable(variant.Availability, Preview.Now, Zone))
                {
                    <p class="hint">This variant couldn't be picked right now; the canvas still shows it while you edit it.</p>
                }
                <div class="row row-wrap">
                    <span class="hint" style="margin:0;">
                        @(Template.Layers.Count(layer => layer.Variant == variant.Id)) of its own layers ·
                        @(variant.Hidden?.Count ?? 0) of the default's hidden · @GeneratedPromoEditing.PlacedCount(Template, variant.Id) set its own way
                    </span>
                    <div class="spacer"></div>
                    <button class="btn btn-sm btn-danger" type="button" title="Delete this variant and its own layers" @onclick="() => RemoveVariant(variant)">Delete variant</button>
                </div>
            </div>
        }
        else if (Template.HasVariants)
        {
            <div class="card vt-variant-settings">
                <div class="grid grid-2">
                    <label class="field">
                        <span>Name of the default look</span>
                        <input type="text" value="@GeneratedPromoVariants.DefaultName(Template)" placeholder="Default"
                               @onchange='e => Set(() => Template.DefaultName = string.IsNullOrWhiteSpace(Text(e)) || Text(e).Trim() == "Default" ? null : Text(e).Trim())' />
                    </label>
                    <label class="field">
                        <span>Relative chance against the variants (0: only when no variant can air)</span>
                        <input type="number" min="0" max="1000" step="0.1" value="@Number(Template.DefaultWeight ?? 1)"
                               @onchange="e => SetNumber(e, value => Template.DefaultWeight = Math.Abs(value - 1) < 0.0001 ? null : Math.Clamp(value, 0, 1000))" />
                    </label>
                </div>
                <p class="hint">
                    Each promo shows one look: this default or one of the variants that can air then, picked by their relative chances (fixed by
                    what the promo is, so a re-render looks the same). Backgrounds with show rules make their variant likelier when they match.
                </p>
            </div>
        }
    };

    private Task AddVariant(bool copyCurrent) => Set(() =>
    {
        GeneratedPromoVariant? from = copyCurrent ? EditingVariant : null;
        List<GeneratedPromoVariant> variants = Template.Variants ??= [];
        string name = GeneratedPromoEditing.UniqueName(variants.Select(variant => variant.Name).Append(GeneratedPromoVariants.DefaultName(Template)),
            from is null ? $"Variant {variants.Count + 1}" : $"{from.Name} copy");
        GeneratedPromoVariant made = from is null ? new GeneratedPromoVariant { Name = name } : GeneratedPromoEditing.Copy(from);
        made.Id = NewVariantId();
        made.Name = name;
        variants.Add(made);

        // A copy brings the original's own layers too, as its own.
        if (from is not null)
        {
            // Each of its own layers not inside another of its own (a group copies what's inside it).
            foreach (GeneratedLayer own in Template.Layers.Where(layer => layer.Variant == from.Id
                         && GeneratedPromoHierarchy.ParentOf(Template, layer)?.Variant != from.Id).ToList())
            {
                GeneratedLayer copy = GeneratedPromoHierarchy.Duplicate(Template, own);
                foreach (GeneratedLayer inside in GeneratedPromoHierarchy.Subtree(Template, copy))
                {
                    inside.Variant = made.Id;
                }

                GeneratedPromoEditing.Offset(copy, -20, -20);
            }
        }

        EditVariant(made.Id);
    });

    private string NewVariantId()
    {
        while (true)
        {
            string id = Guid.NewGuid().ToString("N")[..8];
            if (Template.Variant(id) is null) return id;
        }
    }

    /// <summary>Deletes a variant, its own layers with it; the default look is edited afterwards.</summary>
    private Task RemoveVariant(GeneratedPromoVariant variant) => Set(() =>
    {
        foreach (GeneratedLayer own in Template.Layers.Where(layer => layer.Variant == variant.Id).ToList())
        {
            if (Template.Layers.Contains(own)) GeneratedPromoHierarchy.Remove(Template, own);
        }

        Template.Variants?.Remove(variant);
        if (Template.Variants is { Count: 0 })
        {
            Template.Variants = null;
            Template.DefaultWeight = null;
        }

        EditVariant(null);
    });

    /// <summary>Hides (or shows again) one of the template's layers in the edited variant.</summary>
    private Task SetHidden(GeneratedLayer layer, bool hidden) => Set(() =>
    {
        if (EditingVariant is not { } variant || layer.Variant is not null)
        {
            return;
        }

        layer.Id ??= GeneratedPromoHierarchy.NewId(Template);
        List<string> list = variant.Hidden ??= [];
        list.RemoveAll(id => string.Equals(id, layer.Id, StringComparison.Ordinal));
        if (hidden) list.Add(layer.Id);
        if (list.Count == 0) variant.Hidden = null;
    });

    private Task SetVariantAvailability(GeneratedPromoVariant variant, Action<GeneratedPromoAvailability> change) => Set(() =>
    {
        GeneratedPromoAvailability availability = variant.Availability ?? new GeneratedPromoAvailability();
        change(availability);
        variant.Availability = availability is { TimeRange: null, DateRange: null } && string.IsNullOrWhiteSpace(availability.Query) ? null : availability;
    });

    private Task ResetPlacement(GeneratedLayer layer) =>
        _editVariant is { } background ? Set(() => GeneratedPromoEditing.Unplace(Template, background, layer)) : Task.CompletedTask;

    // ---- Variable image uses ----

    /// <summary>The shows a use of a variable image can be resolved for, as selectors.</summary>
    private static readonly string[] ImageShowSelectors =
    [
        "promoted", "watching",
        .. Enumerable.Range(0, GeneratedImageSelectors.MaxAhead).Select(offset => GeneratedImageSelectors.Format(GeneratedImageContext.UpNext, offset))
    ];

    private static string ImageShowName(string selector) =>
        GeneratedImageSelectors.TryParse(selector, out GeneratedImageContext context, out int offset)
            ? context switch
            {
                GeneratedImageContext.CurrentlyWatching => "What's on now / before the break",
                GeneratedImageContext.UpNext => offset == 0 ? "The next show" : $"{offset + 1} shows ahead",
                _ => "The show this promo is for"
            }
            : selector;

    private static string? ShowSelector(string value) => string.IsNullOrWhiteSpace(value) ? null : value;

    // ---- Video layers ----

    private const string VideoFile = "file";
    private const string CuratedChoice = "curated";
    private const string CuratedTokens = "{show}, {episode}, {time}, {when} and {day}";

    /// <summary>
    /// What a video layer plays: a file, one clip of an episode, or clips curated by AI (from the episode it already
    /// names, else the one the promo is for). Leaving curation drops its settings.
    /// </summary>
    private Task SetPlays(GeneratedVideoOptions video, string choice) => Set(() =>
    {
        if (choice == CuratedChoice)
        {
            video.Episode ??= "promoted";
            video.Curated ??= new GeneratedCuratedClips();
            return;
        }

        video.Curated = null;
        video.Episode = choice == VideoFile ? null : choice;
    });

    /// <summary>Another layer that's curated by AI before this one, which is the one that's used; null when there's none.</summary>
    private string? OtherCuratedLayer(GeneratedLayer layer) =>
        CuratedPromo.LayerIndex(Template) is { } index && !ReferenceEquals(Template.Layers[index], layer)
            ? string.IsNullOrWhiteSpace(Template.Layers[index].Name) ? $"layer {index + 1}" : Template.Layers[index].Name
            : null;

    // Each try gets its own seed, so a plan can be heard several ways; what airs is written per airing.
    private Task<AiTextResult> TryCuration(CancellationToken token) =>
        Preview.TryCurationAsync(Template, Channel, Zone, (++_tries).ToString(CultureInfo.InvariantCulture), token);

    private static GeneratedVideoOptions VideoOptions(GeneratedLayer layer) => layer.Video ??= new GeneratedVideoOptions();

    private static string VideoSourceName(string selector) =>
        GeneratedImageSelectors.TryParse(selector, out GeneratedImageContext context, out int offset)
            ? context switch
            {
                GeneratedImageContext.CurrentlyWatching => "A clip of what's on now (or before the break)",
                GeneratedImageContext.UpNext => offset == 0 ? "A clip of the next episode" : $"A clip of the episode {offset + 1} shows ahead",
                _ => "A clip of the episode this promo is for"
            }
            : selector;

    /// <summary>Picks the variable image a layer shows. Its show choice stays when swapping variables, and goes with a static file.</summary>
    private Task SetVariableImage(GeneratedLayer layer, string? name) => Set(() =>
    {
        layer.VariableImage = name;
        if (name is null)
        {
            layer.VariableImageShow = null;
        }
    });

    /// <summary>Sets both alignments; top (the old, only, way) is stored as nothing, so older templates keep their render keys.</summary>
    private Task SetAlign(GeneratedLayer layer, GeneratedVerticalAlign vertical, GeneratedTextAlign horizontal) => Set(() =>
    {
        layer.Align = horizontal;
        layer.VerticalAlign = vertical == GeneratedVerticalAlign.Top ? null : vertical;
    });

    private static string EasingName(GeneratedEasing easing) => easing switch
    {
        GeneratedEasing.EaseIn => "Ease in",
        GeneratedEasing.EaseOut => "Ease out",
        GeneratedEasing.EaseInOut => "Ease in and out",
        GeneratedEasing.Hold => "Hold, then jump",
        _ => "Linear"
    };

    /// <summary>Screen pixels per template pixel: the canvas fills the editor's width, so this follows the window.</summary>
    private double Scale => (_canvasPixels > 0 ? _canvasPixels : 640) / Math.Max(1, Template.Width);

    /// <summary>Reads how wide the canvas is drawn, for turning pointer movement into template pixels.</summary>
    private async Task MeasureCanvas()
    {
        try
        {
            double width = await JS.InvokeAsync<double>("eval", $"document.getElementById('{_canvasId}')?.getBoundingClientRect().width || 0");
            if (width > 0)
            {
                _canvasPixels = width;
            }
        }
        catch (Exception)
        {
            // Disconnected or still prerendering: the last width (or a guess) stands in.
        }
    }

    private Task SetSize(ChangeEventArgs e)
    {
        if (Text(e) == CustomValue)
        {
            _customSize = true;
            return Task.CompletedTask;
        }

        string[] parts = Text(e).Split('x');
        if (parts.Length != 2 || !int.TryParse(parts[0], out int width) || !int.TryParse(parts[1], out int height))
        {
            return Task.CompletedTask;
        }

        _customSize = false;
        return Set(() => GeneratedPromoEditing.Resize(Template, width, height));
    }

    private const string CustomValue = "custom";

    private bool CustomSize => _customSize || !Sizes.Any(size => size.Width == Template.Width && size.Height == Template.Height);

    // H.264 needs even dimensions.
    private Task SetCustomSize(ChangeEventArgs e, bool width, int max) =>
        double.TryParse(Text(e), NumberStyles.Float, CultureInfo.InvariantCulture, out double value)
            ? Set(() =>
            {
                int size = (int)Math.Clamp(Math.Round(value / 2) * 2, 16, max);
                GeneratedPromoEditing.Resize(Template, width ? size : Template.Width, width ? Template.Height : size);
            })
            : Task.CompletedTask;

    /// <summary>Whether the layer is locked, by itself or by a group it's in.</summary>
    private bool IsLocked(GeneratedLayer layer) =>
        layer.Locked || GeneratedPromoHierarchy.Ancestors(Template, layer).Any(group => group.Locked);

    /// <summary>
    /// Locks or unlocks a layer. Locking drops it from a several-layer selection, so dragging the others leaves it be;
    /// it stays the one the settings show, as it's still editable there.
    /// </summary>
    private Task ToggleLock(GeneratedLayer layer) => Set(() =>
    {
        layer.Locked = !layer.Locked;
        if (layer.Locked && _chosen.Count > 1)
        {
            _chosen.RemoveWhere(chosen => !ReferenceEquals(chosen, _layer) && IsLocked(chosen));
        }
    });

    /// <summary>
    /// The layer list's rows for what's being edited: the template's layers (those the variant hides too, to show them
    /// again) and the edited variant's own; other variants' layers aren't listed.
    /// </summary>
    private List<(GeneratedLayer Layer, int Depth)> ListedRows() =>
        [.. GeneratedPromoHierarchy.Rows(Template, IsOpen).Where(row => row.Layer.Variant is null || row.Layer.Variant == _editVariant)];

    /// <summary>Selects just this layer.</summary>
    private void Select(GeneratedLayer layer)
    {
        if (!ReferenceEquals(_layer, layer)) _keys.Clear();
        _layer = layer;
        _chosen.Clear();
        _chosen.Add(layer);
    }

    /// <summary>A click on a row: alone it selects the layer; Ctrl (⌘) adds or drops it; Shift selects the rows from the last one to it.</summary>
    private void ClickRow(MouseEventArgs e, GeneratedLayer layer)
    {
        if (!ReferenceEquals(_layer, layer)) _keys.Clear();
        if (e.CtrlKey || e.MetaKey)
        {
            Toggle(layer);
            return;
        }

        if (e.ShiftKey && _layer is { } anchor)
        {
            List<GeneratedLayer> rows = [.. ListedRows().Select(row => row.Layer)];
            int from = rows.IndexOf(anchor);
            int to = rows.IndexOf(layer);
            if (from >= 0 && to >= 0)
            {
                _chosen.Clear();
                foreach (GeneratedLayer row in rows.Skip(Math.Min(from, to)).Take(Math.Abs(to - from) + 1))
                {
                    _chosen.Add(row);
                }

                _layer = layer;
                return;
            }
        }

        Select(layer);
    }

    private void Toggle(GeneratedLayer layer)
    {
        if (!ReferenceEquals(_layer, layer)) _keys.Clear();
        if (_chosen.Add(layer))
        {
            _layer = layer;
        }
        else
        {
            _chosen.Remove(layer);
            if (ReferenceEquals(_layer, layer))
            {
                _layer = _chosen.FirstOrDefault();
            }
        }
    }

    private bool IsOpen(GeneratedLayer layer) => !_folded.Contains(layer);

    private void ToggleOpen(GeneratedLayer layer)
    {
        if (!_folded.Remove(layer))
        {
            _folded.Add(layer);
        }
    }

    /// <summary>Drops selections of layers that are gone (deleted, or the template reloaded).</summary>
    private void PruneSelection()
    {
        _chosen.RemoveWhere(layer => !Template.Layers.Contains(layer));
        _folded.RemoveWhere(layer => !Template.Layers.Contains(layer));
        if (_layer is not null && !Template.Layers.Contains(_layer))
        {
            _layer = _chosen.FirstOrDefault();
        }

        if (_layer is not null)
        {
            _chosen.Add(_layer);
        }
    }

    private Task AddLayer(GeneratedLayerKind kind)
    {
        GeneratedLayer layer = GeneratedPromoEditing.NewLayer(Template, kind);
        // Made while editing a variant, it's that variant's own.
        layer.Variant = EditingVariant?.Id;
        Template.Layers.Add(layer);
        Select(layer);
        return Commit();
    }

    private IEnumerable<GeneratedLayer> MaskTargets(GeneratedLayer mask) => Template.Layers
        .Take(Template.Layers.IndexOf(mask)).Where(layer => layer.Mask is null).Reverse();

    private Task SetLayerMask(GeneratedLayer layer, string mode) => Set(() =>
    {
        if (string.IsNullOrEmpty(mode))
        {
            layer.Mask = null;
            return;
        }
        layer.Mask ??= new GeneratedLayerMask();
        layer.Mask.Mode = Enum.Parse<GeneratedMaskMode>(mode);
        if (layer.Mask.Target is null && MaskTargets(layer).FirstOrDefault() is { } target)
        {
            target.Id ??= GeneratedPromoHierarchy.NewId(Template);
            layer.Mask.Target = target.Id;
        }
    });

    private Task SetMaskTarget(GeneratedLayer layer, string value) => Set(() =>
    {
        if (layer.Mask is null) return;
        GeneratedLayer? target = int.TryParse(value, out int index) && index >= 0 && index < Template.Layers.Count
            && MaskTargets(layer).Contains(Template.Layers[index]) ? Template.Layers[index] : null;
        if (target is not null) target.Id ??= GeneratedPromoHierarchy.NewId(Template);
        layer.Mask.Target = target?.Id;
    });

    // A copy of the layer, or of a group with everything inside it, with ids of its own (so the original's
    // per-background placements stay with the original).
    private Task DuplicateLayer(GeneratedLayer layer) => Set(() => Select(GeneratedPromoHierarchy.Duplicate(Template, layer)));

    private Task RemoveLayer(GeneratedLayer layer) => Set(() =>
    {
        int index = Template.Layers.IndexOf(layer);
        GeneratedPromoHierarchy.Remove(Template, layer);
        _chosen.Clear();
        _layer = null;
        // The layer below it that's in what's being edited (not another variant's), else the top one that is.
        GeneratedLayer? next = Template.Layers.Take(Math.Max(0, index)).LastOrDefault(VisibleHere) ?? Template.Layers.LastOrDefault(VisibleHere);
        if (next is not null)
        {
            Select(next);
        }
    });

    private Task RemoveChosen() => Set(() =>
    {
        foreach (GeneratedLayer layer in GeneratedPromoHierarchy.Outermost(Template, _chosen))
        {
            GeneratedPromoHierarchy.Remove(Template, layer);
        }

        _chosen.Clear();
        _layer = null;
        if (Template.Layers.LastOrDefault(VisibleHere) is { } top)
        {
            Select(top);
        }
    });

    private Task StepLayer(GeneratedLayer layer, int direction) => Set(() => GeneratedPromoHierarchy.Step(Template, layer, direction, Time));

    // Grouping keeps everything where it is on screen, as it is at the preview time.
    private Task GroupChosen() => _chosen.Count == 0 ? Task.CompletedTask : Set(() =>
    {
        bool ownLayers = EditingVariant is { } variant && _chosen.All(layer => layer.Variant == variant.Id);
        GeneratedLayer group = GeneratedPromoHierarchy.Group(Template, _chosen, Time);
        // A group of a variant's own layers is the variant's too.
        if (ownLayers) group.Variant = _editVariant;
        Select(group);
    });

    private Task Ungroup(GeneratedLayer group) => Set(() =>
    {
        List<GeneratedLayer> members = GeneratedPromoHierarchy.Ungroup(Template, group, Time);
        _chosen.Clear();
        _layer = null;
        foreach (GeneratedLayer member in members)
        {
            _chosen.Add(member);
            _layer ??= member;
        }
    });

    // ---- Dragging in the layer list ----

    private void StartListDrag(GeneratedLayer layer)
    {
        if (!_chosen.Contains(layer))
        {
            Select(layer);
        }

        _listDrag = GeneratedPromoHierarchy.Outermost(Template, _chosen);
    }

    private void EndListDrag()
    {
        _listDrag = null;
        _dropOn = null;
    }

    /// <summary>Top of a row puts it in front, bottom behind; the middle of a group's row puts it inside.</summary>
    private static LayerDrop DropAt(DragEventArgs e, GeneratedLayer layer)
    {
        double y = e.OffsetY;
        if (GeneratedPromoHierarchy.IsGroup(layer))
        {
            return y < RowHeight * 0.3 ? LayerDrop.Above : y > RowHeight * 0.7 ? LayerDrop.Below : LayerDrop.Into;
        }

        return y < RowHeight / 2 ? LayerDrop.Above : LayerDrop.Below;
    }

    private void ListDragOver(DragEventArgs e, GeneratedLayer layer)
    {
        if (_listDrag is not { } dragged || dragged.Any(moving => GeneratedPromoHierarchy.IsWithin(Template, layer, moving)))
        {
            _dropOn = null;
            return;
        }

        (_dropOn, _dropWhere) = (layer, DropAt(e, layer));
    }

    private Task ListDrop(DragEventArgs e, GeneratedLayer layer)
    {
        List<GeneratedLayer>? dragged = _listDrag;
        EndListDrag();
        if (dragged is null)
        {
            return Task.CompletedTask;
        }

        LayerDrop where = DropAt(e, layer);
        return Set(() =>
        {
            if (GeneratedPromoHierarchy.Move(Template, dragged, layer, where, Time) && where == LayerDrop.Into)
            {
                _folded.Remove(layer);
            }
        });
    }

    // ---- Dragging on the canvas ----

    private void StartDrag(PointerEventArgs e, GeneratedLayer layer, string handle)
    {
        // The middle button pans the canvas; only the main one moves things. Locked layers can't be picked here.
        if (e.Button != 0 || IsLocked(layer))
        {
            return;
        }

        // Ctrl (⌘) or Shift on a box adds it to the selection or takes it out, without moving anything.
        if (handle == Move && (e.CtrlKey || e.MetaKey || e.ShiftKey))
        {
            Toggle(layer);
            return;
        }

        // Pressing a box that's already selected keeps the selection, so they all move together.
        if (_chosen.Contains(layer))
        {
            _layer = layer;
        }
        else
        {
            Select(layer);
        }

        // From where the layer is at the preview time, so an animated layer is dragged from what's on screen.
        LayerPose pose = GeneratedPromoEditing.PoseAt(Pose(layer), Time);
        List<Mover> movers = handle != Move ? [] :
        [
            // Locked layers stay put while the rest of the selection moves.
            .. GeneratedPromoHierarchy.Outermost(Template, _chosen).Where(chosen => !IsLocked(chosen)).Select(chosen =>
            {
                LayerPose start = GeneratedPromoEditing.PoseAt(Pose(chosen), Time);
                return new Mover(chosen, start.X, start.Y, GeneratedPromoHierarchy.SpaceAngle(Template, chosen, Pose, Time));
            })
        ];
        _drag = new DragState(layer, handle, e.ClientX, e.ClientY, pose.X, pose.Y, pose.Width, pose.Height)
        {
            Movers = movers,
            OwnRotation = pose.Rotation ?? 0,
            SpaceRotation = GeneratedPromoHierarchy.SpaceAngle(Template, layer, Pose, Time)
        };
        // Usually already measured when the pointer came onto the canvas; this catches a resized window.
        _ = MeasureCanvas();
        // So ←/→ step through frames right after placing the box, to line it up with the background.
        _ = FocusRuler();
    }

    /// <summary>Starts turning the layer by its round handle: the angle is taken about the box's middle on screen.</summary>
    private async Task StartRotate(PointerEventArgs e, GeneratedLayer layer)
    {
        if (e.Button != 0 || IsLocked(layer))
        {
            return;
        }

        Select(layer);
        LayerPose pose = GeneratedPromoEditing.PoseAt(Pose(layer), Time);
        // The overlay comes up straight away; the turn follows once it's known where the canvas is.
        var pending = new DragState(layer, Rotate, e.ClientX, e.ClientY, pose.X, pose.Y, pose.Width, pose.Height) { OwnRotation = pose.Rotation ?? 0 };
        _drag = pending;
        (double left, double top, double width) = await CanvasBox();
        if (!ReferenceEquals(_drag, pending) || width <= 0)
        {
            return;
        }

        _canvasPixels = width;
        WorldBox box = GeneratedPromoHierarchy.World(Template, layer, Pose, Time);
        double centreX = left + box.CenterX * Scale;
        double centreY = top + box.CenterY * Scale;
        _drag = pending with
        {
            CentreClientX = centreX,
            CentreClientY = centreY,
            StartAngle = Math.Atan2(e.ClientY - centreY, e.ClientX - centreX) * 180 / Math.PI
        };
    }

    /// <summary>Where the canvas is on screen (left, top, width), or zeros when it can't be told.</summary>
    private async Task<(double Left, double Top, double Width)> CanvasBox()
    {
        try
        {
            double[] box = await JS.InvokeAsync<double[]>("eval",
                $"(r => r ? [r.left, r.top, r.width] : [0, 0, 0])(document.getElementById('{_canvasId}')?.getBoundingClientRect())");
            return box is [var left, var top, var width] ? (left, top, width) : (0, 0, 0);
        }
        catch (Exception)
        {
            return (0, 0, 0);
        }
    }

    private void Drag(PointerEventArgs e)
    {
        if (_drag is not { } drag)
        {
            return;
        }

        // Canvas pixels the pointer has moved, as the canvas is drawn (before any group's turn).
        double screenDx = (e.ClientX - drag.StartX) / Scale;
        double screenDy = (e.ClientY - drag.StartY) / Scale;
        GeneratedLayer layer = drag.Layer;
        const float minimum = 8;
        drag.Moved |= Math.Abs(screenDx) >= 1 || Math.Abs(screenDy) >= 1;
        // A click that doesn't move the box changes nothing (and adds no keyframe).
        if (!drag.Moved)
        {
            return;
        }

        if (drag.Handle == Rotate)
        {
            if (drag.StartAngle is 0 && drag.CentreClientX is 0)
            {
                return;
            }

            double angle = Math.Atan2(e.ClientY - drag.CentreClientY, e.ClientX - drag.CentreClientX) * 180 / Math.PI;
            double turned = drag.OwnRotation + (angle - drag.StartAngle);
            turned = e.ShiftKey ? Math.Round(turned / 15) * 15 : Math.Round(turned, 1);
            turned = ((turned + 180) % 360 + 360) % 360 - 180;
            IGeneratedPose turning = Editable(layer);
            GeneratedPromoEditing.SetPose(turning, Time, GeneratedPromoEditing.PoseAt(turning, Time) with { Rotation = (float)turned });
            RequestStill(fast: true);
            return;
        }

        if (drag.Handle == PinHandle)
        {
            // The corner follows the pointer: the pull is along the box's own edges, so undo its turn and its groups'.
            (double pullX, double pullY) = Rigid.Rotate(screenDx, screenDy, -(drag.SpaceRotation + drag.OwnRotation));
            (float startX, float startY) = drag.PinStart[drag.Corner];
            PromoCorners pulled = drag.PinStart.With(drag.Corner, (float)Math.Round(startX + pullX, 1), (float)Math.Round(startY + pullY, 1));
            IGeneratedPose pinning = Editable(layer);
            // On an animated layer this sets (or adds) the keyframe at the preview time, so the pin can follow a turning face.
            GeneratedPromoEditing.SetPose(pinning, Time, GeneratedPromoEditing.PoseAt(pinning, Time) with { Rotation = null, Corners = pulled });
            RequestStill(fast: true);
            return;
        }

        if (drag.Handle == Move)
        {
            // Each layer moves in its own group's space, so a drag goes the same way on screen however its groups are turned.
            bool snaps = drag.Movers.Count == 1 && GeneratedPromoHierarchy.ParentOf(Template, drag.Movers[0].Layer) is null && !e.AltKey;
            _snapX = _snapY = false;
            foreach (Mover mover in drag.Movers)
            {
                (double localDx, double localDy) = Rigid.Rotate(screenDx, screenDy, -mover.SpaceRotation);
                IGeneratedPose target = Editable(mover.Layer);
                LayerPose current = GeneratedPromoEditing.PoseAt(target, Time);
                float x = (float)Math.Round(mover.X + localDx);
                float y = (float)Math.Round(mover.Y + localDy);
                if (snaps)
                {
                    (x, y, _snapX, _snapY) = GeneratedPromoEditing.SnapToCenter(x, y, current.Width, current.Height,
                        Template.Width, Template.Height, (float)(SnapDistance / Scale));
                }

                // On an animated layer this sets (or adds) the keyframe at the preview time; while placing layers for
                // one background, it goes into that background's placement instead.
                GeneratedPromoEditing.SetPose(target, Time, current with { X = x, Y = y, Rotation = null });
            }

            RequestStill(fast: true);
            return;
        }

        // Resizing works along the box's own edges, however it and its groups are turned; the opposite edge stays put.
        (double dx, double dy) = Rigid.Rotate(screenDx, screenDy, -(drag.SpaceRotation + drag.OwnRotation));
        double left = 0, right = 0, top = 0, bottom = 0;
        if (drag.Handle.Contains('e')) right = Math.Max(minimum - drag.Width, dx);
        if (drag.Handle.Contains('w')) left = Math.Min(dx, drag.Width - minimum);
        if (drag.Handle.Contains('s')) bottom = Math.Max(minimum - drag.Height, dy);
        if (drag.Handle.Contains('n')) top = Math.Min(dy, drag.Height - minimum);
        double width = drag.Width - left + right;
        double height = drag.Height - top + bottom;
        (double shiftX, double shiftY) = Rigid.Rotate((left + right) / 2, (top + bottom) / 2, drag.OwnRotation);
        double centreX = drag.X + drag.Width / 2.0 + shiftX;
        double centreY = drag.Y + drag.Height / 2.0 + shiftY;

        IGeneratedPose resized = Editable(layer);
        LayerPose was = GeneratedPromoEditing.PoseAt(resized, Time);
        GeneratedPromoEditing.SetPose(resized, Time, was with
        {
            X = (float)Math.Round(centreX - width / 2),
            Y = (float)Math.Round(centreY - height / 2),
            Width = (float)Math.Round(width),
            Height = (float)Math.Round(height),
            Rotation = null
        });
        RequestStill(fast: true);
    }

    private async Task EndDrag(PointerEventArgs e)
    {
        if (_drag is not { } drag)
        {
            return;
        }

        Drag(e);
        _drag = null;
        _snapX = _snapY = false;
        if (drag.Moved)
        {
            await Commit();
        }
    }

    private bool VisibleAt(GeneratedLayer layer)
    {
        var time = TimeSpan.FromSeconds(_time);
        IGeneratedTiming timing = Timing(layer);
        return time >= timing.Start && time < (timing.End ?? Template.Duration);
    }

    private async Task ToggleVoice(ChangeEventArgs e)
    {
        await Set(() =>
        {
            if (e.Value is true)
            {
                // TikTok needs no setup, so it's the default when its plugin is on; otherwise the first voice plugin.
                Template.Voice ??= Voices.Providers.Any(provider => provider.Id == GeneratedPromoTemplates.DefaultVoiceProvider) || Voices.Providers.Count == 0
                    ? new GeneratedVoiceConfig { Provider = GeneratedPromoTemplates.DefaultVoiceProvider, Voice = GeneratedPromoTemplates.DefaultVoice }
                    : new GeneratedVoiceConfig { Provider = Voices.Providers.First().Id, Voice = string.Empty };
                Template.Voice.Enabled = true;
            }
            else if (Template.Voice is not null)
            {
                Template.Voice.Enabled = false;
            }
        });
        await LoadVoices();
    }

    private async Task SetProvider(GeneratedVoiceConfig voice, string id)
    {
        voice.Provider = id;
        _voiceLanguage = DefaultLanguage;
        _voiceSearch = string.Empty;
        await LoadVoices();
        IReadOnlyList<TtsVoice> shown = ShownVoices(_voiceList);
        voice.Voice = (shown.Count > 0 ? shown : _voiceList).FirstOrDefault()?.Id ?? string.Empty;
        await Commit();
    }

    private async Task LoadVoices()
    {
        if (Template.Voice is not { Enabled: true } voice || string.Equals(_voiceListFor, voice.Provider, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        string providerId = voice.Provider;
        _voiceListFor = providerId;
        _voiceList = [];
        _voiceError = null;
        ITextToSpeechProvider? provider = Voices.Providers.FirstOrDefault(candidate => string.Equals(candidate.Id, providerId, StringComparison.OrdinalIgnoreCase));
        if (provider is null || provider.SetupProblem is not null)
        {
            return;
        }

        _voicesLoading = true;
        StateHasChanged();
        try
        {
            IReadOnlyList<TtsVoice> list = await provider.GetVoicesAsync(_life.Token);
            if (_voiceListFor == providerId)
            {
                _voiceList = list;
                // Open on the chosen voice's language so it stays visible; otherwise English.
                string? language = list.FirstOrDefault(option => option.Id == VoiceId(list, voice.Voice))?.Language;
                _voiceLanguage = language ?? (list.Any(option => option.Language == DefaultLanguage) ? DefaultLanguage : AllLanguages);
            }
        }
        catch (OperationCanceledException) when (_life.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _voiceError = ex.GetBaseException().Message;
            _voiceListFor = null;
        }
        finally
        {
            _voicesLoading = false;
        }

        if (!_life.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private IReadOnlyList<TtsVoice> VoiceList(ITextToSpeechProvider? provider) =>
        provider is not null && string.Equals(_voiceListFor, provider.Id, StringComparison.OrdinalIgnoreCase) ? _voiceList : [];

    private IReadOnlyList<TtsVoice> ShownVoices(IReadOnlyList<TtsVoice> list) =>
        [.. list.Where(option => (_voiceLanguage == AllLanguages || option.Language == _voiceLanguage)
            && (string.IsNullOrWhiteSpace(_voiceSearch)
                || $"{option.Name} {option.Id} {option.Description}".Contains(_voiceSearch.Trim(), StringComparison.OrdinalIgnoreCase)))];

    private string VoiceLabel(IReadOnlyList<TtsVoice> list, string id) =>
        list.FirstOrDefault(option => option.Id == id) is { } option
            ? _voiceLanguage == AllLanguages && list.Select(item => item.Language).Distinct().Skip(1).Any()
                ? $"{Words(option.Name)} ({option.Language})"
                : Words(option.Name)
            : id;

    private Task ToggleMusic(ChangeEventArgs e) =>
        Set(() => Template.Music = e.Value is true ? Template.Music ?? new GeneratedMusicConfig() : null);

    /// <summary>Songs from files, or from a music library (the first one set up, to start with); the file list is kept either way.</summary>
    private Task ChooseSongSource(GeneratedMusicConfig music, string? value) => Set(() =>
        music.Library = value == "library"
            ? music.Library ?? new BackgroundMusic
            {
                LibraryId = (MusicLibraries.FirstOrDefault(library => library.IsConfigured) ?? MusicLibraries.FirstOrDefault())?.Id ?? "local"
            }
            : null);

    private Task SetLibraryMusic(GeneratedMusicConfig music, BackgroundMusic? value) =>
        Set(() => music.Library = value is { FromLibrary: true } ? value : music.Library);

    private Task SetMadeWith(ChangeEventArgs e) => Set(() =>
        Template.Generator = Text(e) == GeneratorMode ? Template.Generator ?? new GeneratedScriptConfig() : null);

    private static List<string> Lines(ChangeEventArgs e) =>
        [.. Text(e).Replace("\r", "").Split('\n').Where(line => line.Trim().Length > 0)];

    private static readonly string[] NoExtensions = [];

    private bool _settingUp;
    private string? _setupProblem;

    /// <summary>Runs the generator's setup command now (again, if it has run before).</summary>
    private async Task RunSetup(GeneratedScriptConfig generator)
    {
        _settingUp = true;
        _setupProblem = null;
        try
        {
            await Setup.RunAgainAsync(generator, _life.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _setupProblem = ex.Message;
        }
        finally
        {
            _settingUp = false;
        }
    }

    private string CommandPreview()
    {
        if (Template.Generator is not { } generator)
        {
            return string.Empty;
        }

        IReadOnlyList<UpNextListing> listings = PreviewListings(out _);
        return GeneratedPromoResolver.Resolve(Template, Channel.Name, listings, Zone, Preview.Now, Preview.ImageSubjects(Channel, Template)) is { } promo
            ? ExternalPromoGenerator.Describe(generator, promo.GeneratorArguments)
            : string.Empty;
    }

    private static readonly string[] BackgroundExtensions = [.. FileBrowsing.Images, .. FileBrowsing.Videos];

    /// <summary>Whose backgrounds the background list edits: the edited variant's, or the template's (the default look's).</summary>
    private IGeneratedBackgrounds BackgroundHost => EditingVariant is { } variant ? variant : Template;

    /// <summary>Every background what's being edited picks from, the single one older templates have included.</summary>
    private List<string> BackgroundList => GeneratedPromoEditing.Backgrounds(BackgroundHost);

    /// <summary>Swaps the background at <paramref name="index"/> for another file, or removes it when null.</summary>
    private Task SetBackground(int index, string? value) => Set(() =>
    {
        List<string> backgrounds = BackgroundList;
        if (index < 0 || index >= backgrounds.Count)
        {
            return;
        }

        string old = backgrounds[index];
        string? replacement = string.IsNullOrWhiteSpace(value) ? null : value;
        if (string.Equals(_previewBackground, old, StringComparison.OrdinalIgnoreCase))
        {
            _previewBackground = replacement;
        }

        // Its rule goes with it to the new file, or with it when it's removed.
        GeneratedPromoEditing.RenameBackground(Template, BackgroundHost, old, replacement);

        if (string.IsNullOrWhiteSpace(value))
        {
            backgrounds.RemoveAt(index);
        }
        else
        {
            backgrounds[index] = value;
        }

        GeneratedPromoEditing.SetBackgrounds(BackgroundHost, backgrounds);
    });

    /// <summary>The template's background video sound settings, kept on the template from the first change.</summary>
    private GeneratedBackgroundSoundConfig EditBackgroundSound() => Template.BackgroundSound ??= new GeneratedBackgroundSoundConfig();

    private Task AddBackgrounds(IReadOnlyList<string> picked) =>
        Set(() => GeneratedPromoEditing.SetBackgrounds(BackgroundHost, [.. BackgroundList, .. picked]));

    private Task TogglePromoAvailability(bool time, bool enabled) => Set(() =>
    {
        Template.Availability ??= new GeneratedPromoAvailability();
        if (time) Template.Availability.TimeRange = enabled ? Template.Availability.TimeRange ?? new GeneratedBackgroundTimeRange() : null;
        else Template.Availability.DateRange = enabled ? Template.Availability.DateRange ?? new GeneratedAnnualDateRange() : null;
        DropEmptyAvailability();
    });

    /// <summary>The programme the promo is about has to match this library query; blank allows any programme.</summary>
    private Task SetProgrammeQuery(ChangeEventArgs e) => Set(() =>
    {
        string? query = e.Value?.ToString()?.Trim();
        Template.Availability ??= new GeneratedPromoAvailability();
        Template.Availability.Query = string.IsNullOrWhiteSpace(query) ? null : query;
        DropEmptyAvailability();
    });

    // Nothing restricted: no availability block in the YAML (and the render key it always had).
    private void DropEmptyAvailability()
    {
        if (Template.Availability is { TimeRange: null, DateRange: null, Query: null }) Template.Availability = null;
    }

    private static int AvailabilityDatePart(string date, bool month)
    {
        string[] parts = date.Split('-');
        return parts.Length == 2 && int.TryParse(parts[month ? 0 : 1], out int part) ? part : 1;
    }

    private Task SetAvailabilityDate(GeneratedAnnualDateRange range, bool start, bool month, ChangeEventArgs e) => SetNumber(e, value =>
    {
        string date = start ? range.Start : range.End;
        int newMonth = month ? (int)Math.Clamp(value, 1, 12) : AvailabilityDatePart(date, month: true);
        int newDay = month ? AvailabilityDatePart(date, month: false) : (int)Math.Clamp(value, 1, 31);
        string changed = FormattableString.Invariant($"{newMonth:00}-{newDay:00}");
        if (start) range.Start = changed; else range.End = changed;
    });

    // ---- A layer's files or wordings to pick from ----

    /// <summary>
    /// A layer's other files (image and video layers) or wordings (text layers), one picked per promo: each with the same
    /// "choose based on the shows / only during a daily time range" settings backgrounds have, and so does its own.
    /// </summary>
    private RenderFragment LayerChoices(GeneratedLayer layer, string what) => __builder =>
    {
        List<GeneratedLayerChoice> alternatives = layer.Alternatives ?? [];
        bool text = layer.Kind == GeneratedLayerKind.Text;
        <details class="vt-choices" open="@(alternatives.Count > 0)">
            <summary>
                @(alternatives.Count == 0 ? $"Pick from several {what}s" : $"Picks from {alternatives.Count + 1} {what}s, one per promo")
            </summary>
            @if (alternatives.Count > 0)
            {
                <p class="hint">The one above is the first to pick from; each promo uses one of these by their settings (fixed by what the promo is, so a re-render looks the same).</p>
                @(RuleEditor(OwnChoiceSlot(layer), $"The first {what}'s"))
            }
            <ol class="song-list vt-choice-list">
                @for (int index = 0; index < alternatives.Count; index++)
                {
                    int position = index;
                    GeneratedLayerChoice choice = alternatives[position];
                    <li @key="choice">
                        <div class="song-row">
                            @if (text)
                            {
                                <textarea rows="2" aria-label="@($"Wording {position + 2}")" @onchange="e => Set(() => choice.Value = Text(e))">@choice.Value</textarea>
                            }
                            else
                            {
                                <FilePathPicker Value="@choice.Value" ValueChanged="value => Set(() => choice.Value = value ?? string.Empty)" KeepCopyIn="@GeneratedPromoPackages.AssetCategory"
                                                Extensions="@(layer.Kind == GeneratedLayerKind.Video ? FileBrowsing.Videos : FileBrowsing.Images)" Label="@what" />
                            }
                            <button class="btn btn-sm btn-danger" type="button" aria-label="@($"Remove {what} {position + 2}")"
                                    @onclick="() => RemoveChoice(layer, choice)">Remove</button>
                        </div>
                        @if (!text && Missing(choice.Value))
                        {
                            <p class="hint warn">The scheduler can't find this file.</p>
                        }
                        @(RuleEditor(new RuleSlot(() => choice.Rule, rule => choice.Rule = rule), char.ToUpperInvariant(what[0]) + what[1..]))
                    </li>
                }
            </ol>
            <div class="row row-wrap">
                @if (text)
                {
                    <button class="btn btn-sm" type="button" @onclick="() => AddChoices(layer, [string.Empty])">+ Another wording</button>
                }
                else
                {
                    <FilePathPicker Multiple="true" ButtonText="@($"Add {what}s to pick from…")" Label="@($"{what}s")" KeepCopyIn="@GeneratedPromoPackages.AssetCategory"
                                    Extensions="@(layer.Kind == GeneratedLayerKind.Video ? FileBrowsing.Videos : FileBrowsing.Images)" OnPicked="picked => AddChoices(layer, picked)" />
                }
            </div>
        </details>
    };

    private RuleSlot OwnChoiceSlot(GeneratedLayer layer) => new(() => layer.ChoiceRule, rule => layer.ChoiceRule = rule);

    private Task AddChoices(GeneratedLayer layer, IReadOnlyList<string> values) => Set(() =>
    {
        List<GeneratedLayerChoice> alternatives = layer.Alternatives ??= [];
        foreach (string value in values)
        {
            // Files already there aren't added twice; an empty wording is a new one to fill in.
            if (value.Length > 0 && (string.Equals(value, layer.Path, StringComparison.OrdinalIgnoreCase)
                    || alternatives.Any(choice => string.Equals(choice.Value, value, StringComparison.OrdinalIgnoreCase))))
            {
                continue;
            }

            alternatives.Add(new GeneratedLayerChoice { Value = value });
        }

        if (alternatives.Count == 0) layer.Alternatives = null;
    });

    private Task RemoveChoice(GeneratedLayer layer, GeneratedLayerChoice choice) => Set(() =>
    {
        layer.Alternatives?.Remove(choice);
        if (layer.Alternatives is { Count: 0 })
        {
            layer.Alternatives = null;
            layer.ChoiceRule = null;
        }
    });

    // ---- Pick rules (backgrounds' and layers' files and wordings) ----

    /// <summary>
    /// Where a pick rule lives and how it's stored: read it, and set it (null: none). Backgrounds keep theirs in their
    /// host's list keyed by path; a layer's own file or wording and each alternative keep one each.
    /// </summary>
    private sealed record RuleSlot(Func<GeneratedBackgroundRule?> Get, Action<GeneratedBackgroundRule?> Store);

    private RuleSlot BackgroundRuleSlot(IGeneratedBackgrounds host, string background) => new(
        () => GeneratedPromoBackgrounds.Rule(host, background),
        rule =>
        {
            host.BackgroundRules?.RemoveAll(existing => string.Equals(existing.Background, background, StringComparison.OrdinalIgnoreCase));
            if (rule is not null)
            {
                rule.Background = background;
                (host.BackgroundRules ??= []).Add(rule);
            }

            if (host.BackgroundRules is { Count: 0 }) host.BackgroundRules = null;
        });

    private Task ToggleRuleShows(RuleSlot slot, bool enabled) => Set(() =>
    {
        GeneratedBackgroundRule rule = slot.Get() ?? new GeneratedBackgroundRule { MatchShows = false };
        rule.MatchShows = enabled ? null : false;
        slot.Store(rule.MatchShows == false && rule.TimeRange is null ? null : rule);
    });

    private Task ToggleRuleTimeRange(RuleSlot slot, bool enabled) => Set(() =>
    {
        GeneratedBackgroundRule rule = slot.Get() ?? new GeneratedBackgroundRule { MatchShows = false };
        rule.TimeRange = enabled ? rule.TimeRange ?? new GeneratedBackgroundTimeRange() : null;
        slot.Store(rule.MatchShows == false && rule.TimeRange is null ? null : rule);
    });

    /// <summary>
    /// The "choose based on the shows / only during a daily time range" settings for one pick (a background, or one of
    /// a layer's files or wordings), folded away under a summary.
    /// </summary>
    private RenderFragment RuleEditor(RuleSlot slot, string what) => __builder =>
    {
        GeneratedBackgroundRule? rule = slot.Get();
        bool matchShows = rule is not null && rule.MatchShows != false;
        <details class="ed-background-rules">
            <summary>@what selection · @(matchShows ? "show matching on" : "show matching off") · @(rule?.TimeRange is { } hours ? $"{BackgroundTime(hours.Start)}–{BackgroundTime(hours.End)}" : "any time")</summary>
            <label class="check">
                <input type="checkbox" checked="@matchShows" @onchange="e => ToggleRuleShows(slot, e.Value is true)" />
                <span>@(Template.Type == GeneratedPromoType.NowPlaying ? "Choose based on the Now Playing show" : "Choose based on upcoming shows")</span>
            </label>
            @if (matchShows && rule is not null)
            {
                <div class="grid grid-2">
                    <label class="field">
                        <span>Matching shows (one per line; any can match)</span>
                        <textarea rows="3" placeholder="SpongeBob SquarePants&#10;Rugrats"
                                  @onchange="e => Set(() => rule.Shows = Text(e).Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList())">@string.Join('\n', rule.Shows)</textarea>
                    </label>
                    <label class="field">
                        <span>When no show matches</span>
                        <select value="@(rule.OnlyWhenMatching ? "exclude" : "normal")"
                                @onchange='e => Set(() => rule.OnlyWhenMatching = Text(e) == "exclude")'>
                            <option value="normal">Still eligible at normal chance (prefer on match)</option>
                            <option value="exclude">Never use it (only when matching)</option>
                        </select>
                    </label>
                    @if (Template.Type != GeneratedPromoType.NowPlaying)
                    {
                        <label class="field">
                            <span>Look ahead by</span>
                            <select value="@(rule.Within is null ? "shows" : "time")"
                                    @onchange='e => Set(() => rule.Within = Text(e) == "time" ? TimeSpan.FromMinutes(60) : null)'>
                                <option value="shows">Number of upcoming shows</option>
                                <option value="time">Time from the promo's start</option>
                            </select>
                        </label>
                        @if (rule.Within is { } within)
                        {
                            <label class="field">
                                <span>Within the next (minutes)</span>
                                <input type="number" min="1" max="1440" step="1" value="@Number(within.TotalMinutes)"
                                       @onchange="e => SetNumber(e, value => rule.Within = TimeSpan.FromMinutes(Math.Clamp(value, 1, 1440)))" />
                            </label>
                        }
                        else
                        {
                            <label class="field">
                                <span>Next shows (1 = only the next show)</span>
                                <input type="number" min="1" max="10" value="@rule.NextShows"
                                       @onchange="e => SetNumber(e, value => rule.NextShows = (int)Math.Clamp(value, 1, 10))" />
                            </label>
                        }
                    }
                    <label class="field">
                        <span>Relative chance when matching</span>
                        <input type="number" min="1" max="1000" step="1" value="@Number(rule.MatchWeight)"
                               @onchange="e => SetNumber(e, value => rule.MatchWeight = Math.Clamp(value, 1, 1000))" />
                    </label>
                </div>
                @if (Template.Type == GeneratedPromoType.NowPlaying)
                {
                    <p class="hint">Matches the show this Now Playing promo identifies, including a show that has already started. Lookahead settings aren't used for this promo type.</p>
                }
                <p class="hint">Normal chance is 1. A weight of 5 gives five times the chance of an ordinary pick. “Only when matching” restricts this one; others can still be picked. Names use the same loose matching as variable images.</p>
                @if (rule.Shows.Count == 0)
                {
                    <p class="hint warn">Add at least one show for this rule to match.</p>
                }
            }
            <label class="check">
                <input type="checkbox" checked="@(rule?.TimeRange is not null)" @onchange="e => ToggleRuleTimeRange(slot, e.Value is true)" />
                <span>Only choose during a daily time range</span>
            </label>
            @if (rule?.TimeRange is { } range)
            {
                <div class="grid grid-2">
                    <label class="field">
                        <span>From (channel-local time, inclusive)</span>
                        <input type="time" step="60" value="@BackgroundTime(range.Start)" @onchange="e => SetBackgroundTime(e, value => range.Start = value)" />
                    </label>
                    <label class="field">
                        <span>Until (exclusive)</span>
                        <input type="time" step="60" value="@BackgroundTime(range.End)" @onchange="e => SetBackgroundTime(e, value => range.End = value)" />
                    </label>
                </div>
                <p class="hint">Uses the promo's scheduled start in @Zone.Id. An earlier end crosses midnight, such as 22:00–06:00. Outside this range it can't be chosen, even when its show matches.</p>
                @if (range.Start == range.End)
                {
                    <p class="hint warn">Start and end must differ. Turn off the time range to allow any time.</p>
                }
            }
        </details>
    };

    private static string BackgroundTime(TimeSpan time) => time.ToString(@"hh\:mm", CultureInfo.InvariantCulture);

    // Blazor hands a time input's value over as HH:mm:ss (it adds ":00" to the browser's HH:mm), so both are read.
    private Task SetBackgroundTime(ChangeEventArgs e, Action<TimeSpan> apply) =>
        GeneratedPromoEditing.TryParseTimeOfDay(Text(e), out TimeSpan time)
            ? Set(() => apply(time)) : Task.CompletedTask;

    private void PreviewBackground(string? background)
    {
        _previewBackground = background;
        RequestStill();
    }

    /// <summary>The editable opener list, folding in the single opener older templates may still carry.</summary>
    private static List<string> PreMessages(GeneratedVoiceConfig voice)
    {
        if (!string.IsNullOrWhiteSpace(voice.PreMessage) && voice.PreMessages.Count == 0) voice.PreMessages = [voice.PreMessage];
        voice.PreMessage = null;
        return voice.PreMessages;
    }

    private static List<string> PostMessages(GeneratedVoiceConfig voice)
    {
        if (!string.IsNullOrWhiteSpace(voice.PostMessage) && voice.PostMessages.Count == 0) voice.PostMessages = [voice.PostMessage];
        voice.PostMessage = null;
        return voice.PostMessages;
    }

    /// <summary>
    /// The editable song list, folding in the single-song form older templates may still carry, and turning the old
    /// shared start point into a start for each song so new songs begin at 0.
    /// </summary>
    private static List<string> Songs(GeneratedMusicConfig music)
    {
        if (music.Path is { Length: > 0 })
        {
            music.Paths = [.. music.Songs];
            music.Path = null;
        }

        if (music.StartAt > TimeSpan.Zero)
        {
            foreach (string song in music.Paths.Where(song => !string.IsNullOrWhiteSpace(song)))
            {
                SongStarts(music).TryAdd(song, music.StartFor(song));
            }

            music.StartAt = TimeSpan.Zero;
        }

        return music.Paths;
    }

    private static Dictionary<string, TimeSpan> SongStarts(GeneratedMusicConfig music)
    {
        // Copies made for previews come back with an ordinal map, so the comparer is restored here.
        if (music.SongStarts is null || music.SongStarts.Comparer != StringComparer.OrdinalIgnoreCase)
        {
            music.SongStarts = music.SongStarts is { } existing
                ? new Dictionary<string, TimeSpan>(existing, StringComparer.OrdinalIgnoreCase)
                : new Dictionary<string, TimeSpan>(StringComparer.OrdinalIgnoreCase);
        }

        return music.SongStarts;
    }

    private static void SetStart(GeneratedMusicConfig music, string song, TimeSpan start)
    {
        Dictionary<string, TimeSpan> starts = SongStarts(music);
        if (start > TimeSpan.Zero)
        {
            starts[song] = start;
        }
        else
        {
            starts.Remove(song);
        }

        // Null rather than empty, so the YAML and the render key stay as they were without per-song starts.
        if (starts.Count == 0) music.SongStarts = null;
    }

    private Task SetSong(GeneratedMusicConfig music, int index, string? value) => Set(() =>
    {
        List<string> songs = Songs(music);
        string old = songs[index];
        TimeSpan start = music.StartFor(old);
        double volume = music.VolumeFor(old);
        SetStart(music, old, TimeSpan.Zero);
        SetVolume(music, old, 1);
        if (string.Equals(_songPlaying, old, StringComparison.OrdinalIgnoreCase)) StopSongPreview();

        if (string.IsNullOrWhiteSpace(value))
        {
            songs.RemoveAt(index);
        }
        else
        {
            songs[index] = value;
            // Swapping the file keeps the start and volume the row had.
            SetStart(music, value, start);
            SetVolume(music, value, volume);
        }
    });

    /// <summary>Sets a song's own volume (1 = the master volume), keeping only the ones that differ.</summary>
    private static void SetVolume(GeneratedMusicConfig music, string song, double volume)
    {
        // Copies made for previews come back with an ordinal map, so the comparer is restored here.
        Dictionary<string, double> volumes = music.SongVolumes is { } existing
            ? new Dictionary<string, double>(existing, StringComparer.OrdinalIgnoreCase)
            : new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        if (Math.Abs(volume - 1) < 0.001)
        {
            volumes.Remove(song);
        }
        else
        {
            volumes[song] = Math.Round(Math.Clamp(volume, 0, 2), 3);
        }

        // Null rather than empty, so the YAML and the render key stay as they were without per-song volumes.
        music.SongVolumes = volumes.Count == 0 ? null : volumes;
    }

    private async Task SetSongVolume(ChangeEventArgs e, GeneratedMusicConfig music, string song)
    {
        await SetNumber(e, value => SetVolume(music, song, value / 100));
        if (string.Equals(_songPlaying, song, StringComparison.OrdinalIgnoreCase))
        {
            // Restart so what's heard is at the new volume.
            await PlaySongPreview(music, song);
        }
    }

    private Task AddSongs(GeneratedMusicConfig music, IReadOnlyList<string> picked) => Set(() =>
    {
        List<string> songs = Songs(music);
        songs.AddRange(picked.Where(song => !songs.Contains(song, StringComparer.OrdinalIgnoreCase)));
    });

    private async Task SetSongStart(ChangeEventArgs e, GeneratedMusicConfig music, string song)
    {
        await SetSeconds(e, value => SetStart(music, song, value));
        if (string.Equals(_songPlaying, song, StringComparison.OrdinalIgnoreCase))
        {
            // Restart so what's heard matches the new start.
            await PlaySongPreview(music, song);
        }
    }

    private Task ToggleSongPreview(GeneratedMusicConfig music, string song)
    {
        if (string.Equals(_songPlaying, song, StringComparison.OrdinalIgnoreCase))
        {
            StopSongPreview();
            return Task.CompletedTask;
        }

        return PlaySongPreview(music, song);
    }

    private async Task PlaySongPreview(GeneratedMusicConfig music, string song)
    {
        StopSongPreview();
        var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_life.Token);
        _songCancellation = cancellation;
        _songCutting = song;
        _songError = null;
        try
        {
            string clip = await Preview.SongClipAsync(GeneratedPromoEditing.Copy(music), song, Template.Duration, cancellation.Token);
            if (cancellation.IsCancellationRequested) return;
            _songClipUrl = $"{Preview.FileUrl(clip)}?v={DateTime.UtcNow.Ticks}";
            _songPlaying = song;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _songError = $"Couldn't play {Path.GetFileName(song)}: {ex.GetBaseException().Message}";
        }
        finally
        {
            if (ReferenceEquals(_songCancellation, cancellation)) _songCutting = null;
        }
    }

    private void StopSongPreview()
    {
        _songCancellation?.Cancel();
        _songCancellation = null;
        _songCutting = null;
        _songPlaying = null;
        _songClipUrl = null;
    }

    private string Script()
    {
        IReadOnlyList<UpNextListing> listings = PreviewListings(out _);
        return GeneratedPromoResolver.Resolve(Template, Channel.Name, listings, Zone, Preview.Now, Preview.ImageSubjects(Channel, Template),
            where: Preview.VoiceContext(Channel))?.Script ?? string.Empty;
    }

    private string DefaultVoiceTemplate => Template.Type == GeneratedPromoType.UpNext ? "Now, it's {up_next}." : "It's {show} on {channel}!";

    // ---- Pre-recorded voice-over --------------------------------------------------------------------------------

    private bool _voicePacksOpen;
    private string? _sayUrl;
    private string? _sayNote;
    private bool _saying;
    private int _says;

    private List<GeneratedVoicePack> VoicePacks => Editor.Working.Settings.GeneratedPromosVoicePacks;

    /// <summary>The time the voice-over has: the promo less when it starts, and a moment at the end.</summary>
    private TimeSpan VoiceRoom => Template.Duration - (Template.Voice?.Start ?? TimeSpan.Zero) - TimeSpan.FromMilliseconds(300);

    /// <summary>The shows a pre-recorded voice-over's parts can be about, as the promo would have them right now.</summary>
    private IReadOnlyList<UpNextListing> VoiceShows()
    {
        IReadOnlyList<UpNextListing> listings = PreviewListings(out _);
        IReadOnlyList<UpNextListing> upcoming = Preview.ImageSubjects(Channel, Template).Upcoming;
        return PrerecordedVoice.Shows(Template.Type, listings, upcoming);
    }

    // 100% is kept as null, so templates left at it keep their render keys.
    private static void SetVoiceVolume(GeneratedVoiceConfig voice, double percent)
    {
        double level = Math.Clamp(Math.Round(percent) / 100, 0, GeneratedVoiceConfig.MaxVolume);
        voice.Volume = Math.Abs(level - 1) < 0.001 ? null : level;
    }

    private static string VoiceVolumeLabel(double level)
    {
        string percent = $"{Math.Round(level * 100):0}%";
        if (level <= 0) return $"{percent} (silent)";
        double decibels = 20 * Math.Log10(level);
        return Math.Abs(decibels) < 0.05 ? $"{percent} (as recorded)" : $"{percent} ({decibels:+0.0;-0.0} dB)";
    }

    private Task SetVoiceMode(GeneratedVoiceConfig voice, GeneratedVoiceMode mode) => Set(() =>
    {
        // Text-to-speech is the default, kept as null so templates without pre-recorded lines keep their renders.
        voice.Mode = mode == GeneratedVoiceMode.Prerecorded ? mode : null;
        if (mode == GeneratedVoiceMode.Prerecorded && voice.Prerecorded is null)
        {
            voice.Prerecorded = new GeneratedPrerecordedVoiceConfig { Pack = VoicePacks.Count == 1 ? VoicePacks[0].Id : string.Empty };
        }

        GeneratedVoicePacks.Link(Template, VoicePacks);
        ClearSay();
    });

    private Task ChooseVoicePack(string id) => Set(() =>
    {
        if (Template.Voice?.Prerecorded is not { } recorded) return;
        if (!string.Equals(recorded.Pack, id, StringComparison.OrdinalIgnoreCase)) recorded.Templates = null;
        recorded.Pack = id;
        GeneratedVoicePacks.Link(Template, VoicePacks);
        ClearSay();
    });

    // A pack made in the dialog becomes this template's when it has none yet.
    private Task PackCreated(string id) =>
        Template.Voice?.Prerecorded is { } recorded && GeneratedVoicePacks.Find(VoicePacks, recorded.Pack) is null
            ? ChooseVoicePack(id)
            : Task.CompletedTask;

    // A voice pack changes nothing on screen, so the preview frame isn't drawn again (Commit would), only the edit recorded.
    private Task VoicePacksChanged()
    {
        GeneratedVoicePacks.Link(Template, VoicePacks);
        ClearSay();
        return Changed.InvokeAsync();
    }

    private Task SetPackTemplate(GeneratedPrerecordedVoiceConfig recorded, GeneratedVoicePack pack, string id, bool use) => Set(() =>
    {
        // Ticking every template is the same as "all of them", which also takes in ones added later.
        List<string> chosen = recorded.Templates is { Count: > 0 } list ? list : [.. pack.Templates.Select(template => template.Id)];
        chosen.RemoveAll(existing => string.Equals(existing, id, StringComparison.OrdinalIgnoreCase));
        if (use) chosen.Add(id);
        recorded.Templates = pack.Templates.All(template => chosen.Contains(template.Id, StringComparer.OrdinalIgnoreCase)) ? null : chosen;

        // Unticking the last one means none of the pack's (an empty pick would otherwise mean all of them).
        if (recorded.Templates is { Count: 0 })
        {
            recorded.Templates = null;
            recorded.UsePackTemplates = false;
        }
        ClearSay();
    });

    // Off leaves only this promo's own templates; on is kept as null so promos without them keep their render keys.
    private Task SetUsePackTemplates(GeneratedPrerecordedVoiceConfig recorded, bool use) => Set(() =>
    {
        recorded.UsePackTemplates = use ? null : false;
        ClearSay();
    });

    // On (the default) is kept as null.
    private Task SetNormalizeLevels(GeneratedPrerecordedVoiceConfig recorded, bool normalize) => Set(() =>
    {
        recorded.NormalizeLevels = normalize ? null : false;
        ClearSay();
    });

    // Bumped to reset the "copy a pack template" picker after each pick.
    private int _inlineCopyPicker;

    /// <summary>
    /// Adds a template kept with this promo: empty, or a copy of the pack's template <paramref name="copyOf"/> (its parts
    /// say the same phrases, so it can be tweaked here without changing the pack's).
    /// </summary>
    private Task AddInlineTemplate(GeneratedPrerecordedVoiceConfig recorded, GeneratedVoicePack pack, string? copyOf)
    {
        GeneratedVoicePackTemplate? source = null;
        if (copyOf is not null)
        {
            _inlineCopyPicker++;
            source = pack.Templates.FirstOrDefault(template => string.Equals(template.Id, copyOf, StringComparison.OrdinalIgnoreCase));
            if (source is null) return Task.CompletedTask;
        }

        return Set(() =>
        {
            recorded.InlineTemplates ??= [];
            IEnumerable<string> taken = recorded.InlineTemplates.Select(template => template.Name);
            recorded.InlineTemplates.Add(new GeneratedVoicePackTemplate
            {
                Name = GeneratedPromoEditing.UniqueName(taken, source is null ? "This promo's template" : source.Name),
                Parts = source?.Parts.Select(part => new GeneratedVoicePart { Phrase = part.Phrase, Show = part.Show, Gap = part.Gap }).ToList() ?? []
            });
            ClearSay();
        });
    }

    private Task RemoveInlineTemplate(GeneratedPrerecordedVoiceConfig recorded, GeneratedVoicePackTemplate inline) => Set(() =>
    {
        recorded.InlineTemplates?.Remove(inline);
        if (recorded.InlineTemplates is { Count: 0 }) recorded.InlineTemplates = null;
        ClearSay();
    });

    /// <summary>Moves an inline template into the pack, where every promo using it can pick it; this promo keeps using it.</summary>
    private Task MoveInlineToPack(GeneratedPrerecordedVoiceConfig recorded, GeneratedVoicePack pack, GeneratedVoicePackTemplate inline) => Set(() =>
    {
        recorded.InlineTemplates?.Remove(inline);
        if (recorded.InlineTemplates is { Count: 0 }) recorded.InlineTemplates = null;
        inline.Name = GeneratedPromoEditing.UniqueName(pack.Templates.Select(template => template.Name), string.IsNullOrWhiteSpace(inline.Name) ? "Template" : inline.Name);
        pack.Templates.Add(inline);

        // Still said by this promo: a pick of the pack's templates gets it added, and its pack templates are turned on.
        if (recorded.Templates is { Count: > 0 } chosen) chosen.Add(inline.Id);
        if (!recorded.PackTemplatesUsed)
        {
            recorded.UsePackTemplates = null;
            recorded.Templates = [inline.Id];
        }

        ClearSay();
    });

    private Task RenameInlineTemplate(GeneratedVoicePackTemplate inline, string? name)
    {
        inline.Name = name ?? string.Empty;
        return InlineTemplateChanged();
    }

    private Task EnableInlineTemplate(GeneratedVoicePackTemplate inline, bool enabled)
    {
        inline.Enabled = enabled;
        return InlineTemplateChanged();
    }

    // Like a voice pack edit, an inline template's changes nothing on screen, so only the edit is recorded.
    private Task InlineTemplateChanged()
    {
        ClearSay();
        return Changed.InvokeAsync();
    }

    private void ClearSay()
    {
        _sayUrl = null;
        _sayNote = null;
        _sayFor = null;
    }

    private async Task SayVoiceOver()
    {
        ClearSay();
        GeneratedVoicePacks.Link(Template, VoicePacks);
        if (Preview.Resolve(Template, Channel, Zone)?.Prerecorded is not { } request)
        {
            _sayNote = "None of this promo's templates can be said for these shows.";
            return;
        }

        _saying = true;
        try
        {
            (string clip, PrerecordedChoice choice, double tempo) = await Preview.SayAsync(request with { Seed = $"{request.Seed}|try|{++_says}" }, VoiceRoom, _life.Token);
            _sayUrl = $"{Preview.FileUrl(clip)}?v={DateTime.UtcNow.Ticks}";
            _sayNote = $"{choice.Candidate.Name}: {choice.Candidate.Describe()} — {PrerecordedVoice.Seconds(choice.Length)} of {PrerecordedVoice.Seconds(VoiceRoom)}"
                       + (tempo > 1.001 ? $", sped up {tempo:0.00}× in the promo." : choice.Length > VoiceRoom ? ", so the end is cut off (speeding up is off)." : ".");
        }
        catch (OperationCanceledException) when (_life.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            _sayNote = $"Couldn't put it together: {ex.GetBaseException().Message}";
        }
        finally
        {
            _saying = false;
        }
    }

    /// <summary>
    /// Text-to-speech settings: the voice-over's own, or (<paramref name="fallback"/>) those a pre-recorded voice-over falls
    /// back on when its recordings can't say a promo, which leave out what only applies to text-to-speech proper (when
    /// it starts is shared, curation and AI wording aren't used for a fallback).
    /// </summary>
    private RenderFragment TtsSettings(GeneratedVoiceConfig voice, bool fallback) => __builder =>
    {
        bool advancedVoice = voice.Advanced is { Enabled: true };
        ITextToSpeechProvider? provider = Voices.Providers.FirstOrDefault(candidate => string.Equals(candidate.Id, voice.Provider, StringComparison.OrdinalIgnoreCase));
        IReadOnlyList<TtsVoice> voiceList = VoiceList(provider);
        IReadOnlyList<string> languages = [.. voiceList.Select(option => option.Language).Distinct().Order()];
        IReadOnlyList<TtsVoice> shown = ShownVoices(voiceList);
        string current = VoiceId(voiceList, voice.Voice);
        <div class="grid grid-3">
            <label class="field">
                <span>Voice service</span>
                <select value="@voice.Provider" @onchange="e => SetProvider(voice, Text(e))">
                    @foreach (ITextToSpeechProvider candidate in Voices.Providers)
                    {
                        <option value="@candidate.Id">@candidate.DisplayName</option>
                    }
                </select>
            </label>
            <label class="field">
                <span>Voice@(_voicesLoading ? " (loading…)" : languages.Count > 1 ? $" ({shown.Count} of {voiceList.Count})" : "")</span>
                <select value="@current" @onchange="e => Set(() => voice.Voice = Text(e))">
                    @if (!shown.Any(option => option.Id == current))
                    {
                        <option value="@voice.Voice">@(string.IsNullOrWhiteSpace(voice.Voice) ? "Choose a voice" : VoiceLabel(voiceList, voice.Voice))</option>
                    }
                    @foreach (TtsVoice option in shown)
                    {
                        <option value="@option.Id" title="@option.Description">@VoiceLabel(voiceList, option.Id)</option>
                    }
                </select>
            </label>
            @if (!fallback)
            {
                <label class="field">
                    <span>Starts speaking at (s)</span>
                    <input type="number" min="0" step="0.05" value="@Number(voice.Start.TotalSeconds)"
                           @onchange="e => SetSeconds(e, value => voice.Start = value)" />
                </label>
            }
        </div>
        @if (languages.Count > 1)
        {
            <div class="grid grid-2">
                <label class="field">
                    <span>Voice language</span>
                    <select value="@_voiceLanguage" @onchange="e => _voiceLanguage = Text(e)">
                        <option value="@AllLanguages">All languages</option>
                        @foreach (string language in languages)
                        {
                            <option value="@language">@language</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Search voices</span>
                    <input type="search" value="@_voiceSearch" placeholder="narrator, deep, female…" @oninput="e => _voiceSearch = Text(e)" />
                </label>
            </div>
        }
        @if (provider?.SetupProblem is { } setup)
        {
            <p class="hint warn">@setup</p>
        }
        else if (_voiceError is { } voiceError)
        {
            <p class="hint warn">Couldn't load the voice list: @voiceError</p>
        }
        <label class="check">
            <input type="checkbox" checked="@advancedVoice" @onchange="e => ToggleAdvancedVoice(voice, e.Value is true)" />
            <span>Advanced voice-over templates (write the complete script)</span>
        </label>
        @if (voice.Advanced is { Enabled: true } advanced)
        {
            <p class="hint">One of your eligible templates is picked for each promo. Its wording is used exactly, with tokens filled in—no automatic linking phrases or AI rewriting.</p>
            @for (int index = 0; index < advanced.Templates.Count; index++)
            {
                int position = index;
                <div class="field" @key="position">
                    <label for="@($"{_canvasId}-voice-{position}")">Script template @(position + 1)</label>
                    <textarea id="@($"{_canvasId}-voice-{position}")" rows="3"
                              @onchange="e => Set(() => advanced.Templates[position] = Text(e))">@advanced.Templates[position]</textarea>
                    <button class="btn btn-sm btn-danger" type="button" @onclick="() => Set(() => advanced.Templates.RemoveAt(position))">Remove template</button>
                </div>
            }
            <button class="btn btn-sm" type="button" @onclick="() => Set(() => advanced.Templates.Add(DefaultVoiceTemplate))">Add script template</button>
            <p class="hint">{up_next}, {up_next_2} … {up_next_10} always use the same upcoming sequence as text and variable images. The template's “Count upcoming programmes by” setting controls whether this counts timeslots/episodes or groups consecutive slots by show. {show} names the show this promo is for; {channel}, {episode}, {start_time}, and {end_time} are also available.</p>
            <p class="hint">Use {up_next_2:raw} to bypass repeat wording, or :episode, :start_time, or :end_time for its details. A template referencing an unavailable upcoming listing is skipped; add a shorter template as a fallback. If none can be used, this promo has no voice-over.</p>
            <div class="grid grid-2">
                <label class="field">
                    <span>Before a repeated show title (spaces included)</span>
                    <input type="text" value="@advanced.RepeatPrefix" @onchange="e => Set(() => advanced.RepeatPrefix = Text(e))" />
                </label>
                <label class="field">
                    <span>After a repeated show title (spaces included)</span>
                    <input type="text" value="@advanced.RepeatSuffix" @onchange="e => Set(() => advanced.RepeatSuffix = Text(e))" />
                </label>
            </div>
            <p class="hint">For example, “more ” makes a later token say “more Rugrats” if an earlier listing is also Rugrats. Separate slots of the same show can repeat in Timeslot / episode mode; episodes packed into one slot stay together. Clear both fields to repeat titles unchanged.</p>
            <label class="check">
                <input type="checkbox" checked="@advanced.IncludePreMessages" @onchange="e => Set(() => advanced.IncludePreMessages = e.Value is true)" />
                <span>Include an opener before the script (optional)</span>
            </label>
            <label class="check">
                <input type="checkbox" checked="@advanced.IncludePostMessages" @onchange="e => Set(() => advanced.IncludePostMessages = e.Value is true)" />
                <span>Include a closer after the script (optional)</span>
            </label>
        }
        <div class="grid grid-2">
            @if (!advancedVoice || voice.Advanced!.IncludePreMessages)
            {
            <div class="field">
                <span>Said first (one is picked for each promo)</span>
                <PhraseListEditor Values="PreMessages(voice)" Changed="Commit" Label="Opener"
                                  Placeholder="@GeneratedPromoResolver.DefaultPreMessage(Template.Type)"
                                  EmptyHint="@(advancedVoice ? "No opener; the script stands on its own." : $"Says the usual “{GeneratedPromoResolver.DefaultPreMessage(Template.Type)}”")" />
            </div>
            }
            @if (!advancedVoice || voice.Advanced!.IncludePostMessages)
            {
            <div class="field">
                <span>Said last ({channel}, {show}, {time} and {when} are filled in)</span>
                <PhraseListEditor Values="PostMessages(voice)" Changed="Commit" Label="Closer" Placeholder="Only on {channel}!"
                                  EmptyHint="Nothing is said after the shows." />
            </div>
            }
        </div>
        @if (!fallback)
        {
        if (CuratedPromo.LayerIndex(Template) is { } curatedLayer)
        {
            <p class="hint">
                The voice-over is written by the layer curated by AI (<strong>@(string.IsNullOrWhiteSpace(Template.Layers[curatedLayer].Name) ? $"layer {curatedLayer + 1}" : Template.Layers[curatedLayer].Name)</strong>),
                in this voice, around the clips it picks, between the <strong>Said first</strong> and <strong>Said last</strong> picked
                below (said as written; for curated promos they can also use @CuratedTokens, and empty says nothing extra).
                The read-out below is said instead whenever it can't be curated.
            </p>
        }
        <p class="hint">@(advancedVoice ? "Template read-out:" : voice.Writer is null ? ReadOutLabel : UsualReadOutLabel) <em>@Script()</em></p>
        @if (advancedVoice && string.IsNullOrWhiteSpace(Script()))
        {
            <p class="hint warn">No usable voice-over template for these shows. Check tokens and add a template requiring fewer upcoming listings.</p>
        }

        @if (!advancedVoice)
        {
        <label class="check">
            <input type="checkbox" checked="@(voice.Writer is not null)"
                   @onchange="e => Set(() => voice.Writer = e.Value is true ? voice.Writer ?? new AiTextConfig() : null)" />
            <span>Have AI word it naturally (and say something about the episode)</span>
        </label>
        @if (voice.Writer is { } voiceWriter)
        {
            <AiTextSettings Config="voiceWriter" Changed="Commit" PromptLabel="Anything else it should do (optional)"
                            PromptPlaceholder="@VoicePromptPlaceholder" WordsPlaceholder="@VoiceWords(voice)" Try="@TryVoice"
                            TryHint="Writes one with this channel's next shows (a new one each time)." />
        }
        }
        }
    };

    private RenderFragment PrerecordedSettings(GeneratedVoiceConfig voice, GeneratedPrerecordedVoiceConfig recorded) => __builder =>
    {
        GeneratedVoicePack? pack = GeneratedVoicePacks.Find(VoicePacks, recorded.Pack);
        <div class="grid grid-3">
            <label class="field">
                <span>Voice pack</span>
                <select value="@(pack?.Id ?? string.Empty)" @onchange="e => ChooseVoicePack(e.Value?.ToString() ?? string.Empty)">
                    @if (pack is null)
                    {
                        <option value="">@(VoicePacks.Count == 0 ? "No voice packs yet" : "Choose a voice pack")</option>
                    }
                    @foreach (GeneratedVoicePack option in VoicePacks)
                    {
                        <option value="@option.Id">@(string.IsNullOrWhiteSpace(option.Name) ? "Untitled" : option.Name)</option>
                    }
                </select>
            </label>
            <label class="field">
                <span>Starts speaking at (s)</span>
                <input type="number" min="0" step="0.05" value="@Number(voice.Start.TotalSeconds)"
                       @onchange="e => SetSeconds(e, value => voice.Start = value)" />
            </label>
            <label class="field">
                <span>Choosing takes</span>
                <select value="@recorded.Fit" @onchange="e => Set(() => recorded.Fit = Enum.Parse<GeneratedVoiceFit>(Text(e)))">
                    <option value="@GeneratedVoiceFit.Random">At random (shorter ones when time is tight)</option>
                    <option value="@GeneratedVoiceFit.Fill">Fill the time (longest that fit)</option>
                </select>
            </label>
        </div>
        <div class="row row-wrap">
            <button class="btn btn-sm" type="button" @onclick="() => _voicePacksOpen = true">
                <Icon Name="mic" Size="15" />@(VoicePacks.Count == 0 ? "Make a voice pack…" : "Edit voice packs…")
            </button>
            <span class="hint" style="margin: 0;">Record phrases (with several takes each) and build templates from them; packs are shared by every promo.</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(recorded.Pack) && pack is null)
        {
            <p class="hint warn">The chosen voice pack no longer exists, so this promo has no voice-over.</p>
        }
        @if (pack is not null)
        {
            IReadOnlyList<UpNextListing> shows = VoiceShows();
            DateTimeOffset now = Preview.Now;
            GeneratedVoiceContext voiceWhere = Preview.VoiceContext(Channel);
            @(PackTemplatePicker(recorded, pack, shows, now, voiceWhere))
            <div class="field">
                <span>This promo's own templates (built from the pack's phrases, kept with this promo only)</span>
                @if (recorded.InlineTemplates is not { Count: > 0 })
                {
                    <p class="hint" style="margin: 0;">None yet. Make one to say something particular to this promo, or copy one of the pack's to tweak it here.</p>
                }
                @foreach (GeneratedVoicePackTemplate inline in recorded.InlineTemplates ?? [])
                {
                    IReadOnlyList<string> missing = PrerecordedVoice.Missing(pack, inline, shows, Zone, now, voiceWhere);
                    <div class="card voice-template" @key="inline">
                        <div class="card-head">
                            <input type="text" class="voice-template-name" value="@inline.Name" aria-label="Template name"
                                   @onchange="e => RenameInlineTemplate(inline, e.Value?.ToString())" />
                            <label class="check" style="margin: 0;">
                                <input type="checkbox" checked="@inline.Enabled" @onchange="e => EnableInlineTemplate(inline, e.Value is true)" />
                                <span>On</span>
                            </label>
                            <div class="spacer"></div>
                            <button class="btn btn-sm" type="button" title="Move it into the voice pack, so other promos can use it too"
                                    @onclick="() => MoveInlineToPack(recorded, pack, inline)">Move to pack</button>
                            <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveInlineTemplate(recorded, inline)">Delete</button>
                        </div>
                        @if (pack.Phrases.Count == 0)
                        {
                            <p class="hint warn">The pack has no phrases yet. Open the voice packs to record some.</p>
                        }
                        <VoiceTemplateParts Pack="pack" Template="inline" Changed="InlineTemplateChanged" />
                        @if (inline.Enabled && missing.Count > 0 && inline.Parts.Count > 0)
                        {
                            <p class="hint warn">Skipped for these shows: @(string.Join("; ", missing)).</p>
                        }
                    </div>
                }
                <div class="row row-wrap">
                    <button class="btn btn-sm" type="button" @onclick="() => AddInlineTemplate(recorded, pack, null)"><Icon Name="plus" Size="15" />New template for this promo</button>
                    @if (pack.Templates.Count > 0)
                    {
                        <select @key="_inlineCopyPicker" value="" aria-label="Copy one of the pack's templates into this promo"
                                @onchange="e => AddInlineTemplate(recorded, pack, e.Value?.ToString())">
                            <option value="">Copy a pack template…</option>
                            @foreach (GeneratedVoicePackTemplate option in pack.Templates)
                            {
                                <option value="@option.Id">@(string.IsNullOrWhiteSpace(option.Name) ? "Untitled" : option.Name)</option>
                            }
                        </select>
                    }
                </div>
            </div>
            <label class="check">
                <input type="checkbox" checked="@recorded.SpeedUp" @onchange="e => Set(() => recorded.SpeedUp = e.Value is true)" />
                <span>Speed it up (up to 1.35×) when even the shortest takes run longer than the promo</span>
            </label>
            <label class="check">
                <input type="checkbox" checked="@recorded.LevelsNormalized"
                       @onchange="e => SetNormalizeLevels(recorded, e.Value is true)" />
                <span>Even out the volume of every phrase (for takes recorded closer to or further from the mic)</span>
            </label>
            string readOut = Script();
            bool fallingBack = Preview.Resolve(Template, Channel, Zone)?.TtsFallback == true;
            @if (fallingBack)
            {
                <p class="hint warn">None of these templates can be said for the preview's shows, so text-to-speech says it instead: <em>@readOut</em></p>
            }
            else if (string.IsNullOrWhiteSpace(readOut))
            {
                <p class="hint warn">None of these templates can be said for the preview's shows, so this promo would have no voice-over. Record what's missing, add a template that needs less, or fall back to text-to-speech below.</p>
            }
            else
            {
                <p class="hint">One possible read-out: <em>@readOut</em></p>
                <div class="row row-wrap">
                    <button class="btn btn-sm" type="button" disabled="@_saying" @onclick="SayVoiceOver">@(_saying && _sayFor is null ? "Putting it together…" : "▶ Hear one")</button>
                    @if (_sayNote is not null && _sayFor is null)
                    {
                        <span class="hint" style="margin: 0;" role="status">@_sayNote</span>
                    }
                </div>
                @if (_sayUrl is not null && _sayFor is null)
                {
                    <audio class="song-preview" src="@_sayUrl" autoplay controls></audio>
                }
            }
        }
        <label class="check">
            <input type="checkbox" checked="@(recorded.FallbackToTts == true)" @onchange="e => SetFallbackToTts(recorded, e.Value is true)" />
            <span>Fall back to text-to-speech when the recordings can't say it (a show, day or time isn't recorded)</span>
        </label>
        @if (recorded.FallbackToTts == true)
        {
            <p class="hint">Said with these text-to-speech settings, as a text-to-speech voice-over would be (without AI wording). Recording what was missing makes the promo again with the recordings.</p>
            @(TtsSettings(voice, fallback: true))
        }
    };

    // Off is kept as null.
    private Task SetFallbackToTts(GeneratedPrerecordedVoiceConfig recorded, bool fallback) => Set(() =>
    {
        recorded.FallbackToTts = fallback ? true : null;
        ClearSay();
    });

    // Which pack template's ▶ was last pressed (its clip and note show on its card); null for the read-out's "Hear one".
    private string? _sayFor;

    /// <summary>
    /// The voice pack's templates as cards to pick from: each shows what it says (its phrases as chips), whether it can
    /// be said for the preview's shows, and plays on its own; clicking a card adds it to (or takes it from) this promo.
    /// </summary>
    private RenderFragment PackTemplatePicker(GeneratedPrerecordedVoiceConfig recorded, GeneratedVoicePack pack,
        IReadOnlyList<UpNextListing> shows, DateTimeOffset now, GeneratedVoiceContext voiceWhere) => __builder =>
    {
        bool usePack = recorded.PackTemplatesUsed;
        int chosen = usePack ? pack.Templates.Count(option => IsPackTemplateUsed(recorded, option)) : 0;
        <div class="vt-picker">
            <div class="vt-picker-head">
                <div>
                    <strong>Voice-over templates</strong>
                    <span class="hint" style="margin: 0;">One that suits the shows is picked for each promo.</span>
                </div>
                <div class="spacer"></div>
                <div class="vt-segmented" role="group" aria-label="Which templates this promo uses">
                    <button type="button" class="@(usePack ? "active" : "")" aria-pressed="@usePack"
                            @onclick="() => SetUsePackTemplates(recorded, true)">From the voice pack</button>
                    <button type="button" class="@(!usePack ? "active" : "")" aria-pressed="@(!usePack)"
                            @onclick="() => SetUsePackTemplates(recorded, false)">Only this promo's own</button>
                </div>
            </div>
            @if (usePack)
            {
                @if (pack.Templates.Count == 0)
                {
                    <div class="vt-empty">
                        <p>“@(string.IsNullOrWhiteSpace(pack.Name) ? "Untitled" : pack.Name)” has no templates yet.</p>
                        <button class="btn btn-sm" type="button" @onclick="() => _voicePacksOpen = true">Build one in the voice pack…</button>
                    </div>
                }
                else
                {
                    <div class="vt-picker-bar">
                        <span class="hint" style="margin: 0;">
                            @(recorded.Templates is not { Count: > 0 } ? $"Using all {pack.Templates.Count} (templates added to the pack later are used too)" : $"Using {chosen} of {pack.Templates.Count}")
                        </span>
                        <div class="spacer"></div>
                        <button class="btn btn-ghost btn-sm" type="button" disabled="@(recorded.Templates is not { Count: > 0 })"
                                @onclick="() => SelectAllPackTemplates(recorded)">Select all</button>
                        <button class="btn btn-ghost btn-sm" type="button" @onclick="() => SetUsePackTemplates(recorded, false)">Select none</button>
                    </div>
                    <div class="vt-grid" role="listbox" aria-multiselectable="true" aria-label="The voice pack's templates">
                        @foreach (GeneratedVoicePackTemplate option in pack.Templates)
                        {
                            bool used = IsPackTemplateUsed(recorded, option);
                            IReadOnlyList<string> missing = PrerecordedVoice.Missing(pack, option, shows, Zone, now, voiceWhere);
                            string state = !option.Enabled ? "off" : missing.Count > 0 ? "skipped" : "ready";
                            string name = string.IsNullOrWhiteSpace(option.Name) ? "Untitled" : option.Name;
                            <div class="vt-card @(used ? "selected" : "") vt-@state" @key="option" role="option" aria-selected="@(used ? "true" : "false")" tabindex="0"
                                 title="@(used ? $"Click to stop using “{name}”" : $"Click to use “{name}”")"
                                 @onclick="() => SetPackTemplate(recorded, pack, option.Id, !used)"
                                 @onkeydown="e => CardKey(e, recorded, pack, option.Id, !used)">
                                <div class="vt-card-head">
                                    <span class="vt-check" aria-hidden="true">@(used ? "✓" : "")</span>
                                    <strong class="vt-name">@name</strong>
                                    <span class="vt-badge">@(state switch { "off" => "Off in the pack", "skipped" => "Can't say these shows", _ => "Ready" })</span>
                                </div>
                                <div class="vt-chips">@(TemplateChips(pack, option))</div>
                                @if (state == "skipped")
                                {
                                    <p class="vt-why">@(string.Join("; ", missing)).</p>
                                }
                                <div class="vt-card-foot">
                                    <button class="btn btn-ghost btn-sm" type="button" disabled="@(_saying || option.Parts.Count == 0)"
                                            title="Hear this template for the preview's shows (a new pick of takes each time)"
                                            @onclick="() => SayTemplate(pack, option)" @onclick:stopPropagation="true">
                                        @(_saying && _sayFor == option.Id ? "Putting it together…" : "▶ Hear it")
                                    </button>
                                </div>
                                @if (_sayFor == option.Id)
                                {
                                    <div @onclick:stopPropagation="true">
                                        @if (_sayNote is not null)
                                        {
                                            <p class="vt-why" role="status" style="color: var(--muted);">@_sayNote</p>
                                        }
                                        @if (_sayUrl is not null)
                                        {
                                            <audio class="song-preview" src="@_sayUrl" autoplay controls></audio>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <p class="hint">The voice pack's templates aren't used; only this promo's own templates below are.</p>
            }
        </div>
    };

    // Enter or Space on a focused card picks it, as a click does.
    private Task CardKey(KeyboardEventArgs e, GeneratedPrerecordedVoiceConfig recorded, GeneratedVoicePack pack, string id, bool use) =>
        e.Key is "Enter" or " " ? SetPackTemplate(recorded, pack, id, use) : Task.CompletedTask;

    private static bool IsPackTemplateUsed(GeneratedPrerecordedVoiceConfig recorded, GeneratedVoicePackTemplate option) =>
        recorded.PackTemplatesUsed && (recorded.Templates is not { Count: > 0 } || recorded.Templates.Contains(option.Id, StringComparer.OrdinalIgnoreCase));

    private Task SelectAllPackTemplates(GeneratedPrerecordedVoiceConfig recorded) => Set(() =>
    {
        recorded.Templates = null;
        recorded.UsePackTemplates = null;
        ClearSay();
    });

    /// <summary>A template's parts as chips: fixed words in quotes, and what changes per promo (show, day, time, channel) as labels.</summary>
    private static RenderFragment TemplateChips(GeneratedVoicePack pack, GeneratedVoicePackTemplate template) => __builder =>
    {
        if (template.Parts.Count == 0)
        {
            <span class="vt-chip vt-chip-missing">no parts yet</span>
        }

        foreach (GeneratedVoicePart part in template.Parts)
        {
            GeneratedVoicePhrase? phrase = pack.Phrases.FirstOrDefault(candidate => candidate.Id == part.Phrase);
            if (phrase is null)
            {
                <span class="vt-chip vt-chip-missing">deleted phrase</span>
            }
            else if (phrase.Kind == GeneratedVoicePhraseKind.Text)
            {
                <span class="vt-chip vt-chip-text">“@phrase.Name”</span>
            }
            else
            {
                string kind = phrase.Kind switch
                {
                    GeneratedVoicePhraseKind.ShowName => "show",
                    GeneratedVoicePhraseKind.ChannelName => "channel",
                    _ => "when"
                };
                string about = phrase.Kind is GeneratedVoicePhraseKind.ChannelName || part.Show == 0 ? "" : $" · {PrerecordedVoice.ShowLabel(part.Show)}";
                <span class="vt-chip vt-chip-@kind" title="@VoiceTemplateParts.KindName(phrase.Kind)">@(string.IsNullOrWhiteSpace(phrase.Name) ? VoiceTemplateParts.KindName(phrase.Kind) : phrase.Name)@about</span>
            }
        }
    };

    /// <summary>Says one pack template for the preview's shows, whether or not this promo uses it yet.</summary>
    private async Task SayTemplate(GeneratedVoicePack pack, GeneratedVoicePackTemplate option)
    {
        ClearSay();
        _sayFor = option.Id;
        if (Template.Voice is not { Prerecorded: { } recorded })
        {
            return;
        }

        GeneratedVoiceConfig trial = new()
        {
            Mode = GeneratedVoiceMode.Prerecorded,
            Prerecorded = new GeneratedPrerecordedVoiceConfig
            {
                Pack = pack.Id, Templates = [option.Id], Linked = pack, NormalizeLevels = recorded.NormalizeLevels, Fit = recorded.Fit, SpeedUp = recorded.SpeedUp
            }
        };

        // A template that's off in the pack is still heard here, so it can be judged before turning it on.
        bool wasEnabled = option.Enabled;
        PrerecordedVoiceRequest? request;
        try
        {
            option.Enabled = true;
            request = PrerecordedVoice.Plan(trial, VoiceShows(), Zone, Preview.Now, $"try|{++_says}|{DateTime.UtcNow.Ticks}", Preview.VoiceContext(Channel));
        }
        finally
        {
            option.Enabled = wasEnabled;
        }

        if (request is null)
        {
            _sayNote = $"It can't be said for these shows: {string.Join("; ", PrerecordedVoice.Missing(pack, option, VoiceShows(), Zone, Preview.Now, Preview.VoiceContext(Channel)))}.";
            return;
        }

        _saying = true;
        try
        {
            (string clip, PrerecordedChoice choice, double tempo) = await Preview.SayAsync(request, VoiceRoom, _life.Token);
            _sayUrl = $"{Preview.FileUrl(clip)}?v={DateTime.UtcNow.Ticks}";
            _sayNote = $"{choice.Candidate.Describe()} — {PrerecordedVoice.Seconds(choice.Length)} of {PrerecordedVoice.Seconds(VoiceRoom)}"
                       + (tempo > 1.001 ? $", sped up {tempo:0.00}× in the promo." : choice.Length > VoiceRoom ? ", so the end is cut off (speeding up is off)." : ".");
        }
        catch (OperationCanceledException) when (_life.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            _sayNote = $"Couldn't put it together: {ex.GetBaseException().Message}";
        }
        finally
        {
            _saying = false;
        }
    }


    private Task ToggleAdvancedVoice(GeneratedVoiceConfig voice, bool enabled) => Set(() =>
    {
        voice.Advanced ??= new GeneratedAdvancedVoiceConfig { Templates = [DefaultVoiceTemplate] };
        voice.Advanced.Enabled = enabled;
    });

    /// <summary>The word limit the voice-over gets when none is set, worked out from the promo's length.</summary>
    private string VoiceWords(GeneratedVoiceConfig voice) =>
        $"About {AiTextRules.SpokenWords(Template.Duration - voice.Start - TimeSpan.FromMilliseconds(300))}, from the length";

    // Each try gets its own seed, so it can be heard several ways; what airs is written per airing.
    private async Task<AiTextResult> TryVoice(CancellationToken token)
    {
        ResolvedGeneratedPromo? promo = Preview.Resolve(Template, Channel, Zone);
        if (Preview.Writer is not { } writer || promo?.ScriptJob is not { } job)
        {
            return new AiTextResult(promo?.Script ?? string.Empty, false, "the AI writer isn't available here");
        }

        return await writer.TryAsync(job with { Seed = $"{job.Seed}|try|{++_tries}" }, token);
    }

    private async Task<AiTextResult> TryLayer(GeneratedLayer layer, CancellationToken token)
    {
        ResolvedGeneratedPromo? promo = Preview.Resolve(Template, Channel, Zone);
        int index = Template.Layers.IndexOf(layer);
        if (Preview.Writer is not { } writer || promo is null || !promo.LayerJobs.TryGetValue(index, out AiTextJob? job))
        {
            return new AiTextResult(layer.Text ?? string.Empty, false, "the AI writer isn't available here");
        }

        return await writer.TryAsync(job with { Seed = $"{job.Seed}|try|{++_tries}" }, token);
    }

    // A caption the AI finished writing shows in the preview straight away.
    // A variable image's automatic picture found (or not): redrawn, so it shows.
    private void OnAutomaticImage(SchedularrTV.Service.Images.AutomaticImageRequest request)
    {
        if ((Template.VariableImages ?? []).Any(image => image.Choices.Automatic is not null) && !_life.IsCancellationRequested)
        {
            _ = InvokeAsync(async () =>
            {
                await RefreshStill();
                StateHasChanged();
            });
        }
    }

    private void OnWritten(AiTextJob job, AiTextResult result)
    {
        if (job.Source == GeneratedPromoWriting.Source && result.Written
            && (Template.Layers.Any(layer => layer.Writer is not null) || CuratedPromo.LayerIndex(Template) is not null))
        {
            _ = InvokeAsync(RefreshStill);
        }
    }

    /// <param name="song">Renders with this background song rather than the one the promo would pick; the video then
    /// shows under that song.</param>
    private async Task RenderVideo(string? song)
    {
        _rendering = true;
        _videoMessage = null;
        _videoUrl = null;
        _curationReport = null;
        _videoSong = song;
        try
        {
            if (NeedsClip)
            {
                await Preview.PrepareStandInAsync(Channel, _life.Token);
            }

            IReadOnlyList<UpNextListing> listings = PreviewListings(out _sample);
            GeneratedPromoRender render = await Preview.RenderVideoAsync(GeneratedPromoEditing.Copy(Template), Channel.Name, listings, Zone, _life.Token, song,
                Preview.ImageSubjects(Channel, Template), Preview.VoiceContext(Channel));
            _videoUrl = $"{Preview.FileUrl(render.Path)}?v={DateTime.UtcNow.Ticks}";
            _curationReport = render.Curation;
            _videoMessage = render.VoiceError is { } error
                ? $"The voice-over failed, so this preview is silent: {error.GetBaseException().Message}"
                : null;
        }
        catch (OperationCanceledException) when (_life.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _videoMessage = $"Preview failed: {ex.GetBaseException().Message}";
        }
        finally
        {
            _rendering = false;
        }
    }

    private GeneratedLayerKind RequiredKind => GeneratedPromoKinds.RequiredLayer(Template.Type);

    private Task SetType(GeneratedPromoType type) => Set(() =>
    {
        // New Episode promos are always about a new episode, so they can't be limited to one kind.
        if (type == GeneratedPromoType.NewEpisode)
        {
            Template.Episodes = null;
        }

        // An opener that was only the old type's usual one follows the type; an empty list already does.
        if (Template.Voice is { } voice && PreMessages(voice) is [var only] && only == GeneratedPromoResolver.DefaultPreMessage(Template.Type))
        {
            voice.PreMessages.Clear();
        }

        // The placed show block becomes the new type's block, keeping its position and styling.
        GeneratedLayerKind from = RequiredKind;
        GeneratedLayerKind to = GeneratedPromoKinds.RequiredLayer(type);
        foreach (GeneratedLayer layer in Template.Layers.Where(layer => layer.Kind == from && from != to))
        {
            layer.Kind = to;
            layer.UpNext = to == GeneratedLayerKind.UpNext ? layer.UpNext ?? new GeneratedUpNextOptions() : null;
            layer.Show = GeneratedPromoKinds.IsShowLayer(to) ? GeneratedPromoResolver.DefaultShowOptions(to) : null;
        }

        Template.Type = type;
        if (Template.Layers.FirstOrDefault(layer => layer.Kind == RequiredKind) is { } shown) Select(shown);
    });

    private IReadOnlyList<UpNextListing> PreviewListings(out bool sample) => Preview.Listings(Channel, Template, out sample);

    private static GeneratedShowOptions ShowOptions(GeneratedLayer layer) =>
        layer.Show ??= GeneratedPromoResolver.DefaultShowOptions(layer.Kind);

    private static string TypeName(GeneratedPromoType type) => type switch
    {
        GeneratedPromoType.UpNext => "Up Next",
        GeneratedPromoType.NowPlaying => "Now Playing",
        GeneratedPromoType.ThisHasBeen => "This Has Been",
        GeneratedPromoType.ComingUp => "Coming Up",
        GeneratedPromoType.YoureWatching => "You're Watching",
        GeneratedPromoType.BackToTheShow => "Back to the Show",
        GeneratedPromoType.NewEpisode => "New Episode",
        GeneratedPromoType.RightBack => "We'll Be Right Back",
        _ => "Eventually"
    };

    private static GeneratedUpNextOptions UpNext(GeneratedLayer layer) => layer.UpNext ??= new GeneratedUpNextOptions();

    private static string VoiceId(IReadOnlyList<TtsVoice> list, string voice) =>
        list.Any(option => option.Id == voice)
            ? voice
            : list.FirstOrDefault(option => string.Equals(option.Name, voice, StringComparison.OrdinalIgnoreCase))?.Id ?? voice;

    private static bool Missing(string? path) => !string.IsNullOrWhiteSpace(path) && !File.Exists(path);

    private string FontName(string family) =>
        _fonts.FirstOrDefault(font => string.Equals(font, family, StringComparison.OrdinalIgnoreCase)) ?? family;

    private static string Label(GeneratedLayer layer) => string.IsNullOrWhiteSpace(layer.Name) ? KindName(layer.Kind) : layer.Name;

    private static string KindName(GeneratedLayerKind kind) => kind switch
    {
        GeneratedLayerKind.UpNext => "Up Next text",
        GeneratedLayerKind.NowPlaying => "Now Playing text",
        GeneratedLayerKind.ThisHasBeen => "This Has Been text",
        GeneratedLayerKind.ComingUp => "Coming Up text",
        GeneratedLayerKind.Eventually => "Eventually text",
        GeneratedLayerKind.YoureWatching => "You're Watching text",
        GeneratedLayerKind.BackToTheShow => "Back to the Show text",
        GeneratedLayerKind.NewEpisode => "New Episode text",
        GeneratedLayerKind.RightBack => "Right Back text",
        GeneratedLayerKind.Rect => "Shape",
        _ => kind.ToString()
    };

    private static string Words(object value) =>
        Regex.Replace(value.ToString()!.Replace('_', ' '), "(?<=[a-z])(?=[A-Z0-9])", " ").ToLowerInvariant() is { Length: > 0 } words
            ? char.ToUpperInvariant(words[0]) + words[1..]
            : string.Empty;

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? string.Empty;

    private static string? Optional(ChangeEventArgs e) => string.IsNullOrWhiteSpace(Text(e)) ? null : Text(e).Trim();

    /// <summary>Prefix or suffix text as typed, spaces kept (they separate it from the show); null when empty.</summary>
    private static string? Affix(ChangeEventArgs e) => Text(e).Replace("\r", "") is { Length: > 0 } text ? text : null;

    private static string Number(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    /// <summary>A template-pixel position or size as a percent of the canvas, so boxes follow the canvas at any width.</summary>
    private static string Pct(double value, double of) => $"{(value / Math.Max(1, of) * 100).ToString("0.###", CultureInfo.InvariantCulture)}%";

    /// <summary>
    /// Output size, frame rate and background: under the preview when the canvas is used, or on their own when an
    /// external program makes the video.
    /// </summary>
    private RenderFragment CanvasSettings => @<div class="ed-settings">
        <div class="grid grid-3">
            <label class="field">
                <span>Output size</span>
                <select value="@(CustomSize ? CustomValue : $"{Template.Width}x{Template.Height}")" @onchange="SetSize">
                    @foreach ((int width, int height, string label) in Sizes)
                    {
                        <option value="@($"{width}x{height}")">@label</option>
                    }
                    <option value="@CustomValue">Custom size…</option>
                </select>
            </label>
            <label class="field">
                <span>Frame rate</span>
                <select value="@Template.Fps" @onchange="e => Set(() => Template.Fps = int.Parse(Text(e), CultureInfo.InvariantCulture))">
                    @foreach (int fps in (int[])[24, 25, 30, 60])
                    {
                        <option value="@fps">@fps fps</option>
                    }
                </select>
            </label>
            <div class="field">
                <span>Background colour</span>
                <input type="color" class="ed-colour" aria-label="Background colour" value="@GeneratedPromoEditing.SplitColor(Template.BackgroundColor).Rgb"
                       @onchange="e => Set(() => Template.BackgroundColor = GeneratedPromoEditing.JoinColor(Text(e), 100))" />
            </div>
        </div>
        @if (CustomSize)
        {
            <div class="grid grid-3">
                <label class="field">
                    <span>Width (px)</span>
                    <input type="number" min="16" max="3840" step="2" value="@Template.Width" @onchange="e => SetCustomSize(e, width: true, max: 3840)" />
                </label>
                <label class="field">
                    <span>Height (px)</span>
                    <input type="number" min="16" max="2160" step="2" value="@Template.Height" @onchange="e => SetCustomSize(e, width: false, max: 2160)" />
                </label>
            </div>
        }
        <LowPowerNotice Inline="true" Advice="LowPowerTemplateWarnings" />
        @if (Template.Generator is null)
        {
            @(VariantBar())
            @(VariantSettings())
        }
        <div class="field">
            <span>
                @(Template.BackgroundClip is null || GeneratedPromoResolver.UsesClip(Template.Generator) ? "Background images or videos" : "Fallback background images or videos (when the episode file can't be read)")
                @(EditingVariant is null ? "" : $"for {VariantLabel(_editVariant)}")
                (optional; videos loop; with several, one is picked at random for each promo)
            </span>
            @if (EditingVariant is not null && BackgroundList.Count == 0)
            {
                <p class="hint">This variant has no backgrounds of its own, so it uses @(VariantLabel(null))'s. Add some to give it its own.</p>
            }
            <ol class="song-list background-list">
                @foreach ((string background, int position) in BackgroundList.Select((path, index) => (path, index)))
                {
                    bool previewing = string.Equals(_previewBackground, background, StringComparison.OrdinalIgnoreCase);
                    <li @key="position">
                        <div class="song-row">
                            <FilePathPicker Value="@background" ValueChanged="value => SetBackground(position, value)" KeepCopyIn="@GeneratedPromoPackages.AssetCategory"
                                            Extensions="BackgroundExtensions" Label="background image or video" Placeholder="D:\Media\Promos\Backgrounds\loop.mp4" />
                            @if (BackgroundList.Count > 1 && Template.Generator is null)
                            {
                                <button class="btn btn-sm" type="button" aria-pressed="@(previewing ? "true" : "false")"
                                        title="@(previewing ? "Go back to the background this promo picks" : "Show this background in the canvas preview")"
                                        @onclick="() => PreviewBackground(previewing ? null : background)">
                                    @(previewing ? "Previewing" : "Preview")
                                </button>
                            }
                            <button class="btn btn-sm btn-danger" type="button" aria-label="@($"Remove {Path.GetFileName(background)}")"
                                    @onclick="() => SetBackground(position, null)">Remove</button>
                        </div>
                        @if (Missing(background))
                        {
                            <p class="hint warn">The scheduler can't find this file.</p>
                        }
                        @(RuleEditor(BackgroundRuleSlot(BackgroundHost, background), "Background"))
                    </li>
                }
            </ol>
            <div class="row row-wrap">
                <FilePathPicker Multiple="true" ButtonText="@(BackgroundList.Count == 0 ? "Add a background…" : "Add more backgrounds…")" Extensions="BackgroundExtensions"
                                Label="backgrounds" KeepCopyIn="@GeneratedPromoPackages.AssetCategory" OnPicked="AddBackgrounds" />
                @if (BackgroundList.Count > 1 && Template.Generator is null)
                {
                    <span class="hint" style="margin:0;">@(_previewBackground is null ? "The canvas shows the one these shows would get." : "The canvas shows the one you're previewing.")</span>
                }
            </div>
            @if (BackgroundHost.BackgroundRules is { Count: > 0 })
            {
                <p class="hint">If no background is eligible, the background colour is used@(EditingVariant is null ? "" : ", and this variant isn't picked"). Preview lets you inspect a background regardless of its rule.</p>
            }
        </div>
        @if (BackgroundList.Any(background => !PromoRenderer.IsImage(background)))
        {
            GeneratedBackgroundSoundConfig sound = GeneratedPromoResolver.BackgroundSound(Template);
            <div class="grid grid-3">
                <label class="check template-enabled">
                    <input type="checkbox" checked="@sound.Enabled" @onchange="e => Set(() => EditBackgroundSound().Enabled = e.Value is true)" />
                    <span>Play the background video's sound</span>
                </label>
                @if (sound.Enabled)
                {
                    <label class="field">
                        <span>Background volume: @($"{sound.Volume:P0}")</span>
                        <input type="range" min="0" max="100" value="@Number(sound.Volume * 100)"
                               @onchange="e => SetNumber(e, value => EditBackgroundSound().Volume = Math.Clamp(value / 100, 0, 1))" />
                    </label>
                    <label class="check template-enabled">
                        <input type="checkbox" checked="@sound.DuckUnderVoice" @onchange="e => Set(() => EditBackgroundSound().DuckUnderVoice = e.Value is true)" />
                        <span>Lower it while the voice speaks</span>
                    </label>
                }
            </div>
            @if (sound.Enabled)
            {
                <p class="hint">Videos without a sound track play silently. @(BackgroundList.Any(PromoRenderer.IsImage) ? "Pictures have no sound, so promos that pick one are quiet here." : "")</p>
            }
        }
        <label class="check">
            <input type="checkbox" checked="@(Template.BackgroundClip is not null)"
                   @onchange="e => Set(() => Template.BackgroundClip = e.Value is true ? Template.BackgroundClip ?? new GeneratedClipConfig() : null)" />
            <span>Play a clip from the promoted episode behind the promo</span>
        </label>
        @if (Template.BackgroundClip is { } clip)
        {
            <div class="grid grid-3">
                <label class="field">
                    <span>Start into the episode (s; blank picks a spot in the middle)</span>
                    <input type="number" min="0" step="1" value="@(clip.StartAt is { } clipStart ? Number(clipStart.TotalSeconds) : "")"
                           placeholder="Middle of the episode" @onchange="e => SetOptionalSeconds(e, value => clip.StartAt = value)" />
                </label>
                <label class="check template-enabled">
                    <input type="checkbox" checked="@clip.IncludeAudio" @onchange="e => Set(() => clip.IncludeAudio = e.Value is true)" />
                    <span>Include the episode's sound</span>
                </label>
                @if (clip.IncludeAudio)
                {
                    <label class="field">
                        <span>Episode volume: @($"{clip.Volume:P0}")</span>
                        <input type="range" min="0" max="100" value="@Number(clip.Volume * 100)"
                               @onchange="e => SetNumber(e, value => clip.Volume = Math.Clamp(value / 100, 0, 1))" />
                    </label>
                }
            </div>
            @if (clip.IncludeAudio)
            {
                <label class="check">
                    <input type="checkbox" checked="@clip.DuckUnderVoice" @onchange="e => Set(() => clip.DuckUnderVoice = e.Value is true)" />
                    <span>Lower the episode's sound while the voice speaks</span>
                </label>
            }
            <p class="hint">
                Uses the episode this promo is for (the first show listed on Up Next).
                @(GeneratedPromoResolver.UsesClip(Template.Generator) ? "The program below is handed this clip, so it isn't played behind; only the start time applies." : "")
                @(_sample ? "The preview shows the fallback background until the channel's schedule is built." : "")
            </p>
        }
    </div>;
}
