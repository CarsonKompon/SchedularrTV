    // Each try gets its own seed, so it can be heard several ways; what airs is written per airing.
    private async Task<AiTextResult> TryVoice(CancellationToken token)
    {
        ResolvedGeneratedPromo? promo = Preview.Resolve(Template, Channel, Zone);
        if (Preview.Writer is not { } writer || promo?.ScriptJob is not { } job)
        {
            return new AiTextResult(promo?.Script ?? string.Empty, false, "the AI writer isn't available here");
        }

        return await writer.TryAsync(job with { Seed = $"{job.Seed}|try|{++_tries}" }, token);
    }

    private async Task<AiTextResult> TryLayer(GeneratedLayer layer, CancellationToken token)
    {
        ResolvedGeneratedPromo? promo = Preview.Resolve(Template, Channel, Zone);
        int index = Template.Layers.IndexOf(layer);
        if (Preview.Writer is not { } writer || promo is null || !promo.LayerJobs.TryGetValue(index, out AiTextJob? job))
        {
            return new AiTextResult(layer.Text ?? string.Empty, false, "the AI writer isn't available here");
        }

        return await writer.TryAsync(job with { Seed = $"{job.Seed}|try|{++_tries}" }, token);
    }

    // A caption the AI finished writing shows in the preview straight away.
    private void OnWritten(AiTextJob job, AiTextResult result)
    {
        if (job.Source == GeneratedPromoWriting.Source && result.Written && Template.Layers.Any(layer => layer.Writer is not null))
        {
            _ = InvokeAsync(RefreshStill);
        }
    }

    /// <param name="song">Renders with this background song rather than the one the promo would pick; the video then
    /// shows under that song.</param>
    private async Task RenderVideo(string? song)
    {
        _rendering = true;
        _videoMessage = null;
        _videoUrl = null;
        _videoSong = song;
        try
        {
            if (NeedsClip)
            {
                await Preview.PrepareStandInAsync(Channel, _life.Token);
            }

            IReadOnlyList<UpNextListing> listings = PreviewListings(out _sample);
            GeneratedPromoRender render = await Preview.RenderVideoAsync(GeneratedPromoEditing.Copy(Template), Channel.Name, listings, Zone, _life.Token, song,
                Preview.ImageSubjects(Channel, Template));
            _videoUrl = $"{Preview.FileUrl(render.Path)}?v={DateTime.UtcNow.Ticks}";
            _videoMessage = render.VoiceError is { } error
                ? $"The voice-over failed, so this preview is silent: {error.GetBaseException().Message}"
                : null;
        }
        catch (OperationCanceledException) when (_life.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _videoMessage = $"Preview failed: {ex.GetBaseException().Message}";
        }
        finally
        {
            _rendering = false;
        }
    }

    private GeneratedLayerKind RequiredKind => GeneratedPromoKinds.RequiredLayer(Template.Type);

    private Task SetType(GeneratedPromoType type) => Set(() =>
    {
        // An opener that was only the old type's usual one follows the type; an empty list already does.
        if (Template.Voice is { } voice && PreMessages(voice) is [var only] && only == GeneratedPromoResolver.DefaultPreMessage(Template.Type))
        {
            voice.PreMessages.Clear();
        }

        // The placed show block becomes the new type's block, keeping its position and styling.
        GeneratedLayerKind from = RequiredKind;
        GeneratedLayerKind to = GeneratedPromoKinds.RequiredLayer(type);
        foreach (GeneratedLayer layer in Template.Layers.Where(layer => layer.Kind == from && from != to))
        {
            layer.Kind = to;
            layer.UpNext = to == GeneratedLayerKind.UpNext ? layer.UpNext ?? new GeneratedUpNextOptions() : null;
            layer.Show = GeneratedPromoKinds.IsShowLayer(to) ? GeneratedPromoResolver.DefaultShowOptions(to) : null;
        }

        Template.Type = type;
        if (Template.Layers.FirstOrDefault(layer => layer.Kind == RequiredKind) is { } shown) Select(shown);
    });

