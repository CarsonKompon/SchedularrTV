    protected override void OnInitialized()
    {
        _fonts = PromoFonts.Installed();
        if (Preview.Writer is { } writer)
        {
            writer.Written += OnWritten;
        }

        if (Preview.AutomaticImages is { } automatic)
        {
            automatic.Fetched += OnAutomaticImage;
        }

        _layer =Template.Layers.FirstOrDefault(layer => layer.Kind == GeneratedPromoKinds.RequiredLayer(Template.Type)) ?? Template.Layers.FirstOrDefault();
        if (_layer is not null) _chosen.Add(_layer);
        _time = SnapToFrame(Math.Min(2, Template.Duration.TotalSeconds));
        _ = RefreshStill();
        _ = PrepareStandIn();
    }

    protected override void OnParametersSet()
    {
        // A variant that's gone (the template was swapped or reloaded) goes back to the default look.
        if (_editVariant is not null && Template.Variant(_editVariant) is null)
        {
            _editVariant = null;
        }

        if (_layer is not null && !Template.Layers.Contains(_layer))
        {
            _layer = Template.Layers.FirstOrDefault();
        }

        PruneSelection();
        _ = LoadVoices();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Template.Generator is not null)
        {
            // The canvas is gone; its frame (and zooming) are put back when it returns.
            _shownStill = null;
            _zoomWired = false;
            return;
        }

        // Once, as soon as the canvas is on the page (it isn't while an external program makes the video).
        if (_canvasPixels <= 0)
        {
            await MeasureCanvas();
        }

        if (!_zoomWired)
        {
            _zoomWired = await SetUpZoom();
        }

        // A frame drawn before the canvas was on the page (or before it came back).
        if (_still is not null && !ReferenceEquals(_still, _shownStill) && !_stillRunning)
        {
            await ShowStill();
        }
    }

    public void Dispose()
    {
        if (Preview.Writer is { } writer)
        {
            writer.Written -= OnWritten;
        }

        if (Preview.AutomaticImages is { } automatic)
        {
            automatic.Fetched -= OnAutomaticImage;
        }

        _life.Cancel();
        _life.Dispose();
    }

    private async Task Commit()
    {
        await Changed.InvokeAsync();
        _ = RefreshStill();
        _ = PrepareStandIn();
    }

    // Video layers playing an episode need one to preview with too.
    private bool NeedsClip => Template.BackgroundClip is not null || GeneratedPromoResolver.UsesClip(Template.Generator)
        || Template.Layers.Any(layer => layer is { Kind: GeneratedLayerKind.Video, Video.Episode: not null });

