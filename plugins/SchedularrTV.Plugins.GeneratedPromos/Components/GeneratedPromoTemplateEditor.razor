                <label class="check template-enabled">
                    <input type="checkbox" checked="@clip.IncludeAudio" @onchange="e => Set(() => clip.IncludeAudio = e.Value is true)" />
                    <span>Include the episode's sound</span>
                </label>
                @if (clip.IncludeAudio)
                {
                    <label class="field">
                        <span>Episode volume: @($"{clip.Volume:P0}")</span>
                        <input type="range" min="0" max="100" value="@Number(clip.Volume * 100)"
                               @onchange="e => SetNumber(e, value => clip.Volume = Math.Clamp(value / 100, 0, 1))" />
                    </label>
                }
            </div>
            @if (clip.IncludeAudio)
            {
                <label class="check">
                    <input type="checkbox" checked="@clip.DuckUnderVoice" @onchange="e => Set(() => clip.DuckUnderVoice = e.Value is true)" />
                    <span>Lower the episode's sound while the voice speaks</span>
                </label>
            }
            <p class="hint">
                Uses the episode this promo is for (the first show listed on Up Next).
                @(GeneratedPromoResolver.UsesClip(Template.Generator) ? "The program below is handed this clip, so it isn't played behind; only the start time applies." : "")
                @(_sample ? "The preview shows the fallback background until the channel's schedule is built." : "")
            </p>
        }
    </div>;
}
