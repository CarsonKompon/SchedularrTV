@* One generated promo template: settings, voice, music, and a layer canvas drawn by the real renderer. *@
@using System.Globalization
@using System.Text.RegularExpressions
@implements IDisposable
@inject GeneratedPromoPreview Preview
@inject TextToSpeechCatalog Voices
@inject ConfigEditor Editor
@inject IJSRuntime JS
@inject IEnumerable<IMusicLibrary> MusicLibraries
@inject GeneratorSetup Setup

<div class="card promo-template visual-editor">
    <div class="card-head">
        <h2>@(string.IsNullOrWhiteSpace(Template.Name) ? "Untitled template" : Template.Name)</h2>
        @if (!Template.Enabled)
        {
            <span class="pill pill-muted">off</span>
        }
        <div class="spacer"></div>
        <button class="btn btn-sm btn-danger" type="button" @onclick="OnRemove">Delete template</button>
    </div>

    @if (Errors.Count > 0)
    {
        <div class="banner banner-error" role="alert">
            <ul>
                @foreach (string error in Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="grid grid-3">
        <label class="field">
            <span>Name</span>
            <input type="text" value="@Template.Name" @onchange="e => Set(() => Template.Name = Text(e))" />
        </label>
        <label class="field">
            <span>Promo type</span>
            <select value="@Template.Type" @onchange="e => SetType(Enum.Parse<GeneratedPromoType>(Text(e)))">
                @foreach (GeneratedPromoType type in Enum.GetValues<GeneratedPromoType>())
                {
                    <option value="@type">@TypeName(type)</option>
                }
            </select>
        </label>
        <label class="field">
            <span>Length (seconds)</span>
            <input type="number" min="1" max="120" step="0.5" value="@Number(Template.Duration.TotalSeconds)"
                   @onchange="e => SetSeconds(e, value => Template.Duration = value, min: 1)" />
        </label>
        <label class="field">
            <span>When to use</span>
            <select value="@Template.Usage" @onchange="e => Set(() => Template.Usage = Enum.Parse<GeneratedPromoUsage>(Text(e)))">
                <option value="@GeneratedPromoUsage.Fallback">Only when a show has no promo clip</option>
                <option value="@GeneratedPromoUsage.Mixed">Also mixed in with real clips</option>
            </select>
        </label>
        @if (Template.Usage == GeneratedPromoUsage.Mixed)
        {
            <label class="field">
                <span>Chance over a real clip (%)</span>
                <input type="number" min="0" max="100" step="5" value="@Number(Template.MixChance * 100)"
                       @onchange="e => SetNumber(e, value => Template.MixChance = Math.Clamp(value, 0, 100) / 100)" />
            </label>
        }
        <label class="field">
            <span>Video made with</span>
            <select value="@(Template.Generator is null ? CanvasMode : GeneratorMode)" @onchange="SetMadeWith">
                <option value="@CanvasMode">The canvas editor</option>
                <option value="@GeneratorMode">An external program or script</option>
            </select>
        </label>
        <label class="check template-enabled">
            <input type="checkbox" checked="@Template.Enabled" @onchange="e => Set(() => Template.Enabled = e.Value is true)" />
            <span>Template enabled</span>
        </label>
    </div>

    <label class="field">
        <span>Count upcoming programmes by</span>
        <select value="@Template.UpcomingGrouping" @onchange="e => Set(() => Template.UpcomingGrouping = Enum.Parse<GeneratedUpcomingGrouping>(Text(e)))">
            <option value="@GeneratedUpcomingGrouping.Timeslot">Timeslot / episode (follow the channel's slots)</option>
            <option value="@GeneratedUpcomingGrouping.Show">Show (group consecutive slots of the same show)</option>
        </select>
    </label>
    <p class="hint">Shared by Up Next text, variable images, voice-over, external generators, and background rules. Timeslot / episode counts episodes packed into one channel slot together; when packing is disabled, each episode counts separately. Mid-roll segments never count as new programmes.</p>

    <details class="ed-plain">
        <summary>Promo availability · @(Template.Availability?.TimeRange is { } summaryHours ? $"{BackgroundTime(summaryHours.Start)}–{BackgroundTime(summaryHours.End)}" : "any time") · @(Template.Availability?.DateRange is { } summaryDates ? $"{summaryDates.Start} through {summaryDates.End} each year" : "all year")</summary>
        <p class="hint">Controls whether this entire template can be selected, using the promo's scheduled start in @Zone.Id. When both restrictions are enabled, both must match. Previewing remains available outside these ranges.</p>
        <label class="check">
            <input type="checkbox" checked="@(Template.Availability?.TimeRange is not null)" @onchange="e => TogglePromoAvailability(time: true, e.Value is true)" />
            <span>Only use this promo during a daily time range</span>
        </label>
        @if (Template.Availability?.TimeRange is { } availableHours)
        {
            <div class="grid grid-2">
                <label class="field">
                    <span>From (inclusive)</span>
                    <input type="time" step="60" value="@BackgroundTime(availableHours.Start)" @onchange="e => SetBackgroundTime(e, value => availableHours.Start = value)" />
                </label>
                <label class="field">
                    <span>Until (exclusive)</span>
                    <input type="time" step="60" value="@BackgroundTime(availableHours.End)" @onchange="e => SetBackgroundTime(e, value => availableHours.End = value)" />
                </label>
            </div>
            <p class="hint">An earlier end crosses midnight (for example 22:00–06:00). Start and end must differ.</p>
        }
        <label class="check">
            <input type="checkbox" checked="@(Template.Availability?.DateRange is not null)" @onchange="e => TogglePromoAvailability(time: false, e.Value is true)" />
            <span>Only use this promo during a recurring date range</span>
        </label>
        @if (Template.Availability?.DateRange is { } availableDates)
        {
            <div class="grid grid-2">
                @foreach (bool start in new[] { true, false })
                {
                    string date = start ? availableDates.Start : availableDates.End;
                    <div class="field">
                        <span>@(start ? "First day (inclusive)" : "Last day (inclusive)")</span>
                        <div class="row">
                            <select aria-label="@(start ? "Start month" : "End month")" value="@AvailabilityDatePart(date, month: true)"
                                    @onchange="e => SetAvailabilityDate(availableDates, start, month: true, e)">
                                @for (int month = 1; month <= 12; month++)
                                {
                                    <option value="@month">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                                }
                            </select>
                            <input type="number" aria-label="@(start ? "Start day" : "End day")" min="1" max="31" value="@AvailabilityDatePart(date, month: false)"
                                   @onchange="e => SetAvailabilityDate(availableDates, start, month: false, e)" />
                        </div>
                    </div>
                }
            </div>
            <p class="hint">Repeats every year. December 1–31 covers Christmas season; December 20–January 5 crosses New Year. Use the same date at both ends for a single day. February 29 is eligible only in leap years.</p>
        }
        @if (Template.Availability is not null && !GeneratedPromoEligibility.IsAvailable(Template, Preview.Now, Zone))
        {
            <p class="hint warn">Outside this template's availability right now. It can still be previewed, but won't be selected for airings outside its ranges.</p>
        }
    </details>

    <VariableImagesEditor Template="Template" Changed="Commit" />

    @if (Template.Generator is { } generator)
    {
        <div class="ed-plain">
            <h3 class="ed-section">Canvas</h3>
            @CanvasSettings
        </div>

        <h3 class="ed-section">External program</h3>
        <div class="generator" aria-label="External generator">
            <p class="hint">
                The program draws the video; the voice-over and music are then mixed on top. Its video is scaled to fit the
                output size over the background above, so a transparent video (.mov or .webm) shows the background or
                episode clip through it. It's held on its last frame if shorter than the promo and cut if longer.
            </p>
            <div class="grid grid-2">
                <label class="field">
                    <span>Program</span>
                    <input type="text" value="@generator.Command" placeholder="node" @onchange="e => Set(() => generator.Command = Text(e).Trim())" />
                </label>
                <div class="field">
                    <span>Run in folder</span>
                    <FilePathPicker Value="@generator.WorkingDirectory" ValueChanged="value => Set(() => generator.WorkingDirectory = value)"
                                    PickFolder="true" Extensions="NoExtensions" Label="the generator's folder" StartIn="Environment.SpecialFolder.MyDocuments"
                                    Placeholder="D:\Media\Promo Generators\My Generator" />
                </div>
            </div>
            <div class="grid grid-2">
                <label class="field">
                    <span>First-time setup (optional; runs once in that folder before it's first used, e.g. npm install)</span>
                    <input type="text" value="@generator.SetupCommand" placeholder="npm install" spellcheck="false"
                           @onchange="e => Set(() => generator.SetupCommand = Optional(e)?.Trim())" />
                </label>
                @if (GeneratorSetup.Needs(generator))
                {
                    <div class="field">
                        <span>Setup</span>
                        <div class="row row-wrap" style="gap:8px;align-items:center;">
                            <span class="hint" style="margin:0;">
                                @(_settingUp ? "Running…" : Setup.DoneAt(generator) is { } setUpAt ? $"Done {setUpAt.ToLocalTime():g}" : "Not run yet")
                            </span>
                            <button class="btn btn-sm" type="button" disabled="@_settingUp" @onclick="() => RunSetup(generator)">
                                @(Setup.DoneAt(generator) is null ? "Run it now" : "Run it again")
                            </button>
                        </div>
                        @if (_setupProblem is not null)
                        {
                            <p class="hint warn" role="alert">@_setupProblem</p>
                        }
                    </div>
                }
            </div>
            <label class="field">
                <span>Arguments (one per line; {shows} and {clip_arguments} expand to the lists below)</span>
                <textarea rows="5" spellcheck="false" @onchange="e => Set(() => generator.Arguments = Lines(e))">@string.Join('\n', generator.Arguments)</textarea>
            </label>
            <div class="grid grid-2">
                <label class="field">
                    <span>For each show (one per line)</span>
                    <textarea rows="4" spellcheck="false" @onchange="e => Set(() => generator.PerShow = Lines(e))">@string.Join('\n', generator.PerShow)</textarea>
                </label>
                <label class="field">
                    <span>When there's an episode clip (one per line; {clip} and {clip_start} work without playing it behind)</span>
                    <textarea rows="4" spellcheck="false" @onchange="e => Set(() => generator.ClipArguments = Lines(e))">@string.Join('\n', generator.ClipArguments)</textarea>
                </label>
            </div>
            <div class="grid grid-4">
                @if (Template.Type == GeneratedPromoType.UpNext)
                {
                    <label class="field">
                        <span>Shows passed</span>
                        <input type="number" min="1" max="10" value="@generator.Shows"
                               @onchange="e => SetNumber(e, value => generator.Shows = (int)Math.Clamp(value, 1, 10))" />
                    </label>
                }
                <label class="field">
                    <span>{output} file type</span>
                    <select value="@generator.OutputExtension" @onchange="e => Set(() => generator.OutputExtension = Text(e))">
                        @foreach (string extension in (string[])[".mp4", ".mov", ".webm", ".mkv"])
                        {
                            <option value="@extension">@extension</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Give up after (s)</span>
                    <input type="number" min="5" max="1800" step="5" value="@Number(generator.Timeout.TotalSeconds)"
                           @onchange="e => SetSeconds(e, value => generator.Timeout = value, min: 5)" />
                </label>
                <label class="check template-enabled">
                    <input type="checkbox" checked="@generator.KeepAudio" @onchange="e => Set(() => generator.KeepAudio = e.Value is true)" />
                    <span>Keep its sound</span>
                </label>
            </div>
            @if (generator.KeepAudio)
            {
                <div class="grid grid-2">
                    <label class="field">
                        <span>Its volume: @($"{generator.Volume:P0}")</span>
                        <input type="range" min="0" max="100" value="@Number(generator.Volume * 100)"
                               @onchange="e => SetNumber(e, value => generator.Volume = Math.Clamp(value / 100, 0, 1))" />
                    </label>
                    <label class="check template-enabled">
                        <input type="checkbox" checked="@generator.DuckUnderVoice" @onchange="e => Set(() => generator.DuckUnderVoice = e.Value is true)" />
                        <span>Lower it while the voice speaks</span>
                    </label>
                </div>
            }
            <details class="generator-tokens">
                <summary>Placeholders</summary>
                <ul>
                    @foreach ((string token, string meaning) in GeneratedPromoResolver.GeneratorTokens)
                    {
                        <li><code>@token</code> @meaning</li>
                    }
                </ul>
                <p class="hint">
                    Show placeholders use the first show, or each show inside "For each show". If {output} isn't used, the
                    program must print the finished file's full path as its last line.
                </p>
            </details>
            <p class="hint">
                @(PreviewIsSample ? "With sample shows" : "With this channel's next shows"), it runs:
            </p>
            <pre class="generator-command">@CommandPreview()</pre>
        </div>
    }
    else
    {
    <div class="ed-workspace">
        <div class="ed-stage">
            <div class="ed-toolbar">
                <span class="ed-toolbar-label">Add</span>
                <button class="btn btn-sm" type="button" @onclick="() => AddLayer(RequiredKind)">+ @KindName(RequiredKind)</button>
                <button class="btn btn-sm" type="button" @onclick="() => AddLayer(GeneratedLayerKind.Text)">+ Text</button>
                <button class="btn btn-sm" type="button" @onclick="() => AddLayer(GeneratedLayerKind.Rect)">+ Shape</button>
                <button class="btn btn-sm" type="button" @onclick="() => AddLayer(GeneratedLayerKind.Image)">+ Image</button>
                <button class="btn btn-sm" type="button" @onclick="() => AddLayer(GeneratedLayerKind.Video)">+ Video</button>
                <span class="ed-toolbar-label" style="margin-left:8px;">Tool</span>
                <button class="btn btn-sm @(_pinTool ? "btn-primary" : "")" type="button" aria-pressed="@(_pinTool ? "true" : "false")"
                        title="Drag the selected layer's corners for a perspective look, like text on the side of a building (P)"
                        @onclick="() => _pinTool = !_pinTool">⬚ Perspective</button>
                <div class="spacer"></div>
                <span class="ed-meta">@Template.Width × @Template.Height</span>
            </div>
            @if (_editBackground is { } editingBackground)
            {
                <div class="banner ed-placing" role="status">
                    <div>
                        <strong>Placing layers for @Path.GetFileName(editingBackground)</strong>
                        <span class="hint" style="margin:0;display:block;">
                            Moving, resizing, opacity, keyframes, colour, and when layers appear, leave and how they animate in and out now change this background only (⌖ marks layers set for it;
                            @GeneratedPromoEditing.PlacedCount(Template, editingBackground) so far). Everything else still applies to every background.
                        </span>
                    </div>
                    <div class="spacer"></div>
                    <button class="btn btn-sm btn-primary" type="button" @onclick="() => EditBackground(null)">Done</button>
                </div>
            }
            @if (!Template.Layers.Any(layer => layer.Kind == RequiredKind))
            {
                @* Optional: a template can show the shows with variable images alone. *@
                <p class="hint">
                    No “@KindName(RequiredKind)” block, so the show's name isn't written on screen
                    @(Template.Layers.Any(layer => !string.IsNullOrWhiteSpace(layer.VariableImage)) ? "(its variable images show it)" : "")
                    — fine if that's intended.
                    <button class="btn btn-sm" type="button" @onclick="() => AddLayer(RequiredKind)">Add one</button>
                </p>
            }
            @* Ctrl + wheel zooms about the pointer and the middle button pans; script moves the canvas inside this frame. *@
            <div class="ed-viewport" id="@_viewportId">
            <span class="ed-zoom-badge" aria-hidden="true"></span>
            <div class="ed-canvas" id="@_canvasId" role="group" aria-label="Promo canvas" @onpointerenter="MeasureCanvas"
                 style="aspect-ratio:@(Template.Width) / @(Template.Height);">
                @* The preview frame. Script swaps it in only once the next frame has decoded, so it never blanks between frames;
                   the renderer leaves this element alone (nothing about it changes between renders). *@
                <div class="ed-still" id="@_stillId" aria-hidden="true"></div>
                @foreach (GeneratedLayer layer in Template.Layers)
                {
                    bool isSelected = ReferenceEquals(layer, _layer);
                    bool inSelection = _chosen.Contains(layer);
                    // Where it ends up on the canvas, inside whatever groups it's in: its middle, size and total turn.
                    WorldBox box = GeneratedPromoHierarchy.World(Template, layer, Pose, Time);
                    bool placedHere = PlacedHere(layer);
                    bool isGroupBox = GeneratedPromoHierarchy.IsGroup(layer);
                    // A pinned box is outlined by its pinned shape (drawn below) rather than its square.
                    bool pinned = IsPinned(layer);
                    // Locked: clicks go straight through it to what's underneath.
                    bool locked = IsLocked(layer);
                    <div class="layer-box @(isSelected ? "selected" : inSelection ? "chosen" : "") @(VisibleAt(layer) ? "" : "hidden-now") @(GeneratedPromoEditing.HasKeyframes(Pose(layer)) ? "keyed" : "") @(placedHere ? "placed" : "") @(isGroupBox ? "group" : "") @(pinned ? "pinned" : "") @(locked ? "locked" : "")" @key="layer"
                         style="left:@Pct(box.CenterX - box.Width / 2, Template.Width);top:@Pct(box.CenterY - box.Height / 2, Template.Height);width:@Pct(box.Width, Template.Width);height:@Pct(box.Height, Template.Height);@(Math.Abs(box.Angle) > 0.001 ? $"transform:rotate({Number(box.Angle)}deg);" : "")"
                         title="@layer.Name" @onpointerdown="e => StartDrag(e, layer, Move)" @onpointerdown:preventDefault="true">
                        <span class="layer-tag">@(locked ? "🔒 " : "")@(isGroupBox ? "▣ " : "")@(GeneratedPromoEditing.HasKeyframes(Pose(layer)) ? "◆ " : "")@(placedHere ? "⌖ " : "")@Label(layer)</span>
                        @if (isSelected && !_pinTool && !locked)
                        {
                            // A group's box is only what it turns about, so it's moved and turned rather than stretched.
                            @foreach (string handle in isGroupBox ? [] : Handles)
                            {
                                <span class="handle handle-@handle" aria-hidden="true" @onpointerdown="e => StartDrag(e, layer, handle)"
                                      @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true"></span>
                            }
                            <span class="handle handle-rotate" title="Drag to turn it (hold Shift for 15° steps)" aria-hidden="true"
                                  @onpointerdown="e => StartRotate(e, layer)" @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true"></span>
                        }
                    </div>
                }
                @* Pinned layers' shapes, and with the Perspective tool, the selected layer's four corners to drag. In the
                   template's own pixels, so they line up with the frame however wide the canvas is drawn. *@
                <svg class="ed-quads" viewBox="0 0 @Template.Width @Template.Height" preserveAspectRatio="none" aria-hidden="true">
                    @foreach (GeneratedLayer layer in Template.Layers)
                    {
                        bool showQuad = IsPinned(layer) || (_pinTool && ReferenceEquals(layer, _layer));
                        if (showQuad)
                        {
                            <polygon class="ed-quad @(ReferenceEquals(layer, _layer) ? "selected" : "")" points="@QuadPoints(layer)" />
                        }
                    }
                    @if (_pinTool && _layer is { } pinning && !IsLocked(pinning))
                    {
                        (double X, double Y)[] corners = GeneratedPromoHierarchy.WorldQuad(Template, pinning, Pose, Time);
                        double radius = 7 / Math.Max(0.01, Scale);
                        for (int corner = 0; corner < 4; corner++)
                        {
                            int which = corner;
                            <circle class="ed-pin" cx="@Number(corners[which].X)" cy="@Number(corners[which].Y)" r="@Number(radius)"
                                    @onpointerdown="e => StartPin(e, pinning, which)" @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true">
                                <title>@PinCornerNames[which] corner: drag it</title>
                            </circle>
                        }
                    }
                </svg>
                @if (_drag is not null && _snapX)
                {
                    <div class="snap-guide snap-guide-x" aria-hidden="true"></div>
                }
                @if (_drag is not null && _snapY)
                {
                    <div class="snap-guide snap-guide-y" aria-hidden="true"></div>
                }
            </div>
            </div>
            <div class="ed-viewport-bar">
                <span class="hint" style="margin:0;">Ctrl + scroll to zoom in for precise edits, middle-drag to pan.</span>
                <div class="spacer"></div>
                <button class="btn btn-sm" type="button" title="Show the whole frame again (Ctrl + 0)" @onclick="ResetZoom">Fit</button>
            </div>
            <div class="ed-timeline">
                <div class="ed-timeline-head">
                    <div class="ed-frame-step" role="group" aria-label="Step through frames">
                        <button class="btn btn-sm" type="button" title="Back a second (Shift+←)" aria-label="Back a second" @onclick="() => StepFrames(-Fps)">«</button>
                        <button class="btn btn-sm" type="button" title="Previous frame (← or ,)" aria-label="Previous frame" @onclick="() => StepFrames(-1)">‹</button>
                        <button class="btn btn-sm" type="button" title="Next frame (→ or .)" aria-label="Next frame" @onclick="() => StepFrames(1)">›</button>
                        <button class="btn btn-sm" type="button" title="Forward a second (Shift+→)" aria-label="Forward a second" @onclick="() => StepFrames(Fps)">»</button>
                    </div>
                    <span>
                        <strong>@($"{_time:0.000}")s</strong> of @($"{DurationSeconds:0.#}")s
                        <span class="ed-meta">· frame @(CurrentFrame + 1) of @FrameCount</span>
                    </span>
                    <div class="spacer"></div>
                    @if (_layer is { } timedLayer)
                    {
                        <span class="ed-meta">@Label(timedLayer)@(Pose(timedLayer).Keyframes is { Count: > 0 } timedKeys ? $" · {timedKeys.Count} keyframe{(timedKeys.Count == 1 ? "" : "s")}" : "")@(PlacedHere(timedLayer) ? " · placed for this background" : "")</span>
                    }
                </div>
                <div class="ed-ruler" id="@_rulerId" role="slider" tabindex="0" aria-label="Preview time" aria-valuemin="0"
                     aria-valuemax="@Number(DurationSeconds)" aria-valuenow="@Number(_time)" aria-valuetext="@($"{_time:0.00} seconds")"
                     @onpointerdown="StartScrub" @onpointerdown:preventDefault="true" @onkeydown="RulerKey">
                    @foreach (double tick in Ticks())
                    {
                        <span class="ed-tick @(tick > DurationSeconds * 0.92 ? "ed-tick-end" : "")" style="left:@Pct(tick, DurationSeconds)"><span>@Number(tick)s</span></span>
                    }
                    @if (_layer is { } spanLayer)
                    {
                        IGeneratedTiming spanTiming = Timing(spanLayer);
                        double spanStart = spanTiming.Start.TotalSeconds;
                        double spanEnd = Math.Min(DurationSeconds, (spanTiming.End ?? Template.Duration).TotalSeconds);
                        <span class="ed-span" style="left:@Pct(spanStart, DurationSeconds);width:@Pct(Math.Max(0, spanEnd - spanStart), DurationSeconds)"></span>
                        GeneratedKeyframe? currentFrame = CurrentKeyframe;
                        @foreach (GeneratedKeyframe frame in Pose(spanLayer).Keyframes ?? [])
                        {
                            <span class="ed-key @(ReferenceEquals(frame, currentFrame) ? "current" : "") @($"ease-{frame.Easing.ToString().ToLowerInvariant()}")" @key="frame"
                                  style="left:@Pct(frame.At.TotalSeconds, DurationSeconds)"
                                  title="@($"Keyframe at {frame.At.TotalSeconds:0.00}s, then {EasingName(frame.Easing).ToLowerInvariant()}. Drag to move it.")"
                                  @onpointerdown="e => StartKeyDrag(e, spanLayer, frame)" @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true"></span>
                        }
                    }
                    <span class="ed-playhead" style="left:@Pct(_time, DurationSeconds)"></span>
                </div>
                @if (_layer is { } keyLayer)
                {
                    <div class="ed-keybar" aria-label="Keyframes">
                        @if (!GeneratedPromoEditing.HasKeyframes(Pose(keyLayer)))
                        {
                            <button class="btn btn-sm" type="button" @onclick="() => StartKeyframes(keyLayer)"
                                    title="Animate this layer's position, size and opacity by setting them at different times">◆ Animate with keyframes</button>
                            <span class="hint">Starts with a keyframe here; move the time and drag the box to add more.</span>
                        }
                        else
                        {
                            <button class="btn btn-sm" type="button" title="Previous keyframe" aria-label="Previous keyframe"
                                    disabled="@(NextKeyframe(keyLayer, -1) is null)" @onclick="() => GoToKeyframe(keyLayer, -1)">◀</button>
                            @if (CurrentKeyframe is { } key)
                            {
                                <label class="ed-keyfield">
                                    <span>At (s)</span>
                                    <input type="number" min="0" max="@Number(DurationSeconds)" step="0.05" value="@Number(key.At.TotalSeconds)"
                                           @onchange="e => SetKeyframeTime(e, keyLayer, key)" />
                                </label>
                                <label class="ed-keyfield">
                                    <span>Then</span>
                                    <select value="@key.Easing" title="How it moves on to the next keyframe"
                                            @onchange="e => SetEasing(keyLayer, key, Enum.Parse<GeneratedEasing>(Text(e)))">
                                        @foreach (GeneratedEasing easing in Enum.GetValues<GeneratedEasing>())
                                        {
                                            <option value="@easing">@EasingName(easing)</option>
                                        }
                                    </select>
                                </label>
                                <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveKeyframe(keyLayer, key)">Delete keyframe</button>
                            }
                            else
                            {
                                <button class="btn btn-sm" type="button" @onclick="() => AddKeyframe(keyLayer)">◆ Add keyframe at @($"{_time:0.00}")s</button>
                            }
                            <button class="btn btn-sm" type="button" title="Next keyframe" aria-label="Next keyframe"
                                    disabled="@(NextKeyframe(keyLayer, 1) is null)" @onclick="() => GoToKeyframe(keyLayer, 1)">▶</button>
                            <div class="spacer"></div>
                            <button class="btn btn-sm" type="button" title="Remove every keyframe, leaving the layer where it is now"
                                    @onclick="() => StopKeyframes(keyLayer)">Stop animating</button>
                        }
                    </div>
                }
            </div>
            <p class="hint">
                @(_sample ? "Showing sample shows; once the channel's schedule is built, its real shows are used." : "Showing this channel's real shows.")
                Drag along the timeline to scrub the preview. Drag a box to move it, or a handle to resize it; it snaps to the centre lines unless you hold Alt.
                Dashed boxes are hidden at this time. On an animated layer (◆), moving or resizing it sets a keyframe at the current time.
            </p>
            @if (_stillError is not null)
            {
                <p class="hint warn" role="alert">Preview failed: @_stillError</p>
            }

            <h3 class="ed-section">Canvas</h3>
            @CanvasSettings
        </div>

        <div class="ed-side">
            <h3 class="ed-section">Layers <span class="ed-meta">top first</span></h3>
            <div class="layer-actions">
                <span class="ed-meta">@(_chosen.Count > 1 ? $"{_chosen.Count} selected" : "Ctrl or Shift + click to select several")</span>
                <div class="spacer"></div>
                <button class="btn btn-sm" type="button" disabled="@(_chosen.Count == 0)" title="Put the selected layers in a group, which can then be moved, turned, faded and animated as one"
                        @onclick="GroupChosen">Group</button>
                @if (_layer is { Kind: GeneratedLayerKind.Group } openGroup)
                {
                    <button class="btn btn-sm" type="button" title="Take the layers out of this group and remove it (its own animation goes with it)"
                            @onclick="() => Ungroup(openGroup)">Ungroup</button>
                }
                @if (_chosen.Count > 1)
                {
                    <button class="btn btn-sm btn-danger" type="button" @onclick="RemoveChosen">Delete @_chosen.Count</button>
                }
            </div>
            <ol class="layer-list layer-tree @(_listDrag is null ? "" : "dragging")" aria-label="Layers">
                @foreach ((GeneratedLayer layer, int depth) in GeneratedPromoHierarchy.Rows(Template, IsOpen))
                {
                    bool rowGroup = GeneratedPromoHierarchy.IsGroup(layer);
                    string drop = ReferenceEquals(_dropOn, layer) ? $"drop-{_dropWhere.ToString().ToLowerInvariant()}" : "";
                    <li class="layer-row @(ReferenceEquals(layer, _layer) ? "selected" : "") @(_chosen.Contains(layer) ? "chosen" : "") @drop" @key="layer"
                        style="padding-left:@(depth * 16)px" draggable="true"
                        @ondragstart="() => StartListDrag(layer)" @ondragend="EndListDrag"
                        @ondragover="e => ListDragOver(e, layer)" @ondragover:preventDefault="true"
                        @ondrop="e => ListDrop(e, layer)" @ondrop:preventDefault="true">
                        @if (rowGroup)
                        {
                            <button type="button" class="layer-twisty" aria-label="@(IsOpen(layer) ? "Fold" : "Unfold") @Label(layer)"
                                    @onclick="() => ToggleOpen(layer)">@(IsOpen(layer) ? "▾" : "▸")</button>
                        }
                        else
                        {
                            <span class="layer-twisty" aria-hidden="true"></span>
                        }
                        <button type="button" class="layer-select" aria-pressed="@(_chosen.Contains(layer) ? "true" : "false")"
                                @onclick="e => ClickRow(e, layer)">
                            <span>@(rowGroup ? "▣ " : "")@Label(layer)</span>
                            <small>@(rowGroup ? $"{GeneratedPromoHierarchy.Children(Template, layer).Count} inside" : KindName(layer.Kind))</small>
                        </button>
                        @{
                            bool lockedByGroup = !layer.Locked && IsLocked(layer);
                        }
                        <button class="layer-lock @(layer.Locked ? "on" : lockedByGroup ? "inherited" : "")" type="button"
                                aria-pressed="@(layer.Locked ? "true" : "false")" aria-label="@(layer.Locked ? "Unlock" : "Lock") @Label(layer)"
                                title="@(layer.Locked ? "Unlock: it can be picked and moved on the canvas again" : lockedByGroup ? "Locked by its group" : "Lock: it can't be picked or moved on the canvas (still editable here)")"
                                @onclick="() => ToggleLock(layer)">@(layer.Locked || lockedByGroup ? "🔒" : "🔓")</button>
                        <button class="btn btn-sm" type="button" title="Bring forward" aria-label="Bring @Label(layer) forward"
                                @onclick="() => StepLayer(layer, 1)">↑</button>
                        <button class="btn btn-sm" type="button" title="Send backward" aria-label="Send @Label(layer) backward"
                                @onclick="() => StepLayer(layer, -1)">↓</button>
                    </li>
                }
            </ol>
            @if (Template.Layers.Count == 0)
            {
                <p class="hint">No layers yet. Add one above the canvas.</p>
            }
            else
            {
                <p class="hint">Drag layers to reorder them, or onto a group to put them inside it; dropping between rows of a group's layers puts it in there too.</p>
            }

            @if (_layer is { } selected)
            {
                <div class="inspector" aria-label="Layer settings">
                    <div class="inspector-head">
                        <h3 class="ed-section">@KindName(selected.Kind)</h3>
                        <div class="spacer"></div>
                        <button class="btn btn-sm" type="button" @onclick="() => DuplicateLayer(selected)">Duplicate</button>
                        <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveLayer(selected)">Delete</button>
                    </div>
                    <label class="field">
                        <span>Layer name</span>
                        <input type="text" value="@selected.Name" @onchange="e => Set(() => selected.Name = Text(e))" />
                    </label>

                    @if (selected.Kind == GeneratedLayerKind.UpNext)
                    {
                        <div class="grid grid-2">
                            <label class="field">
                                <span>Start from</span>
                                <select value="@(selected.UpNext?.Offset ?? 0)"
                                        @onchange="e => Set(() => UpNext(selected).Offset = int.Parse(Text(e), CultureInfo.InvariantCulture))">
                                    <option value="0">The next show</option>
                                    <option value="1">The show after it</option>
                                    <option value="2">Two shows ahead</option>
                                    <option value="3">Three shows ahead</option>
                                </select>
                            </label>
                            <label class="field">
                                <span>Shows listed (one per line)</span>
                                <input type="number" min="1" max="10" value="@(selected.UpNext?.ShowsAhead ?? 1)"
                                       @onchange="e => SetNumber(e, value => UpNext(selected).ShowsAhead = (int)Math.Clamp(value, 1, 10))" />
                            </label>
                        </div>
                        <label class="check">
                            <input type="checkbox" checked="@(selected.UpNext?.IncludeTime == true)"
                                   @onchange="e => Set(() => UpNext(selected).IncludeTime = e.Value is true)" />
                            <span>Show start times</span>
                        </label>
                        <div class="grid grid-2">
                            <label class="field">
                                <span>Before the shows (optional)</span>
                                <textarea rows="2" placeholder="Up next: " spellcheck="false"
                                          @onchange="e => Set(() => UpNext(selected).Prefix = Affix(e))">@(selected.UpNext?.Prefix)</textarea>
                            </label>
                            <label class="field">
                                <span>After the shows (optional)</span>
                                <textarea rows="2" placeholder=" on {channel}" spellcheck="false"
                                          @onchange="e => Set(() => UpNext(selected).Suffix = Affix(e))">@(selected.UpNext?.Suffix)</textarea>
                            </label>
                        </div>
                        <p class="hint">Joined onto the first and last show, spaces included, so the whole line is one layer; a new line puts it on a line of its own. {channel} is the channel name. {start_time} and {end_time} are the first listed show's start and last listed show's end in the channel's local time. An unknown end time is left blank.</p>
                    }
                    else if (GeneratedPromoKinds.IsShowLayer(selected.Kind))
                    {
                        GeneratedShowOptions show = ShowOptions(selected);
                        <p class="hint">Each ticked part gets its own line.</p>
                        <div class="check-stack">
                            <label class="check">
                                <input type="checkbox" checked="@show.Title" @onchange="e => Set(() => show.Title = e.Value is true)" />
                                <span>Show title</span>
                            </label>
                            <label class="check">
                                <input type="checkbox" checked="@show.EpisodeTitle" @onchange="e => Set(() => show.EpisodeTitle = e.Value is true)" />
                                <span>Episode title</span>
                            </label>
                            <label class="check">
                                <input type="checkbox" checked="@show.Day" @onchange="e => Set(() => show.Day = e.Value is true)" />
                                <span>Day (Today, Tonight, Tomorrow or weekday)</span>
                            </label>
                            <label class="check">
                                <input type="checkbox" checked="@show.Time" @onchange="e => Set(() => show.Time = e.Value is true)" />
                                <span>Start time</span>
                            </label>
                        </div>
                    }
                    else if (selected.Kind == GeneratedLayerKind.Text)
                    {
                        <label class="field">
                            <span>Text ({channel} is the channel name; new lines start new lines)</span>
                            <textarea rows="2" @onchange="e => Set(() => selected.Text = Text(e))">@selected.Text</textarea>
                        </label>
                        <label class="check">
                            <input type="checkbox" checked="@(selected.Writer is not null)"
                                   @onchange="e => Set(() => selected.Writer = e.Value is true ? selected.Writer ?? new AiTextConfig() : null)" />
                            <span>Have AI write it (the text above is the fallback)</span>
                        </label>
                        @if (selected.Writer is { } layerWriter)
                        {
                            <AiTextSettings Config="layerWriter" Changed="Commit" Compact="true" PromptPlaceholder="@LayerPromptPlaceholder"
                                            StylePlaceholder="@LayerStylePlaceholder" WordsPlaceholder="8" Try="@(token => TryLayer(selected, token))" />
                        }
                    }
                    else if (selected.Kind == GeneratedLayerKind.Image)
                    {
                        <label class="field">
                            <span>Image source</span>
                            <select value="@selected.VariableImage" @onchange="e => SetVariableImage(selected, Optional(e))">
                                <option value="">Static image file</option>
                                @foreach (GeneratedVariableImage image in Template.VariableImages ?? [])
                                {
                                    <option value="@image.Name">@(image.Linked is { } linked ? $"{image.Name} (shared: {linked.Name})" : image.Name)</option>
                                }
                            </select>
                        </label>
                        @if (Template.VariableImages?.FirstOrDefault(image => string.Equals(image.Name, selected.VariableImage, StringComparison.OrdinalIgnoreCase)) is { } variable)
                        {
                            <label class="field">
                                <span>For which show</span>
                                <select value="@(selected.VariableImageShow ?? "")" @onchange="e => Set(() => selected.VariableImageShow = ShowSelector(Text(e)))">
                                    <option value="">@($"Its usual one ({ImageShowName(GeneratedImageSelectors.Format(variable.Context, variable.Offset))})")</option>
                                    @foreach (string selector in ImageShowSelectors)
                                    {
                                        <option value="@selector">@ImageShowName(selector)</option>
                                    }
                                </select>
                            </label>
                            <p class="hint">
                                The same variable can be used by several layers, each for a different show. In program arguments this is
                                <code>@($"{{{GeneratedImageSelectors.Reference(variable.Name, selected.VariableImageShow)}}}")</code>.
                            </p>
                        }
                        @if (string.IsNullOrWhiteSpace(selected.VariableImage))
                        {
                        <div class="field">
                            <span>Image file</span>
                            <FilePathPicker Value="@selected.Path" ValueChanged="value => Set(() => selected.Path = value)" KeepCopyIn="@GeneratedPromoPackages.AssetCategory"
                                            Extensions="FileBrowsing.Images" Label="image" StartIn="Environment.SpecialFolder.MyPictures"
                                            Placeholder="D:\Media\Promos\Logos\channel.png" />
                        </div>
                        @if (Missing(selected.Path))
                        {
                            <p class="hint warn">The scheduler can't find this file.</p>
                        }
                        }
                    }
                    else if (selected.Kind == GeneratedLayerKind.Video)
                    {
                        GeneratedVideoOptions video = VideoOptions(selected);
                        <label class="field">
                            <span>Plays</span>
                            <select value="@(video.Episode ?? VideoFile)" @onchange="e => Set(() => video.Episode = Text(e) == VideoFile ? null : Text(e))">
                                <option value="@VideoFile">A video file</option>
                                @foreach (string selector in ImageShowSelectors)
                                {
                                    <option value="@selector">@VideoSourceName(selector)</option>
                                }
                            </select>
                        </label>
                        @if (video.Episode is null)
                        {
                            <div class="field">
                                <span>Video file</span>
                                <FilePathPicker Value="@selected.Path" ValueChanged="value => Set(() => selected.Path = value)" KeepCopyIn="@GeneratedPromoPackages.AssetCategory"
                                                Extensions="FileBrowsing.Videos" Label="video" Placeholder="D:\Media\Promos\Clips\sting.mp4" />
                            </div>
                            @if (Missing(selected.Path))
                            {
                                <p class="hint warn">The scheduler can't find this file.</p>
                            }
                            <label class="field">
                                <span>Start into the file (s)</span>
                                <input type="number" min="0" step="0.1" value="@Number(video.FileStart.TotalSeconds)"
                                       @onchange="e => SetSeconds(e, value => video.FileStart = value)" />
                            </label>
                        }
                        else
                        {
                            <label class="field">
                                <span>Start into the episode (s; blank picks a spot in the middle, different each airing)</span>
                                <input type="number" min="0" step="1" value="@(video.ClipStart is { } clipStart ? Number(clipStart.TotalSeconds) : "")"
                                       placeholder="Middle of the episode" @onchange="e => SetOptionalSeconds(e, value => video.ClipStart = value)" />
                            </label>
                            <p class="hint">
                                Plays the episode file of that show. With nothing there (no such show yet, or a file the scheduler can't read) the layer is left out.
                                @(PreviewIsSample ? "Until the channel's schedule is built, the preview only has an episode for the show this promo is for." : "")
                            </p>
                        }
                        <div class="grid grid-2">
                            <label class="field">
                                <span>Starts playing</span>
                                <select value="@video.Playback" @onchange="e => Set(() => video.Playback = Enum.Parse<GeneratedVideoPlayback>(Text(e)))">
                                    <option value="@GeneratedVideoPlayback.WithLayer">When the layer appears</option>
                                    <option value="@GeneratedVideoPlayback.WithPromo">When the promo starts</option>
                                </select>
                            </label>
                            <div class="check-stack">
                                <label class="check">
                                    <input type="checkbox" checked="@video.Fill" @onchange="e => Set(() => video.Fill = e.Value is true)" />
                                    <span>Fill the box (crop the video)</span>
                                </label>
                                <label class="check">
                                    <input type="checkbox" checked="@video.Loop" @onchange="e => Set(() => video.Loop = e.Value is true)" />
                                    <span>Loop (otherwise it stays on its last frame)</span>
                                </label>
                            </div>
                        </div>
                        <label class="check">
                            <input type="checkbox" checked="@video.IncludeAudio" @onchange="e => Set(() => video.IncludeAudio = e.Value is true)" />
                            <span>Play its sound</span>
                        </label>
                        @if (video.IncludeAudio)
                        {
                            <div class="grid grid-2">
                                <label class="field">
                                    <span>Its volume: @($"{video.Volume:P0}")</span>
                                    <input type="range" min="0" max="100" value="@Number(video.Volume * 100)"
                                           @onchange="e => SetNumber(e, value => video.Volume = Math.Clamp(value / 100, 0, 1))" />
                                </label>
                                <label class="check template-enabled">
                                    <input type="checkbox" checked="@video.DuckUnderVoice" @onchange="e => Set(() => video.DuckUnderVoice = e.Value is true)" />
                                    <span>Lower it while the voice speaks</span>
                                </label>
                            </div>
                            <p class="hint">Its sound fades in and out with the layer, and follows its opacity.</p>
                        }
                    }

                    @if (selected.Kind is GeneratedLayerKind.Text or GeneratedLayerKind.UpNext || GeneratedPromoKinds.IsShowLayer(selected.Kind))
                    {
                        <h4>Text style</h4>
                        <div class="grid grid-2">
                            <label class="field">
                                <span>Font</span>
                                <select value="@FontName(selected.FontFamily)" style="font-family: '@selected.FontFamily'"
                                        @onchange="e => Set(() => selected.FontFamily = Text(e))">
                                    @if (!_fonts.Contains(FontName(selected.FontFamily)))
                                    {
                                        <option value="@selected.FontFamily">@selected.FontFamily (not installed)</option>
                                    }
                                    @foreach (string font in _fonts)
                                    {
                                        <option value="@font" style="font-family: '@font'">@font</option>
                                    }
                                </select>
                            </label>
                            <label class="field">
                                <span>Largest size</span>
                                <input type="number" min="4" max="600" value="@Number(selected.FontSize)"
                                       @onchange="e => SetNumber(e, value => selected.FontSize = (float)Math.Clamp(value, 4, 600))" />
                            </label>
                            <div class="field">
                                <span>Align in its box</span>
                                <div class="align-grid" role="group" aria-label="Text alignment">
                                    @foreach (GeneratedVerticalAlign vertical in Enum.GetValues<GeneratedVerticalAlign>())
                                    {
                                        @foreach (GeneratedTextAlign horizontal in Enum.GetValues<GeneratedTextAlign>())
                                        {
                                            bool chosen = selected.Align == horizontal && (selected.VerticalAlign ?? GeneratedVerticalAlign.Top) == vertical;
                                            string name = AlignName(vertical, horizontal);
                                            <button type="button" class="align-cell @(chosen ? "selected" : "")" title="@name" aria-label="@name"
                                                    aria-pressed="@(chosen ? "true" : "false")" @onclick="() => SetAlign(selected, vertical, horizontal)">
                                                <span class="align-lines @($"h-{horizontal.ToString().ToLowerInvariant()} v-{vertical.ToString().ToLowerInvariant()}")" aria-hidden="true">
                                                    <i></i><i></i><i></i>
                                                </span>
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                            <label class="field">
                                <span>Letters</span>
                                <select value="@(selected.TextCase ?? GeneratedTextCase.AsWritten)"
                                        @onchange="e => SetTextCase(selected, Enum.Parse<GeneratedTextCase>(Text(e)))">
                                    <option value="@GeneratedTextCase.AsWritten">As written</option>
                                    <option value="@GeneratedTextCase.Upper">ALL UPPERCASE</option>
                                    <option value="@GeneratedTextCase.Lower">all lowercase</option>
                                </select>
                            </label>
                            <div class="check-stack">
                                <label class="check">
                                    <input type="checkbox" checked="@selected.Bold" @onchange="e => Set(() => selected.Bold = e.Value is true)" />
                                    <span>Bold</span>
                                </label>
                                <label class="check">
                                    <input type="checkbox" checked="@selected.Shadow" @onchange="e => Set(() => selected.Shadow = e.Value is true)" />
                                    <span>Drop shadow</span>
                                </label>
                            </div>
                        </div>
                        <p class="hint">Text shrinks to fit its box.</p>
                    }

                    @if (selected.Kind == GeneratedLayerKind.Group)
                    {
                        <p class="hint">
                            A group holds @GeneratedPromoHierarchy.Children(Template, selected).Count layer(s). Move, turn, fade, time and keyframe it like any
                            layer, and everything inside goes with it while keeping its own animation. Its box is what it turns about;
                            resize it with the numbers below (that moves the turning point, not what's inside).
                        </p>
                    }
                    @if (selected.Kind is not (GeneratedLayerKind.Image or GeneratedLayerKind.Group or GeneratedLayerKind.Video))
                    {
                        (string rgb, int alpha) = GeneratedPromoEditing.SplitColor(ColorOf(selected));
                        bool ownColour = _editBackground is not null && GeneratedPromoResolver.Recolour(Template, _editBackground, selected) is not null;
                        <div class="grid grid-2">
                            <div class="field">
                                <span>Colour@(_editBackground is null ? "" : ownColour ? " (this background's)" : " (the template's; changing it sets this background's)")</span>
                                <ScreenColourPicker @key="selected" Value="@rgb"
                                                    ValueChanged="colour => SetColor(selected, GeneratedPromoEditing.JoinColor(colour, alpha))" />
                            </div>
                            <label class="field">
                                <span>Colour transparency: @(100 - alpha)%</span>
                                <input type="range" min="0" max="100" value="@(100 - alpha)"
                                       @onchange="e => int.TryParse(Text(e), out int transparency) ? SetColor(selected, GeneratedPromoEditing.JoinColor(rgb, 100 - transparency)) : Task.CompletedTask" />
                            </label>
                        </div>
                    }
                    @if (selected.Kind == GeneratedLayerKind.Rect)
                    {
                        <label class="field">
                            <span>Shape</span>
                            <select value="@(selected.Shape ?? GeneratedShape.Rectangle)"
                                    @onchange="e => Set(() => selected.Shape = Enum.Parse<GeneratedShape>(Text(e)))">
                                @foreach (var shape in Enum.GetValues<GeneratedShape>())
                                {
                                    <option value="@shape">@shape</option>
                                }
                            </select>
                        </label>
                        <label class="field">
                            <span>Soft edges (pixels)</span>
                            <input type="number" min="0" max="200" step="1" value="@Number(selected.SoftEdges ?? 0)"
                                   @onchange="e => SetNumber(e, value => selected.SoftEdges = (float)Math.Clamp(value, 0, 200))" />
                        </label>
                        <p class="hint">Soft edges feather the outline; 0 keeps it sharp. Shape and softness apply across backgrounds; turning is under Position.</p>
                        @if (selected.Shape is null or GeneratedShape.Rectangle)
                        {
                            <label class="field">
                                <span>Corner radius</span>
                                <input type="number" min="0" value="@Number(selected.CornerRadius)"
                                       @onchange="e => SetNumber(e, value => selected.CornerRadius = (float)Math.Max(0, value))" />
                            </label>
                        }
                    }

                    @{ LayerPose selectedPose = GeneratedPromoEditing.PoseAt(Pose(selected), Time); }
                    @if (_editBackground is { } placingFor)
                    {
                        <div class="ed-placing-layer">
                            @if (PlacedHere(selected))
                            {
                                <span class="hint" style="margin:0;">
                                    ⌖ @CustomisedParts(selected, placingFor) its own way for @Path.GetFileName(placingFor).
                                </span>
                                <button class="btn btn-sm" type="button" title="Use the template's position, size, opacity, keyframes, timing and colour again for this background"
                                        @onclick="() => ResetPlacement(selected)">Use the template's</button>
                            }
                            else
                            {
                                <span class="hint" style="margin:0;">As the template has it; move it or change its colour to set it for @Path.GetFileName(placingFor) only.</span>
                            }
                        </div>
                    }
                    <h4>
                        Position (pixels)
                        @if (GeneratedPromoEditing.HasKeyframes(Pose(selected)))
                        {
                            <span class="ed-meta">· at @($"{_time:0.00}")s; @(CurrentKeyframe is null ? "changing these adds a keyframe" : "this keyframe")</span>
                        }
                    </h4>
                    <div class="grid grid-4">
                        <label class="field"><span>X</span><input type="number" value="@Number(Math.Round(selectedPose.X, 1))" @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { X = value })" /></label>
                        <label class="field"><span>Y</span><input type="number" value="@Number(Math.Round(selectedPose.Y, 1))" @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { Y = value })" /></label>
                        <label class="field"><span>Width</span><input type="number" min="1" value="@Number(Math.Round(selectedPose.Width, 1))" @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { Width = value })" /></label>
                        <label class="field"><span>Height</span><input type="number" min="1" value="@Number(Math.Round(selectedPose.Height, 1))" @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { Height = value })" /></label>
                    </div>
                    <div class="grid grid-2">
                        <label class="field">
                            <span>Turn (degrees, clockwise)</span>
                            <input type="number" step="1" value="@Number(Math.Round(selectedPose.Rotation ?? 0, 1))"
                                   @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { Rotation = value })" />
                        </label>
                        <label class="field">
                            <span>Opacity: @($"{selectedPose.Opacity:P0}")</span>
                            <input type="range" min="0" max="100" value="@Number(Math.Round(selectedPose.Opacity * 100))"
                                   @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { Opacity = value / 100 })" />
                        </label>
                    </div>
                    <div class="ed-pin-row">
                        <span>Perspective: @(selectedPose.Corners is { IsSquare: false } ? "corners pulled" : "square")</span>
                        <div class="spacer"></div>
                        <button class="btn btn-sm @(_pinTool ? "btn-primary" : "")" type="button" aria-pressed="@(_pinTool ? "true" : "false")"
                                @onclick="() => _pinTool = !_pinTool">@(_pinTool ? "Done pulling corners" : "Pull corners")</button>
                        @if (selectedPose.Corners is { IsSquare: false })
                        {
                            <button class="btn btn-sm" type="button" title="Square the corners up again (at this keyframe, on an animated layer)"
                                    @onclick="() => ResetPin(selected)">Square up</button>
                        }
                    </div>
                    @if (_pinTool)
                    {
                        <p class="hint">
                            Drag the round corners on the canvas to stretch the layer with perspective, as if it were on a wall or the side of a
                            block. On an animated layer each change sets a keyframe at the playhead, so the corners can follow a turning face.
                            @(GeneratedPromoHierarchy.IsGroup(selected) ? "Everything inside the group is stretched with it." : "")
                        </p>
                    }
                    @if (GeneratedPromoHierarchy.ParentOf(Template, selected) is { } holder)
                    {
                        <p class="hint">Inside “@Label(holder)”: these are from the group's top-left corner, turned with it.</p>
                    }
                    @if (selected.Kind != GeneratedLayerKind.Group)
                    {
                    <label class="check">
                        <input type="checkbox" checked="@(selected.MutesClip == true)"
                               @onchange="e => Set(() => selected.MutesClip = e.Value is true ? true : null)" />
                        <span>Mutes the episode clip (as much as it's showing)</span>
                    </label>
                    }
                    @if (selected.MutesClip == true)
                    {
                        <p class="hint @(Template.BackgroundClip is { IncludeAudio: true } ? string.Empty : "warn")">
                            @(Template.BackgroundClip is { IncludeAudio: true } ? MutesClipHint : MutesNothingHint)
                        </p>
                    }

                    @{ IGeneratedTiming timing = Timing(selected); }
                    <h4>
                        Timing and animation
                        @if (_editBackground is { } timingFor)
                        {
                            @if (GeneratedPromoResolver.Retiming(Template, timingFor, selected) is not null)
                            {
                                <span class="ed-meta">· this background's own</span>
                                <button class="btn btn-sm" type="button" title="Use the template's timing and transitions again for this background"
                                        @onclick="() => ResetTiming(selected)">Use the template's</button>
                            }
                            else
                            {
                                <span class="ed-meta">· the template's; changing it sets this background's</span>
                            }
                        }
                    </h4>
                    <div class="grid grid-2">
                        <label class="field">
                            <span>Appears at (s)</span>
                            <input type="number" min="0" step="0.05" value="@Number(timing.Start.TotalSeconds)"
                                   @onchange="e => SetSeconds(e, value => EditableTiming(selected).Start = value)" />
                        </label>
                        <label class="field">
                            <span>Leaves at (s, blank = end)</span>
                            <input type="number" min="0" step="0.05" value="@(timing.End is { } end ? Number(end.TotalSeconds) : "")"
                                   @onchange="e => SetOptionalSeconds(e, value => EditableTiming(selected).End = value)" />
                        </label>
                        <label class="field">
                            <span>Enter</span>
                            <select value="@timing.TransitionIn" @onchange="e => Set(() => EditableTiming(selected).TransitionIn = Enum.Parse<GeneratedTransition>(Text(e)))">
                                @foreach (GeneratedTransition transition in Enum.GetValues<GeneratedTransition>())
                                {
                                    <option value="@transition">@Words(transition)</option>
                                }
                            </select>
                        </label>
                        <label class="field">
                            <span>Exit</span>
                            <select value="@timing.TransitionOut" @onchange="e => Set(() => EditableTiming(selected).TransitionOut = Enum.Parse<GeneratedTransition>(Text(e)))">
                                @foreach (GeneratedTransition transition in Enum.GetValues<GeneratedTransition>())
                                {
                                    <option value="@transition">@Words(transition)</option>
                                }
                            </select>
                        </label>
                        <label class="field">
                            <span>Transition length (s)</span>
                            <input type="number" min="0" max="5" step="0.05" value="@Number(timing.TransitionDuration.TotalSeconds)"
                                   @onchange="e => SetSeconds(e, value => EditableTiming(selected).TransitionDuration = value)" />
                        </label>
                    </div>
                </div>
            }
        </div>
    </div>
    }

    <h3 class="ed-section">Voice-over</h3>
    <label class="check">
        <input type="checkbox" checked="@(Template.Voice is { Enabled: true })" @onchange="ToggleVoice" />
        <span>Read the listings aloud</span>
    </label>
    @if (Template.Voice is { Enabled: true } voice)
    {
        bool advancedVoice = voice.Advanced is { Enabled: true };
        ITextToSpeechProvider? provider = Voices.Providers.FirstOrDefault(candidate => string.Equals(candidate.Id, voice.Provider, StringComparison.OrdinalIgnoreCase));
        IReadOnlyList<TtsVoice> voiceList = VoiceList(provider);
        IReadOnlyList<string> languages = [.. voiceList.Select(option => option.Language).Distinct().Order()];
        IReadOnlyList<TtsVoice> shown = ShownVoices(voiceList);
        string current = VoiceId(voiceList, voice.Voice);
        <div class="grid grid-3">
            <label class="field">
                <span>Voice service</span>
                <select value="@voice.Provider" @onchange="e => SetProvider(voice, Text(e))">
                    @foreach (ITextToSpeechProvider candidate in Voices.Providers)
                    {
                        <option value="@candidate.Id">@candidate.DisplayName</option>
                    }
                </select>
            </label>
            <label class="field">
                <span>Voice@(_voicesLoading ? " (loading…)" : languages.Count > 1 ? $" ({shown.Count} of {voiceList.Count})" : "")</span>
                <select value="@current" @onchange="e => Set(() => voice.Voice = Text(e))">
                    @if (!shown.Any(option => option.Id == current))
                    {
                        <option value="@voice.Voice">@(string.IsNullOrWhiteSpace(voice.Voice) ? "Choose a voice" : VoiceLabel(voiceList, voice.Voice))</option>
                    }
                    @foreach (TtsVoice option in shown)
                    {
                        <option value="@option.Id" title="@option.Description">@VoiceLabel(voiceList, option.Id)</option>
                    }
                </select>
            </label>
            <label class="field">
                <span>Starts speaking at (s)</span>
                <input type="number" min="0" step="0.05" value="@Number(voice.Start.TotalSeconds)"
                       @onchange="e => SetSeconds(e, value => voice.Start = value)" />
            </label>
        </div>
        @if (languages.Count > 1)
        {
            <div class="grid grid-2">
                <label class="field">
                    <span>Voice language</span>
                    <select value="@_voiceLanguage" @onchange="e => _voiceLanguage = Text(e)">
                        <option value="@AllLanguages">All languages</option>
                        @foreach (string language in languages)
                        {
                            <option value="@language">@language</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Search voices</span>
                    <input type="search" value="@_voiceSearch" placeholder="narrator, deep, female…" @oninput="e => _voiceSearch = Text(e)" />
                </label>
            </div>
        }
        @if (provider?.SetupProblem is { } setup)
        {
            <p class="hint warn">@setup</p>
        }
        else if (_voiceError is { } voiceError)
        {
            <p class="hint warn">Couldn't load the voice list: @voiceError</p>
        }
        <label class="check">
            <input type="checkbox" checked="@advancedVoice" @onchange="e => ToggleAdvancedVoice(voice, e.Value is true)" />
            <span>Advanced voice-over templates (write the complete script)</span>
        </label>
        @if (voice.Advanced is { Enabled: true } advanced)
        {
            <p class="hint">One of your eligible templates is picked for each promo. Its wording is used exactly, with tokens filled in—no automatic linking phrases or AI rewriting.</p>
            @for (int index = 0; index < advanced.Templates.Count; index++)
            {
                int position = index;
                <div class="field" @key="position">
                    <label for="@($"{_canvasId}-voice-{position}")">Script template @(position + 1)</label>
                    <textarea id="@($"{_canvasId}-voice-{position}")" rows="3"
                              @onchange="e => Set(() => advanced.Templates[position] = Text(e))">@advanced.Templates[position]</textarea>
                    <button class="btn btn-sm btn-danger" type="button" @onclick="() => Set(() => advanced.Templates.RemoveAt(position))">Remove template</button>
                </div>
            }
            <button class="btn btn-sm" type="button" @onclick="() => Set(() => advanced.Templates.Add(DefaultVoiceTemplate))">Add script template</button>
            <p class="hint">{up_next}, {up_next_2} … {up_next_10} always use the same upcoming sequence as text and variable images. The template's “Count upcoming programmes by” setting controls whether this counts timeslots/episodes or groups consecutive slots by show. {show} names the show this promo is for; {channel}, {episode}, {start_time}, and {end_time} are also available.</p>
            <p class="hint">Use {up_next_2:raw} to bypass repeat wording, or :episode, :start_time, or :end_time for its details. A template referencing an unavailable upcoming listing is skipped; add a shorter template as a fallback. If none can be used, this promo has no voice-over.</p>
            <div class="grid grid-2">
                <label class="field">
                    <span>Before a repeated show title (spaces included)</span>
                    <input type="text" value="@advanced.RepeatPrefix" @onchange="e => Set(() => advanced.RepeatPrefix = Text(e))" />
                </label>
                <label class="field">
                    <span>After a repeated show title (spaces included)</span>
                    <input type="text" value="@advanced.RepeatSuffix" @onchange="e => Set(() => advanced.RepeatSuffix = Text(e))" />
                </label>
            </div>
            <p class="hint">For example, “more ” makes a later token say “more Rugrats” if an earlier listing is also Rugrats. Separate slots of the same show can repeat in Timeslot / episode mode; episodes packed into one slot stay together. Clear both fields to repeat titles unchanged.</p>
            <label class="check">
                <input type="checkbox" checked="@advanced.IncludePreMessages" @onchange="e => Set(() => advanced.IncludePreMessages = e.Value is true)" />
                <span>Include an opener before the script (optional)</span>
            </label>
            <label class="check">
                <input type="checkbox" checked="@advanced.IncludePostMessages" @onchange="e => Set(() => advanced.IncludePostMessages = e.Value is true)" />
                <span>Include a closer after the script (optional)</span>
            </label>
        }
        <div class="grid grid-2">
            @if (!advancedVoice || voice.Advanced!.IncludePreMessages)
            {
            <div class="field">
                <span>Said first (one is picked for each promo)</span>
                <PhraseListEditor Values="PreMessages(voice)" Changed="Commit" Label="Opener"
                                  Placeholder="@GeneratedPromoResolver.DefaultPreMessage(Template.Type)"
                                  EmptyHint="@(advancedVoice ? "No opener; the script stands on its own." : $"Says the usual “{GeneratedPromoResolver.DefaultPreMessage(Template.Type)}”")" />
            </div>
            }
            @if (!advancedVoice || voice.Advanced!.IncludePostMessages)
            {
            <div class="field">
                <span>Said last ({channel} is the channel name)</span>
                <PhraseListEditor Values="PostMessages(voice)" Changed="Commit" Label="Closer" Placeholder="Only on {channel}!"
                                  EmptyHint="Nothing is said after the shows." />
            </div>
            }
        </div>
        <p class="hint">@(advancedVoice ? "Template read-out:" : voice.Writer is null ? ReadOutLabel : UsualReadOutLabel) <em>@Script()</em></p>
        @if (advancedVoice && string.IsNullOrWhiteSpace(Script()))
        {
            <p class="hint warn">No usable voice-over template for these shows. Check tokens and add a template requiring fewer upcoming listings.</p>
        }

        @if (!advancedVoice)
        {
        <label class="check">
            <input type="checkbox" checked="@(voice.Writer is not null)"
                   @onchange="e => Set(() => voice.Writer = e.Value is true ? voice.Writer ?? new AiTextConfig() : null)" />
            <span>Have AI word it naturally (and say something about the episode)</span>
        </label>
        @if (voice.Writer is { } voiceWriter)
        {
            <AiTextSettings Config="voiceWriter" Changed="Commit" PromptLabel="Anything else it should do (optional)"
                            PromptPlaceholder="@VoicePromptPlaceholder" WordsPlaceholder="@VoiceWords(voice)" Try="@TryVoice"
                            TryHint="Writes one with this channel's next shows (a new one each time)." />
        }
        }
    }

    <h3 class="ed-section">Background music</h3>
    <label class="check">
        <input type="checkbox" checked="@(Template.Music is not null)" @onchange="ToggleMusic" />
        <span>Play a song under the promo</span>
    </label>
    @if (Template.Music is { } music)
    {
        List<string> songs = Songs(music);
        <label class="field">
            <span>Songs from</span>
            <select value="@(music.FromLibrary ? "library" : "files")" @onchange="e => ChooseSongSource(music, e.Value?.ToString())">
                <option value="files">Song files I choose</option>
                <option value="library">A music library (Jellyfin, local music folders, a plugin's)</option>
            </select>
        </label>
        @if (music.FromLibrary)
        {
            <MusicPicker Value="music.Library" ValueChanged="value => SetLibraryMusic(music, value)" Label="Music library"
                         AllowNone="false" AllowFolder="false" NoneLabel="Choose…" />
            <p class="hint">One of these songs is picked for each promo (the same one each time that promo is rendered), and loops if shorter than the promo.
                Songs a library serves rather than keeps as files are copied once into the promos folder for rendering.</p>
        }
        else
        {
        <div class="field">
            <span>Songs (one is picked for each promo; each loops if shorter than the promo)</span>
            <ol class="song-list">
                @for (int index = 0; index < songs.Count; index++)
                {
                    int position = index;
                    string song = songs[position];
                    bool playing = string.Equals(_songPlaying, song, StringComparison.OrdinalIgnoreCase);
                    bool cutting = string.Equals(_songCutting, song, StringComparison.OrdinalIgnoreCase);
                    <li @key="position">
                        <div class="song-row">
                            <FilePathPicker Value="@song" ValueChanged="value => SetSong(music, position, value)" KeepCopyIn="@GeneratedPromoPackages.AssetCategory"
                                            Extensions="FileBrowsing.Audio" Label="song" StartIn="Environment.SpecialFolder.MyMusic" />
                            <label class="song-start" title="Where in this song the promo starts">
                                <span>Start (s)</span>
                                <input type="number" min="0" step="0.5" value="@Number(music.StartFor(song).TotalSeconds)"
                                       aria-label="@($"Start into {Path.GetFileName(song)} in seconds")"
                                       @onchange="e => SetSongStart(e, music, song)" />
                            </label>
                            <label class="song-start" title="This song's own volume, on top of the master volume below (100% plays it at the master volume)">
                                <span>Volume %</span>
                                <input type="number" min="0" max="200" step="5" value="@Number(Math.Round(music.VolumeFor(song) * 100))"
                                       aria-label="@($"Volume of {Path.GetFileName(song)} in percent")"
                                       @onchange="e => SetSongVolume(e, music, song)" />
                            </label>
                            <button class="btn btn-sm" type="button" disabled="@(cutting || Missing(song) || string.IsNullOrWhiteSpace(song))"
                                    title="@($"Play the {Number(Template.Duration.TotalSeconds)} s a promo would use")"
                                    aria-label="@($"{(playing ? "Stop" : "Play")} {Path.GetFileName(song)} preview")"
                                    @onclick="() => ToggleSongPreview(music, song)">
                                @(cutting ? "…" : playing ? "■ Stop" : "▶ Play")
                            </button>
                            @if (songs.Count > 1)
                            {
                                bool renderingThis = _rendering && string.Equals(_videoSong, song, StringComparison.OrdinalIgnoreCase);
                                <button class="btn btn-sm" type="button" disabled="@(_rendering || Missing(song) || string.IsNullOrWhiteSpace(song))"
                                        title="Render a preview promo with this song" aria-label="@($"Preview a promo with {Path.GetFileName(song)}")"
                                        @onclick="() => RenderVideo(song)">
                                    @(renderingThis ? "Rendering…" : "Preview")
                                </button>
                            }
                            <button class="btn btn-sm btn-danger" type="button" aria-label="@($"Remove {Path.GetFileName(song)}")"
                                    @onclick="() => SetSong(music, position, null)">Remove</button>
                        </div>
                        @if (Missing(song))
                        {
                            <p class="hint warn">The scheduler can't find this file.</p>
                        }
                        @if (playing && _songClipUrl is not null)
                        {
                            <audio class="song-preview" src="@_songClipUrl" autoplay controls @onended="StopSongPreview"></audio>
                        }
                        @if (_videoSong is not null && string.Equals(_videoSong, song, StringComparison.OrdinalIgnoreCase))
                        {
                            @if (_videoMessage is not null)
                            {
                                <p class="hint warn" role="status">@_videoMessage</p>
                            }
                            @if (_videoUrl is not null)
                            {
                                <video class="promo-video" src="@_videoUrl" controls autoplay></video>
                            }
                        }
                    </li>
                }
            </ol>
            @if (_songError is not null)
            {
                <p class="hint warn" role="status">@_songError</p>
            }
            <div class="row row-wrap">
                <FilePathPicker Multiple="true" ButtonText="Add songs…" Extensions="FileBrowsing.Audio" Label="songs" KeepCopyIn="@GeneratedPromoPackages.AssetCategory"
                                StartIn="Environment.SpecialFolder.MyMusic" OnPicked="picked => AddSongs(music, picked)" />
                @if (songs.Count == 0)
                {
                    <span class="hint warn" style="margin:0;">Add at least one song.</span>
                }
            </div>
        </div>
        }
        <div class="grid grid-3">
            <label class="field">
                <span>Master volume: @($"{music.Volume:P0}")</span>
                <input type="range" min="0" max="100" value="@Number(music.Volume * 100)"
                       @onchange="e => SetNumber(e, value => music.Volume = Math.Clamp(value / 100, 0, 1))" />
            </label>
            <label class="field">
                <span>Fade in (s)</span>
                <input type="number" min="0" step="0.1" value="@Number(music.FadeIn.TotalSeconds)" @onchange="e => SetSeconds(e, value => music.FadeIn = value)" />
            </label>
            <label class="field">
                <span>Fade out (s)</span>
                <input type="number" min="0" step="0.1" value="@Number(music.FadeOut.TotalSeconds)" @onchange="e => SetSeconds(e, value => music.FadeOut = value)" />
            </label>
        </div>
        <label class="check">
            <input type="checkbox" checked="@music.DuckUnderVoice" @onchange="e => Set(() => music.DuckUnderVoice = e.Value is true)" />
            <span>Lower the music while the voice speaks</span>
        </label>
        <label class="check">
            <input type="checkbox" checked="@(music.DuckUnderClip == true)"
                   @onchange="e => Set(() => music.DuckUnderClip = e.Value is true ? true : null)" />
            <span>Lower the music while the episode clip's (or background video's) sound plays</span>
        </label>
        @if (music.DuckUnderClip == true && Template.BackgroundClip is not { IncludeAudio: true }
             && !(GeneratedPromoResolver.BackgroundSound(Template).Enabled && BackgroundList.Any(background => !PromoRenderer.IsImage(background))))
        {
            <p class="hint warn">@ClipSoundOff</p>
        }
    }

    <h3 class="ed-section">Preview</h3>
    <div class="row row-wrap">
        <button class="btn btn-primary" type="button" disabled="@_rendering" @onclick="() => RenderVideo(null)">
            @(_rendering && _videoSong is null ? "Rendering…" : "Render preview video")
        </button>
        <span class="hint" style="margin:0;">Renders the full promo with voice and music, exactly as it will air.</span>
    </div>
    @if (_videoSong is null && _videoMessage is not null)
    {
        <p class="hint warn" role="status">@_videoMessage</p>
    }
    @if (_videoSong is null && _videoUrl is not null)
    {
        <video class="promo-video" src="@_videoUrl" controls autoplay></video>
    }
</div>

@if (_drag is not null || _scrubbing || _keyDrag is not null)
{
    <div class="drag-overlay @(_drag is null ? "drag-time" : "")" @onpointermove="OverlayMove" @onpointerup="OverlayEnd" @onpointercancel="OverlayEnd" @onpointerleave="OverlayEnd"></div>
}

@code {
    [Parameter, EditorRequired] public GeneratedPromoTemplate Template { get; set; } = new();
    [Parameter, EditorRequired] public ChannelConfig Channel { get; set; } = new() { Id = "", Name = "" };
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public string? ErrorScope { get; set; }

    private const string Move = "move";
    private const string ReadOutLabel = "Read-out (one of the variations):";
    private const string UsualReadOutLabel = "Usual read-out, used when the AI's isn't:";
    private const string VoicePromptPlaceholder = "Mention it's the Saturday morning marathon";
    private const string LayerPromptPlaceholder = "A five-word tagline teasing the episode";
    private const string LayerStylePlaceholder = "Short and punchy";
    private const string MutesClipHint =
        "The episode's sound follows this layer: it fades out as the layer fades in, cuts out if it cuts in, and is turned down by its opacity.";
    private const string ClipSoundOff =
        "Neither the episode clip's sound nor a background video's sound is on (both are under Canvas), so the music has nothing to dip under.";
    private const string MutesNothingHint =
        "The episode clip's sound isn't on (under Canvas), so there's nothing for this to mute yet.";
    private int _tries;
    private static readonly string[] Handles = ["nw", "n", "ne", "e", "se", "s", "sw", "w"];
    // On a Raspberry Pi: what in this template makes each render slow (each promo is encoded in software there).
    private IEnumerable<string?> LowPowerTemplateWarnings =>
    [
        Template.Width * Template.Height > 1280 * 720
            ? $"{Template.Width} × {Template.Height} takes about twice as long to render here as 1280 × 720; 720p looks the same on most channels."
            : null,
        Template.Fps > 30 ? $"{Template.Fps} fps is twice the frames of 30 to draw and encode." : null,
        Template.BackgroundChoices.Any(background => !PromoRenderer.IsImage(background))
            ? "A looping video background is decoded and scaled for every frame; a picture is much lighter here."
            : null
    ];

    private static readonly (int Width, int Height, string Label)[] Sizes =
    [
        (1920, 1080, "1920 × 1080 (1080p)"),
        (1280, 720, "1280 × 720 (720p)"),
        (3840, 2160, "3840 × 2160 (4K)"),
        (1440, 1080, "1440 × 1080 (4:3 HD)"),
        (960, 720, "960 × 720 (4:3)"),
        (720, 480, "720 × 480 (SD)"),
        (640, 480, "640 × 480 (4:3 SD)")
    ];

    private sealed record DragState(GeneratedLayer Layer, string Handle, double StartX, double StartY, float X, float Y, float Width, float Height)
    {
        public bool Moved { get; set; }

        /// <summary>Moving: every selected layer (bar those inside another selected one), each from where it started.</summary>
        public List<Mover> Movers { get; init; } = [];

        /// <summary>Resizing: the layer's own turn, and its groups' turn on top of that.</summary>
        public double OwnRotation { get; init; }

        public double SpaceRotation { get; init; }

        /// <summary>Turning: the box's middle on screen, the pointer's angle from it at the start, and the turn it started at.</summary>
        public double CentreClientX { get; init; }

        public double CentreClientY { get; init; }

        public double StartAngle { get; init; }

        /// <summary>Pulling a corner: which (0 top left, clockwise), and the pin it started from.</summary>
        public int Corner { get; init; }

        public PromoCorners PinStart { get; init; }
    }

    /// <param name="SpaceRotation">How far the groups it's in are turned: a drag on screen moves it that much less turned.</param>
    private sealed record Mover(GeneratedLayer Layer, float X, float Y, double SpaceRotation);

    private const string Rotate = "rotate";
    private const string PinHandle = "pin";

    // ---- Perspective (corner pin) ----

    // The Perspective tool: the selected layer shows its four corners to drag instead of resize handles.
    private bool _pinTool;

    private static readonly string[] PinCornerNames = ["Top left", "Top right", "Bottom right", "Bottom left"];

    /// <summary>Whether the layer's corners are pulled at the preview time (in what the canvas shows).</summary>
    private bool IsPinned(GeneratedLayer layer) => GeneratedPromoEditing.PoseAt(Pose(layer), Time).Corners is { IsSquare: false };

    /// <summary>The layer's pinned shape on the canvas, as SVG polygon points in template pixels.</summary>
    private string QuadPoints(GeneratedLayer layer) => string.Join(' ',
        GeneratedPromoHierarchy.WorldQuad(Template, layer, Pose, Time).Select(point => $"{Number(point.X)},{Number(point.Y)}"));

    /// <summary>Starts dragging one of the layer's corners (0 top left, clockwise).</summary>
    private void StartPin(PointerEventArgs e, GeneratedLayer layer, int corner)
    {
        if (e.Button != 0 || IsLocked(layer))
        {
            return;
        }

        _layer = layer;
        _chosen.Add(layer);
        LayerPose pose = GeneratedPromoEditing.PoseAt(Pose(layer), Time);
        _drag = new DragState(layer, PinHandle, e.ClientX, e.ClientY, pose.X, pose.Y, pose.Width, pose.Height)
        {
            OwnRotation = pose.Rotation ?? 0,
            SpaceRotation = GeneratedPromoHierarchy.SpaceAngle(Template, layer, Pose, Time),
            Corner = corner,
            PinStart = pose.Corners ?? default
        };
        _ = MeasureCanvas();
        _ = FocusRuler();
    }

    /// <summary>Squares the layer's corners up again (at the preview time, when it's keyframed).</summary>
    private Task ResetPin(GeneratedLayer layer) => Set(() =>
    {
        IGeneratedPose target = Editable(layer);
        GeneratedPromoEditing.SetPose(target, Time, GeneratedPromoEditing.PoseAt(target, Time) with { Rotation = null, Corners = default(PromoCorners) });
    });

    // Selected layers: _layer is the one the settings show; _chosen holds every selected one (it among them).
    private readonly HashSet<GeneratedLayer> _chosen = [];
    // Groups folded shut in the layer list.
    private readonly HashSet<GeneratedLayer> _folded = [];
    // Dragging in the layer list: what's dragged, and where it would land.
    private List<GeneratedLayer>? _listDrag;
    private GeneratedLayer? _dropOn;
    private LayerDrop _dropWhere;
    private const double RowHeight = 34;

    private readonly CancellationTokenSource _life = new();
    private GeneratedLayer? _layer;
    private DragState? _drag;
    // Screen pixels, so snapping feels the same however wide the canvas is drawn.
    private const double SnapDistance = 8;
    private const string CanvasMode = "canvas";
