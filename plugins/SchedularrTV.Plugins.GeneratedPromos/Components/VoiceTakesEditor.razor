@* The takes of one voice pack phrase (or one value of it): play each, record more from the microphone, or add files. *@
@implements IAsyncDisposable
@inject GeneratedPromoPreview Preview
@inject IJSRuntime JS

<div class="voice-takes">
    @if (Takes.Count == 0)
    {
        <span class="hint voice-takes-empty">No takes yet.</span>
    }
    @for (int index = 0; index < Takes.Count; index++)
    {
        GeneratedVoiceTake take = Takes[index];
        bool playing = ReferenceEquals(_playing, take);
        bool missing = !string.IsNullOrWhiteSpace(take.Path) && !File.Exists(take.Path);
        <div class="voice-take @(missing ? "voice-take-missing" : null)" @key="take">
            <button class="btn btn-ghost btn-sm" type="button" disabled="@(missing || _loading)"
                    title="@(playing ? "Stop" : "Play this take")" aria-label="@($"{(playing ? "Stop" : "Play")} take {index + 1}")"
                    @onclick="() => TogglePlay(take)">@(playing ? "■" : "▶")</button>
            <span class="voice-take-name" title="@take.Path">@($"Take {index + 1}")</span>
            <span class="hint voice-take-length">@(missing ? "file missing" : take.Length is { } length ? PrerecordedVoice.Seconds(length) : "")</span>
            <button class="btn btn-ghost btn-icon btn-sm" type="button" title="Remove this take" aria-label="@($"Remove take {index + 1}")"
                    @onclick="() => Remove(take)"><Icon Name="x" Size="14" /></button>
        </div>
    }
    <div class="voice-take-actions">
        @if (_recording)
        {
            <button class="btn btn-sm btn-danger" type="button" @onclick="StopRecording">■ Stop recording</button>
            <span class="voice-rec-dot" aria-hidden="true"></span><span class="hint" role="status">Recording… say “@Prompt”</span>
        }
        else
        {
            <button class="btn btn-sm" type="button" disabled="@_saving" title="Record a take from this computer's microphone"
                    @onclick="StartRecording">@(_saving ? "Saving…" : "● Record")</button>
            <FilePathPicker Multiple="true" ButtonText="Add files…" Extensions="FileBrowsing.Audio" Label="takes"
                            KeepCopyIn="@GeneratedPromoPreview.VoicePackAssets" StartIn="Environment.SpecialFolder.MyMusic" OnPicked="AddFiles" />
        }
    </div>
    @if (_problem is not null)
    {
        <p class="hint warn" role="alert">@_problem</p>
    }
    @if (_playing is not null && _url is not null)
    {
        <audio class="voice-take-audio" src="@_url" autoplay @onended="StopPlaying"></audio>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<GeneratedVoiceTake> Takes { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>What the takes say, shown while recording and used to name recorded files.</summary>
    [Parameter] public string Prompt { get; set; } = "the line";

    /// <summary>Trims the silence at either end of a recording.</summary>
    [Parameter] public bool TrimSilence { get; set; } = true;

    private GeneratedVoiceTake? _playing;
    private string? _url;
    private bool _loading;
    private bool _recording;
    private bool _saving;
    private string? _problem;
    private readonly CancellationTokenSource _life = new();

    // Defined once per page; starting and stopping use the browser's own recorder.
    private const string RecorderScript = """
        window.schedularrVoiceRecorder = window.schedularrVoiceRecorder || {
          rec: null, chunks: [], stream: null,
          async start() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || !window.MediaRecorder)
              throw new Error('This browser can only record from a secure page (https, or http://localhost on the computer running SchedularrTV).');
            if (this.rec) this.cancel();
            const stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false } });
            const types = ['audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus', 'audio/mp4'];
            const type = types.find(t => MediaRecorder.isTypeSupported(t));
            this.stream = stream; this.chunks = [];
            this.rec = new MediaRecorder(stream, type ? { mimeType: type } : undefined);
            this.rec.ondataavailable = e => { if (e.data && e.data.size) this.chunks.push(e.data); };
            this.rec.start();
          },
          stop() {
            return new Promise((resolve, reject) => {
              const rec = this.rec;
              if (!rec) { reject(new Error('Nothing is being recorded.')); return; }
              rec.onstop = async () => {
                const blob = new Blob(this.chunks, { type: rec.mimeType || 'audio/webm' });
                this.release();
                resolve(new Uint8Array(await blob.arrayBuffer()));
              };
              rec.stop();
            });
          },
          cancel() { try { if (this.rec && this.rec.state !== 'inactive') this.rec.stop(); } catch (e) { } this.release(); },
          release() { if (this.stream) this.stream.getTracks().forEach(t => t.stop()); this.stream = null; this.rec = null; this.chunks = []; }
        };
        """;

    private const long MaxRecordingBytes = 64L * 1024 * 1024;

    private async Task StartRecording()
    {
        _problem = null;
        StopPlaying();
        try
        {
            await JS.InvokeVoidAsync("eval", RecorderScript);
            await JS.InvokeVoidAsync("schedularrVoiceRecorder.start");
            _recording = true;
        }
        catch (JSException ex)
        {
            _problem = $"Couldn't start recording: {ex.Message}";
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            _problem = $"Couldn't start recording: {ex.GetBaseException().Message}";
        }
    }

    private async Task StopRecording()
    {
        _recording = false;
        _saving = true;
        _problem = null;
        try
        {
            await using IJSStreamReference recording = await JS.InvokeAsync<IJSStreamReference>("schedularrVoiceRecorder.stop");
            await using Stream content = await recording.OpenReadStreamAsync(MaxRecordingBytes, _life.Token);
            string path = await Preview.SaveRecordingAsync(content, Prompt, TrimSilence, _life.Token);
            GeneratedVoiceTake take = new() { Path = path, Length = await Length(path) };
            Takes.Add(take);
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) when (_life.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            _problem = $"Couldn't save the recording: {ex.GetBaseException().Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AddFiles(IReadOnlyList<string> picked)
    {
        _problem = null;
        foreach (string path in picked.Where(path => !string.IsNullOrWhiteSpace(path)))
        {
            if (Takes.Any(take => string.Equals(take.Path, path, StringComparison.OrdinalIgnoreCase))) continue;
            Takes.Add(new GeneratedVoiceTake { Path = path, Length = await Length(path) });
        }

        await Changed.InvokeAsync();
    }

    private async Task<TimeSpan?> Length(string path)
    {
        try
        {
            return File.Exists(path) ? (TimeSpan?)await Preview.TakeLengthAsync(path, _life.Token) : null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException and not OperationCanceledException)
        {
            _problem = $"Couldn't read {Path.GetFileName(path)}: {ex.GetBaseException().Message}";
            return null;
        }
    }

    private Task Remove(GeneratedVoiceTake take)
    {
        if (ReferenceEquals(_playing, take)) StopPlaying();
        Takes.Remove(take);
        return Changed.InvokeAsync();
    }

    private async Task TogglePlay(GeneratedVoiceTake take)
    {
        if (ReferenceEquals(_playing, take))
        {
            StopPlaying();
            return;
        }

        StopPlaying();
        _loading = true;
        _problem = null;
        try
        {
            string clip = await Preview.AudioClipAsync(take.Path, _life.Token);
            _url = $"{Preview.FileUrl(clip)}?v={DateTime.UtcNow.Ticks}";
            _playing = take;
            if (take.Length is null && await Length(take.Path) is { } measured)
            {
                take.Length = measured;
                await Changed.InvokeAsync();
            }
        }
        catch (OperationCanceledException) when (_life.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            _problem = $"Couldn't play it: {ex.GetBaseException().Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void StopPlaying()
    {
        _playing = null;
        _url = null;
    }

    public async ValueTask DisposeAsync()
    {
        _life.Cancel();
        if (_recording)
        {
            try
            {
                await JS.InvokeVoidAsync("schedularrVoiceRecorder.cancel");
            }
            catch (Exception)
            {
                // The page is gone, and the recorder with it.
            }
        }

        _life.Dispose();
    }
}
