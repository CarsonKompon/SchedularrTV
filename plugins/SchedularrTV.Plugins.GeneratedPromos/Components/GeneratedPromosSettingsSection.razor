@* Shown under the Generated promos plugin's settings on the Plugins page: where renders are going now, and any values an
   earlier version kept in the schedule file, brought across so saving keeps them. *@
@using System.Globalization
@using System.IO
@using Microsoft.Extensions.Options
@inject GeneratedPromoService Promos
@inject SchedulerConfigProvider Config
@inject IOptions<GeneratedPromoOptions> Options

<div class="field">
    <span>Save folder in use</span>
    <div><code>@Promos.Root</code></div>
</div>
@if (!Directory.Exists(Promos.Root))
{
    <p class="hint">This folder doesn't exist yet; it will be created on the first render.</p>
}
@if (_brought.Count > 0)
{
    <p class="hint">
        Filled in from the schedule file, where an earlier version kept them: @string.Join(", ", _brought).
        Save to keep them here; the schedule file's copies are ignored from then on.
    </p>
}

@code {
    [Parameter, EditorRequired] public PluginSettingsEditor Editor { get; set; } = default!;

    private readonly List<string> _brought = [];

    protected override void OnInitialized()
    {
        // A setting never saved here still follows the schedule file. Where that says something other than the default,
        // it's filled in, so saving the plugin's settings doesn't quietly change it.
        GeneratedPromoOptions saved = Options.Value;
        SchedulerSettings old = Config.Current.Settings;
        var defaults = new SchedulerSettings();

        if (saved.SaveFolder is null && old.GeneratedPromosPath is { Length: > 0 } path)
        {
            Bring("SaveFolder", path, "the save folder");
        }

        if (saved.LeadTime is null && old.GeneratedPromosLeadTime != defaults.GeneratedPromosLeadTime)
        {
            Bring("LeadTimeMinutes", Number(old.GeneratedPromosLeadTime.TotalMinutes), "when to start rendering");
        }

        if (saved.WatchedOnly is null && old.GeneratedPromosWatchedOnly != defaults.GeneratedPromosWatchedOnly)
        {
            Bring("WatchedOnly", old.GeneratedPromosWatchedOnly ? "true" : "false", "only rendering for watched channels");
        }

        if (saved.KeepVideos is null && old.GeneratedPromosKeepVideos != defaults.GeneratedPromosKeepVideos)
        {
            Bring("KeepVideosDays", Number(old.GeneratedPromosKeepVideos.TotalDays), "how long unused videos are kept");
        }

        if (saved.KeepAudio is null && old.GeneratedPromosKeepAudio != defaults.GeneratedPromosKeepAudio)
        {
            Bring("KeepAudioDays", Number(old.GeneratedPromosKeepAudio.TotalDays), "how long voice-overs are kept");
        }
    }

    private void Bring(string key, string value, string what)
    {
        Editor.Set(key, value);
        _brought.Add(what);
    }

    private static string Number(double value) => Math.Round(value, 3).ToString(CultureInfo.InvariantCulture);
}
