<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TikTok voices for generated promos. Not part of the main download: it ships in the all-plugins zip of each
    release (see .github/workflows/build.yml) and is installed from the Plugins page.
  -->
  <PropertyGroup>
    <RootNamespace>SchedularrTV.Speech.TikTok</RootNamespace>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplied by the scheduler at runtime, so it isn't copied into the plugin. -->
    <ProjectReference Include="..\..\src\SchedularrTV.Plugins.Abstractions\SchedularrTV.Plugins.Abstractions.csproj" Private="false" />
  </ItemGroup>

  <!-- plugin.json is copied beside the .dll by plugins/Directory.Build.targets. -->
  <ItemGroup>
    <Using Include="SchedularrTV.Plugins" />
    <Using Include="SchedularrTV.Plugins.Speech" />
  </ItemGroup>

</Project>
