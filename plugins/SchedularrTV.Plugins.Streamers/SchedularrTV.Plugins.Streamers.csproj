<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Streamer channels: Twitch and YouTube streamers in priority order on a channel of their own. Whoever is live is
    shown, with their chat and a word about the others who are live too; while nobody is, a countdown to the next
    stream, predicted from their past ones. No API keys: it reads the sites the way their own pages do, and yt-dlp
    opens the streams. Not part of the main download: it ships in the all-plugins zip of each release.

    It finds yt-dlp the way the scheduler finds ffmpeg, so it builds against the scheduler itself and has to come from
    the same release as the scheduler it runs in.
  -->
  <PropertyGroup>
    <RootNamespace>SchedularrTV.Streamers</RootNamespace>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <ScopedCssEnabled>false</ScopedCssEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplied by the scheduler at runtime, so none of it is copied into the plugin. -->
    <ProjectReference Include="..\..\src\SchedularrTV.Service\SchedularrTV.Service.csproj" Private="false" ExcludeAssets="runtime;native" />
    <ProjectReference Include="..\..\src\SchedularrTV.Plugins.Abstractions\SchedularrTV.Plugins.Abstractions.csproj" Private="false" />

    <!-- Shared with the other live page channels; shipped beside this plugin's .dll. -->
    <ProjectReference Include="..\shared\SchedularrTV.LiveCapture\SchedularrTV.LiveCapture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The channel's page (HTML, CSS and script in one file), served from the plugin. -->
    <EmbeddedResource Include="Assets\streamers.html" LogicalName="streamers.html" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SchedularrTV.Plugins" />
    <Using Include="SchedularrTV.Plugins.Playout" />
    <Using Include="SchedularrTV.LiveCapture" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
