@page "/plugins/iptv"
@* IPTV providers: a playlist and its guide each, and which of their channels to carry alongside your own. *@
@implements IDisposable
@inject SourceStore Store
@inject IptvCatalog Catalog
@inject IptvChannels Channels
@inject IptvFetcher Fetcher
@inject IptvRefresher Refresher
@inject RelayHub Hub
@inject IptvOrgApi IptvOrgLists
@inject IptvOrgGuides IptvOrgGuides

<div class="page-header">
    <div>
        <div class="eyebrow">IPTV passthrough</div>
        <h1>IPTV</h1>
        <p class="muted">Live channels from an IPTV playlist and its guide, carried alongside your own: they appear in ErsatzTV's channel list and
            Jellyfin's guide with everything else, with the provider's listings.</p>
    </div>
    <div class="spacer"></div>
    <button class="btn" type="button" disabled="@Refresher.Refreshing" @onclick="Refresher.RequestRefresh">
        @(Refresher.Refreshing ? "Reading playlists…" : "Refresh now")
    </button>
</div>

@if (_message is not null)
{
    <div class="banner @(_messageOk ? "banner-ok" : "banner-error")" role="status">@_message</div>
}

<LowPowerNotice Title="@($"IPTV on {HardwareProfile.DeviceName}")" Advice="LowPowerAdvice">
    Passed-through channels are relayed as they are, which costs almost nothing here. The heavier parts are re-encoding and the
    iptv-org guide grabber.
</LowPowerNotice>

@foreach (IptvSource source in _sources)
{
    bool editing = ReferenceEquals(source, _editing);
    SourceCatalog? loaded = string.IsNullOrEmpty(source.Id) ? null : Catalog.Get(source.Id);
    List<CarriedChannel> carried = [.. _carried.Where(channel => string.Equals(channel.SourceId, source.Id, StringComparison.OrdinalIgnoreCase))];
    <div class="card" @key="source">
        <div class="card-head">
            <h2>@(string.IsNullOrWhiteSpace(source.Name) ? "New provider" : source.Name)</h2>
            @if (!source.Enabled)
            {
                <span class="pill pill-muted">Off</span>
            }
            <span class="pill pill-muted">@(source.Passthrough ? "Passthrough" : "Re-encoded")</span>
            <div class="spacer"></div>
            @if (_confirmDelete == source.Id && !string.IsNullOrEmpty(source.Id))
            {
                <button class="btn btn-sm btn-danger" type="button" @onclick="() => Remove(source)">Delete @(source.Name)?</button>
                <button class="btn btn-sm" type="button" @onclick="() => _confirmDelete = null">Keep</button>
            }
            else
            {
                @if (!editing)
                {
                    <button class="btn btn-sm" type="button" @onclick="() => Edit(source)">Edit</button>
                }
                <button class="btn btn-sm btn-ghost" type="button" @onclick="() => AskDelete(source)">Delete</button>
            }
        </div>

        @if (editing)
        {
            <div class="iptv-org-box">
                <strong>Free channels from iptv-org</strong>
                <span class="muted">Pick a playlist from <a href="https://github.com/iptv-org/iptv" target="_blank" rel="noopener">iptv-org</a> instead of typing an address.</span>
                <div class="row row-wrap" style="gap:8px;margin-top:8px;">
                    <select value="@_orgKind" @onchange="PickKindAsync">
                        <option value="Country">A country</option>
                        <option value="Category">A category</option>
                        <option value="Language">A language</option>
                        <option value="Everything">Everything</option>
                    </select>
                    @if (_orgKind != IptvOrgPlaylistKind.Everything)
                    {
                        <select value="@_orgCode" style="flex:1;min-width:200px;" @onchange="e => _orgCode = Text(e)">
                            <option value="">@(_orgLoading ? "Loading…" : "Choose…")</option>
                            @foreach (IptvOrgChoice choice in _orgChoices)
                            {
                                <option value="@choice.Code">@choice.Name</option>
                            }
                        </select>
                    }
                    <button class="btn btn-sm" type="button" disabled="@(_orgKind != IptvOrgPlaylistKind.Everything && _orgCode.Length == 0)"
                            @onclick="() => UseIptvOrgAsync(source)">Use this playlist</button>
                </div>
                @if (_orgProblem is { } orgProblem)
                {
                    <p class="hint warn" style="margin:6px 0 0;">@orgProblem</p>
                }
            </div>

            <div class="grid grid-2">
                <label class="field"><span>Name</span>
                    <input type="text" value="@source.Name" placeholder="My provider" @onchange="e => source.Name = Text(e)" /></label>
                <label class="field"><span>First channel number</span>
                    <input type="number" min="1" value="@source.FirstNumber" @onchange="e => source.FirstNumber = Int(e, source.FirstNumber)" /></label>
            </div>
            <label class="field"><span>Playlist (M3U) address or file</span>
                <input type="text" value="@source.PlaylistUrl" placeholder="http://provider.example/get.php?username=…&password=…&type=m3u_plus"
                       @onchange="e => source.PlaylistUrl = Text(e)" /></label>
            <label class="check"><input type="checkbox" checked="@source.IptvOrgGuide" @onchange="e => source.IptvOrgGuide = e.Value is true" />
                <span>Make the guide with iptv-org/epg</span></label>
            <p class="hint" style="margin:0 0 10px;">
                Free listings for the carried channels, grabbed from the TV listings sites <a href="https://github.com/iptv-org/epg" target="_blank" rel="noopener">iptv-org/epg</a>
                knows for each one (matched by the playlist's tvg-id, else the channel's name). The first time, the plugin sets up the grabber in its own
                folder (Node.js, unless you have it, and iptv-org/epg: a few hundred MB and a few minutes); after that the guide is grabbed every few hours.
            </p>
            @if (source.IptvOrgGuide)
            {
                <LowPowerNotice Inline="true" Title="@GrabberWarning" />
            }
            <label class="field"><span>Guide (XMLTV) address or file <span class="muted">(.xml or .xml.gz; @(source.IptvOrgGuide ? "optional: fills in channels iptv-org has nothing for" : "empty uses the one the playlist names"))</span></span>
                <input type="text" value="@source.GuideUrl" placeholder="@(source.IptvOrgGuide ? "" : _preview?.GuideUrls.FirstOrDefault() ?? "http://provider.example/xmltv.php?username=…&password=…")"
                       @onchange="e => source.GuideUrl = Text(e)" /></label>
            <div class="grid grid-2">
                <label class="field"><span>User agent <span class="muted">(optional)</span></span>
                    <input type="text" value="@source.UserAgent" placeholder="Some providers want a particular player's" @onchange="e => source.UserAgent = Text(e)" /></label>
                <label class="field"><span>Guide group <span class="muted">(optional; empty keeps the playlist's groups)</span></span>
                    <input type="text" value="@source.Group" placeholder="IPTV" @onchange="e => source.Group = Text(e)" /></label>
            </div>
            <div class="row row-wrap" style="gap:18px;margin-bottom:10px;">
                <label class="check"><input type="checkbox" checked="@source.Enabled" @onchange="e => source.Enabled = e.Value is true" /><span>On</span></label>
                <label class="check"><input type="checkbox" checked="@source.Passthrough" @onchange="e => source.Passthrough = e.Value is true" />
                    <span>Pass video and audio through without re-encoding (recommended)</span></label>
            </div>
            @if (!source.Passthrough)
            {
                <LowPowerNotice Inline="true" Title="With passthrough off, ErsatzTV re-encodes every one of these channels while it's watched, in software on a Raspberry Pi. Leave it on unless a player can't play the provider's streams." />
            }

            <h3 class="iptv-section">Channels</h3>
            <div class="row" style="gap:8px;margin-bottom:10px;">
                <button class="btn btn-sm" type="button" disabled="@(_loading || string.IsNullOrWhiteSpace(source.PlaylistUrl))" @onclick="() => LoadAsync(source)">
                    @(_loading ? "Reading the playlist…" : _preview is null ? "Load channels" : "Load again")
                </button>
                <label class="check" style="margin:0;"><input type="checkbox" checked="@source.IncludeAll" @onchange="e => source.IncludeAll = e.Value is true" />
                    <span>Carry every channel in the playlist</span></label>
            </div>

            @if (_preview is { } playlist && !source.IncludeAll)
            {
                List<PlaylistChannel> shown = [.. Shown(playlist)];
                <div class="row row-wrap" style="gap:8px;margin-bottom:8px;">
                    <input type="search" value="@_filter" placeholder="Filter by name" style="flex:1;min-width:180px;" @oninput="e => _filter = Text(e)" />
                    <select value="@_group" @onchange="e => _group = Text(e)">
                        <option value="">Every group</option>
                        @foreach (string group in playlist.Channels.Select(channel => channel.Group ?? string.Empty).Where(group => group.Length > 0).Distinct().Order())
                        {
                            <option value="@group">@group</option>
                        }
                    </select>
                    <button class="btn btn-sm" type="button" @onclick="() => SelectShown(source, shown, true)">Carry all shown</button>
                    <button class="btn btn-sm btn-ghost" type="button" @onclick="() => SelectShown(source, shown, false)">Drop all shown</button>
                </div>
                <p class="hint">@source.Selected.Count of @playlist.Channels.Count carried. @(shown.Count > PageSize ? $"Showing the first {PageSize} of {shown.Count} matches." : $"{shown.Count} shown.")</p>
                <div class="iptv-list">
                    @foreach (PlaylistChannel channel in shown.Take(PageSize))
                    {
                        bool selected = source.Selected.Contains(channel.Key);
                        <label class="iptv-row @(selected ? "on" : "")" @key="channel.Key">
                            <input type="checkbox" checked="@selected" @onchange="e => Toggle(source, channel.Key, e.Value is true)" />
                            <span class="iptv-number">@(source.Numbers.TryGetValue(channel.Key, out int number) ? number.ToString(CultureInfo.InvariantCulture) : selected ? "new" : "")</span>
                            @if (!string.IsNullOrWhiteSpace(channel.Logo))
                            {
                                <img src="@channel.Logo" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="iptv-logo"></span>
                            }
                            <span class="iptv-name">@channel.Name</span>
                            <span class="muted">@channel.Group</span>
                        </label>
                    }
                </div>
            }
            else if (_preview is null && !source.IncludeAll)
            {
                <p class="hint">Load the playlist to choose its channels.</p>
            }

            <div class="row" style="gap:8px;margin-top:12px;">
                <div class="spacer"></div>
                <button class="btn btn-sm" type="button" @onclick="Cancel">Cancel</button>
                <button class="btn btn-sm btn-primary" type="button" disabled="@string.IsNullOrWhiteSpace(source.PlaylistUrl)" @onclick="Save">Save</button>
            </div>
        }
        else
        {
            <p class="muted" style="margin:0 0 8px;">
                @IptvFetcher.Redact(source.PlaylistUrl)
                @if (loaded is not null)
                {
                    <text> · @loaded.Playlist.Channels.Count channel(s), @carried.Count carried · read @loaded.LoadedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</text>
                }
            </p>
            @if (loaded?.Problem is { } problem)
            {
                <p class="hint warn">@problem</p>
            }
            @if (loaded?.GuideProblem is { } guideProblem)
            {
                <p class="hint warn">@guideProblem</p>
            }
            @if (source.IptvOrgGuide && !string.IsNullOrEmpty(source.Id))
            {
                IptvOrgStatus org = IptvOrgGuides.Status(source.Id);
                <div class="row row-wrap" style="gap:8px;align-items:center;margin:0 0 8px;">
                    <span class="pill pill-muted">iptv-org guide</span>
                    @if (org.Activity is { } activity)
                    {
                        <span class="hint" style="margin:0;">@activity…</span>
                    }
                    else if (org.GrabbedAt is { } grabbed)
                    {
                        <span class="hint" style="margin:0;">
                            Listings for @org.Listed of @org.Planned channel(s) with a listings site
                            @(org.Unknown > 0 ? $"({org.Unknown} more iptv-org has no site for)" : "")
                            · grabbed @grabbed.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)
                        </span>
                    }
                    else
                    {
                        <span class="hint" style="margin:0;">Not grabbed yet.</span>
                    }
                    <button class="btn btn-sm btn-ghost" type="button" disabled="@(org.Activity is not null)" @onclick="() => IptvOrgGuides.GrabNow(source.Id)">Grab now</button>
                </div>
                @if (org.Problem is { } orgProblem && org.Activity is null)
                {
                    <p class="hint warn">@orgProblem</p>
                }
            }
            @if (carried.Count > 0)
            {
                <div class="iptv-carried">
                    @foreach (CarriedChannel channel in carried.OrderBy(channel => channel.Number))
                    {
                        RelayStatus? relaying = Hub.Running.FirstOrDefault(status => status.Key == $"{source.Id}/{channel.Number.ToString(CultureInfo.InvariantCulture)}");
                        <div class="iptv-carried-row">
                            <span class="channel-number">@channel.Number</span>
                            <span class="iptv-name">@channel.Channel.Name</span>
                            @if (relaying is not null)
                            {
                                <span class="pill pill-ok">On air · @relaying.Viewers</span>
                            }
                            @if (channel.NumberTaken)
                            {
                                <span class="pill pill-danger" title="One of your own channels has this number, so this one is left out.">Number taken</span>
                            }
                            else if (channel.Listings == 0)
                            {
                                <span class="pill pill-muted" title="Shown in the guide under its own name.">No listings</span>
                            }
                            else
                            {
                                <span class="muted">@channel.Listings listings</span>
                            }
                        </div>
                    }
                </div>
            }
            else if (loaded is not null && loaded.Problem is null)
            {
                <p class="hint">No channels carried yet. Edit the provider to choose some.</p>
            }
        }
    </div>
}

<div class="row" style="gap:8px;">
    <button class="btn btn-primary" type="button" disabled="@(_editing is not null)" @onclick="Add">Add a provider</button>
    <button class="btn" type="button" disabled="@(_editing is not null)" @onclick="AddIptvOrgAsync">Add free channels from iptv-org</button>
</div>

<div class="card" style="margin-top:16px;">
    <div class="card-head"><h2>How it works</h2></div>
    <ul class="hint" style="margin:0;padding-left:18px;line-height:1.6;">
        <li>Carried channels are added to ErsatzTV's lineup with your own, under the numbers shown, so Jellyfin finds them on the same tuner and guide. A channel keeps its number when the playlist changes.</li>
        <li>The guide is the provider's own listings, as they wrote them. Channels without listings show their name instead.</li>
        <li>When a channel is watched, the scheduler relays the provider's stream (HLS or MPEG-TS) through ffmpeg without re-encoding it, and ErsatzTV passes it on; with passthrough off, ErsatzTV re-encodes it to the channel's settings.</li>
        <li>Playlists and guides are read again every few hours (the plugin's settings), and when you save here. Changes reach ErsatzTV straight away; new or removed channels restart it.</li>
        <li>A number already used by one of your own channels is skipped: change the provider's first number, or the channel's.</li>
    </ul>
</div>

<style>
    .iptv-section { font-size: 13px; margin: 16px 0 8px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
    .iptv-list { max-height: 420px; overflow-y: auto; border: 1px solid var(--line); border-radius: 8px; }
    .iptv-row { display: flex; align-items: center; gap: 10px; padding: 6px 10px; border-bottom: 1px solid var(--line); cursor: pointer; margin: 0; }
    .iptv-row:last-child { border-bottom: 0; }
    .iptv-row.on { background: rgba(111, 127, 255, .08); }
    .iptv-row img, .iptv-logo { width: 36px; height: 22px; object-fit: contain; flex: none; }
    .iptv-number { width: 44px; text-align: right; font-family: var(--mono); font-size: 12px; color: var(--muted); flex: none; }
    .iptv-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .iptv-carried { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 6px 16px; }
    .iptv-carried-row { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .hint.warn { color: #ffd08a; }
    .iptv-org-box { border: 1px dashed var(--line); border-radius: 10px; padding: 10px 12px; margin-bottom: 14px; display: flex; flex-direction: column; }
</style>

@code {
    private const int PageSize = 300;

    private List<IptvSource> _sources = [];
    private IReadOnlyList<CarriedChannel> _carried = [];

    private static string GrabberWarning =>
        "The grabber runs Node.js for up to a few hours each time, with up to 2 GB of memory, and its first setup downloads a few hundred MB"
        + (HardwareProfile.Detected.MemoryGb is > 0 and < 4.5
            ? ". With this little memory it can starve the channels on air; prefer the provider's own XMLTV guide."
            : ". Keep the days of listings and requests at once low (plugin settings).");

    private IEnumerable<string?> LowPowerAdvice =>
    [
        _sources.Any(source => !string.IsNullOrEmpty(source.Id) && !source.Passthrough)
            ? "A provider has passthrough off: ErsatzTV re-encodes its channels in software here. Turn passthrough on where players can take the streams as they are."
            : null,
        _sources.Any(source => !string.IsNullOrEmpty(source.Id) && source.IptvOrgGuide) ? GrabberWarning : null,
        "Very large provider playlists (with films and series, 100 MB or more) are read whole into memory at each refresh; a playlist of live channels only, if the provider offers one, is much lighter."
    ];
    private IptvSource? _editing;
    private Playlist? _preview;
    private bool _loading;
    private string _filter = string.Empty;
    private string _group = string.Empty;
    private string? _confirmDelete;
    private string? _message;
    private bool _messageOk;

    private IptvOrgPlaylistKind _orgKind = IptvOrgPlaylistKind.Country;
    private string _orgCode = string.Empty;
    private IReadOnlyList<IptvOrgChoice> _orgChoices = [];
    private bool _orgLoading;
    private string? _orgProblem;

    protected override void OnInitialized()
    {
        Load();
        Catalog.Changed += OnChanged;
        Refresher.StateChanged += OnChanged;
        Hub.Changed += OnChanged;
        IptvOrgGuides.Changed += OnChanged;
    }

    public void Dispose()
    {
        Catalog.Changed -= OnChanged;
        Refresher.StateChanged -= OnChanged;
        Hub.Changed -= OnChanged;
        IptvOrgGuides.Changed -= OnChanged;
    }

    /// <summary>A new provider set up for an iptv-org playlist, its picker open on countries.</summary>
    private async Task AddIptvOrgAsync()
    {
        Add();
        if (_editing is { } source)
        {
            source.IptvOrgGuide = true;
            source.Passthrough = true;
        }

        _orgCode = string.Empty;
        await Task.CompletedTask;
    }

    private async Task PickKindAsync(ChangeEventArgs e)
    {
        _orgKind = Enum.TryParse(Text(e), out IptvOrgPlaylistKind kind) ? kind : IptvOrgPlaylistKind.Country;
        _orgCode = string.Empty;
        await LoadChoicesAsync();
    }

    private async Task LoadChoicesAsync()
    {
        _orgChoices = [];
        _orgProblem = null;
        if (_orgKind == IptvOrgPlaylistKind.Everything)
        {
            return;
        }

        _orgLoading = true;
        StateHasChanged();
        try
        {
            _orgChoices = _orgKind switch
            {
                IptvOrgPlaylistKind.Category => await IptvOrgLists.CategoriesAsync(CancellationToken.None),
                IptvOrgPlaylistKind.Language => await IptvOrgLists.LanguagesAsync(CancellationToken.None),
                _ => await IptvOrgLists.CountriesAsync(CancellationToken.None)
            };
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or IOException or System.Text.Json.JsonException)
        {
            _orgProblem = $"Couldn't read iptv-org's lists: {ex.Message}";
        }
        finally
        {
            _orgLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>Points the provider at the chosen iptv-org playlist, with the iptv-org guide, and reads its channels.</summary>
    private async Task UseIptvOrgAsync(IptvSource source)
    {
        string code = _orgKind == IptvOrgPlaylistKind.Everything ? "index" : _orgCode;
        string label = _orgKind == IptvOrgPlaylistKind.Everything ? "Everything" : _orgChoices.FirstOrDefault(choice => choice.Code == code)?.Name ?? code;
        source.PlaylistUrl = IptvOrgApi.PlaylistUrl(_orgKind, code);
        source.IptvOrgGuide = true;
        if (string.IsNullOrWhiteSpace(source.Name) || source.Name.StartsWith("iptv-org", StringComparison.Ordinal))
        {
            source.Name = $"iptv-org: {label}";
        }

        await LoadAsync(source);
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        _carried = Channels.Carried();
        StateHasChanged();
    });

    private void Load()
    {
        _sources = [.. Store.Sources.Select(source => source.Copy())];
        _carried = Channels.Carried();
        _editing = null;
        _preview = null;
        _filter = string.Empty;
        _group = string.Empty;
    }

    private IEnumerable<PlaylistChannel> Shown(Playlist playlist) => playlist.Channels.Where(channel =>
        (_group.Length == 0 || string.Equals(channel.Group, _group, StringComparison.Ordinal))
        && (_filter.Length == 0 || channel.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)));

    private void Edit(IptvSource source)
    {
        if (_editing is not null)
        {
            Load();
            source = _sources.FirstOrDefault(candidate => candidate.Id == source.Id) ?? source;
        }

        _editing = source;
        _preview = Catalog.Get(source.Id)?.Playlist is { Channels.Count: > 0 } known ? known : null;
        _message = null;
        LoadChoicesOnce();
    }

    // The iptv-org picker's list, read the first time an editor opens.
    private void LoadChoicesOnce()
    {
        if (_orgChoices.Count == 0 && !_orgLoading)
        {
            _ = LoadChoicesAsync();
        }
    }

    private void Add()
    {
        var source = new IptvSource { FirstNumber = NextFirstNumber() };
        _sources.Add(source);
        _editing = source;
        _preview = null;
        _message = null;
        LoadChoicesOnce();
    }

    /// <summary>A block of numbers after every provider's, so a second provider doesn't land among the first's.</summary>
    private int NextFirstNumber()
    {
        int highest = Store.Sources.SelectMany(source => source.Numbers.Values.Append(source.FirstNumber)).DefaultIfEmpty(0).Max();
        return highest < 1000 ? 1000 : (highest / 1000 + 1) * 1000;
    }

    private void Cancel() => Load();

    private async Task LoadAsync(IptvSource source)
    {
        _loading = true;
        try
        {
            _preview = await Fetcher.LoadPlaylistAsync(source, CancellationToken.None);
            _message = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException or InvalidOperationException or TaskCanceledException or UnauthorizedAccessException)
        {
            Say($"Couldn't read the playlist: {ex.Message}", ok: false);
        }
        finally
        {
            _loading = false;
        }
    }

    private static void Toggle(IptvSource source, string key, bool on)
    {
        source.Selected.Remove(key);
        if (on)
        {
            source.Selected.Add(key);
        }
    }

    private static void SelectShown(IptvSource source, List<PlaylistChannel> shown, bool on)
    {
        foreach (PlaylistChannel channel in shown)
        {
            Toggle(source, channel.Key, on);
        }
    }

    private void AskDelete(IptvSource source)
    {
        if (string.IsNullOrEmpty(source.Id))
        {
            Load();
            return;
        }

        _confirmDelete = source.Id;
    }

    private void Remove(IptvSource source)
    {
        _confirmDelete = null;
        try
        {
            Store.Save(Store.Sources.Where(saved => !string.Equals(saved.Id, source.Id, StringComparison.OrdinalIgnoreCase)));
            Load();
            Say($"Deleted {source.Name}. Its channels leave ErsatzTV's lineup now.", ok: true);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Say($"Couldn't delete the provider: {ex.Message}", ok: false);
        }
    }

    private void Save()
    {
        string name = _editing?.Name ?? string.Empty;
        try
        {
            Store.Save(_sources);
            Load();
            Say($"Saved {name}. Its playlist and guide are being read; its channels reach ErsatzTV in a moment.", ok: true);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Say($"Couldn't save: {ex.Message}", ok: false);
        }
    }

    private void Say(string message, bool ok)
    {
        _message = message;
        _messageOk = ok;
    }

    private static string Text(ChangeEventArgs e) => e.Value?.ToString()?.Trim() ?? string.Empty;

    private static int Int(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int value) ? value : fallback;
}
