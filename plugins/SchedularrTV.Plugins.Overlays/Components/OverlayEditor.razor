@* One overlay: its look (a design on a canvas, or a file placed on the picture) and when it shows. Laid out like the
   Generated promos template editor: the canvas fills the width with its layers on the right, and the rest under it.
   Its layer list, groups, locking, shapes, masks, timeline and keyframes work as the template editor's do: keep the two in step. *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject ConfigEditor Editor

<div class="card visual-editor">
    <div class="card-head">
        <h2>@Overlay.Name</h2>
        <span class="pill pill-muted">@(Overlay.Kind == OverlayKinds.File ? "File" : OverlayAnimation.IsAnimated(Overlay) ? "Animated design" : "Design")</span>
    </div>

    <div class="grid grid-2">
        <label class="field"><span>Name</span>
            <input type="text" value="@Overlay.Name" @onchange="e => Set(() => Overlay.Name = Text(e, Overlay.Name))" /></label>
        <label class="field"><span>Look</span>
            <select value="@Overlay.Kind" @onchange="e => Set(() => Overlay.Kind = Text(e, OverlayKinds.Design))">
                <option value="design">Designed here (text, pictures, shapes)</option>
                <option value="file">A picture or video file</option>
            </select></label>
    </div>

    <OverlayImagesEditor Overlay="Overlay" Changed="CommitAsync" />
    @if (Overlay.VariableImages.Count > 0)
    {
        <details class="ed-plain">
            <summary>Preview show contexts</summary>
            <div class="grid grid-2">
                <label class="field"><span>Currently watching</span>
                    <input type="text" @bind="_previewCurrent" @bind:after="RefreshPreview" />
                </label>
                <label class="field"><span>Upcoming show titles (one per line, next first)</span>
                    <textarea rows="3" @bind="_previewUpcoming" @bind:after="RefreshPreview"></textarea>
                </label>
            </div>
            <p class="hint">Try the show titles assigned below. These are preview-only; on air, the schedule supplies the shows.</p>
        </details>
    }

    <div class="ed-workspace">
        <div class="ed-stage">
            @if (IsDesign)
            {
                <div class="ed-toolbar">
                    <span class="ed-toolbar-label">Add</span>
                    <button class="btn btn-sm" type="button" @onclick="() => AddLayer(OverlayLayerKinds.Text)">+ Text</button>
                    <button class="btn btn-sm" type="button" @onclick="() => AddLayer(OverlayLayerKinds.Image)">+ Picture</button>                    <button class="btn btn-sm" type="button" @onclick="() => AddLayer(OverlayLayerKinds.Rect)">+ Shape</button>
                    <button class="btn btn-sm" type="button" @onclick="() => AddLayer(OverlayLayerKinds.Video)">+ Video</button>
                    <div class="spacer"></div>
                    <span class="ed-meta">@Overlay.Width × @Overlay.Height</span>
                </div>
            }
            <div class="ed-viewport" id="@_viewportId">
            <span class="ed-zoom-badge" aria-hidden="true"></span>
            <div class="ed-canvas" id="@_canvasId" role="group" aria-label="Overlay canvas" @onpointerenter="MeasureCanvas"
                 style="aspect-ratio:@(CanvasWidth) / @(CanvasHeight);">
                @* The preview. Script swaps each new picture in once it has decoded, so it never blanks while scrubbing. *@
                <div class="ed-still" id="@_stillId" aria-hidden="true"></div>
                @if (IsDesign)
                {
                    @foreach (OverlayLayer layer in Overlay.Layers)
                    {
                        bool isSelected = ReferenceEquals(layer, _layer);
                        bool inSelection = _chosen.Contains(layer);
                        OverlayBox box = OverlayHierarchy.World(Overlay, layer, _time);
                        bool isGroupBox = OverlayHierarchy.IsGroup(layer);
                        bool locked = OverlayHierarchy.IsLocked(Overlay, layer);
                        bool keyed = OverlayAnimation.HasKeyframes(layer);
                        double angle = layer.Kind == OverlayLayerKinds.Video ? 0 : box.Angle;
                        <div class="layer-box @(isSelected ? "selected" : inSelection ? "chosen" : "") @(VisibleNow(layer) ? "" : "hidden-now") @(keyed ? "keyed" : "") @(isGroupBox ? "group" : "") @(locked ? "locked" : "") @(layer.Mask is null ? "" : "mask")" @key="layer"
                             style="left:@Pct(box.CenterX - box.Width / 2, Overlay.Width);top:@Pct(box.CenterY - box.Height / 2, Overlay.Height);width:@Pct(box.Width, Overlay.Width);height:@Pct(box.Height, Overlay.Height);@(Math.Abs(angle) > 0.001 ? $"transform:rotate({Number(angle)}deg);" : "")"
                             title="@layer.Name" @onpointerdown="e => StartDrag(e, layer, MoveHandle)" @onpointerdown:preventDefault="true">
                            <span class="layer-tag">@(locked ? "🔒 " : "")@(isGroupBox ? "▣ " : "")@(keyed ? "◆ " : "")@Label(layer)</span>
                            @if (isSelected && !locked)
                            {
                                @* A group's box is only what it turns about, so it's moved and turned rather than stretched. *@
                                @foreach (string handle in isGroupBox ? [] : Handles)
                                {
                                    <span class="handle handle-@handle" aria-hidden="true" @onpointerdown="e => StartDrag(e, layer, handle)"
                                          @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true"></span>
                                }
                                @if (layer.Kind != OverlayLayerKinds.Video)
                                {
                                    <span class="handle handle-rotate" title="Drag to turn it (hold Shift for 15° steps)" aria-hidden="true"
                                          @onpointerdown="e => StartRotate(e, layer)" @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true"></span>
                                }
                            }
                        </div>
                    }
                    @if (_drag is not null && _snapX)
                    {
                        <div class="snap-guide snap-guide-x" aria-hidden="true"></div>
                    }
                    @if (_drag is not null && _snapY)
                    {
                        <div class="snap-guide snap-guide-y" aria-hidden="true"></div>
                    }
                }
            </div>

            </div>
            <div class="ed-viewport-bar">
                <span class="hint" style="margin:0;">Ctrl/⌘ + scroll to zoom in for precise edits, middle-drag to pan.</span>
                <div class="spacer"></div>
                <button class="btn btn-sm" type="button" title="Show the whole frame again (Ctrl/⌘ + 0)" @onclick="ResetZoom">Fit</button>
            </div>

            @if (IsDesign)
            {
                <div class="ed-timeline">
                    <div class="ed-timeline-head">
                        <div class="ed-frame-step" role="group" aria-label="Step through frames">
                            <button class="btn btn-sm" type="button" title="Back a second (Shift+←)" aria-label="Back a second" @onclick="() => StepFrames(-FramesPerSecond)">«</button>
                            <button class="btn btn-sm" type="button" title="Previous frame (← or ,)" aria-label="Previous frame" @onclick="() => StepFrames(-1)">‹</button>
                            <button class="btn btn-sm" type="button" title="Next frame (→ or .)" aria-label="Next frame" @onclick="() => StepFrames(1)">›</button>
                            <button class="btn btn-sm" type="button" title="Forward a second (Shift+→)" aria-label="Forward a second" @onclick="() => StepFrames(FramesPerSecond)">»</button>
                        </div>
                        <span>
                            <strong>@($"{_time:0.000}")s</strong> of @($"{TimelineLength:0.#}")s
                            <span class="ed-meta">· frame @(CurrentFrame + 1) of @FrameCount · @(TimingSchedule.Always ? "the animation as each part of the programme starts" : "one appearance")</span>
                        </span>
                        <div class="spacer"></div>
                        @if (_layer is { } timedLayer)
                        {
                            <span class="ed-meta">@Label(timedLayer)@(timedLayer.Keyframes is { Count: > 0 } timedKeys ? $" · {timedKeys.Count} keyframe{(timedKeys.Count == 1 ? "" : "s")}" : "")</span>
                        }
                    </div>
                    <div class="ed-ruler" id="@_rulerId" role="slider" tabindex="0" aria-label="Preview time" aria-valuemin="0"
                         aria-valuemax="@Number(TimelineLength)" aria-valuenow="@Number(_time)" aria-valuetext="@($"{_time:0.00} seconds")"
                         @onpointerdown="StartScrub" @onpointerdown:preventDefault="true" @onkeydown="RulerKey">
                        @foreach (double tick in Ticks())
                        {
                            <span class="ed-tick @(tick > TimelineLength * 0.92 ? "ed-tick-end" : "")" style="left:@Pct(tick, TimelineLength)"><span>@Number(tick)s</span></span>
                        }
                        @if (_layer is { } spanLayer)
                        {
                            var (spanStart, spanEnd) = Span(spanLayer);
                            <span class="ed-span" style="left:@Pct(spanStart, TimelineLength);width:@Pct(Math.Max(0, spanEnd - spanStart), TimelineLength)"></span>
                            OverlayKeyframe? currentFrame = CurrentKeyframe;
                            @foreach (OverlayKeyframe frame in spanLayer.Keyframes ?? [])
                            {
                                <span class="ed-key @(ReferenceEquals(frame, currentFrame) ? "current" : "") @(SelectedKeys.Contains(frame) ? "selected" : "") @($"ease-{frame.Easing.ToString().ToLowerInvariant()}")" @key="frame"
                                      style="left:@Pct(frame.At.TotalSeconds, TimelineLength)"
                                      title="@($"Keyframe at {frame.At.TotalSeconds:0.00}s, then {EasingName(frame.Easing).ToLowerInvariant()}. Ctrl/⌘-click to toggle, Shift-click for a range; drag to move the selection.")"
                                      @onpointerdown="e => StartKeyDrag(e, spanLayer, frame)" @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true"></span>
                            }
                        }
                        <span class="ed-playhead" style="left:@Pct(_time, TimelineLength)"></span>
                    </div>
                    @if (_layer is { } keyLayer)
                    {
                        <div class="ed-keybar" aria-label="Keyframes">
                            @if (keyLayer.Kind == OverlayLayerKinds.Video)
                            {
                                <span class="hint">ErsatzTV plays a video layer where its box is, so it can't be animated; time it under “Timing within the overlay”.</span>
                            }
                            else if (!OverlayAnimation.HasKeyframes(keyLayer))
                            {
                                <button class="btn btn-sm" type="button" @onclick="() => StartKeyframes(keyLayer)"
                                        title="Animate this layer's position, size, turn and opacity by setting them at different times">◆ Animate with keyframes</button>
                                <span class="hint">Starts with a keyframe here; move the time and drag the box to add more.</span>
                            }
                            else
                            {
                                <button class="btn btn-sm" type="button" title="Previous keyframe" aria-label="Previous keyframe"
                                        disabled="@(NextKeyframe(keyLayer, -1) is null)" @onclick="() => GoToKeyframe(keyLayer, -1)">◀</button>
                                @if (SelectedKeys.Count > 1)
                                {
                                    <strong>@SelectedKeys.Count selected</strong>
                                    <label class="ed-keyfield">
                                        <span>Then (all)</span>
                                        <select value="@SelectedEasing" @onchange="SetSelectedEasing">
                                            <option value="" disabled>Mixed easing</option>
                                            @foreach (GeneratedEasing easing in Enum.GetValues<GeneratedEasing>())
                                            {
                                                <option value="@easing">@EasingName(easing)</option>
                                            }
                                        </select>
                                    </label>
                                    <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveSelectedKeys(keyLayer)">Delete selected</button>
                                    <button class="btn btn-sm" type="button" @onclick="() => _keys.Clear()">Clear selection</button>
                                }
                                else if (EditingKeyframe is { } key)
                                {
                                    <label class="ed-keyfield">
                                        <span>At (s)</span>
                                        <input type="number" min="0" max="@Number(TimelineLength)" step="0.05" value="@Number(key.At.TotalSeconds)"
                                               @onchange="e => SetKeyframeTime(e, keyLayer, key)" />
                                    </label>
                                    <label class="ed-keyfield">
                                        <span>Then</span>
                                        <select value="@key.Easing" title="How it moves on to the next keyframe"
                                                @onchange="e => Set(() => key.Easing = Enum.Parse<GeneratedEasing>(Text(e, nameof(GeneratedEasing.Linear))))">
                                            @foreach (GeneratedEasing easing in Enum.GetValues<GeneratedEasing>())
                                            {
                                                <option value="@easing">@EasingName(easing)</option>
                                            }
                                        </select>
                                    </label>
                                    <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveKeyframe(keyLayer, key)">Delete keyframe</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm" type="button" @onclick="() => AddKeyframe(keyLayer)">◆ Add keyframe at @($"{_time:0.00}")s</button>
                                }
                                <button class="btn btn-sm" type="button" title="Next keyframe" aria-label="Next keyframe"
                                        disabled="@(NextKeyframe(keyLayer, 1) is null)" @onclick="() => GoToKeyframe(keyLayer, 1)">▶</button>
                                <span class="hint">Ctrl/⌘-click to select several; Shift-click for a range. Drag any selected keyframe to move them together.</span>
                                <div class="spacer"></div>
                                <button class="btn btn-sm" type="button" title="Remove every keyframe, leaving the layer where it is now"
                                        @onclick="() => StopKeyframes(keyLayer)">Stop animating</button>
                            }
                        </div>
                    }
                </div>
            }

            <div class="ed-timeline">
                <div class="field">
                    <span>When it shows, on a 22-minute programme</span>
                    <div class="ed-strip" aria-label="When it shows on a 22-minute programme">
                        @foreach ((TimeSpan shownFrom, TimeSpan shownTo) in OverlayDescriptions.Sample(Overlay, SampleLength))
                        {
                            <span class="ed-strip-on" style="left:@Percent(shownFrom);width:@Percent(shownTo - shownFrom);"></span>
                        }
                    </div>
                </div>
                @if (ShowsAppearance)
                {
                    @foreach (Overlay rule in OverlayTiming.Rules(Overlay))
                    {
                        double length = Math.Max(1, rule.DurationSeconds);
                        <div class="field ov-appearance">
                            <span>@OverlayDescriptions.When(rule) — layer by layer, top first</span>
                            @foreach (OverlayLayer layer in Enumerable.Reverse(Overlay.Layers.Where(OverlayRenderer.IsDrawn)).ToList())
                            {
                                (double comesIn, double goesOut) = OverlayDescriptions.Within(rule, layer);
                                string stripClass = layer.Kind == OverlayLayerKinds.Video ? "ed-strip-on ov-video" : "ed-strip-on";
                                <div class="ov-appearance-row @(ReferenceEquals(layer, _layer) ? "selected" : "")" @key="layer">
                                    <button type="button" class="ov-appearance-name" @onclick="() => Select(layer)">@Label(layer)</button>
                                    <div class="ed-strip">
                                        @if (goesOut > comesIn)
                                        {
                                            <span class="@stripClass" style="left:@Fraction(comesIn, length);width:@Fraction(goesOut - comesIn, length);"
                                                  title="@($"{Number(comesIn)}s to {Number(goesOut)}s")"></span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            <p class="hint">
                @OverlayDescriptions.When(Overlay).
                @(IsDesign
                    ? "Shown over a stand-in picture with sample words for {tokens}, and a still from part-way through any video. Drag along the timeline to scrub through an appearance. Drag a box to move it, a handle to resize it, or the round handle to turn it; it snaps to the centre lines unless you hold Alt. Dashed boxes are hidden at this time. On an animated layer (◆), moving or resizing it sets a keyframe at the current time."
                    : "Shown where ErsatzTV will put it, over a stand-in picture. Videos show as a box here.")
            </p>
            @if (IsDesign && OverlayAnimation.IsAnimated(Overlay))
            {
                <p class="hint">
                    Animated: on air it's sent to ErsatzTV as a transparent video of each appearance, made in the background with ffmpeg
                    (for programmes in the next @((int)OverlayProcessor.AnimationLookahead.TotalHours) hours). Until a video is made, the design shows standing still.
                    @(TimingSchedule.Always ? "Shown all the way through, it animates as each part of the programme starts, then stays as it ends up." : "")
                </p>
            }
            @if (_previewError is not null)
            {
                <p class="hint warn" role="alert">Preview failed: @_previewError</p>
            }

            <h3 class="ed-section">Timing</h3>
            <OverlayScheduleEditor Schedule="TimingSchedule" Changed="TimingChanged" />
            <div class="grid grid-3">
                <label class="field"><span>Fade in and out (seconds each)</span>
                    <input type="number" min="0" max="10" step="0.1" value="@Number(Overlay.FadeSeconds)" @onchange="e => Set(() => Overlay.FadeSeconds = Math.Clamp(Number(e, 1), 0, 10))" /></label>
                <label class="field"><span>On</span>
                    <select value="@Overlay.AppliesTo" @onchange="e => Set(() => Overlay.AppliesTo = Text(e, OverlayAppliesTo.Programmes))">
                        <option value="programmes">Programmes only</option>
                        <option value="everything">Everything, breaks too</option>
                    </select></label>
                @if (IsDesign && TimingSchedule.Always)
                {
                    <label class="field"><span>Animation length (seconds)</span>
                        <input type="number" min="1" max="120" step="0.5" value="@Number(OverlayAnimation.AnimationSeconds(Overlay))"
                               @onchange="e => SetAnimationLength(e)" /></label>
                }
            </div>
            <p class="hint">Times are through the whole programme, so one split by ad breaks still gets it at the right moment. ErsatzTV fades in and
                out over the same time.
                @(IsDesign && TimingSchedule.Always ? "The animation length is the timeline above: keyframed layers move over it as each part of the programme starts." : "")</p>

            <h3 class="ed-section">Canvas</h3>
            <div class="grid grid-3">
                @if (IsDesign)
                {
                    <label class="field"><span>Size</span>
                        <select value="@($"{Overlay.Width}x{Overlay.Height}")" @onchange="SetSize">
                            @foreach ((int width, int height, string label) in Sizes)
                            {
                                <option value="@($"{width}x{height}")">@label</option>
                            }
                        </select></label>
                    <label class="field"><span>Frame rate</span>
                        <select value="@OverlayAnimation.FpsText(Fps)" @onchange="e => SetFps(Number(e, OverlayAnimation.DefaultFps))">
                            @if (!FrameRates.Contains(Fps))
                            {
                                <option value="@OverlayAnimation.FpsText(Fps)">@OverlayAnimation.FpsText(Fps) fps</option>
                            }
                            @foreach (double rate in FrameRates)
                            {
                                <option value="@OverlayAnimation.FpsText(rate)">@OverlayAnimation.FpsText(rate) fps</option>
                            }
                        </select></label>
                }
                <label class="field"><span>Overall opacity: @Overlay.Opacity.ToString("0", CultureInfo.InvariantCulture)%</span>
                    <input type="range" min="5" max="100" step="1" value="@Number(Overlay.Opacity)" @onchange="e => Set(() => Overlay.Opacity = Number(e, 100))" /></label>
            </div>
            @if (IsDesign)
            {
                List<double> videoRates = [.. Overlay.Layers
                    .Where(layer => layer.Kind == OverlayLayerKinds.Video && layer.Path is { Length: > 0 })
                    .Select(layer => _videoInfo.GetValueOrDefault(layer.Path!)?.FrameRate)
                    .OfType<double>()
                    .Distinct()];
                @foreach (double rate in videoRates.Where(rate => Math.Abs(rate - Fps) > 0.0005))
                {
                    <button class="btn btn-sm" type="button" @onclick="() => SetFps(rate)">Match the video's @OverlayAnimation.FpsText(rate) fps</button>
                }
                <p class="hint">The timeline steps a frame at a time at this rate, keyframes land on its frames, and an animated design's video is made at it.
                    Match it to the design's videos so keyframed layers line up with their frames.</p>
            }
        </div>

        <div class="ed-side">
            @if (IsDesign)
            {
                <h3 class="ed-section">Layers <span class="ed-meta">top first</span></h3>
                <div class="layer-actions">
                    <span class="ed-meta">@(_chosen.Count > 1 ? $"{_chosen.Count} selected" : "Ctrl or Shift + click to select several")</span>
                    <div class="spacer"></div>
                    <button class="btn btn-sm" type="button" disabled="@(_chosen.Count == 0)" title="Put the selected layers in a group, which can then be moved, turned, faded and animated as one"
                            @onclick="GroupChosen">Group</button>
                    @if (_layer is { Kind: OverlayLayerKinds.Group } openGroup)
                    {
                        <button class="btn btn-sm" type="button" title="Take the layers out of this group and remove it (its own animation goes with it)"
                                @onclick="() => Ungroup(openGroup)">Ungroup</button>
                    }
                    @if (_chosen.Count > 1)
                    {
                        <button class="btn btn-sm btn-danger" type="button" @onclick="RemoveChosen">Delete @_chosen.Count</button>
                    }
                </div>
                <ol class="layer-list layer-tree @(_listDrag is null ? "" : "dragging")" aria-label="Layers">
                    @foreach ((OverlayLayer layer, int depth) in OverlayHierarchy.Rows(Overlay, IsOpen))
                    {
                        bool rowGroup = OverlayHierarchy.IsGroup(layer);
                        string drop = ReferenceEquals(_dropOn, layer) ? $"drop-{_dropWhere.ToString().ToLowerInvariant()}" : "";
                        bool lockedByGroup = !layer.Locked && OverlayHierarchy.IsLocked(Overlay, layer);
                        <li class="layer-row @(ReferenceEquals(layer, _layer) ? "selected" : "") @(_chosen.Contains(layer) ? "chosen" : "") @drop" @key="layer"
                            style="padding-left:@(depth * 16)px" draggable="true"
                            @ondragstart="() => StartListDrag(layer)" @ondragend="EndListDrag"
                            @ondragover="e => ListDragOver(e, layer)" @ondragover:preventDefault="true"
                            @ondrop="e => ListDrop(e, layer)" @ondrop:preventDefault="true">
                            @if (rowGroup)
                            {
                                <button type="button" class="layer-twisty" aria-label="@(IsOpen(layer) ? "Fold" : "Unfold") @Label(layer)"
                                        @onclick="() => ToggleOpen(layer)">@(IsOpen(layer) ? "▾" : "▸")</button>
                            }
                            else
                            {
                                <span class="layer-twisty" aria-hidden="true"></span>
                            }
                            <button type="button" class="layer-select" aria-pressed="@(_chosen.Contains(layer) ? "true" : "false")"
                                    @onclick="e => ClickRow(e, layer)">
                                <span>@(rowGroup ? "▣ " : "")@(OverlayAnimation.HasKeyframes(layer) ? "◆ " : "")@Label(layer)</span>
                                <small>@(layer.Mask is { } rowMask ? $"{rowMask.Mode} mask" : rowGroup ? $"{OverlayHierarchy.Children(Overlay, layer).Count} inside" : KindName(layer.Kind))</small>
                            </button>
                            <button class="layer-lock @(layer.Locked ? "on" : lockedByGroup ? "inherited" : "")" type="button"
                                    aria-pressed="@(layer.Locked ? "true" : "false")" aria-label="@(layer.Locked ? "Unlock" : "Lock") @Label(layer)"
                                    title="@(layer.Locked ? "Unlock: it can be picked and moved on the canvas again" : lockedByGroup ? "Locked by its group" : "Lock: it can't be picked or moved on the canvas (still editable here)")"
                                    @onclick="() => ToggleLock(layer)">@(layer.Locked || lockedByGroup ? "🔒" : "🔓")</button>
                            <button class="btn btn-sm" type="button" title="Bring forward" aria-label="Bring @Label(layer) forward"
                                    @onclick="() => StepLayer(layer, 1)">↑</button>
                            <button class="btn btn-sm" type="button" title="Send backward" aria-label="Send @Label(layer) backward"
                                    @onclick="() => StepLayer(layer, -1)">↓</button>
                        </li>
                    }
                </ol>
                @if (Overlay.Layers.Count == 0)
                {
                    <p class="hint">No layers yet. Add one above the canvas.</p>
                }
                else
                {
                    <p class="hint">Drag layers to reorder them, or onto the middle of a group to put them inside it.</p>
                }

                @if (_layer is { } selected && Overlay.Layers.Contains(selected))
                {
                    <div class="inspector" aria-label="Layer settings">
                        <div class="inspector-head">
                            <h3 class="ed-section">@KindName(selected.Kind)</h3>
                            <div class="spacer"></div>
                            <button class="btn btn-sm" type="button" @onclick="() => DuplicateLayer(selected)">Duplicate</button>
                            <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveLayer(selected)">Delete</button>
                        </div>
                        <label class="field"><span>Layer name</span>
                            <input type="text" value="@selected.Name" @onchange="e => Set(() => selected.Name = Text(e, selected.Name))" /></label>

                        @if (OverlayHierarchy.CanMask(selected))
                        {
                            <label class="field"><span>Use as</span>
                                <select value="@(selected.Mask?.Mode.ToString() ?? "")" @onchange="e => SetLayerMask(selected, e.Value?.ToString() ?? string.Empty)">
                                    <option value="">Visible layer</option>
                                    <option value="@GeneratedMaskMode.Add">Add mask — reveal inside</option>
                                    <option value="@GeneratedMaskMode.Subtract">Subtract mask — hide inside</option>
                                </select></label>
                            @if (selected.Mask is { } mask)
                            {
                                List<OverlayLayer> targets = [.. OverlayHierarchy.MaskTargets(Overlay, selected)];
                                OverlayLayer? chosenTarget = targets.FirstOrDefault(target => target.Id is not null && target.Id == mask.Target);
                                <label class="field"><span>Mask target</span>
                                    <select value="@(chosenTarget is null ? "" : Overlay.Layers.IndexOf(chosenTarget).ToString(CultureInfo.InvariantCulture))"
                                            @onchange="e => SetMaskTarget(selected, e.Value?.ToString() ?? string.Empty)">
                                        <option value="">Choose a layer or group beneath this mask…</option>
                                        @foreach (OverlayLayer target in targets)
                                        {
                                            <option value="@Overlay.Layers.IndexOf(target)">@(OverlayHierarchy.IsGroup(target) ? "▣ " : "")@Label(target)</option>
                                        }
                                    </select></label>
                                @if (chosenTarget is null)
                                {
                                    <p class="hint warn">Choose a target beneath this mask. Move the mask above its target in the layer list if needed.</p>
                                }
                                <p class="hint">The mask itself isn't drawn; its opacity sets how strongly it cuts. Picture masks use the picture's transparency, not its
                                    brightness. Add masks reveal the target only inside them; subtract masks cut holes in it. Keyframe the mask to follow something as it moves.</p>
                                <p class="hint">A group target masks its combined contents, including nested groups. Groups containing video layers can't be masked because ErsatzTV plays those videos separately.</p>
                            }
                        }

                        @if (selected.Kind == OverlayLayerKinds.Text)
                        {
                            <label class="field"><span>Text</span>
                                <input type="text" value="@selected.Text" @onchange="e => Set(() => selected.Text = Text(e, string.Empty))" /></label>
                            <p class="hint">{title} {episode} {season_episode} {year} {channel} {next} {next_time}</p>
                            <label class="check">
                                <input type="checkbox" checked="@(selected.Writer is not null)"
                                       @onchange="e => Set(() => selected.Writer = e.Value is true ? selected.Writer ?? new AiTextConfig() : null)" />
                                <span>Have AI write it for each programme (the text above is the fallback)</span>
                            </label>
                            @if (selected.Writer is { } layerWriter)
                            {
                                <AiTextSettings Config="layerWriter" Changed="CommitAsync" Compact="true" PromptPlaceholder="@LayerPromptPlaceholder"
                                                StylePlaceholder="@LayerStylePlaceholder" WordsPlaceholder="8" Try="@(token => TryLayer(selected, token))"
                                                TryHint="Writes one for a sample episode." />
                            }

                            <h4>Text style</h4>
                            <div class="grid grid-2">
                                <label class="field"><span>Font</span>
                                    <select value="@FontName(selected.FontFamily)" style="font-family: '@selected.FontFamily'"
                                            @onchange="e => Set(() => selected.FontFamily = Text(e, DefaultFont))">
                                        @if (!_fonts.Contains(FontName(selected.FontFamily)))
                                        {
                                            <option value="@selected.FontFamily">@selected.FontFamily (not installed)</option>
                                        }
                                        @foreach (string font in _fonts)
                                        {
                                            <option value="@font" style="font-family: '@font'">@font</option>
                                        }
                                    </select></label>
                                <label class="field"><span>Largest size</span>
                                    <input type="number" min="6" max="400" value="@Number(selected.FontSize)" @onchange="e => Set(() => selected.FontSize = (float)Math.Clamp(Number(e, selected.FontSize), 6, 400))" /></label>
                                <label class="field"><span>Align</span>
                                    <select value="@selected.Align" @onchange="e => Set(() => selected.Align = Text(e, DefaultAlign))">
                                        <option value="left">Left</option>
                                        <option value="center">Centre</option>
                                        <option value="right">Right</option>
                                    </select></label>
                                <div class="check-stack">
                                    <label class="check"><input type="checkbox" checked="@selected.Bold" @onchange="e => Set(() => selected.Bold = e.Value is true)" /><span>Bold</span></label>
                                    <label class="check"><input type="checkbox" checked="@selected.Shadow" @onchange="e => Set(() => selected.Shadow = e.Value is true)" /><span>Drop shadow</span></label>
                                </div>
                            </div>
                            <p class="hint">Text shrinks to fit its box.</p>
                        }
                        else if (selected.Kind == OverlayLayerKinds.Image)
                        {
                            <label class="field"><span>Image source</span>
                                <select value="@selected.VariableImage" @onchange="e => Set(() => selected.VariableImage = Text(e, string.Empty))">
                                    <option value="">Static picture file</option>
                                    @foreach (GeneratedVariableImage image in Overlay.VariableImages)
                                    {
                                        <option value="@image.Name">@(image.Linked is { } linked ? $"{image.Name} (shared: {linked.Name})" : image.Name)</option>
                                    }
                                </select>
                            </label>
                            @if (Overlay.VariableImages.FirstOrDefault(image => string.Equals(image.Name, selected.VariableImage, StringComparison.OrdinalIgnoreCase)) is { } selectedVariable)
                            {
                                <OverlayImageShowSelect Image="selectedVariable" Value="@selected.VariableImageShow"
                                                        ValueChanged="value => Set(() => selected.VariableImageShow = value)" />
                            }
                            @if (!string.IsNullOrWhiteSpace(selected.VariableImage) && VariableStatus(selected.VariableImage, selected.VariableImageShow) is { } variableStatus)
                            {
                                <p class="hint">@variableStatus</p>
                            }
                            else if (string.IsNullOrWhiteSpace(selected.VariableImage))
                            {
                                <div class="field"><span>Picture</span>
                                    <FilePathPicker Value="@selected.Path" ValueChanged="value => Set(() => selected.Path = value)" Extensions="FileBrowsing.Images" KeepCopyIn="@OverlayPackages.AssetCategory"
                                                    Label="picture" StartIn="Environment.SpecialFolder.MyPictures" Placeholder="D:\Media\Logos\channel.png" /></div>
                                @if (Missing(selected.Path))
                                {
                                    <p class="hint warn">The scheduler can't find this file.</p>
                                }
                            }
                        }
                        else if (selected.Kind == OverlayLayerKinds.Video)
                        {
                            <div class="field"><span>Video</span>
                                <FilePathPicker Value="@selected.Path" ValueChanged="value => SetVideo(selected, value)" Extensions="VideoExtensions" KeepCopyIn="@OverlayPackages.AssetCategory"
                                                Label="video" StartIn="Environment.SpecialFolder.MyVideos" Placeholder="D:\Media\Overlays\lower-third.mov" /></div>
                            @if (Missing(selected.Path))
                            {
                                <p class="hint warn">The scheduler can't find this file.</p>
                            }
                            else if (selected.Path is { Length: > 0 } videoPath && _videoInfo.GetValueOrDefault(videoPath) is { } info)
                            {
                                <p class="hint">
                                    @(info.Width > 0 ? $"{info.Width} × {info.Height}" : "")@(info.Width > 0 && info.Duration is not null ? ", " : "")@(info.Duration is { } runs ? $"{Number(runs.TotalSeconds)}s long" : "")@(info.FrameRate is { } videoRate ? $", {OverlayAnimation.FpsText(videoRate)} fps" : "").
                                    @if (_videoFrames.TryGetValue(videoPath, out var shownFrame))
                                    {
                                        <span>@(shownFrame.Shown ? $"Showing its frame {shownFrame.Seconds:0.00}s in." : $"Couldn't take its frame {shownFrame.Seconds:0.00}s in (ffmpeg).")</span>
                                    }
                                </p>
                                <div class="ed-toolbar">
                                    @if (info.Aspect is not null)
                                    {
                                        <button class="btn btn-sm" type="button" @onclick="() => FitVideo(selected, info, fill: false)">Fit box to its shape</button>
                                        <button class="btn btn-sm" type="button" @onclick="() => FitVideo(selected, info, fill: true)">Fill the canvas</button>
                                    }
                                    @if (info.Duration is { } videoLength && !TimingSchedule.Always)
                                    {
                                        <button class="btn btn-sm" type="button" @onclick="() => Set(() => SetDurations(videoLength.TotalSeconds))">
                                            Set all slot lengths to @Number(Math.Round(videoLength.TotalSeconds, 2))s, its length</button>
                                    }
                                </div>
                            }
                            else if (selected.Path is { Length: > 0 } lookedUp && (_videos is null || _videoInfo.ContainsKey(lookedUp)))
                            {
                                <p class="hint">Couldn't read its length or take a still: that needs ffmpeg and ffprobe (as set for Generated promos, or on the PATH).</p>
                            }
                            <p class="hint">A video with an alpha channel (ProRes 4444 .mov, or VP9 .webm) shows the programme through it. ErsatzTV sizes
                                it by the box's width, keeping its shape, and can't turn, mask or animate it. It doesn't fade:
                                its own animation brings it in and out, so time the other layers around it below.</p>
                        }
                        else if (selected.Kind == OverlayLayerKinds.Group)
                        {
                            <p class="hint">
                                A group holds @OverlayHierarchy.Children(Overlay, selected).Count layer(s). Move, turn, fade, time and keyframe it like any
                                layer, and everything inside goes with it while keeping its own animation. Its box is what it turns about;
                                resize it with the numbers below (that moves the turning point, not what's inside).
                            </p>
                        }

                        @if (selected.Kind is OverlayLayerKinds.Text or OverlayLayerKinds.Rect)
                        {
                            <div class="field"><span>Colour</span>
                                <ScreenColourPicker @key="selected" Value="@ColourValue(selected.Color)"
                                                    ValueChanged="colour => Set(() => selected.Color = string.IsNullOrWhiteSpace(colour) ? selected.Color : colour)" /></div>
                        }
                        @if (selected.Kind == OverlayLayerKinds.Rect)
                        {
                            <div class="grid grid-2">
                                <label class="field"><span>Shape</span>
                                    <select value="@(selected.Shape ?? GeneratedShape.Rectangle)"
                                            @onchange="e => Set(() => selected.Shape = ShapeOf(e))">
                                        @foreach (GeneratedShape shape in Enum.GetValues<GeneratedShape>())
                                        {
                                            <option value="@shape">@shape</option>
                                        }
                                    </select></label>
                                <label class="field"><span>Soft edges (pixels)</span>
                                    <input type="number" min="0" max="200" step="1" value="@Number(selected.SoftEdges ?? 0)"
                                           @onchange="e => Set(() => selected.SoftEdges = Number(e, 0) is var soft && soft > 0 ? (float)Math.Clamp(soft, 0, 200) : null)" /></label>
                                @if (selected.Shape is null or GeneratedShape.Rectangle)
                                {
                                    <label class="field"><span>Corner radius</span>
                                        <input type="number" min="0" max="500" value="@Number(selected.CornerRadius)" @onchange="e => Set(() => selected.CornerRadius = (float)Math.Max(0, Number(e, 0)))" /></label>
                                }
                            </div>
                            <p class="hint">Use equal width and height for a circle. Soft edges feather the outline; 0 keeps it sharp.</p>
                        }

                        @{ OverlayPose selectedPose = OverlayAnimation.PoseAt(selected, _time); }
                        <h4>
                            Position (pixels)
                            @if (OverlayAnimation.HasKeyframes(selected))
                            {
                                <span class="ed-meta">· at @($"{_time:0.00}")s; @(CurrentKeyframe is null ? "changing these adds a keyframe" : "this keyframe")</span>
                            }
                        </h4>
                        <div class="grid grid-4">
                            <label class="field"><span>X</span><input type="number" value="@Number(Math.Round(selectedPose.X, 1))" @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { X = (float)value })" /></label>
                            <label class="field"><span>Y</span><input type="number" value="@Number(Math.Round(selectedPose.Y, 1))" @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { Y = (float)value })" /></label>
                            <label class="field"><span>Width</span><input type="number" min="1" value="@Number(Math.Round(selectedPose.Width, 1))" @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { Width = (float)value })" /></label>
                            <label class="field"><span>Height</span><input type="number" min="1" value="@Number(Math.Round(selectedPose.Height, 1))" @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { Height = (float)value })" /></label>
                        </div>
                        <div class="grid grid-2">
                            @if (selected.Kind != OverlayLayerKinds.Video)
                            {
                                <label class="field"><span>Turn (degrees, clockwise)</span>
                                    <input type="number" step="1" value="@Number(Math.Round(selectedPose.Rotation ?? 0, 1))"
                                           @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { Rotation = (float)value })" /></label>
                            }
                            <label class="field"><span>Opacity: @selectedPose.Opacity.ToString("0", CultureInfo.InvariantCulture)%</span>
                                <input type="range" min="0" max="100" step="1" value="@Number(Math.Round(selectedPose.Opacity))"
                                       @onchange="e => SetPoseValue(e, selected, (pose, value) => pose with { Opacity = Math.Clamp(value, 0, 100) })" /></label>
                        </div>
                        @if (OverlayHierarchy.ParentOf(Overlay, selected) is { } holder)
                        {
                            <p class="hint">Inside “@Label(holder)”: these are from the group's top-left corner, turned with it.</p>
                        }

                        <h4>Timing within the overlay</h4>
                        <div class="grid grid-2">
                            <label class="field"><span>Comes in after (seconds)</span>
                                <input type="number" min="0" step="0.1" value="@Number(selected.InSeconds)" @onchange="e => Set(() => selected.InSeconds = Math.Max(0, Number(e, 0)))" /></label>
                            <label class="field"><span>Goes before the end (seconds)</span>
                                <input type="number" min="0" step="0.1" value="@Number(selected.OutSeconds)" @onchange="e => Set(() => selected.OutSeconds = Math.Max(0, Number(e, 0)))" /></label>
                        </div>
                        <p class="hint">
                            @(selected.Kind == OverlayLayerKinds.Video
                                ? "Usually 0 and 0: the video plays for the whole time the overlay shows."
                                : selected.Kind == OverlayLayerKinds.Group
                                    ? "Everything inside the group comes and goes with it."
                                    : TimingSchedule.Always
                                        ? "Measured from the start and end of each part of the programme (between its breaks)."
                                        : "E.g. text over a video that takes 1.5s to animate in and out: in after 1.5, out 1.5 before the end. It fades as the overlay does.")
                        </p>
                    </div>
                }
            }
            else
            {
                <h3 class="ed-section">File</h3>
                <label class="field"><span>File source</span>
                    <select value="@Overlay.VariableImage" @onchange="e => Set(() => Overlay.VariableImage = Text(e, string.Empty))">
                        <option value="">Static picture or video file</option>
                        @foreach (GeneratedVariableImage image in Overlay.VariableImages)
                        {
                            <option value="@image.Name">@image.Name</option>
                        }
                    </select>
                </label>
                @if (Overlay.VariableImages.FirstOrDefault(image => string.Equals(image.Name, Overlay.VariableImage, StringComparison.OrdinalIgnoreCase)) is { } fileVariable)
                {
                    <OverlayImageShowSelect Image="fileVariable" Value="@Overlay.VariableImageShow"
                                            ValueChanged="value => Set(() => Overlay.VariableImageShow = value)" />
                    @if (VariableStatus(fileVariable.Name, Overlay.VariableImageShow) is { } fileStatus)
                    {
                        <p class="hint">@fileStatus</p>
                    }
                }
                @if (string.IsNullOrWhiteSpace(Overlay.VariableImage))
                {
                    <div class="field"><span>@(Overlay.Variants.Count > 0 ? "Default picture or video" : "Picture or video")</span>
                        <FilePathPicker Value="@Overlay.File" ValueChanged="value => Set(() => Overlay.File = value)" Extensions="MediaExtensions" KeepCopyIn="@OverlayPackages.AssetCategory"
                                        Label="picture or video" StartIn="Environment.SpecialFolder.MyPictures" Placeholder="D:\Media\Logos\bug.png" /></div>
                    @if (Missing(Overlay.File))
                    {
                        <p class="hint warn">The scheduler can't find this file.</p>
                    }
                    <p class="hint">A PNG with transparency, or a video (with an alpha channel, such as a .mov) for an animated bug.
                        @(Overlay.Variants.Count > 0 ? "Leave it empty to show only the pictures below (a rating badge with nothing for unrated shows)." : "")</p>
                }
                else
                {
                    <p class="hint">Uses the variable's default or per-show image. Matching variants below take priority on air.</p>
                }

                <OverlayVariantsEditor Overlay="Overlay" HolidayNames="HolidayNames" Changed="CommitAsync" />

                <h4>Placement</h4>
                <div class="field"><span>Where</span>
                    <div class="ov-anchors" role="radiogroup" aria-label="Where">
                        @foreach (string anchor in OverlayAnchors.All)
                        {
                            <button type="button" class="ov-anchor @(Overlay.Anchor == anchor ? "on" : "")" title="@anchor.Replace('_', ' ')"
                                    aria-checked="@(Overlay.Anchor == anchor ? "true" : "false")" role="radio" @onclick="() => Set(() => Overlay.Anchor = anchor)"></button>
                        }
                    </div>
                </div>
                <label class="field"><span>Width: @Overlay.SizePercent.ToString("0.#", CultureInfo.InvariantCulture)% of the picture</span>
                    <input type="range" min="2" max="60" step="0.5" value="@Number(Overlay.SizePercent)" @onchange="e => Set(() => Overlay.SizePercent = Number(e, 10))" /></label>
                <div class="grid grid-2">
                    <label class="field"><span>Margin across (%)</span>
                        <input type="number" min="0" max="40" step="0.5" value="@Number(Overlay.MarginXPercent)" @onchange="e => Set(() => Overlay.MarginXPercent = Number(e, 3))" /></label>
                    <label class="field"><span>Margin up/down (%)</span>
                        <input type="number" min="0" max="40" step="0.5" value="@Number(Overlay.MarginYPercent)" @onchange="e => Set(() => Overlay.MarginYPercent = Number(e, 4))" /></label>
                </div>
                <label class="check"><input type="checkbox" checked="@Overlay.InsidePicture" @onchange="e => Set(() => Overlay.InsidePicture = e.Value is true)" />
                    <span>Keep inside the picture of letterboxed or 4:3 shows</span></label>
            }
        </div>
    </div>
</div>

@if (_drag is not null || _scrubbing || _keyDrag is not null)
{
    <div class="drag-overlay @(_drag is null ? "drag-time" : "")" @onpointermove="OverlayMove" @onpointerup="OverlayEnd" @onpointercancel="OverlayEnd" @onpointerleave="OverlayEnd"></div>
}

@code {
    [Parameter, EditorRequired] public Overlay Overlay { get; set; } = new();

    [Parameter] public string ChannelName { get; set; } = "Channel";

    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>The schedule's holidays, for a file's other pictures to pick from.</summary>
    [Parameter] public IReadOnlyList<string> HolidayNames { get; set; } = [.. SchedularrTV.Core.Temporal.TemporalTagOptions.DefaultHolidays.Select(holiday => holiday.Name)];

    private const string MoveHandle = "move";
    private const string RotateHandle = "rotate";

    // Named rather than written into the markup: a quoted string inside an attribute's own quotes ends the attribute.
    private const string DefaultFont = "Arial";
    private const string DefaultAlign = "left";
    private const string White = "#ffffff";
    private const string LayerPromptPlaceholder = "A cheeky one-liner about the episode";
    private const string LayerStylePlaceholder = "Short and punchy";
    private int _tries;

    // Screen pixels, so snapping feels the same however wide the canvas is drawn.
    private const double SnapDistance = 8;

    /// <summary>A file overlay is placed on a 1080p picture.</summary>
    private const int FileCanvasWidth = 1920;
    private const int FileCanvasHeight = 1080;

    /// <summary>The preview is drawn about this wide (smaller while scrubbing or dragging); the canvas fills the editor's width.</summary>
    private const float PreviewPixels = 1280;
    private const float FastPreviewPixels = 720;
    private const double RowHeight = 34;
    private static readonly string[] Handles = ["nw", "n", "ne", "e", "se", "s", "sw", "w"];
    private static readonly TimeSpan SampleLength = TimeSpan.FromMinutes(22);
    private static readonly string[] MediaExtensions = [.. FileBrowsing.Images, ".mov", ".webm", ".mp4", ".mkv"];
    private static readonly string[] VideoExtensions = [".mov", ".webm", ".mkv", ".mp4", ".m4v", ".avi"];
    private static readonly (int Width, int Height, string Label)[] Sizes =
    [
        (1920, 1080, "1920 × 1080 (16:9)"),
        (1280, 720, "1280 × 720 (16:9)"),
        (1440, 1080, "1440 × 1080 (4:3)"),
        (720, 480, "720 × 480 (SD)")
    ];

    private sealed record DragState(OverlayLayer Layer, string Handle, double StartX, double StartY, float X, float Y, float Width, float Height)
    {
        public bool Moved { get; set; }

        /// <summary>Moving: every selected layer (bar those inside another selected one), each from where it started.</summary>
        public List<Mover> Movers { get; init; } = [];

        /// <summary>Resizing: the layer's own turn, and its groups' turn on top of that.</summary>
        public double OwnRotation { get; init; }

        public double SpaceRotation { get; init; }

        /// <summary>Turning: the box's middle on screen, and the pointer's angle from it at the start.</summary>
        public double CentreClientX { get; init; }

        public double CentreClientY { get; init; }

        public double StartAngle { get; init; }
    }

    /// <param name="SpaceRotation">How far the groups it's in are turned: a drag on screen moves it that much less turned.</param>
    private sealed record Mover(OverlayLayer Layer, float X, float Y, double SpaceRotation);

    private sealed record KeyDragState(OverlayLayer Layer, OverlayKeyframe Key, double StartX, double StartAt)
    {
        public bool Moved { get; set; }
        public List<(OverlayKeyframe Key, double At)> Starts { get; init; } = [];
    }

    private readonly CancellationTokenSource _life = new();
    private readonly string _canvasId = $"overlay-canvas-{Guid.NewGuid():N}";
    private readonly string _viewportId = $"overlay-viewport-{Guid.NewGuid():N}";
    private IJSObjectReference? _zoom;
    private readonly string _stillId = $"overlay-still-{Guid.NewGuid():N}";
    private readonly string _rulerId = $"overlay-ruler-{Guid.NewGuid():N}";
    private double _canvasPixels;
    private IReadOnlyList<string> _fonts = [];
    private OverlayLayer? _layer;
    // Every selected layer (_layer, whose settings show, among them).
    private readonly HashSet<OverlayLayer> _chosen = [];
    // Groups folded shut in the layer list.
    private readonly HashSet<OverlayLayer> _folded = [];
    private List<OverlayLayer>? _listDrag;
    private OverlayLayer? _dropOn;
    private OverlayDrop _dropWhere;
    private DragState? _drag;
    private KeyDragState? _keyDrag;
    private bool _scrubbing;
    private double _rulerLeft;
    private double _rulerWidth;
    private bool _snapX;
    private bool _snapY;
    private double _time;
    private string? _preview;
    private string? _shownPreview;
    private bool _stillScriptReady;
    private bool _previewWanted;
    private bool _previewFast;
    private bool _previewRunning;
    private string _previewCurrent = "The Show";
    private string _previewUpcoming = "Another Show\nA Later Show";
    private string? _previewError;
    private OverlayVideos? _videos;
    private SchedularrTV.Service.Images.AutomaticImages? _automatic;

    /// <summary>What's known of each video layer's file (null once looked up and ffprobe couldn't say).</summary>
    private readonly Dictionary<string, OverlayVideoInfo?> _videoInfo = new(StringComparer.Ordinal);

    private bool IsDesign => Overlay.Kind != OverlayKinds.File;

    private OverlaySchedule TimingSchedule => Overlay.Schedule ??= OverlaySchedule.FromLegacy(Overlay);

    /// <summary>The one-appearance chart: worth showing once some part of a timed design comes or goes on its own.</summary>
    private bool ShowsAppearance =>
        IsDesign && !TimingSchedule.Always && Overlay.Layers.Count(OverlayRenderer.IsDrawn) > 1
        && Overlay.Layers.Any(layer => layer.Kind == OverlayLayerKinds.Video || layer.InSeconds > 0 || layer.OutSeconds > 0);

    private int CanvasWidth => IsDesign ? Math.Max(1, Overlay.Width) : FileCanvasWidth;

    private int CanvasHeight => IsDesign ? Math.Max(1, Overlay.Height) : FileCanvasHeight;

    /// <summary>Screen pixels per canvas pixel: the canvas fills the editor's width, so this follows the window.</summary>
    private double Scale => (_canvasPixels > 0 ? _canvasPixels : 640) / CanvasWidth;

    protected override void OnInitialized()
    {
        _fonts = InstalledFonts();
        _videos = Services.GetService<OverlayVideos>();
        _automatic = Services.GetService<SchedularrTV.Service.Images.AutomaticImages>();
        // Its variable images show their shared images' names and settings.
        OverlayImages.Link(Overlay, Editor.Working.Settings.GeneratedPromosSharedImages);
        if (_automatic is not null)
        {
            _automatic.Fetched += OnAutomaticImage;
        }
        if (Overlay.Layers.LastOrDefault() is { } top)
        {
            Select(top);
        }

        // Part-way in, where everything that comes in has.
        _time = SnapToFrame(TimelineLength / 2);
        RequestPreview();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_zoom is null)
        {
            try
            {
                await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./plugins/overlays/zoom.js");
                _zoom = await module.InvokeAsync<IJSObjectReference>("create", _viewportId, _canvasId);
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException)
            {
                // Disconnected or still prerendering: try again after the next render.
            }
        }

        // Once, as soon as the canvas is on the page.
        if (_canvasPixels <= 0)
        {
            await MeasureCanvas();
        }

        // A picture drawn before the canvas was on the page.
        if (_preview is not null && !ReferenceEquals(_preview, _shownPreview) && !_previewRunning)
        {
            await ShowPreview();
        }
    }

    private async Task ResetZoom()
    {
        if (_zoom is not null) await _zoom.InvokeVoidAsync("reset");
        await MeasureCanvas();
    }

    public async ValueTask DisposeAsync()
    {
        if (_automatic is not null)
        {
            _automatic.Fetched -= OnAutomaticImage;
        }

        _life.Cancel();
        _life.Dispose();
        if (_zoom is not null)
        {
            try
            {
                await _zoom.InvokeVoidAsync("dispose");
                await _zoom.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    /// <summary>Reads how wide the canvas is drawn, for turning pointer movement into canvas pixels.</summary>
    private async Task MeasureCanvas()
    {
        try
        {
            double width = await JS.InvokeAsync<double>("eval", $"document.getElementById('{_canvasId}')?.getBoundingClientRect().width || 0");
            if (width > 0)
            {
                _canvasPixels = width;
            }
        }
        catch (Exception)
        {
            // Disconnected or still prerendering: the last width (or a guess) stands in.
        }
    }

    /// <summary>Where the canvas is on screen (left, top, width), or zeros when it can't be told.</summary>
    private async Task<(double Left, double Top, double Width)> CanvasBox()
    {
        try
        {
            double[] box = await JS.InvokeAsync<double[]>("eval",
                $"(r => r ? [r.left, r.top, r.width] : [0, 0, 0])(document.getElementById('{_canvasId}')?.getBoundingClientRect())");
            return box is [var left, var top, var width] ? (left, top, width) : (0, 0, 0);
        }
        catch (Exception)
        {
            return (0, 0, 0);
        }
    }

    private Task Set(Action change)
    {
        change();
        return CommitAsync();
    }

    private async Task CommitAsync()
    {
        PruneSelection();
        await Changed.InvokeAsync();
        RequestPreview();
    }

    // Changing when it shows can change the timeline's length.
    private Task TimingChanged()
    {
        _time = SnapToFrame(Math.Min(_time, TimelineLength));
        return CommitAsync();
    }

    private static readonly double[] FrameRates = [23.976, 24, 25, 29.97, 30, 50, 59.94, 60];

    // 30 is stored as nothing, so overlays that never set one stay as they were.
    private Task SetFps(double fps) => Set(() =>
    {
        double rate = Math.Round(Math.Clamp(fps, 1, 120), 3);
        Overlay.Fps = Math.Abs(rate - OverlayAnimation.DefaultFps) < 0.0005 ? null : rate;
        _time = SnapToFrame(_time);
    });

    private Task SetAnimationLength(ChangeEventArgs e) => Set(() =>
    {
        double seconds = Math.Clamp(Number(e, Overlay.DefaultAnimationSeconds), 1, 120);
        Overlay.AnimationSeconds = Math.Abs(seconds - Overlay.DefaultAnimationSeconds) < 0.001 ? null : seconds;
        _time = SnapToFrame(Math.Min(_time, TimelineLength));
    });

    // ---- The preview ----

    private Task RefreshPreview()
    {
        RequestPreview();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Asks for the preview to be drawn again. One is drawn at a time and the newest request wins, so scrubbing or
    /// dragging shows pictures as fast as they can be drawn.
    /// </summary>
    /// <param name="fast">Smaller, for while the pointer moves; a full-size one follows when it stops.</param>
    private void RequestPreview(bool fast = false)
    {
        _previewWanted = true;
        _previewFast = fast;
        if (!_previewRunning)
        {
            _ = DrawPreviews();
        }
    }

    private async Task DrawPreviews()
    {
        _previewRunning = true;
        try
        {
            await Task.Yield();
            while (_previewWanted && !_life.IsCancellationRequested)
            {
                _previewWanted = false;
                bool fast = _previewFast;
                try
                {
                    Overlay snapshot = Overlay.Copy();
                    string[] upcoming = _previewUpcoming.Replace("\r", "").Split('\n').Select(title => title.Trim()).ToArray();
                    // Variable images' automatic pictures show once found; they're looked for in the background, and drawn again when they are.
                    snapshot = OverlayImages.Resolve(snapshot, _previewCurrent, upcoming, Editor.Working.Settings.GeneratedPromosSharedImages,
                        _automatic?.Lookup(queue: true));
                    Dictionary<string, string> tokens = new(OverlayProcessor.SampleTokens)
                    {
                        ["channel"] = ChannelName, ["title"] = _previewCurrent, ["next"] = upcoming.FirstOrDefault() ?? string.Empty
                    };                    float scale = Math.Min(1f, (fast ? FastPreviewPixels : PreviewPixels) / CanvasWidth);
                    OverlayClock? clock = IsDesign ? PreviewClock : null;
                    Dictionary<string, string> posters = await PostersAsync(snapshot, clock);
                    byte[] png = await Task.Run(() => OverlayRenderer.Preview(snapshot, tokens, scale, posters, clock));
                    _preview = "data:image/png;base64," + Convert.ToBase64String(png);
                    _previewError = null;
                    await ShowPreview();
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    _previewError = ex.Message;
                }

                if (!_life.IsCancellationRequested)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _previewRunning = false;
        }
    }

    // Decodes the new picture off screen and only then swaps it in, so the canvas never blanks between pictures.
    private const string StillScript = """
        window.schedularrOverlayStill ??= async (id, url) => {
            const element = document.getElementById(id);
            if (!element) return false;
            const image = new Image();
            image.src = url;
            try { await image.decode(); } catch { }
            if (!element.isConnected) return false;
            element.style.backgroundImage = `url("${url}")`;
            return true;
        };
        """;

    private async Task ShowPreview()
    {
        if (_preview is not { } preview || ReferenceEquals(preview, _shownPreview))
        {
            return;
        }

        try
        {
            if (!_stillScriptReady)
            {
                await JS.InvokeVoidAsync("eval", StillScript);
                _stillScriptReady = true;
            }

            if (await JS.InvokeAsync<bool>("schedularrOverlayStill", _stillId, preview))
            {
                _shownPreview = preview;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Disconnected, still prerendering or without script: tried again after the next render.
        }
    }

    /// <summary>The moment the preview shows: the playhead, in one appearance (or a whole-programme overlay's opening).</summary>
    private OverlayClock PreviewClock => new(_time, TimelineLength, Overlay.FadeSeconds, FadeIn: true, FadeOut: !TimingSchedule.Always,
        LayerOuts: !TimingSchedule.Always);

    /// <summary>
    /// For each of the design's videos, its frame at the playhead (it plays from when its layer comes in, as on air),
    /// or with no moment a still from part-way through; and what's known of each, for the inspector. The frames an
    /// appearance uses are taken in the background the first time, so scrubbing is quick after that.
    /// </summary>
    private async Task<Dictionary<string, string>> PostersAsync(Overlay overlay, OverlayClock? clock)
    {
        Dictionary<string, string> posters = new(StringComparer.Ordinal);
        if (_videos is null || overlay.Kind == OverlayKinds.File)
        {
            return posters;
        }

        foreach (OverlayLayer video in overlay.Layers.Where(layer => layer.Kind == OverlayLayerKinds.Video && layer.Path is { Length: > 0 } && File.Exists(layer.Path)))
        {
            string path = video.Path!;
            string key = OverlayRenderer.FrameKey(overlay, video);
            if (posters.ContainsKey(key))
            {
                continue;
            }

            if (!_videoInfo.ContainsKey(path))
            {
                _videoInfo[path] = await _videos.InfoAsync(path);
            }

            if (clock is null)
            {
                if (await _videos.PosterAsync(path) is { } poster)
                {
                    posters[key] = poster;
                }

                continue;
            }

            double playing = Math.Max(0, clock.Seconds - OverlayHierarchy.EffectiveTiming(overlay, video).InSeconds);
            double needed = Math.Min(clock.Length, _videoInfo[path]?.Duration?.TotalSeconds ?? clock.Length);
            _ = _videos.PrepareFramesAsync(path, needed, Fps);
            string? frame = await _videos.FrameAsync(path, playing, Fps, _life.Token);
            if (frame is not null)
            {
                posters[key] = frame;
            }

            _videoFrames[path] = (playing, frame is not null);
        }

        return posters;
    }

    /// <summary>Each video's frame the preview last showed: how far into it, and whether ffmpeg could take it.</summary>
    private readonly Dictionary<string, (double Seconds, bool Shown)> _videoFrames = new(StringComparer.Ordinal);

    // ---- The timeline ----

    private double TimelineLength => Math.Max(0.5, OverlayAnimation.TimelineSeconds(Overlay));

    private double Fps => OverlayAnimation.FpsOf(Overlay);

    /// <summary>A second's worth of frames, for stepping by a second.</summary>
    private int FramesPerSecond => Math.Max(1, (int)Math.Round(Fps));

    private int FrameCount => Math.Max(1, (int)Math.Ceiling(TimelineLength * Fps));

    private int FrameAt(double seconds) => Math.Clamp((int)Math.Round(Math.Clamp(seconds, 0, 86_400) * Fps), 0, FrameCount - 1);

    private double SnapToFrame(double seconds) => Math.Round(FrameAt(seconds) / (double)Fps, 4);

    private double LastTime => Math.Round((FrameCount - 1) / (double)Fps, 4);

    private int CurrentFrame => FrameAt(_time);

    private void StepFrames(int frames) => SetTimeTo((CurrentFrame + frames) / (double)Fps);

    private void SetTimeTo(double seconds, bool fast = false)
    {
        double time = SnapToFrame(Math.Clamp(seconds, 0, TimelineLength));
        if (fast && Math.Abs(time - _time) < 0.0001)
        {
            return;
        }

        _time = time;
        RequestPreview(fast);
    }

    private IEnumerable<double> Ticks()
    {
        double length = TimelineLength;
        double step = length <= 12 ? 1 : length <= 30 ? 2 : length <= 60 ? 5 : 10;
        for (double tick = 0; tick <= length + 0.0001; tick += step)
        {
            yield return tick;
        }
    }

    /// <summary>When the layer is on screen in the timeline: from coming in to going (with its groups').</summary>
    private (double From, double To) Span(OverlayLayer layer)
    {
        LayerTiming timing = OverlayHierarchy.EffectiveTiming(Overlay, layer);
        double to = TimingSchedule.Always ? TimelineLength : TimelineLength - timing.OutSeconds;
        return (Math.Min(timing.InSeconds, TimelineLength), Math.Max(0, to));
    }

    /// <summary>Whether the layer (and every group it's in) shows at the playhead.</summary>
    private bool VisibleNow(OverlayLayer layer)
    {
        OverlayClock clock = PreviewClock;
        return OverlayAnimation.Visibility(layer, clock) > 0
               && OverlayHierarchy.Ancestors(Overlay, layer).All(group => OverlayAnimation.Visibility(group, clock) > 0);
    }

    private OverlayKeyframe? CurrentKeyframe => _layer is { } layer ? OverlayAnimation.KeyframeAt(layer, _time) : null;

    private readonly SchedularrTV.Core.Editing.KeyframeSelection<OverlayKeyframe> _keys = new(key => key.At.TotalSeconds);
    private IReadOnlyList<OverlayKeyframe> SelectedKeys
    {
        get
        {
            _keys.Bind(_layer, _layer?.Keyframes ?? []);
            return _keys.Selected;
        }
    }
    private OverlayKeyframe? EditingKeyframe => SelectedKeys.LastOrDefault() ?? CurrentKeyframe;
    private string SelectedEasing => SelectedKeys.Select(key => key.Easing).Distinct().ToArray() is [var easing] ? easing.ToString() : "";

    private async Task MeasureRuler()
    {
        try
        {
            double[] box = await JS.InvokeAsync<double[]>("eval",
                $"(r => r ? [r.left, r.width] : [0, 0])(document.getElementById('{_rulerId}')?.getBoundingClientRect())");
            if (box is [var left, var width] && width > 0)
            {
                (_rulerLeft, _rulerWidth) = (left, width);
            }
        }
        catch (Exception)
        {
            // Disconnected or still prerendering: the last measurement stands in.
        }
    }

    private double TimeAtPointer(double clientX) =>
        _rulerWidth <= 0 ? _time : (clientX - _rulerLeft) / _rulerWidth * TimelineLength;

    /// <summary>Gives the timeline the keyboard, so frame stepping works straight after scrubbing or dragging a box.</summary>
    private async Task FocusRuler()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementById('{_rulerId}')?.focus({{ preventScroll: true }})");
        }
        catch (Exception)
        {
            // The keys work once the timeline is clicked again.
        }
    }

    private async Task StartScrub(PointerEventArgs e)
    {
        if (e.Button != 0) return;
        _keys.Clear();
        _scrubbing = true;
        _ = FocusRuler();
        await MeasureRuler();
        if (_scrubbing)
        {
            SetTimeTo(TimeAtPointer(e.ClientX), fast: true);
        }
    }

    private async Task StartKeyDrag(PointerEventArgs e, OverlayLayer layer, OverlayKeyframe key)
    {
        if (e.Button != 0) return;
        _ = SelectedKeys;
        _ = FocusRuler();
        if (!_keys.Click(key, layer.Keyframes ?? [], e.CtrlKey || e.MetaKey, e.ShiftKey)) return;
        _keyDrag = new KeyDragState(layer, key, e.ClientX, key.At.TotalSeconds)
        {
            Starts = [.. SelectedKeys.Select(frame => (frame, frame.At.TotalSeconds))]
        };
        SetTimeTo(key.At.TotalSeconds);
        _ = FocusRuler();
        await MeasureRuler();
    }

    private void OverlayMove(PointerEventArgs e)
    {
        if (_drag is not null)
        {
            Drag(e);
        }
        else if (_keyDrag is { } keyDrag)
        {
            MoveKeyDrag(keyDrag, e);
        }
        else if (_scrubbing)
        {
            SetTimeTo(TimeAtPointer(e.ClientX), fast: true);
        }
    }

    private async Task OverlayEnd(PointerEventArgs e)
    {
        if (_drag is not null)
        {
            await EndDrag(e);
        }
        else if (_keyDrag is { } keyDrag)
        {
            MoveKeyDrag(keyDrag, e);
            _keyDrag = null;
            if (keyDrag.Moved)
            {
                await CommitAsync();
            }
        }
        else if (_scrubbing)
        {
            _scrubbing = false;
            SetTimeTo(TimeAtPointer(e.ClientX));
        }
    }

    private void MoveKeyDrag(KeyDragState drag, PointerEventArgs e)
    {
        if (_rulerWidth <= 0)
        {
            return;
        }

        double seconds = (e.ClientX - drag.StartX) / _rulerWidth * TimelineLength;
        drag.Moved |= Math.Abs(e.ClientX - drag.StartX) >= 2;
        if (!drag.Moved)
        {
            return;
        }

        double delta = SchedularrTV.Core.Editing.KeyframeMoves.Delta(drag.Starts.Select(start => start.At), seconds, LastTime, Fps);
        foreach (var start in drag.Starts)
            start.Key.At = TimeSpan.FromSeconds(Math.Round(start.At + delta, 4));
        drag.Layer.Keyframes = [.. drag.Layer.Keyframes!.OrderBy(key => key.At)];
        SetTimeTo(drag.Key.At.TotalSeconds, fast: true);
    }

    /// <summary>
    /// Timeline shortcuts: ←/→ or ,/. step one frame (Shift: a second), Home/End jump to either end, [/] to the selected
    /// layer's previous or next keyframe, K adds a keyframe and Delete removes the one under the playhead.
    /// </summary>
    private Task RulerKey(KeyboardEventArgs e)
    {
        int step = e.ShiftKey ? FramesPerSecond : 1;
        switch (e.Key)
        {
            case "ArrowLeft" or "," or "<":
                StepFrames(-step);
                break;
            case "ArrowRight" or "." or ">":
                StepFrames(step);
                break;
            case "Home":
                SetTimeTo(0);
                break;
            case "End":
                SetTimeTo(LastTime);
                break;
            case "[" when _layer is { } layer:
                GoToKeyframe(layer, -1);
                break;
            case "]" when _layer is { } layer:
                GoToKeyframe(layer, 1);
                break;
            case "Escape":
                _keys.Clear();
                break;
            case "Delete" or "Backspace" when _layer is { } layer && SelectedKeys.Count > 0:
                return RemoveSelectedKeys(layer);
            case "Delete" or "Backspace" when _layer is { } layer && CurrentKeyframe is { } key:
                return RemoveKeyframe(layer, key);
            case "k" or "K" when _layer is { Kind: not OverlayLayerKinds.Video } layer:
                return AddKeyframe(layer);
        }

        return Task.CompletedTask;
    }

    private Task StartKeyframes(OverlayLayer layer) => Set(() => OverlayAnimation.StartKeyframes(layer, _time));

    private Task StopKeyframes(OverlayLayer layer) => Set(() => OverlayAnimation.StopKeyframes(layer, _time));

    private Task AddKeyframe(OverlayLayer layer) => Set(() =>
    {
        if (!OverlayAnimation.HasKeyframes(layer))
        {
            OverlayAnimation.StartKeyframes(layer, _time);
        }
        else
        {
            OverlayAnimation.AddKeyframe(layer, _time);
        }
    });

    private Task RemoveKeyframe(OverlayLayer layer, OverlayKeyframe key) => Set(() => OverlayAnimation.RemoveKeyframe(layer, key));

    private Task RemoveSelectedKeys(OverlayLayer layer) => Set(() =>
    {
        foreach (OverlayKeyframe key in SelectedKeys.ToArray()) OverlayAnimation.RemoveKeyframe(layer, key);
        _keys.Clear();
    });

    private Task SetSelectedEasing(ChangeEventArgs e) => Set(() =>
    {
        if (!Enum.TryParse<GeneratedEasing>(e.Value?.ToString(), out var easing)) return;
        foreach (OverlayKeyframe key in SelectedKeys) key.Easing = easing;
    });

    private Task SetKeyframeTime(ChangeEventArgs e, OverlayLayer layer, OverlayKeyframe key) => Set(() =>
    {
        OverlayAnimation.MoveKeyframe(layer, key, SnapToFrame(Number(e, key.At.TotalSeconds)), LastTime);
        _time = SnapToFrame(key.At.TotalSeconds);
    });

    private OverlayKeyframe? NextKeyframe(OverlayLayer layer, int direction) =>
        direction < 0
            ? layer.Keyframes?.Where(key => key.At.TotalSeconds < _time - OverlayAnimation.KeyframeTolerance).OrderBy(key => key.At).LastOrDefault()
            : layer.Keyframes?.Where(key => key.At.TotalSeconds > _time + OverlayAnimation.KeyframeTolerance).OrderBy(key => key.At).FirstOrDefault();

    private void GoToKeyframe(OverlayLayer layer, int direction)
    {
        if (NextKeyframe(layer, direction) is { } key)
        {
            SetTimeTo(key.At.TotalSeconds);
        }
    }

    private Task SetPoseValue(ChangeEventArgs e, OverlayLayer layer, Func<OverlayPose, double, OverlayPose> change)
    {
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double value))
        {
            return Task.CompletedTask;
        }

        return Set(() => OverlayAnimation.SetPose(layer, _time, change(OverlayAnimation.PoseAt(layer, _time), value)));
    }

    private static string EasingName(GeneratedEasing easing) => easing switch
    {
        GeneratedEasing.EaseIn => "Ease in",
        GeneratedEasing.EaseOut => "Ease out",
        GeneratedEasing.EaseInOut => "Ease in and out",
        GeneratedEasing.Hold => "Hold, then jump",
        _ => "Linear"
    };

    // ---- Selecting, locking, grouping and the layer list ----

    private void Select(OverlayLayer layer)
    {
        if (!ReferenceEquals(_layer, layer)) _keys.Clear();
        _layer = layer;
        _chosen.Clear();
        _chosen.Add(layer);
    }

    /// <summary>A click on a row: alone it selects the layer; Ctrl (⌘) adds or drops it; Shift selects the rows from the last one to it.</summary>
    private void ClickRow(MouseEventArgs e, OverlayLayer layer)
    {
        if (!ReferenceEquals(_layer, layer)) _keys.Clear();
        if (e.CtrlKey || e.MetaKey)
        {
            Toggle(layer);
            return;
        }

        if (e.ShiftKey && _layer is { } anchor)
        {
            List<OverlayLayer> rows = [.. OverlayHierarchy.Rows(Overlay, IsOpen).Select(row => row.Layer)];
            int from = rows.IndexOf(anchor);
            int to = rows.IndexOf(layer);
            if (from >= 0 && to >= 0)
            {
                _chosen.Clear();
                foreach (OverlayLayer row in rows.Skip(Math.Min(from, to)).Take(Math.Abs(to - from) + 1))
                {
                    _chosen.Add(row);
                }

                _layer = layer;
                return;
            }
        }

        Select(layer);
    }

    private void Toggle(OverlayLayer layer)
    {
        if (!ReferenceEquals(_layer, layer)) _keys.Clear();
        if (_chosen.Add(layer))
        {
            _layer = layer;
        }
        else
        {
            _chosen.Remove(layer);
            if (ReferenceEquals(_layer, layer))
            {
                _layer = _chosen.FirstOrDefault();
            }
        }
    }

    private bool IsOpen(OverlayLayer layer) => !_folded.Contains(layer);

    private void ToggleOpen(OverlayLayer layer)
    {
        if (!_folded.Remove(layer))
        {
            _folded.Add(layer);
        }
    }

    /// <summary>Drops selections of layers that are gone.</summary>
    private void PruneSelection()
    {
        _chosen.RemoveWhere(layer => !Overlay.Layers.Contains(layer));
        _folded.RemoveWhere(layer => !Overlay.Layers.Contains(layer));
        if (_layer is not null && !Overlay.Layers.Contains(_layer))
        {
            _layer = _chosen.FirstOrDefault();
        }

        if (_layer is not null)
        {
            _chosen.Add(_layer);
        }
    }

    /// <summary>Locking drops it from a several-layer selection, so dragging the others leaves it be.</summary>
    private Task ToggleLock(OverlayLayer layer) => Set(() =>
    {
        layer.Locked = !layer.Locked;
        if (layer.Locked && _chosen.Count > 1)
        {
            _chosen.RemoveWhere(chosen => !ReferenceEquals(chosen, _layer) && OverlayHierarchy.IsLocked(Overlay, chosen));
        }
    });

    private Task StepLayer(OverlayLayer layer, int direction) => Set(() => OverlayHierarchy.Step(Overlay, layer, direction, _time));

    private Task GroupChosen() => _chosen.Count == 0 ? Task.CompletedTask : Set(() => Select(OverlayHierarchy.Group(Overlay, _chosen, _time)));

    private Task Ungroup(OverlayLayer group) => Set(() =>
    {
        List<OverlayLayer> members = OverlayHierarchy.Ungroup(Overlay, group, _time);
        _chosen.Clear();
        _layer = null;
        foreach (OverlayLayer member in members)
        {
            _chosen.Add(member);
            _layer ??= member;
        }
    });

    private void StartListDrag(OverlayLayer layer)
    {
        if (!_chosen.Contains(layer))
        {
            Select(layer);
        }

        _listDrag = OverlayHierarchy.Outermost(Overlay, _chosen);
    }

    private void EndListDrag()
    {
        _listDrag = null;
        _dropOn = null;
    }

    /// <summary>Top of a row puts it in front, bottom behind; the middle of a group's row puts it inside.</summary>
    private static OverlayDrop DropAt(DragEventArgs e, OverlayLayer layer)
    {
        double y = e.OffsetY;
        if (OverlayHierarchy.IsGroup(layer))
        {
            return y < RowHeight * 0.3 ? OverlayDrop.Above : y > RowHeight * 0.7 ? OverlayDrop.Below : OverlayDrop.Into;
        }

        return y < RowHeight / 2 ? OverlayDrop.Above : OverlayDrop.Below;
    }

    private void ListDragOver(DragEventArgs e, OverlayLayer layer)
    {
        if (_listDrag is not { } dragged || dragged.Any(moving => OverlayHierarchy.IsWithin(Overlay, layer, moving)))
        {
            _dropOn = null;
            return;
        }

        (_dropOn, _dropWhere) = (layer, DropAt(e, layer));
    }

    private Task ListDrop(DragEventArgs e, OverlayLayer layer)
    {
        List<OverlayLayer>? dragged = _listDrag;
        EndListDrag();
        if (dragged is null)
        {
            return Task.CompletedTask;
        }

        OverlayDrop where = DropAt(e, layer);
        return Set(() =>
        {
            if (OverlayHierarchy.Move(Overlay, dragged, layer, where, _time) && where == OverlayDrop.Into)
            {
                _folded.Remove(layer);
            }
        });
    }

    // ---- Masks ----

    private Task SetLayerMask(OverlayLayer layer, string mode) => Set(() =>
    {
        if (string.IsNullOrEmpty(mode) || !Enum.TryParse(mode, out GeneratedMaskMode parsed))
        {
            layer.Mask = null;
            return;
        }

        layer.Mask ??= new GeneratedLayerMask();
        layer.Mask.Mode = parsed;
        if (layer.Mask.Target is null && OverlayHierarchy.MaskTargets(Overlay, layer).FirstOrDefault() is { } target)
        {
            target.Id ??= OverlayHierarchy.NewId(Overlay);
            layer.Mask.Target = target.Id;
        }
    });

    private Task SetMaskTarget(OverlayLayer layer, string value) => Set(() =>
    {
        if (layer.Mask is not { } mask)
        {
            return;
        }

        OverlayLayer? target = int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out int index) && index >= 0 && index < Overlay.Layers.Count
                               && OverlayHierarchy.MaskTargets(Overlay, layer).Contains(Overlay.Layers[index])
            ? Overlay.Layers[index]
            : null;
        if (target is not null)
        {
            target.Id ??= OverlayHierarchy.NewId(Overlay);
        }

        mask.Target = target?.Id;
    });

    private static GeneratedShape? ShapeOf(ChangeEventArgs e) =>
        Enum.TryParse(e.Value?.ToString(), out GeneratedShape shape) && shape != GeneratedShape.Rectangle ? shape : null;

    // ---- Automatic images ----

    // A variable image's automatic picture found (or not): drawn again, so it shows.
    private void OnAutomaticImage(SchedularrTV.Service.Images.AutomaticImageRequest request)
    {
        if (OverlayImages.HasAutomatic(Overlay) && !_life.IsCancellationRequested)
        {
            _ = InvokeAsync(() =>
            {
                RequestPreview();
                StateHasChanged();
            });
        }
    }

    /// <summary>
    /// For a picture layer showing a variable image whose shared image finds pictures automatically: what the preview's
    /// show got (found, being searched for, or why not). Null otherwise.
    /// </summary>
    private string? VariableStatus(string name, string? selector)
    {
        if (_automatic is null
            || Overlay.VariableImages.FirstOrDefault(image => string.Equals(image.Name, name, StringComparison.OrdinalIgnoreCase)) is not { } variable
            || variable.Choices.Automatic is not { } config)
        {
            return null;
        }

        string[] upcoming = _previewUpcoming.Replace("\r", "").Split('\n').Select(title => title.Trim()).ToArray();
        var (context, offset) = OverlayImages.ContextFor(variable, selector);
        string? show = context == GeneratedImageContext.UpNext ? upcoming.ElementAtOrDefault(offset) : _previewCurrent;
        if (string.IsNullOrWhiteSpace(show))
        {
            return null;
        }

        // Without an automatic search, anything but the default comes from an override.
        if (GeneratedImageChoices.PathFor(variable.Choices, show, null) is { Length: > 0 } own
            && !string.Equals(own, variable.Choices.DefaultPath, StringComparison.OrdinalIgnoreCase))
        {
            return $"“{show}” has its own picture in the shared image.";
        }

        if (AutomaticImageQuery.ForShow(config.Query, show, null) is not { } query
            || SchedularrTV.Service.Images.AutomaticImageRequest.For(config, query) is not { } request)
        {
            return "Its shared image's automatic search has nothing to search for here.";
        }

        return _automatic.Peek(request, queue: false) is not null
            ? $"Showing the picture found for “{request.Query}” (for the preview's “{show}”)."
            : _automatic.Problem(request) ?? (_automatic.SetupProblem(config.Provider) is { } setup ? setup : $"Searching for “{request.Query}”…");
    }

    // ---- Videos ----

    /// <summary>A video chosen: its box takes its shape, and the first one chosen sets how long the overlay shows.</summary>
    private async Task SetVideo(OverlayLayer layer, string? path)
    {
        bool first = string.IsNullOrWhiteSpace(layer.Path)
                     && !Overlay.Layers.Any(other => other.Kind == OverlayLayerKinds.Video && !ReferenceEquals(other, layer) && !string.IsNullOrWhiteSpace(other.Path));
        layer.Path = string.IsNullOrWhiteSpace(path) ? null : path.Trim().Trim('"');
        if (_videos is not null && layer.Path is { } chosen && File.Exists(chosen))
        {
            OverlayVideoInfo? info = await _videos.InfoAsync(chosen);
            _videoInfo[chosen] = info;
            if (info?.Aspect is { } aspect)
            {
                layer.Height = MathF.Round(layer.Width * (float)aspect);
            }

            if (first && info?.Duration is { } length && !TimingSchedule.Always)
            {
                SetDurations(length.TotalSeconds);
            }

            // The first video also sets the frame rate, while the overlay hasn't one of its own.
            if (first && Overlay.Fps is null && info?.FrameRate is { } rate && Math.Abs(rate - OverlayAnimation.DefaultFps) >= 0.0005)
            {
                Overlay.Fps = Math.Round(Math.Clamp(rate, 1, 120), 3);
                _time = SnapToFrame(_time);
            }
        }

        await CommitAsync();
    }

    /// <summary>The box to the video's shape at its current width, or covering the canvas's width from the top-left.</summary>
    private async Task FitVideo(OverlayLayer layer, OverlayVideoInfo info, bool fill)
    {
        if (info.Aspect is not { } aspect)
        {
            return;
        }

        if (fill)
        {
            layer.X = 0;
            layer.Y = 0;
            layer.Width = Overlay.Width;
        }

        layer.Height = MathF.Round(layer.Width * (float)aspect);
        await CommitAsync();
    }

    private void SetDurations(double seconds)
    {
        double duration = Math.Max(1, Math.Round(seconds, 2));
        foreach (OverlaySlot slot in TimingSchedule.Slots)
        {
            slot.DurationSeconds = duration;
        }

        TimingSchedule.Automatic.DurationSeconds = duration;
        _time = SnapToFrame(Math.Min(_time, TimelineLength));
    }

    private async Task SetSize(ChangeEventArgs e)
    {
        string[] parts = (e.Value?.ToString() ?? "1920x1080").Split('x');
        if (parts.Length == 2 && int.TryParse(parts[0], out int width) && int.TryParse(parts[1], out int height)
            && (width != Overlay.Width || height != Overlay.Height))
        {
            // Everything scales with the canvas, so the design keeps its look.
            float across = width / (float)Overlay.Width;
            float down = height / (float)Overlay.Height;
            foreach (OverlayLayer layer in Overlay.Layers)
            {
                layer.X *= across;
                layer.Y *= down;
                layer.Width *= across;
                layer.Height *= down;
                layer.FontSize *= across;
                if (layer.SoftEdges is { } soft)
                {
                    layer.SoftEdges = Math.Clamp(soft * Math.Min(across, down), 0, 200);
                }

                OverlayAnimation.Scale(layer, across, down);
            }

            Overlay.Width = width;
            Overlay.Height = height;
            await CommitAsync();
        }
    }

    // ---- Adding and removing layers ----

    private async Task AddLayer(string kind)
    {
        if (kind == OverlayLayerKinds.Video)
        {
            // Usually the design's backdrop, so it goes under everything, covering the canvas until a video gives it a shape.
            var video = new OverlayLayer
            {
                Kind = kind, Name = OverlayHierarchy.UniqueName(Overlay, KindName(kind)), X = 0, Y = 0, Width = Overlay.Width, Height = Overlay.Height, Shadow = false
            };
            Overlay.Layers.Insert(0, video);
            Select(video);
            await CommitAsync();
            return;
        }

        var layer = new OverlayLayer
        {
            Kind = kind,
            Name = OverlayHierarchy.UniqueName(Overlay, KindName(kind)),
            X = Overlay.Width * 0.1f,
            Y = Overlay.Height * 0.75f,
            Width = kind == OverlayLayerKinds.Image ? Overlay.Width * 0.12f : Overlay.Width * 0.4f,
            Height = kind == OverlayLayerKinds.Image ? Overlay.Width * 0.12f : Overlay.Height * 0.08f,
            Text = kind == OverlayLayerKinds.Text ? "{title}" : null,
            Color = kind == OverlayLayerKinds.Rect ? "#14142b" : White,
            Opacity = kind == OverlayLayerKinds.Rect ? 85 : 100
        };
        Overlay.Layers.Add(layer);
        Select(layer);
        await CommitAsync();
    }

    // A copy of the layer, or of a group with everything inside it, with ids of its own.
    private Task DuplicateLayer(OverlayLayer layer) => Set(() => Select(OverlayHierarchy.Duplicate(Overlay, layer)));

    private Task RemoveLayer(OverlayLayer layer) => Set(() =>
    {
        int index = Overlay.Layers.IndexOf(layer);
        OverlayHierarchy.Remove(Overlay, layer);
        _chosen.Clear();
        _layer = null;
        if (Overlay.Layers.Count > 0)
        {
            Select(Overlay.Layers[Math.Clamp(index - 1, 0, Overlay.Layers.Count - 1)]);
        }
    });

    private Task RemoveChosen() => Set(() =>
    {
        foreach (OverlayLayer layer in OverlayHierarchy.Outermost(Overlay, _chosen))
        {
            OverlayHierarchy.Remove(Overlay, layer);
        }

        _chosen.Clear();
        _layer = null;
        if (Overlay.Layers.LastOrDefault() is { } top)
        {
            Select(top);
        }
    });

    // ---- Dragging on the canvas ----

    private void StartDrag(PointerEventArgs e, OverlayLayer layer, string handle)
    {
        // Only the main button moves things. Locked layers can't be picked here.
        if (e.Button != 0 || OverlayHierarchy.IsLocked(Overlay, layer))
        {
            return;
        }

        // Ctrl (⌘) or Shift on a box adds it to the selection or takes it out, without moving anything.
        if (handle == MoveHandle && (e.CtrlKey || e.MetaKey || e.ShiftKey))
        {
            Toggle(layer);
            return;
        }

        if (_chosen.Contains(layer))
        {
            _layer = layer;
        }
        else
        {
            Select(layer);
        }

        OverlayPose pose = OverlayAnimation.PoseAt(layer, _time);
        List<Mover> movers = handle != MoveHandle ? [] :
        [
            // Locked layers stay put while the rest of the selection moves.
            .. OverlayHierarchy.Outermost(Overlay, _chosen).Where(chosen => !OverlayHierarchy.IsLocked(Overlay, chosen)).Select(chosen =>
            {
                OverlayPose start = OverlayAnimation.PoseAt(chosen, _time);
                return new Mover(chosen, start.X, start.Y, OverlayHierarchy.SpaceAngle(Overlay, chosen, _time));
            })
        ];
        _drag = new DragState(layer, handle, e.ClientX, e.ClientY, pose.X, pose.Y, pose.Width, pose.Height)
        {
            Movers = movers,
            OwnRotation = layer.Kind == OverlayLayerKinds.Video ? 0 : pose.Rotation ?? 0,
            SpaceRotation = OverlayHierarchy.SpaceAngle(Overlay, layer, _time)
        };
        _ = MeasureCanvas();
        _ = FocusRuler();
    }

    /// <summary>Starts turning the layer by its round handle: the angle is taken about the box's middle on screen.</summary>
    private async Task StartRotate(PointerEventArgs e, OverlayLayer layer)
    {
        if (e.Button != 0 || OverlayHierarchy.IsLocked(Overlay, layer))
        {
            return;
        }

        Select(layer);
        OverlayPose pose = OverlayAnimation.PoseAt(layer, _time);
        var pending = new DragState(layer, RotateHandle, e.ClientX, e.ClientY, pose.X, pose.Y, pose.Width, pose.Height) { OwnRotation = pose.Rotation ?? 0 };
        _drag = pending;
        (double left, double top, double width) = await CanvasBox();
        if (!ReferenceEquals(_drag, pending) || width <= 0)
        {
            return;
        }

        _canvasPixels = width;
        OverlayBox box = OverlayHierarchy.World(Overlay, layer, _time);
        double centreX = left + box.CenterX * Scale;
        double centreY = top + box.CenterY * Scale;
        _drag = pending with
        {
            CentreClientX = centreX,
            CentreClientY = centreY,
            StartAngle = Math.Atan2(e.ClientY - centreY, e.ClientX - centreX) * 180 / Math.PI
        };
    }

    private void Drag(PointerEventArgs e)
    {
        if (_drag is not { } drag)
        {
            return;
        }

        double screenDx = (e.ClientX - drag.StartX) / Scale;
        double screenDy = (e.ClientY - drag.StartY) / Scale;
        OverlayLayer layer = drag.Layer;
        const float minimum = 8;
        drag.Moved |= Math.Abs(screenDx) >= 1 || Math.Abs(screenDy) >= 1;
        // A click that doesn't move the box changes nothing (and adds no keyframe).
        if (!drag.Moved)
        {
            return;
        }

        if (drag.Handle == RotateHandle)
        {
            if (drag.StartAngle is 0 && drag.CentreClientX is 0)
            {
                return;
            }

            double angle = Math.Atan2(e.ClientY - drag.CentreClientY, e.ClientX - drag.CentreClientX) * 180 / Math.PI;
            double turned = drag.OwnRotation + (angle - drag.StartAngle);
            turned = e.ShiftKey ? Math.Round(turned / 15) * 15 : Math.Round(turned, 1);
            turned = ((turned + 180) % 360 + 360) % 360 - 180;
            OverlayAnimation.SetPose(layer, _time, OverlayAnimation.PoseAt(layer, _time) with { Rotation = (float)turned });
            RequestPreview(fast: true);
            return;
        }

        if (drag.Handle == MoveHandle)
        {
            // Each layer moves in its own group's space, so a drag goes the same way on screen however its groups are turned.
            bool snaps = drag.Movers.Count == 1 && OverlayHierarchy.ParentOf(Overlay, drag.Movers[0].Layer) is null && !e.AltKey;
            _snapX = _snapY = false;
            foreach (Mover mover in drag.Movers)
            {
                (double localDx, double localDy) = OverlaySpace.Rotate(screenDx, screenDy, -mover.SpaceRotation);
                OverlayPose current = OverlayAnimation.PoseAt(mover.Layer, _time);
                float x = (float)Math.Round(mover.X + localDx);
                float y = (float)Math.Round(mover.Y + localDy);
                if (snaps)
                {
                    float snap = (float)(SnapDistance / Scale);
                    float centredX = (Overlay.Width - current.Width) / 2;
                    float centredY = (Overlay.Height - current.Height) / 2;
                    _snapX = Math.Abs(x - centredX) <= snap;
                    _snapY = Math.Abs(y - centredY) <= snap;
                    x = _snapX ? MathF.Round(centredX) : x;
                    y = _snapY ? MathF.Round(centredY) : y;
                }

                // On an animated layer this sets (or adds) the keyframe at the playhead.
                OverlayAnimation.SetPose(mover.Layer, _time, current with { X = x, Y = y, Rotation = null });
            }

            RequestPreview(fast: true);
            return;
        }

        // Resizing works along the box's own edges, however it and its groups are turned; the opposite edge stays put.
        (double dx, double dy) = OverlaySpace.Rotate(screenDx, screenDy, -(drag.SpaceRotation + drag.OwnRotation));
        double left = 0, right = 0, top = 0, bottom = 0;
        if (drag.Handle.Contains('e')) right = Math.Max(minimum - drag.Width, dx);
        if (drag.Handle.Contains('w')) left = Math.Min(dx, drag.Width - minimum);
        if (drag.Handle.Contains('s')) bottom = Math.Max(minimum - drag.Height, dy);
        if (drag.Handle.Contains('n')) top = Math.Min(dy, drag.Height - minimum);
        double width = drag.Width - left + right;
        double height = drag.Height - top + bottom;
        (double shiftX, double shiftY) = OverlaySpace.Rotate((left + right) / 2, (top + bottom) / 2, drag.OwnRotation);
        double centreX = drag.X + drag.Width / 2.0 + shiftX;
        double centreY = drag.Y + drag.Height / 2.0 + shiftY;

        OverlayPose was = OverlayAnimation.PoseAt(layer, _time);
        OverlayAnimation.SetPose(layer, _time, was with
        {
            X = (float)Math.Round(centreX - width / 2),
            Y = (float)Math.Round(centreY - height / 2),
            Width = (float)Math.Round(width),
            Height = (float)Math.Round(height),
            Rotation = null
        });
        RequestPreview(fast: true);
    }

    private async Task EndDrag(PointerEventArgs e)
    {
        if (_drag is not { } drag)
        {
            return;
        }

        Drag(e);
        _drag = null;
        _snapX = _snapY = false;
        if (drag.Moved)
        {
            await CommitAsync();
        }
    }

    /// <summary>A caption written now for a sample episode, a different one each try.</summary>
    private async Task<AiTextResult> TryLayer(OverlayLayer layer, CancellationToken token)
    {
        Dictionary<string, string> tokens = new(OverlayProcessor.SampleTokens) { ["channel"] = ChannelName };
        AiTextJob job = OverlayWriting.Job(Overlay, layer, tokens, OverlayWriting.SampleOverview, $"sample|{++_tries}", DateTimeOffset.UtcNow);
        return Services.GetService<AiTextWriter>() is { } writer
            ? await writer.TryAsync(job, token)
            : new AiTextResult(job.Fallback, false, "the AI writer isn't available here");
    }

    /// <summary>Font families the renderer can draw with, including fonts installed for the current user only.</summary>
    private static IReadOnlyList<string> InstalledFonts()
    {
        try
        {
            return
            [
                .. SkiaSharp.SKFontManager.Default.GetFontFamilies()
                    .Where(family => !string.IsNullOrWhiteSpace(family) && family[0] != '@')
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .Order(StringComparer.OrdinalIgnoreCase)
            ];
        }
        catch (Exception)
        {
            return [DefaultFont];
        }
    }

    private string FontName(string family) =>
        _fonts.FirstOrDefault(font => string.Equals(font, family, StringComparison.OrdinalIgnoreCase)) ?? family;

    private static bool Missing(string? path) => !string.IsNullOrWhiteSpace(path) && !File.Exists(path);

    private static string Label(OverlayLayer layer) => string.IsNullOrWhiteSpace(layer.Name) ? KindName(layer.Kind) : layer.Name;

    private static string KindName(string kind) => kind switch
    {
        OverlayLayerKinds.Image => "Picture",
        OverlayLayerKinds.Rect => "Shape",
        OverlayLayerKinds.Video => "Video",
        OverlayLayerKinds.Group => "Group",
        _ => "Text"
    };

    private static string Fraction(double value, double of) => (Math.Clamp(value / Math.Max(0.001, of), 0, 1) * 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    /// <summary>A canvas-pixel position or size as a percent of the canvas, so boxes follow the canvas at any width.</summary>
    private static string Pct(double value, double of) => (value / Math.Max(0.001, of) * 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private static string Percent(TimeSpan value) => (value.TotalMilliseconds / SampleLength.TotalMilliseconds * 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private static string Number(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string ColourValue(string? value) => value is { Length: 7 } && value[0] == '#' ? value.ToLowerInvariant() : White;

    private static string Text(ChangeEventArgs e, string fallback) => e.Value?.ToString()?.Trim() is { Length: > 0 } text ? text : fallback;

    private static double Number(ChangeEventArgs e, double fallback) =>
        double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double value) ? value : fallback;
}
