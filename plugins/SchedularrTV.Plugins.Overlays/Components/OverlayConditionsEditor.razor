@* When an overlay may show (new episodes, films, Up Next promos…) and whether it shares the screen or takes turns. *@
@inject LibraryBrowser Library

<label class="check">
    <input type="checkbox" checked="@OverlayContention.IsAdditive(Overlay)" @onchange="e => Set(() => Overlay.Additive = e.Value is true)" />
    <span>Additive: always show, alongside any other overlay</span>
</label>
<p class="hint" style="margin-top:0;">
    Overlays that aren't additive take turns: where several would be on screen at the same time, one of them is picked at
    random (the same one every time that airing is published) and the others stand down. Screen bugs are usually additive;
    lower thirds and Up Next cards usually aren't, so variations of one can share its spot.
</p>

<label class="check">
    <input type="checkbox" checked="@Overlay.ScreenBug" @onchange="e => Set(() => Overlay.ScreenBug = e.Value is true)" />
    <span>This is a screen bug</span>
</label>
<p class="hint" style="margin-top:0;">
    Screen bugs stand down on episodes whose recordings already have a bug burned in. Mark those shows, seasons or
    episodes on their page under <a href="library/shows">TV Shows</a>.
</p>

<div class="field">
    <span>Only on <span class="muted">(any of; none ticked means wherever “On” above allows)</span></span>
    <div class="row row-wrap" style="gap:6px;">
        @foreach (string value in OverlayOn.All)
        {
            bool on = Conditions?.On.Contains(value) == true;
            <button type="button" class="btn btn-sm @(on ? "btn-primary" : "btn-ghost")" aria-pressed="@(on ? "true" : "false")"
                    @onclick="() => Set(() => Toggle(value, !on))">@OverlayOn.Label(value)</button>
        }
    </div>
</div>

<div class="grid grid-3">
    <label class="field"><span>The programme is</span>
        <select value="@(Conditions?.Episodes ?? "")" @onchange="e => Set(() => Edit().Episodes = Empty(e))">
            <option value="">Anything</option>
            <option value="@OverlayAiring.New">A new episode</option>
            <option value="@OverlayAiring.Repeat">Not a new episode</option>
        </select></label>
    <label class="field"><span>What's on next is</span>
        <select value="@(Conditions?.Next ?? "")" @onchange="e => Set(() => Edit().Next = Empty(e))">
            <option value="">Anything</option>
            <option value="@OverlayAiring.New">A new episode</option>
            <option value="@OverlayAiring.Repeat">Not a new episode</option>
            <option value="@OverlayAiring.Episode">An episode</option>
            <option value="@OverlayAiring.Movie">A movie</option>
        </select></label>
    <label class="field"><span>The programme matches <span class="muted">(library query, optional)</span></span>
        <QueryInput Value="@Conditions?.Query" Placeholder="genre:'Comedy'" Scope="what in the library it matches; it's checked against each programme"
                    ValueChanged="v => Set(() => Edit().Query = Empty(new ChangeEventArgs { Value = v }))" /></label>
</div>
<div class="field">
    <span>Only on these shows <span class="muted">(any of; none means any show)</span></span>
    @if (Conditions?.Shows is { Count: > 0 } chosen)
    {
        <div class="chip-row" style="margin-bottom:6px;">
            @foreach (string show in chosen)
            {
                <span class="chip chip-on">
                    @show
                    <button type="button" class="btn btn-sm btn-ghost" style="padding:0 4px;min-height:0;" title="Remove @show"
                            aria-label="@($"Remove {show}")" @onclick="() => Set(() => Edit().Shows.Remove(show))">×</button>
                </span>
            }
        </div>
    }
    <TitlePicker Options="ShowOptions" Value="@_pendingShow" ValueChanged="v => _pendingShow = v" OnPicked="AddShow"
                 Placeholder="Add a show…" AriaLabel="Show" />
</div>
<p class="hint" style="margin-top:0;">
    Judged on what's on screen, so with <strong>Interstitials</strong> ticked above it's the interstitial itself (each music
    video of a music video show, say), not the programme the break interrupts.
</p>

@if (Conditions?.Query is { Length: > 0 } conditionQuery && !SchedularrTV.Core.Query.QueryParser.TryParse(conditionQuery, out _, out string? queryError))
{
    <p class="hint warn">That query doesn't read: @queryError</p>
}
<p class="hint">
    A new episode is the first airing of one released by a Drop order. In a break, “the programme” is the one the break
    interrupts or follows. Tokens <code>{new}</code> and <code>{next_new}</code> read NEW for a new episode (now, or next).
</p>

@code {
    [Parameter, EditorRequired] public Overlay Overlay { get; set; } = new();
    [Parameter] public EventCallback Changed { get; set; }

    private OverlayConditions? Conditions => Overlay.Conditions;

    private List<string> _shows = [];
    private string? _pendingShow;

    // Shows not already chosen.
    private IEnumerable<string> ShowOptions => _shows.Where(show => Conditions?.Shows?.Contains(show, StringComparer.OrdinalIgnoreCase) != true);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _shows = [.. (await Library.GetShowsAsync()).Select(show => show.Name).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase)];
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            _shows = []; // the library can't be read right now: shows can still be typed in
        }
    }

    private async Task AddShow(string? show)
    {
        _pendingShow = null;
        if (string.IsNullOrWhiteSpace(show))
        {
            return;
        }

        await Set(() =>
        {
            List<string> shows = Edit().Shows ??= [];
            if (!shows.Contains(show.Trim(), StringComparer.OrdinalIgnoreCase))
            {
                shows.Add(show.Trim());
            }
        });
    }

    private OverlayConditions Edit() => Overlay.Conditions ??= new OverlayConditions();

    private async Task Set(Action change)
    {
        change();
        // Nothing set: don't leave an empty block in the YAML.
        if (Overlay.Conditions is { HasConditions: false })
        {
            Overlay.Conditions = null;
        }

        await Changed.InvokeAsync();
    }

    private void Toggle(string value, bool on)
    {
        List<string> values = Edit().On;
        if (on && !values.Contains(value))
        {
            values.Add(value);
        }
        else if (!on)
        {
            values.Remove(value);
        }
    }

    private static string? Empty(ChangeEventArgs e) => e.Value?.ToString() is { Length: > 0 } value && !string.IsNullOrWhiteSpace(value) ? value.Trim() : null;
}
