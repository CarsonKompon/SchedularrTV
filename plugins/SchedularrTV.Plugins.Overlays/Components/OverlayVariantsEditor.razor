@* A file overlay's other pictures: each shown instead of the default when its conditions hold (first match wins). *@

<h4>Other pictures <span class="ed-meta">first match wins</span></h4>
<p class="hint" style="margin-top:0;">
    Show a different picture when a programme's rating, the holiday, the season or the time calls for it: a TV-Y badge on kids' shows, a
    pumpkin bug through Halloween. With none matching, the picture above shows@(string.IsNullOrWhiteSpace(Overlay.File) ? " (none is set, so nothing does)" : "").
</p>

@for (int index = 0; index < Overlay.Variants.Count; index++)
{
    int at = index;
    OverlayVariant variant = Overlay.Variants[at];
    bool open = ReferenceEquals(variant, _open);
    <div class="ov-variant @(open ? "open" : "")" @key="variant">
        <div class="ov-variant-head">
            <input type="checkbox" checked="@variant.Enabled" title="Use this picture" aria-label="Use @variant.Name"
                   @onchange="e => Set(() => variant.Enabled = e.Value is true)" />
            <button type="button" class="ov-variant-name" aria-expanded="@(open ? "true" : "false")" @onclick="() => _open = open ? null : variant">
                <strong>@variant.Name</strong>
                <small>@Summary(variant)</small>
            </button>
            <button class="btn btn-sm" type="button" title="Checked earlier" aria-label="Move @variant.Name up" disabled="@(at == 0)" @onclick="() => Move(at, -1)">↑</button>
            <button class="btn btn-sm" type="button" title="Checked later" aria-label="Move @variant.Name down" disabled="@(at == Overlay.Variants.Count - 1)" @onclick="() => Move(at, 1)">↓</button>
        </div>

        @if (open)
        {
            <div class="ov-variant-body">
                <label class="field"><span>Name</span>
                    <input type="text" value="@variant.Name" @onchange="e => Set(() => variant.Name = Text(e) ?? variant.Name)" /></label>
                <div class="field"><span>Picture or video</span>
                    <FilePathPicker Value="@variant.File" ValueChanged="value => Set(() => variant.File = value)" Extensions="Extensions"
                                    Label="picture or video" StartIn="Environment.SpecialFolder.MyPictures" Placeholder="D:\Media\Logos\halloween.png" /></div>
                @if (!string.IsNullOrWhiteSpace(variant.File) && !File.Exists(variant.File))
                {
                    <p class="hint warn">The scheduler can't find this file.</p>
                }
                else if (string.IsNullOrWhiteSpace(variant.File))
                {
                    <p class="hint warn">Choose a picture: without one this is skipped.</p>
                }

                <h4>When the programme…</h4>
                <label class="field"><span>Is rated <span class="muted">(any of, comma-separated: TV-Y, TV-Y7, TV-G, TV-PG…)</span></span>
                    <input type="text" value="@string.Join(", ", variant.Ratings)" placeholder="TV-Y, TV-Y7"
                           @onchange="e => Set(() => variant.Ratings = List(e))" /></label>
                <div class="row row-wrap" style="gap:6px;margin:-4px 0 10px;">
                    @foreach (string rating in CommonRatings)
                    {
                        bool on = variant.Ratings.Any(chosen => OverlayVariants.SameRating(chosen, rating));
                        <button type="button" class="btn btn-sm @(on ? "btn-primary" : "btn-ghost")" @onclick="() => Set(() => Toggle(variant.Ratings, rating, !on))">@rating</button>
                    }
                </div>
                <label class="field"><span>Matches a library query <span class="muted">(optional)</span></span>
                    <input type="text" value="@variant.Query" placeholder="show:'Rugrats' OR tag:'Halloween'" spellcheck="false"
                           @onchange="e => Set(() => variant.Query = Text(e))" /></label>
                @if (!string.IsNullOrWhiteSpace(variant.Query) && !SchedularrTV.Core.Query.QueryParser.TryParse(variant.Query, out _, out string? queryError))
                {
                    <p class="hint warn">That query doesn't read: @queryError</p>
                }

                <h4>When it airs…</h4>
                <div class="field"><span>During a holiday <span class="muted">(as set under Settings)</span></span>
                    <div class="row row-wrap" style="gap:4px 14px;">
                        @foreach (string holiday in HolidayNames)
                        {
                            <label class="check" style="margin:0;"><input type="checkbox" checked="@Has(variant.Holidays, holiday)"
                                                                          @onchange="e => Set(() => Toggle(variant.Holidays, holiday, e.Value is true))" /><span>@holiday</span></label>
                        }
                    </div>
                </div>
                <div class="field"><span>In a season</span>
                    <div class="row row-wrap" style="gap:4px 14px;">
                        @foreach (string season in Seasons)
                        {
                            <label class="check" style="margin:0;"><input type="checkbox" checked="@Has(variant.Seasons, season)"
                                                                          @onchange="e => Set(() => Toggle(variant.Seasons, season, e.Value is true))" /><span>@season</span></label>
                        }
                    </div>
                </div>
                <div class="field"><span>In a month</span>
                    <div class="row row-wrap" style="gap:4px 12px;">
                        @for (int month = 1; month <= 12; month++)
                        {
                            int number = month;
                            <label class="check" style="margin:0;"><input type="checkbox" checked="@variant.Months.Contains(number)"
                                                                          @onchange="e => Set(() => ToggleMonth(variant, number, e.Value is true))" />
                                <span>@CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(number)</span></label>
                        }
                    </div>
                </div>
                <div class="grid grid-2">
                    <label class="field"><span>From the date <span class="muted">(MM-DD)</span></span>
                        <input type="text" value="@variant.DateFrom" placeholder="10-01" @onchange="e => Set(() => variant.DateFrom = Text(e))" /></label>
                    <label class="field"><span>To the date <span class="muted">(MM-DD)</span></span>
                        <input type="text" value="@variant.DateTo" placeholder="10-31" @onchange="e => Set(() => variant.DateTo = Text(e))" /></label>
                </div>
                <div class="field"><span>On a day</span>
                    <div class="row row-wrap" style="gap:4px 12px;">
                        @foreach (DayOfWeek day in Week)
                        {
                            <label class="check" style="margin:0;"><input type="checkbox" checked="@variant.Days.Contains(day)"
                                                                          @onchange="e => Set(() => ToggleDay(variant, day, e.Value is true))" />
                                <span>@CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(day)</span></label>
                        }
                    </div>
                </div>
                <div class="grid grid-2">
                    <label class="field"><span>From the time</span>
                        <input type="time" value="@Clock(variant.TimeFrom)" @onchange="e => Set(() => variant.TimeFrom = Time(e))" /></label>
                    <label class="field"><span>Until the time</span>
                        <input type="time" value="@Clock(variant.TimeTo)" @onchange="e => Set(() => variant.TimeTo = Time(e))" /></label>
                </div>
                <p class="hint">Everything set must hold; leave the rest empty. Dates and times can wrap (12-20 to 01-05, 22:00 to 06:00), and are
                    judged as each programme starts, in the channel's time zone.</p>
                @if (!variant.HasConditions)
                {
                    <p class="hint warn">No conditions yet, so this picture always shows and the ones after it never do.</p>
                }

                <div class="row" style="gap:8px;">
                    <div class="spacer"></div>
                    <button class="btn btn-sm" type="button" @onclick="() => Duplicate(variant)">Duplicate</button>
                    <button class="btn btn-sm btn-danger" type="button" @onclick="() => Remove(variant)">Delete</button>
                </div>
            </div>
        }
    </div>
}

<div class="row row-wrap" style="gap:6px;margin-top:6px;">
    <button class="btn btn-sm" type="button" @onclick="AddRating">+ Rating badge</button>
    <button class="btn btn-sm" type="button" @onclick="AddHoliday">+ Holiday picture</button>
    <button class="btn btn-sm" type="button" @onclick="AddOther">+ Other</button>
</div>

<style>
    .ov-variant { border: 1px solid var(--line); border-radius: 10px; margin-bottom: 6px; }
    .ov-variant.open { border-color: var(--line-strong); }
    .ov-variant-head { display: flex; gap: 6px; align-items: center; padding: 6px 8px; }
    .ov-variant-name { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; text-align: left; background: none; border: 0; color: inherit; cursor: pointer; padding: 2px 4px; font: inherit; }
    .ov-variant-name small { color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
    .ov-variant-body { padding: 4px 12px 12px; border-top: 1px solid var(--line); }
</style>

@code {
    [Parameter, EditorRequired] public Overlay Overlay { get; set; } = new();

    /// <summary>The holidays set up under Settings (else the defaults), to pick from.</summary>
    [Parameter] public IReadOnlyList<string> HolidayNames { get; set; } = [];

    [Parameter] public EventCallback Changed { get; set; }

    private static readonly string[] Extensions = [".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".mov", ".webm", ".mp4", ".mkv"];
    private static readonly string[] CommonRatings = ["TV-Y", "TV-Y7", "TV-G", "TV-PG", "TV-14", "TV-MA", "G", "PG", "PG-13", "R"];
    private static readonly string[] Seasons = ["Winter", "Spring", "Summer", "Fall"];
    private static readonly DayOfWeek[] Week =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    private OverlayVariant? _open;

    private async Task Set(Action change)
    {
        change();
        await Changed.InvokeAsync();
    }

    private Task Add(OverlayVariant variant)
    {
        Overlay.Variants.Add(variant);
        _open = variant;
        return Changed.InvokeAsync();
    }

    private Task AddRating() => Add(new OverlayVariant { Name = Unique("Rating badge"), Ratings = ["TV-Y"] });

    private Task AddHoliday() => Add(new OverlayVariant { Name = Unique(HolidayNames.FirstOrDefault() ?? "Holiday"), Holidays = [.. HolidayNames.Take(1)] });

    private Task AddOther() => Add(new OverlayVariant { Name = Unique("Other picture") });

    private Task Duplicate(OverlayVariant variant)
    {
        OverlayVariant copy = variant.Copy();
        copy.Name = Unique(variant.Name);
        Overlay.Variants.Insert(Overlay.Variants.IndexOf(variant) + 1, copy);
        _open = copy;
        return Changed.InvokeAsync();
    }

    private Task Remove(OverlayVariant variant)
    {
        Overlay.Variants.Remove(variant);
        _open = null;
        return Changed.InvokeAsync();
    }

    private Task Move(int index, int by)
    {
        int to = index + by;
        if (to < 0 || to >= Overlay.Variants.Count)
        {
            return Task.CompletedTask;
        }

        (Overlay.Variants[index], Overlay.Variants[to]) = (Overlay.Variants[to], Overlay.Variants[index]);
        return Changed.InvokeAsync();
    }

    private string Unique(string name)
    {
        string candidate = name;
        for (int number = 2; Overlay.Variants.Any(variant => string.Equals(variant.Name, candidate, StringComparison.OrdinalIgnoreCase)); number++)
        {
            candidate = $"{name} {number}";
        }

        return candidate;
    }

    /// <summary>The conditions in a few words, for the collapsed row.</summary>
    private static string Summary(OverlayVariant variant)
    {
        List<string> parts = [];
        if (variant.Ratings.Count > 0) parts.Add("rated " + string.Join("/", variant.Ratings));
        if (!string.IsNullOrWhiteSpace(variant.Query)) parts.Add("matching " + variant.Query);
        if (variant.Holidays.Count > 0) parts.Add(string.Join("/", variant.Holidays));
        if (variant.Seasons.Count > 0) parts.Add(string.Join("/", variant.Seasons));
        if (variant.Months.Count > 0) parts.Add(string.Join("/", variant.Months.Order().Select(month => CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month))));
        if (!string.IsNullOrWhiteSpace(variant.DateFrom) || !string.IsNullOrWhiteSpace(variant.DateTo)) parts.Add($"{variant.DateFrom ?? "…"} to {variant.DateTo ?? "…"}");
        if (variant.Days.Count > 0) parts.Add(string.Join("/", variant.Days.Select(day => CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(day))));
        if (variant.TimeFrom is not null || variant.TimeTo is not null) parts.Add($"{Clock(variant.TimeFrom) ?? "00:00"}–{Clock(variant.TimeTo) ?? "24:00"}");
        string picture = string.IsNullOrWhiteSpace(variant.File) ? "no picture yet" : Path.GetFileName(variant.File);
        return (parts.Count == 0 ? "always" : string.Join(" · ", parts)) + " → " + picture;
    }

    private static bool Has(List<string> list, string value) => list.Contains(value, StringComparer.OrdinalIgnoreCase);

    private static void Toggle(List<string> list, string value, bool on)
    {
        // Alike ignoring case, spaces and dashes ("TV-Y" and "TVY"), so one written by hand toggles off too.
        list.RemoveAll(existing => OverlayVariants.SameRating(existing, value));
        if (on)
        {
            list.Add(value);
        }
    }

    private static void ToggleMonth(OverlayVariant variant, int month, bool on)
    {
        variant.Months.Remove(month);
        if (on)
        {
            variant.Months.Add(month);
            variant.Months.Sort();
        }
    }

    private static void ToggleDay(OverlayVariant variant, DayOfWeek day, bool on)
    {
        variant.Days.Remove(day);
        if (on)
        {
            variant.Days.Add(day);
        }
    }

    private static string? Text(ChangeEventArgs e) => e.Value?.ToString()?.Trim() is { Length: > 0 } text ? text : null;

    private static List<string> List(ChangeEventArgs e) =>
        [.. (e.Value?.ToString() ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase)];

    private static string? Clock(TimeSpan? time) => time is { } value ? value.ToString(@"hh\:mm", CultureInfo.InvariantCulture) : null;

    private static TimeSpan? Time(ChangeEventArgs e) =>
        TimeSpan.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out TimeSpan value) && value >= TimeSpan.Zero && value < TimeSpan.FromDays(1) ? value : null;
}
