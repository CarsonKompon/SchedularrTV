@page "/plugins/web-channels"
@* Web channels: each one a "show" of a live web page (from a preset or any address), in the lengths you allow. *@
@implements IDisposable
@inject ChannelStore Store
@inject ChannelHub Hub
@inject WebChannelSettings Settings
@inject Geocoder Places
@inject IEnumerable<SchedularrTV.Core.Media.IMusicLibrary> MusicLibraries

<div class="page-header">
    <div>
        <div class="eyebrow">Plugins</div>
        <h1>Web shows</h1>
        <p class="muted">Schedule weather, clocks or any web page as a live show.</p>
    </div>
</div>

<VirtualShowNotice />

@if (BrowserLocator.Find(Settings.BrowserPath) is null)
{
    <div class="banner banner-error" role="alert">
        A browser is required. Install Chrome, Edge or Chromium, or select its path in <a href="settings/plugins">plugin settings</a>.
    </div>
}
@if (_message is not null)
{
    <div class="banner @(_messageOk ? "banner-ok" : "banner-error")" role="status">@_message</div>
}

<LowPowerNotice Title="@($"Web shows on{SchedularrTV.Core.Platform.HardwareProfile.DeviceName}")" Advice="LowPowerAdvice">
    Each channel on air is a hidden browser drawing the page without a graphics chip, plus a live encode. One at a time is
    comfortable; two at once can use the whole processor.
</LowPowerNotice>

@foreach (WebChannel channel in _channels)
{
    bool editing = ReferenceEquals(channel, _editing);
    WebPreset preset = channel.PresetInfo;
    LiveStatus? status = string.IsNullOrEmpty(channel.Id) ? null : Hub.Streams.Status(channel.Id);
    <div class="card" @key="channel">
        <div class="card-head">
            <h2>@Title(channel)</h2>
            <span class="pill pill-muted">@preset.Name</span>
            @if (string.IsNullOrEmpty(channel.Id))
            {
                <span class="pill pill-warn">Not saved yet</span>
            }
            @if (status is not null)
            {
                <span class="pill pill-ok">On air · @status.Viewers watching</span>
            }
            <div class="spacer"></div>
            @if (_confirmDelete == channel.Id && !string.IsNullOrEmpty(channel.Id))
            {
                <button class="btn btn-sm btn-danger" type="button" @onclick="() => Remove(channel)">Delete @(channel.Name)?</button>
                <button class="btn btn-sm" type="button" @onclick="() => _confirmDelete = null">Keep</button>
            }
            else
            {
                @if (!editing)
                {
                    <button class="btn btn-sm" type="button" @onclick="() => Edit(channel)">Edit</button>
                }
                <button class="btn btn-sm btn-ghost" type="button" title="Delete this show" aria-label="Delete @channel.Name"
                        @onclick="() => AskDelete(channel)">Delete</button>
            }
        </div>

        @if (editing)
        {
            <div class="grid grid-2">
                <label class="field">
                    <span>Shows</span>
                    <select value="@preset.Id" @onchange="e => SetPreset(channel, Text(e))">
                        @foreach (WebPreset option in WebPresets.All)
                        {
                            <option value="@option.Id">@option.Name</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Show name</span>
                    <input type="text" value="@channel.Name" placeholder="@preset.DefaultName(Town(channel))" @onchange="e => channel.Name = Text(e)" />
                </label>
            </div>
            <p class="hint" style="margin:-4px 0 12px;">@preset.Description</p>
            <LowPowerNotice Inline="true" Title="@PresetWarning(preset.Id)" />

            @if (preset.Id == WebPresets.Custom)
            {
                <label class="field">
                    <span>Page address</span>
                    <input type="text" value="@channel.Url" placeholder="https://example.com/dashboard?kiosk=1" @onchange="e => channel.Url = Text(e)" />
                </label>
                <p class="hint" style="margin:-4px 0 10px;">
                    {lat}, {lon}, {location} and {name} are filled in from the place below, if you choose one. Its own sound can be aired
                    (under Sound below), or music of yours.
                </p>
                @if (!string.IsNullOrWhiteSpace(channel.Url) && !WebPresets.IsWebAddress(channel.Url))
                {
                    <p class="hint warn">That isn't a web address; it has to start with http:// or https://.</p>
                }
            }

            @if (preset.Place != PlaceNeed.None)
            {
                <h3 class="wc-section">Place @(preset.Place == PlaceNeed.Optional ? "(optional)" : "")</h3>
                <div class="field">
                    <div class="row" style="gap:6px;">
                        <input type="text" value="@_query" placeholder="Search for a city" style="flex:1;min-width:0;"
                               @onchange="e => _query = Text(e)" @onkeydown="SearchOnEnter" />
                        <button class="btn btn-sm" type="button" disabled="@_searching" @onclick="SearchAsync">@(_searching ? "Searching…" : "Search")</button>
                        @if (preset.Place == PlaceNeed.Optional && channel.HasPlace)
                        {
                            <button class="btn btn-sm btn-ghost" type="button" @onclick="() => ClearPlace(channel)">No place</button>
                        }
                    </div>
                </div>
                @if (_places.Count > 0)
                {
                    <div class="row row-wrap" style="gap:6px;margin-bottom:10px;">
                        @foreach (Place place in _places)
                        {
                            <button class="btn btn-sm" type="button" @onclick="() => Pick(channel, place)">@place.Label</button>
                        }
                    </div>
                }
                <div class="grid grid-3">
                    <label class="field">
                        <span>Shown as</span>
                        <input type="text" value="@channel.Location" placeholder="Toronto, Ontario" @onchange="e => channel.Location = Text(e)" />
                    </label>
                    <label class="field">
                        <span>Latitude</span>
                        <input type="number" step="0.0001" value="@channel.Latitude.ToString("0.####", CultureInfo.InvariantCulture)"
                               @onchange="e => channel.Latitude = Number(e, channel.Latitude)" />
                    </label>
                    <label class="field">
                        <span>Longitude</span>
                        <input type="number" step="0.0001" value="@channel.Longitude.ToString("0.####", CultureInfo.InvariantCulture)"
                               @onchange="e => channel.Longitude = Number(e, channel.Longitude)" />
                    </label>
                </div>
                @if (preset.PlaceHint is { } placeHint)
                {
                    <p class="hint" style="margin:-4px 0 10px;">@placeHint</p>
                }
            }

            <h3 class="wc-section">Look</h3>
            @switch (preset.Id)
            {
                case WebPresets.WeatherStar:
                    <div class="grid grid-3">
                        <label class="field">
                            <span>Units</span>
                            <select value="@(channel.Imperial ? "imperial" : "metric")" @onchange="e => channel.Imperial = IsImperial(e)">
                                <option value="metric">Metric (°C, km/h, km, hPa)</option>
                                <option value="imperial">Imperial (°F, mph, mi, inHg)</option>
                            </select>
                        </label>
                        <label class="field">
                            <span>Page speed</span>
                            <select value="@channel.Speed.ToString("0.##", CultureInfo.InvariantCulture)" @onchange="e => channel.Speed = Number(e, 1.0)">
                                <option value="0.5">Very fast</option>
                                <option value="0.75">Fast</option>
                                <option value="1">Normal</option>
                                <option value="1.25">Slow</option>
                                <option value="1.5">Very slow</option>
                            </select>
                        </label>
                    </div>
                    <div class="row row-wrap" style="gap:18px;margin-bottom:10px;">
                        <label class="check"><input type="checkbox" checked="@channel.Widescreen" @onchange="e => channel.Widescreen = e.Value is true" /><span>Widescreen</span></label>
                        <label class="check"><input type="checkbox" checked="@channel.TwelveHourClock" @onchange="e => channel.TwelveHourClock = e.Value is true" /><span>12-hour clock</span></label>
                        <label class="check"><input type="checkbox" checked="@channel.ScanLines" @onchange="e => channel.ScanLines = e.Value is true" /><span>Scan lines</span></label>
                    </div>
                    break;

                case WebPresets.Clock:
                    <div class="grid grid-3">
                        <label class="field">
                            <span>Style</span>
                            <select value="@channel.ClockStyle" @onchange="e => channel.ClockStyle = Text(e)">
                                <option value="digital">Digital</option>
                                <option value="analog">Clock face</option>
                            </select>
                        </label>
                        <label class="field">
                            <span>Time zone <span class="muted">(empty for this computer's)</span></span>
                            <input type="text" value="@channel.TimeZone" placeholder="America/Toronto" @onchange="e => channel.TimeZone = Text(e)" />
                        </label>
                        <label class="field">
                            <span>Units</span>
                            <select value="@(channel.Imperial ? "imperial" : "metric")" @onchange="e => channel.Imperial = IsImperial(e)">
                                <option value="metric">°C, km/h</option>
                                <option value="imperial">°F, mph</option>
                            </select>
                        </label>
                    </div>
                    <div class="row row-wrap" style="gap:18px;margin-bottom:10px;">
                        <label class="check"><input type="checkbox" checked="@channel.TwelveHourClock" @onchange="e => channel.TwelveHourClock = e.Value is true" /><span>12-hour clock</span></label>
                        <label class="check"><input type="checkbox" checked="@channel.ShowWeather" @onchange="e => channel.ShowWeather = e.Value is true" /><span>Current weather (needs a place)</span></label>
                    </div>
                    <label class="field">
                        <span>Scrolling message <span class="muted">(optional)</span></span>
                        <input type="text" value="@channel.Message" maxlength="500" placeholder="Thanks for watching. Regular programming resumes shortly." @onchange="e => channel.Message = Text(e)" />
                    </label>
                    break;

                case WebPresets.WeatherscanV1:
                case WebPresets.WeatherscanV2:
                    <p class="hint">Weatherscan runs its own lineup of segments, music and narration, and starts by itself with the place above.</p>
                    break;

                case WebPresets.WeatherscanLocal:
                    <div class="field">
                        <span>Segments <span class="muted">(none ticked: @(string.Join(", ", WebPresets.DefaultLocalSegments.Select(SegmentLabel))))</span></span>
                        <div class="row row-wrap" style="gap:4px 18px;">
                            @foreach (LayerOption segment in WebPresets.LocalSegments)
                            {
                                <label class="check" style="margin:0;">
                                    <input type="checkbox" checked="@channel.Segments.Contains(segment.Value)" @onchange="e => ToggleSegment(channel, segment.Value, e.Value is true)" />
                                    <span>@segment.Label</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="grid grid-2">
                        <label class="field">
                            <span>Cable company's name <span class="muted">(optional)</span></span>
                            <input type="text" value="@channel.Affiliate" maxlength="60" placeholder="Your cable company" @onchange="e => channel.Affiliate = Text(e)" />
                        </label>
                        <label class="field">
                            <span>Scrolling message <span class="muted">(optional)</span></span>
                            <input type="text" value="@channel.Message" maxlength="500" placeholder="Thanks for watching." @onchange="e => channel.Message = Text(e)" />
                        </label>
                    </div>
                    <label class="check"><input type="checkbox" checked="@channel.Narration" @onchange="e => channel.Narration = e.Value is true" /><span>Narration between songs</span></label>
                    break;

                case WebPresets.WeatherStarJr:
                case WebPresets.WeatherStar4000:
                    <div class="grid grid-2">
                        <label class="field">
                            <span>Bottom line</span>
                            <select value="@WebPresets.Choice(WebPresets.ClassicBars, channel.BottomBar)" @onchange="e => channel.BottomBar = Text(e)">
                                @foreach (LayerOption option in WebPresets.ClassicBars)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </label>
                        <label class="field">
                            <span>Your message <span class="muted">(optional)</span></span>
                            <input type="text" value="@channel.Message" maxlength="500" placeholder="Thanks for watching." @onchange="e => channel.Message = Text(e)" />
                        </label>
                    </div>
                    break;

                case WebPresets.WeatherStarXl:
                    <div class="grid grid-3">
                        <label class="field">
                            <span>Flavor <span class="muted">(each forecast's length)</span></span>
                            <select value="@WebPresets.Choice(WebPresets.XlFlavors, channel.Flavor)" @onchange="e => channel.Flavor = Text(e)">
                                @foreach (LayerOption option in WebPresets.XlFlavors)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </label>
                        <label class="field">
                            <span>Bottom line</span>
                            <select value="@WebPresets.Choice(WebPresets.XlBars, channel.BottomBar)" @onchange="e => channel.BottomBar = Text(e)">
                                @foreach (LayerOption option in WebPresets.XlBars)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </label>
                        <label class="field">
                            <span>Graphics</span>
                            <select value="@WebPresets.Choice(WebPresets.XlGraphics, channel.Graphics)" @onchange="e => channel.Graphics = Text(e)">
                                @foreach (LayerOption option in WebPresets.XlGraphics)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </label>
                    </div>
                    <label class="field">
                        <span>Your message <span class="muted">(optional)</span></span>
                        <input type="text" value="@channel.Message" maxlength="500" placeholder="Thanks for watching." @onchange="e => channel.Message = Text(e)" />
                    </label>
                    <div class="row row-wrap" style="gap:18px;margin-bottom:10px;">
                        <label class="check"><input type="checkbox" checked="@channel.Widescreen" @onchange="e => channel.Widescreen = e.Value is true" /><span>Wider picture (3:2 rather than 4:3)</span></label>
                        <label class="check"><input type="checkbox" checked="@channel.Narration" @onchange="e => channel.Narration = e.Value is true" /><span>Narration</span></label>
                    </div>
                    @if (WebPresets.Choice(WebPresets.XlBars, channel.BottomBar) == "both" && WebPresets.Choice(WebPresets.XlFlavors, channel.Flavor) != "m")
                    {
                        <p class="hint warn">Conditions and your message together only fit the M flavor; with this one it shows conditions.</p>
                    }
                    break;

                case WebPresets.IntelliStar:
                    <div class="grid grid-3">
                        <label class="field">
                            <span>Flavor <span class="muted">(each forecast's length)</span></span>
                            <select value="@WebPresets.Choice(WebPresets.IntelliStarFlavors, channel.Flavor)" @onchange="e => channel.Flavor = Text(e)">
                                @foreach (LayerOption option in WebPresets.IntelliStarFlavors)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </label>
                        <label class="field">
                            <span>Graphics</span>
                            <select value="@WebPresets.Choice(WebPresets.IntelliStarGraphics, channel.Graphics)" @onchange="e => channel.Graphics = Text(e)">
                                @foreach (LayerOption option in WebPresets.IntelliStarGraphics)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </label>
                        <label class="field">
                            <span>Bottom line</span>
                            <select value="@WebPresets.Choice(WebPresets.IntelliStarBars, channel.BottomBar)" @onchange="e => channel.BottomBar = Text(e)">
                                @foreach (LayerOption option in WebPresets.IntelliStarBars)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </label>
                    </div>
                    <label class="field">
                        <span>Your message <span class="muted">(optional)</span></span>
                        <input type="text" value="@channel.Message" maxlength="500" placeholder="Thanks for watching." @onchange="e => channel.Message = Text(e)" />
                    </label>
                    <label class="check"><input type="checkbox" checked="@channel.Narration" @onchange="e => channel.Narration = e.Value is true" /><span>Narration</span></label>
                    break;

                default:
                    <p class="hint">The page is shown as it is, at 1280×720.</p>
                    break;
            }

            <h3 class="wc-section">Scheduling and sound</h3>
            <label class="field">
                <span>Lengths it can be scheduled for (minutes)</span>
                <input type="text" value="@(string.Join(", ", channel.Lengths))" placeholder="3, 4, 5, 10, 30, 60" @onchange="e => channel.Lengths = Lengths(e)" />
            </label>
            @if (preset.CanPlayPageSound)
            {
                <label class="check">
                    <input type="checkbox" checked="@channel.PlaysPageSound" @onchange="e => channel.PageSound = e.Value is true" />
                    <span>@(preset.OwnSound ? "Play its own music and narration" : "Play the page's own sound")</span>
                </label>
            }
            @if (!channel.PlaysPageSound)
            {
                <MusicPicker Value="channel.Music" ValueChanged="value => channel.Music = value" Label="Music (shuffled under the page)"
                             FolderPlaceholder="D:\Music\Weather" MissingFolderText="That music folder doesn't exist on this computer; the channel will be silent." />
            }
            @if (channel.PlaysPageSound || channel.Music is not null)
            {
                <label class="field">
                    <span>@(channel.PlaysPageSound ? "Volume" : "Music volume"): @((int)Math.Round(channel.MusicVolume * 100))%</span>
                    <input type="range" min="0" max="1" step="0.05" value="@channel.MusicVolume.ToString(CultureInfo.InvariantCulture)"
                           @onchange="e => channel.MusicVolume = Number(e, channel.MusicVolume)" />
                </label>
            }
            @if (channel.PlaysPageSound)
            {
                <p class="hint">What the page plays (its audio and video) is aired as it plays. If a page makes its sound some other way, it airs silent; choose music instead.</p>
            }
            <div class="row" style="gap:8px;margin-top:6px;align-items:center;">
                @if (!CanShow(channel))
                {
                    <span class="hint warn" style="margin:0;">@(channel.PresetInfo.Id == WebPresets.Custom ? "Enter the page's address to save it." : "Choose a place to save it.")</span>
                }
                <div class="spacer"></div>
                <button class="btn btn-sm" type="button" @onclick="Done">Done</button>
            </div>
        }
        else
        {
            <p class="muted" style="margin:0 0 8px;">@Summary(channel)</p>
            <div class="row row-wrap" style="gap:6px;margin-bottom:10px;">
                @foreach (int minutes in channel.ValidLengths)
                {
                    <span class="pill pill-muted">@minutes min</span>
                }
            </div>
            <p class="hint" style="margin:0 0 8px;">
                Schedule it as the show <strong>@channel.Name</strong>: in a channel's base rotation or a block to run it round the clock,
                or as one of a channel's interstitial shows (Breaks tab) between programmes. Stream: <code>@Settings.LiveUrl(channel.Id)</code>
            </p>
            @if (status?.Problem is { } problem)
            {
                <p class="hint warn">@problem</p>
            }
        }

        <details style="margin-top:10px;" open="@editing">
            <summary class="hint" style="cursor:pointer;">Preview</summary>
            <div class="wc-preview">
                @if (status is not null && !editing)
                {
                    <img src="@($"plugins/web-channels/snapshot/{Uri.EscapeDataString(channel.Id)}.jpg?t={_tick}")" alt="What's on air now" />
                }
                else if (CanShow(channel))
                {
                    <iframe src="@preset.PageUrl(channel, Settings.ForPreview)" title="@channel.Name preview" loading="lazy"></iframe>
                }
                else
                {
                    <div class="empty">@(preset.Id == WebPresets.Custom ? "Enter a page address to preview it." : "Choose a place to preview it.")</div>
                }
            </div>
            @if (preset.Id == WebPresets.Custom)
            {
                <p class="hint">Some sites refuse to show inside another page, so the preview can stay blank even when the channel works.</p>
            }
            else if (preset.PreviewNeedsScript)
            {
                <p class="hint">This preview shows the simulator's own setup screen: on air it's set up with your settings and started for you.
                    Save and watch the channel to see it.</p>
            }
        </details>
    </div>
}

<div class="row" style="gap:8px;">
    <button class="btn btn-primary" type="button" @onclick="Add">Add a show</button>
</div>

<SaveDock Dirty="Dirty" Label="Unsaved web shows" CanSave="@_channels.All(CanShow)"
          Problem="@(_channels.FirstOrDefault(channel => !CanShow(channel)) is { } unfinished ? $"{Title(unfinished)} isn't finished" : null)"
          OnSave="Save" OnDiscard="Discard" />

<details class="card" style="margin-top:16px;">
    <summary>Scheduling web shows</summary>
    <ul class="hint" style="margin:0;padding-left:18px;line-height:1.6;">
        <li>Each one appears as a show (under TV Shows and in collection pickers) with one "episode" per length, so the scheduler picks whichever fits.</li>
        <li><strong>24/7:</strong> use the show as a channel's default programming, with 30- or 60-minute lengths.</li>
        <li><strong>Between shows:</strong> on a channel's Ad breaks tab, add it to the interstitial shows with 2–5 minute lengths.</li>
        <li>When it airs, ErsatzTV plays it live: a hidden browser shows the page and its picture is streamed with your music, so it's always current.</li>
        <li>New or renamed shows reach the schedule on its next rebuild (Dashboard → Rebuild).</li>
    </ul>
</details>

<style>
    .wc-section { font-size: 13px; margin: 16px 0 8px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
    .wc-preview { margin-top: 8px; width: 640px; max-width: 100%; height: 360px; background: #000; border-radius: 8px; overflow: hidden; }
    .wc-preview iframe { width: 1280px; height: 720px; border: 0; display: block; transform: scale(.5); transform-origin: 0 0; }
    .wc-preview img { width: 100%; height: 100%; display: block; object-fit: contain; }
    .wc-preview .empty { height: 100%; border: 0; border-radius: 0; display: flex; align-items: center; justify-content: center; }
    .hint.warn { color: #ffd08a; }
</style>

@code {
    private List<WebChannel> _channels = [];

    // On a Raspberry Pi: the presets that draw continuously with WebGL or canvas are far heavier without a graphics chip.
    private static string? PresetWarning(string presetId) => presetId switch
    {
        WebPresets.WeatherscanV1 or WebPresets.WeatherscanV2 or WebPresets.WeatherscanLocal or WebPresets.IntelliStar =>
            "This simulator draws a large animated picture with radar loops; drawn in software here it can be slow. WeatherStar 4000+ and the clock are much lighter.",
        WebPresets.Custom => "Busy pages (video, WebGL, large animations) are slow without a graphics chip; a simple page works best here.",
        _ => null
    };

    private IEnumerable<string?> LowPowerAdvice =>
    [
        Settings.CaptureFrameRate > 10
            ? $"Capture frames per second is {Settings.CaptureFrameRate}. 5 to 10 is plenty for forecasts and a clock (plugin settings)."
            : null,
        _channels.Any(channel => channel.Preset is WebPresets.WeatherscanV1 or WebPresets.WeatherscanV2 or WebPresets.WeatherscanLocal or WebPresets.IntelliStar)
            ? "Weatherscan and the IntelliStar are heavy animations here; prefer WeatherStar 4000+ or the clock."
            : null,
        "Used as short segments between programmes, each one starts a browser (a few seconds on a Pi); a longer keep-alive saves restarting it.",
        "The hidden browser is Chromium: on Raspberry Pi OS, sudo apt install chromium."
    ];
    private WebChannel? _editing;
    private string? _confirmDelete;
    private string _query = string.Empty;
    private IReadOnlyList<Place> _places = [];
    private bool _searching;
    private string? _message;
    private bool _messageOk;
    private long _tick;
    private Timer? _refresh;

    protected override void OnInitialized()
    {
        Load();
        Hub.Streams.Changed += OnHubChanged;

        // Keeps the on-air preview frames moving.
        _refresh = new Timer(_ => InvokeAsync(() => { _tick++; if (Hub.Streams.Running.Count > 0) StateHasChanged(); }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    public void Dispose()
    {
        Hub.Streams.Changed -= OnHubChanged;
        _refresh?.Dispose();
    }

    private void OnHubChanged() => _ = InvokeAsync(StateHasChanged);

    // Edits, new channels and deletions are held in _channels until Save in the bar along the bottom; Discard drops them.
    // What was loaded, to tell whether anything has changed since.
    private string _loaded = string.Empty;

    private bool Dirty => !string.Equals(Snapshot(_channels), _loaded, StringComparison.Ordinal);

    private static string Snapshot(IEnumerable<WebChannel> channels) => System.Text.Json.JsonSerializer.Serialize(channels);

    private static string Title(WebChannel channel) => string.IsNullOrWhiteSpace(channel.Name) ? "New show" : channel.Name;

    private void Load()
    {
        _channels = [.. Store.Channels.Select(channel => channel.Copy())];
        _loaded = Snapshot(_channels);
        _editing = null;
        _confirmDelete = null;
        _places = [];
    }

    /// <summary>Whether the channel has what its preset needs to show anything.</summary>
    private static bool CanShow(WebChannel channel) => channel.PresetInfo switch
    {
        { Id: WebPresets.Custom } => WebPresets.IsWebAddress(channel.Url),
        { Place: PlaceNeed.Required } => channel.HasPlace,
        _ => true
    };

    private static string? Town(WebChannel channel) =>
        string.IsNullOrWhiteSpace(channel.Location) ? null : channel.Location.Split(',')[0].Trim();

    private string Summary(WebChannel channel)
    {
        WebPreset preset = channel.PresetInfo;
        List<string> parts = [];
        if (preset.Id == WebPresets.Custom)
        {
            parts.Add(channel.Url ?? "No address");
        }

        if (preset.Place != PlaceNeed.None)
        {
            parts.Add(string.IsNullOrWhiteSpace(channel.Location) ? (channel.HasPlace ? "Unnamed place" : "No place") : channel.Location);
        }

        switch (preset.Id)
        {
            case WebPresets.WeatherStar:
                parts.Add(channel.Imperial ? "Imperial" : "Metric");
                parts.Add(channel.Widescreen ? "Widescreen" : "4:3");
                break;
            case WebPresets.Clock:
                parts.Add(channel.ClockStyle == "analog" ? "Clock face" : "Digital");
                parts.Add(string.IsNullOrWhiteSpace(channel.TimeZone) ? "this computer's time" : channel.TimeZone);
                break;
            case WebPresets.WeatherscanLocal:
                parts.Add(string.Join(", ", (channel.Segments.Count > 0 ? channel.Segments : WebPresets.DefaultLocalSegments).Select(SegmentLabel)));
                break;
            case WebPresets.WeatherStarXl:
                parts.Add(WebPresets.XlFlavors.First(option => option.Value == WebPresets.Choice(WebPresets.XlFlavors, channel.Flavor)).Label);
                break;
            case WebPresets.IntelliStar:
                parts.Add($"{WebPresets.Choice(WebPresets.IntelliStarGraphics, channel.Graphics)} graphics");
                break;
        }

        parts.Add(channel.PlaysPageSound ? "its own sound"
            : channel.Music is { IsSet: true } music ? "music from " + music.Describe(MusicLibraries) : "no music");
        return string.Join(" · ", parts.Where(part => part.Length > 0));
    }

    private void SetPreset(WebChannel channel, string id)
    {
        WebPreset before = channel.PresetInfo;
        WebPreset after = WebPresets.Find(id);

        // A name that was only the old preset's suggestion follows the new one.
        if (string.IsNullOrWhiteSpace(channel.Name) || channel.Name == before.DefaultName(Town(channel)))
        {
            channel.Name = after.DefaultName(Town(channel));
        }

        channel.Preset = after.Id;
        channel.Zoom = 0;
        channel.Layer = null;

        // Each preset's own sound choice, and settings whose choices differ between presets, start afresh.
        channel.PageSound = null;
        channel.BottomBar = null;
        channel.Flavor = null;
        channel.Graphics = null;
    }

    private static string SegmentLabel(string value) =>
        WebPresets.LocalSegments.FirstOrDefault(option => option.Value == value)?.Label ?? value;

    private static void ToggleSegment(WebChannel channel, string segment, bool on)
    {
        channel.Segments.Remove(segment);
        if (on)
        {
            channel.Segments.Add(segment);
        }

        // Kept in the order the simulator shows them.
        channel.Segments = [.. WebPresets.LocalSegments.Select(option => option.Value).Where(channel.Segments.Contains)];
    }

    // Another channel's editor closes, keeping its edits for the save bar.
    private void Edit(WebChannel channel)
    {
        _editing = channel;
        _query = channel.Location;
        _places = [];
        _message = null;
    }

    private void Add()
    {
        var channel = new WebChannel { Name = string.Empty };
        _channels.Add(channel);
        _editing = channel;
        _query = string.Empty;
        _places = [];
        _message = null;
    }

    private void Done()
    {
        _editing = null;
        _places = [];
    }

    private void Discard()
    {
        Load();
        _message = null;
    }

    private void AskDelete(WebChannel channel)
    {
        // A channel that was never saved just goes.
        if (string.IsNullOrEmpty(channel.Id))
        {
            Remove(channel);
            return;
        }

        _confirmDelete = channel.Id;
    }

    private void Remove(WebChannel channel)
    {
        _confirmDelete = null;
        _channels.Remove(channel);
        if (ReferenceEquals(_editing, channel))
        {
            Done();
        }
    }

    private void Save()
    {
        if (!_channels.All(CanShow))
        {
            return;
        }

        foreach (WebChannel channel in _channels.Where(channel => string.IsNullOrWhiteSpace(channel.Name)))
        {
            channel.Name = channel.PresetInfo.DefaultName(Town(channel));
        }

        try
        {
            bool removed = Store.Channels.Any(saved => !_channels.Any(channel => string.Equals(channel.Id, saved.Id, StringComparison.OrdinalIgnoreCase)));
            Store.Save(_channels);
            Load();
            Say("Saved. Web shows are under TV Shows (and in the show pickers). One that's on air starts again with its new settings; "
                + "channels already airing it show a new name in their guide from their next rebuild."
                + (removed ? " Channels that used a deleted one fill that time with their other programming from the next rebuild." : ""), ok: true);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Say($"Couldn't save the web shows: {ex.Message}", ok: false);
        }
    }

    private async Task SearchAsync()
    {
        _searching = true;
        try
        {
            _places = await Places.SearchAsync(_query, CancellationToken.None);
            if (_places.Count == 0)
            {
                Say($"No places called \"{_query}\" were found.", ok: false);
            }
            else
            {
                _message = null;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Say($"Couldn't search for places: {ex.Message}", ok: false);
        }
        finally
        {
            _searching = false;
        }
    }

    private void Pick(WebChannel channel, Place place)
    {
        string? before = Town(channel);
        bool suggestedName = string.IsNullOrWhiteSpace(channel.Name) || channel.Name == channel.PresetInfo.DefaultName(before);

        channel.Location = string.Join(", ", place.Label.Split(", ").Take(2));
        channel.Latitude = Math.Round(place.Latitude, 4);
        channel.Longitude = Math.Round(place.Longitude, 4);
        channel.TimeZone = place.TimeZone;
        if (suggestedName)
        {
            channel.Name = channel.PresetInfo.DefaultName(Town(channel));
        }

        _query = place.Label;
        _places = [];
    }

    private void ClearPlace(WebChannel channel)
    {
        channel.Location = string.Empty;
        channel.Latitude = 0;
        channel.Longitude = 0;
        _query = string.Empty;
    }

    private async Task SearchOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private void Say(string message, bool ok)
    {
        _message = message;
        _messageOk = ok;
    }

    private static bool IsImperial(ChangeEventArgs e) => string.Equals(e.Value?.ToString(), "imperial", StringComparison.Ordinal);

    private static string Text(ChangeEventArgs e) => e.Value?.ToString()?.Trim() ?? string.Empty;

    private static double Number(ChangeEventArgs e, double fallback) =>
        double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double value) ? value : fallback;

    private static List<int> Lengths(ChangeEventArgs e) =>
        [.. Text(e).Split([',', ' ', ';'], StringSplitOptions.RemoveEmptyEntries)
            .Select(part => int.TryParse(part, NumberStyles.Integer, CultureInfo.InvariantCulture, out int minutes) ? minutes : 0)
            .Where(minutes => minutes is > 0 and <= 1440)
            .Distinct()
            .Order()];
}
