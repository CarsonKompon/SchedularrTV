<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Live WeatherStar 4000+ weather (github.com/mwood77/ws4kp-international) as schedulable programmes: each station
    is a "show" whose episodes are the lengths you allow, streamed live to ErsatzTV from a headless browser.
    Not part of the main download: it ships in the all-plugins zip of each release.
  -->
  <PropertyGroup>
    <RootNamespace>SchedularrTV.WeatherStar</RootNamespace>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <ScopedCssEnabled>false</ScopedCssEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplied by the scheduler at runtime, so it isn't copied into the plugin. -->
    <ProjectReference Include="..\..\src\SchedularrTV.Plugins.Abstractions\SchedularrTV.Plugins.Abstractions.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SchedularrTV.Plugins" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
