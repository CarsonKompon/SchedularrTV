@page "/plugins/ws4kp"
@* Weather stations: each one a "show" of live WeatherStar forecasts for a place, in the lengths you allow. *@
@implements IDisposable
@inject StationStore Store
@inject StreamHub Hub
@inject StreamAddress Address
@inject WeatherStarSettings Settings
@inject Geocoder Places

<div class="page-header">
    <div>
        <div class="eyebrow">WeatherStar 4000+</div>
        <h1>Weather stations</h1>
        <p class="muted">Live retro weather for any place, scheduled like a show: a 24/7 weather channel, or a short local forecast between programmes.</p>
    </div>
</div>

@if (BrowserLocator.Find(Settings.BrowserPath) is null)
{
    <div class="banner banner-error" role="alert">
        No Chrome, Edge or Chromium was found on this computer. The forecast is drawn by one running hidden; install one, or choose it
        in this plugin's settings (its gear on the Plugins page).
    </div>
}
@if (_message is not null)
{
    <div class="banner @(_messageOk ? "banner-ok" : "banner-error")" role="status">@_message</div>
}

@foreach (WeatherStation station in _stations)
{
    bool editing = ReferenceEquals(station, _editing);
    StreamHub.Status? status = Hub.Running.FirstOrDefault(running => string.Equals(running.StationId, station.Id, StringComparison.OrdinalIgnoreCase));
    <div class="card" @key="station">
        <div class="card-head">
            <h2>@(string.IsNullOrWhiteSpace(station.Name) ? "New station" : station.Name)</h2>
            @if (status is not null)
            {
                <span class="pill pill-ok">On air · @status.Viewers watching</span>
            }
            <div class="spacer"></div>
            @if (_confirmDelete == station.Id && !string.IsNullOrEmpty(station.Id))
            {
                <button class="btn btn-sm btn-danger" type="button" @onclick="() => Remove(station)">Delete @(station.Name)?</button>
                <button class="btn btn-sm" type="button" @onclick="() => _confirmDelete = null">Keep</button>
            }
            else
            {
                @if (!editing)
                {
                    <button class="btn btn-sm" type="button" @onclick="() => Edit(station)">Edit</button>
                }
                <button class="btn btn-sm btn-ghost" type="button" title="Delete this station" aria-label="Delete @station.Name"
                        @onclick="() => AskDelete(station)">Delete</button>
            }
        </div>

        @if (editing)
        {
            <div class="grid grid-2">
                <label class="field">
                    <span>Show name</span>
                    <input type="text" value="@station.Name" placeholder="Toronto Weather" @onchange="e => station.Name = Text(e)" />
                </label>
                <div class="field">
                    <span>Place</span>
                    <div class="row" style="gap:6px;">
                        <input type="text" value="@_query" placeholder="Search for a city" style="flex:1;min-width:0;"
                               @onchange="e => _query = Text(e)" @onkeydown="SearchOnEnter" />
                        <button class="btn btn-sm" type="button" disabled="@_searching" @onclick="SearchAsync">@(_searching ? "Searching…" : "Search")</button>
                    </div>
                </div>
            </div>
            @if (_places.Count > 0)
            {
                <div class="row row-wrap" style="gap:6px;margin-bottom:10px;">
                    @foreach (Place place in _places)
                    {
                        <button class="btn btn-sm" type="button" @onclick="() => Pick(station, place)">@place.Label</button>
                    }
                </div>
            }
            <div class="grid grid-3">
                <label class="field">
                    <span>Shown as</span>
                    <input type="text" value="@station.Location" placeholder="Toronto, Ontario" @onchange="e => station.Location = Text(e)" />
                </label>
                <label class="field">
                    <span>Latitude</span>
                    <input type="number" step="0.0001" value="@station.Latitude.ToString("0.####", CultureInfo.InvariantCulture)"
                           @onchange="e => station.Latitude = Number(e, station.Latitude)" />
                </label>
                <label class="field">
                    <span>Longitude</span>
                    <input type="number" step="0.0001" value="@station.Longitude.ToString("0.####", CultureInfo.InvariantCulture)"
                           @onchange="e => station.Longitude = Number(e, station.Longitude)" />
                </label>
                <label class="field">
                    <span>Units</span>
                    <select value="@(station.Imperial ? "imperial" : "metric")" @onchange="e => station.Imperial = IsImperial(e)">
                        <option value="metric">Metric (°C, km/h, km, hPa)</option>
                        <option value="imperial">Imperial (°F, mph, mi, inHg)</option>
                    </select>
                </label>
                <label class="field">
                    <span>Page speed</span>
                    <select value="@station.Speed.ToString("0.##", CultureInfo.InvariantCulture)" @onchange="e => station.Speed = Number(e, 1.0)">
                        <option value="0.5">Very fast</option>
                        <option value="0.75">Fast</option>
                        <option value="1">Normal</option>
                        <option value="1.25">Slow</option>
                        <option value="1.5">Very slow</option>
                    </select>
                </label>
                <label class="field">
                    <span>Lengths it can be scheduled for (minutes)</span>
                    <input type="text" value="@(string.Join(", ", station.Lengths))" placeholder="3, 4, 5, 10, 30, 60" @onchange="e => station.Lengths = Lengths(e)" />
                </label>
            </div>
            <div class="row row-wrap" style="gap:18px;margin-bottom:10px;">
                <label class="check"><input type="checkbox" checked="@station.Widescreen" @onchange="e => station.Widescreen = e.Value is true" /><span>Widescreen</span></label>
                <label class="check"><input type="checkbox" checked="@station.TwelveHourClock" @onchange="e => station.TwelveHourClock = e.Value is true" /><span>12-hour clock</span></label>
                <label class="check"><input type="checkbox" checked="@station.ScanLines" @onchange="e => station.ScanLines = e.Value is true" /><span>Scan lines</span></label>
            </div>
            <div class="grid grid-2">
                <label class="field">
                    <span>Music folder <span class="muted">(optional; shuffled under the forecast)</span></span>
                    <input type="text" value="@station.MusicFolder" placeholder="D:\Music\Weather" @onchange="e => station.MusicFolder = Text(e)" />
                </label>
                <label class="field">
                    <span>Music volume: @((int)Math.Round(station.MusicVolume * 100))%</span>
                    <input type="range" min="0" max="1" step="0.05" value="@station.MusicVolume.ToString(CultureInfo.InvariantCulture)"
                           @onchange="e => station.MusicVolume = Number(e, station.MusicVolume)" />
                </label>
            </div>
            @if (!string.IsNullOrWhiteSpace(station.MusicFolder) && !Directory.Exists(station.MusicFolder))
            {
                <p class="hint warn">That music folder doesn't exist on this computer; the forecast will be silent.</p>
            }
            <div class="row" style="gap:8px;margin-top:6px;">
                <div class="spacer"></div>
                <button class="btn btn-sm" type="button" @onclick="Cancel">Cancel</button>
                <button class="btn btn-sm btn-primary" type="button" disabled="@(station.Latitude == 0 && station.Longitude == 0)" @onclick="Save">Save</button>
            </div>
        }
        else
        {
            <p class="muted" style="margin:0 0 8px;">
                @(string.IsNullOrWhiteSpace(station.Location) ? "No place chosen" : station.Location)
                · @(station.Imperial ? "Imperial" : "Metric") · @(station.Widescreen ? "Widescreen" : "4:3")
                · @(string.IsNullOrWhiteSpace(station.MusicFolder) ? "no music" : "music from " + station.MusicFolder)
            </p>
            <div class="row row-wrap" style="gap:6px;margin-bottom:10px;">
                @foreach (int minutes in station.ValidLengths)
                {
                    <span class="pill pill-muted">@minutes min</span>
                }
            </div>
            <p class="hint" style="margin:0 0 8px;">
                Schedule it as the show <strong>@station.Name</strong>: in a channel's base rotation or a block for round-the-clock weather,
                or as one of a channel's interstitial shows (Breaks tab) for forecasts between programmes. Stream: <code>@Address.LiveUrl(station.Id)</code>
            </p>
            @if (status?.Problem is { } problem)
            {
                <p class="hint warn">@problem</p>
            }
        }

        <details style="margin-top:10px;" open="@editing">
            <summary class="hint" style="cursor:pointer;">Preview</summary>
            <div class="ws4kp-preview">
                @if (status is not null)
                {
                    <img src="@($"plugins/ws4kp/snapshot/{Uri.EscapeDataString(station.Id)}.jpg?t={_tick}")" alt="What's on air now" />
                }
                else if (station.Latitude != 0 || station.Longitude != 0)
                {
                    <iframe src="@station.PageUrl(Settings.Site)" title="@station.Name preview" loading="lazy"></iframe>
                }
                else
                {
                    <div class="empty">Choose a place to preview it.</div>
                }
            </div>
        </details>
    </div>
}

<div class="row" style="gap:8px;">
    <button class="btn btn-primary" type="button" disabled="@(_editing is not null)" @onclick="Add">Add a station</button>
</div>

<div class="card" style="margin-top:16px;">
    <div class="card-head"><h2>How it works</h2></div>
    <ul class="hint" style="margin:0;padding-left:18px;line-height:1.6;">
        <li>Each station appears as a show (under TV Shows and in collection pickers) with one "episode" per length, so the scheduler picks whichever fits.</li>
        <li><strong>24/7 weather channel:</strong> make the station the channel's base rotation. With long lengths (30, 60) it fills the day.</li>
        <li><strong>Forecasts between shows:</strong> on a channel's Breaks tab, set its interstitial shows to the station with short lengths (3–5 minutes) and one per slot.</li>
        <li>When a forecast airs, ErsatzTV plays this station live: a hidden browser shows the WeatherStar page and its picture is streamed with your music. Forecasts are current as they air.</li>
        <li>New or renamed stations reach the schedule on its next rebuild (Dashboard → Rebuild).</li>
    </ul>
</div>

<style>
    .ws4kp-preview { margin-top: 8px; width: 100%; max-width: 640px; aspect-ratio: 16 / 9; background: #000; border-radius: 8px; overflow: hidden; }
    .ws4kp-preview iframe, .ws4kp-preview img { width: 100%; height: 100%; border: 0; display: block; object-fit: contain; }
    .ws4kp-preview .empty { height: 100%; border: 0; border-radius: 0; display: flex; align-items: center; justify-content: center; }
    .hint.warn { color: #ffd08a; }
</style>

@code {
    private List<WeatherStation> _stations = [];
    private WeatherStation? _editing;
    private string? _confirmDelete;
    private string _query = string.Empty;
    private IReadOnlyList<Place> _places = [];
    private bool _searching;
    private string? _message;
    private bool _messageOk;
    private long _tick;
    private Timer? _refresh;

    protected override void OnInitialized()
    {
        Load();
        Hub.Changed += OnHubChanged;

        // Keeps the on-air preview frames moving.
        _refresh = new Timer(_ => InvokeAsync(() => { _tick++; if (Hub.Running.Count > 0) StateHasChanged(); }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    public void Dispose()
    {
        Hub.Changed -= OnHubChanged;
        _refresh?.Dispose();
    }

    private void OnHubChanged() => _ = InvokeAsync(StateHasChanged);

    private void Load()
    {
        _stations = [.. Store.Stations.Select(station => station.Copy())];
        _editing = null;
        _places = [];
    }

    private void Edit(WeatherStation station)
    {
        if (_editing is not null)
        {
            Load();
            station = _stations.FirstOrDefault(candidate => candidate.Id == station.Id) ?? station;
        }

        _editing = station;
        _query = station.Location;
        _places = [];
        _message = null;
    }

    private void Add()
    {
        var station = new WeatherStation { Name = string.Empty };
        _stations.Add(station);
        _editing = station;
        _query = string.Empty;
        _places = [];
        _message = null;
    }

    private void Cancel() => Load();

    private void AskDelete(WeatherStation station)
    {
        // A station that was never saved is just discarded.
        if (string.IsNullOrEmpty(station.Id))
        {
            Load();
            return;
        }

        _confirmDelete = station.Id;
    }

    private void Remove(WeatherStation station)
    {
        _confirmDelete = null;

        // Deleted from what's saved, so unsaved edits to other stations aren't written along with it.
        List<WeatherStation> kept = [.. Store.Stations.Where(saved => !string.Equals(saved.Id, station.Id, StringComparison.OrdinalIgnoreCase))];
        try
        {
            Store.Save(kept);
            Load();
            _message = $"Deleted {station.Name}. Channels that used it fill that time with their other programming from the next rebuild.";
            _messageOk = true;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _message = $"Couldn't delete the station: {ex.Message}";
            _messageOk = false;
        }
    }

    private void Save()
    {
        if (_editing is { } station && string.IsNullOrWhiteSpace(station.Name))
        {
            station.Name = string.IsNullOrWhiteSpace(station.Location) ? "Weather" : $"{station.Location.Split(',')[0].Trim()} Weather";
        }

        Persist($"Saved {_editing?.Name}.");
    }

    private void Persist(string? message)
    {
        try
        {
            Store.Save(_stations);
            Load();
            if (message is not null)
            {
                _message = message;
                _messageOk = true;
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _message = $"Couldn't save the stations: {ex.Message}";
            _messageOk = false;
        }
    }

    private async Task SearchAsync()
    {
        _searching = true;
        try
        {
            _places = await Places.SearchAsync(_query, CancellationToken.None);
            _message = _places.Count == 0 ? $"No places called \"{_query}\" were found." : null;
            _messageOk = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _message = $"Couldn't search for places: {ex.Message}";
            _messageOk = false;
        }
        finally
        {
            _searching = false;
        }
    }

    private void Pick(WeatherStation station, Place place)
    {
        station.Location = string.Join(", ", place.Label.Split(", ").Take(2));
        station.Latitude = Math.Round(place.Latitude, 4);
        station.Longitude = Math.Round(place.Longitude, 4);
        if (string.IsNullOrWhiteSpace(station.Name))
        {
            station.Name = $"{place.Label.Split(", ")[0]} Weather";
        }

        _query = place.Label;
        _places = [];
    }

    private async Task SearchOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private static bool IsImperial(ChangeEventArgs e) => string.Equals(e.Value?.ToString(), "imperial", StringComparison.Ordinal);

    private static string Text(ChangeEventArgs e) => e.Value?.ToString()?.Trim() ?? string.Empty;

    private static double Number(ChangeEventArgs e, double fallback) =>
        double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double value) ? value : fallback;

    private static List<int> Lengths(ChangeEventArgs e) =>
        [.. Text(e).Split([',', ' ', ';'], StringSplitOptions.RemoveEmptyEntries)
            .Select(part => int.TryParse(part, NumberStyles.Integer, CultureInfo.InvariantCulture, out int minutes) ? minutes : 0)
            .Where(minutes => minutes is > 0 and <= 1440)
            .Distinct()
            .Order()];
}
