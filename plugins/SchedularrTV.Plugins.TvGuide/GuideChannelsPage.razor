@page "/plugins/tv-guide"
@* Guide channels: scrolling listings made from the schedule, edited with a live preview. *@
@implements IDisposable
@inject GuideStore Store
@inject GuideSettings Settings
@inject GuideData Data
@inject GuideHub Running
@inject TimeProvider Clock
@inject IJSRuntime JS

<div class="page-header">
    <div>
        <div class="eyebrow">TV Guide shows</div>
        <h1>Guide shows</h1>
        <p class="muted">Scrolling listings made from your own schedule, like the Prevue Channel or the TV Guide Channel.</p>
    </div>
</div>

<VirtualShowNotice />

@if (BrowserLocator.Find(Settings.BrowserPath) is null)
{
    <div class="banner banner-error" role="alert">
        No Chrome, Edge or Chromium was found on this computer. The guide is drawn by one running hidden; install one, or choose it
        in this plugin's settings (its gear on the Plugins page).
    </div>
}
@if (_message is not null)
{
    <div class="banner @(_messageOk ? "banner-ok" : "banner-error")" role="status">@_message</div>
}

<LowPowerNotice Title="@($"The guide channel on {HardwareProfile.DeviceName}")" Advice="LowPowerAdvice">
    The listings scroll all the time, so every frame is new: a hidden browser draws them without a graphics chip and they're
    encoded live. With the Information top panel and music it's one comfortable channel here.
</LowPowerNotice>

@foreach (GuideStation guide in _guides)
{
    bool editing = ReferenceEquals(guide, _editing);
    LiveStatus? status = string.IsNullOrEmpty(guide.Id) ? null : Hub.Status(guide.Id);
    <div class="card" @key="guide">
        <div class="card-head">
            <h2>@(string.IsNullOrWhiteSpace(guide.Name) ? "New guide" : guide.Name)</h2>
            <span class="pill pill-muted">@GuideThemes.Of(guide.Theme).Name</span>
            @if (string.IsNullOrEmpty(guide.Id))
            {
                <span class="pill pill-warn">Not saved yet</span>
            }
            @if (status is not null)
            {
                <span class="pill pill-ok">On air · @status.Viewers watching</span>
            }
            <div class="spacer"></div>
            @if (_confirmDelete == guide.Id && !string.IsNullOrEmpty(guide.Id))
            {
                <button class="btn btn-sm btn-danger" type="button" @onclick="() => Remove(guide)">Delete @(guide.Name)?</button>
                <button class="btn btn-sm" type="button" @onclick="() => _confirmDelete = null">Keep</button>
            }
            else
            {
                @if (!editing)
                {
                    <button class="btn btn-sm" type="button" @onclick="() => Edit(guide)">Edit</button>
                }
                <button class="btn btn-sm btn-ghost" type="button" @onclick="() => AskDelete(guide)">Delete</button>
            }
        </div>

        @if (!editing)
        {
            <p class="hint" style="margin:0 0 8px;">
                Schedule it as the show <strong>@guide.Name</strong>: as a channel's base rotation for a 24/7 guide channel, or between
                programmes (lengths @string.Join(", ", guide.ValidLengths.Select(minutes => minutes + " min"))). Stream: <code>@Settings.LiveUrl(guide.Id)</code>
            </p>
            @if (status?.Problem is { } problem)
            {
                <p class="hint warn">@problem</p>
            }
            @if (status is not null)
            {
                <img class="tvg-snapshot" src="@($"plugins/tv-guide/snapshot/{Uri.EscapeDataString(guide.Id)}.jpg?t={_tick}")" alt="What's on air now" />
            }
        }
        else
        {
            <div class="tvg-editor">
                <div class="tvg-form">
                    <h3>Guide</h3>
                    <label class="field"><span>Show name</span>
                        <input type="text" value="@guide.Name" @onchange="e => Change(() => guide.Name = Text(e))" /></label>
                    <div class="tvg-looks">
                        @foreach (GuideThemes.Look look in GuideThemes.All)
                        {
                            <button type="button" class="tvg-look @(guide.Theme == look.Theme ? "on" : "")" @onclick="() => Change(() => guide.Theme = look.Theme)">
                                <strong>@look.Name</strong>
                                <span>@look.Blurb</span>
                            </button>
                        }
                    </div>
                    <label class="field"><span>Lengths it can be scheduled for (minutes)</span>
                        <input type="text" value="@(string.Join(", ", guide.Lengths))" @onchange="e => Change(() => guide.Lengths = Lengths(e))" /></label>

                    <h3>Listings</h3>
                    <div class="grid grid-2">
                        <label class="field"><span>Time shown</span>
                            <select value="@guide.HoursShown.ToString(CultureInfo.InvariantCulture)" @onchange="e => Change(() => guide.HoursShown = Number(e, 1.5))">
                                <option value="1">1 hour</option>
                                <option value="1.5">1½ hours</option>
                                <option value="2">2 hours</option>
                                <option value="3">3 hours</option>
                            </select></label>
                        <label class="field"><span>Scroll speed: @((int)guide.ScrollSpeed)</span>
                            <input type="range" min="0" max="150" step="5" value="@guide.ScrollSpeed.ToString(CultureInfo.InvariantCulture)"
                                   @oninput="e => Change(() => guide.ScrollSpeed = Number(e, 40))" /></label>
                        <label class="field"><span>Row height: @guide.RowHeight px</span>
                            <input type="range" min="36" max="100" step="2" value="@guide.RowHeight"
                                   @oninput="e => Change(() => guide.RowHeight = (int)Number(e, 54))" /></label>
                        <label class="field"><span>Text size: @((int)Math.Round(guide.FontScale * 100))%</span>
                            <input type="range" min="0.7" max="1.6" step="0.05" value="@guide.FontScale.ToString(CultureInfo.InvariantCulture)"
                                   @oninput="e => Change(() => guide.FontScale = Number(e, 1))" /></label>
                    </div>
                    <div class="row row-wrap" style="gap:18px;margin-bottom:8px;">
                        <label class="check"><input type="checkbox" checked="@guide.ShowLogos" @onchange="e => Change(() => guide.ShowLogos = e.Value is true)" /><span>Channel logos</span></label>
                        <label class="check"><input type="checkbox" checked="@guide.TwentyFourHourClock" @onchange="e => Change(() => guide.TwentyFourHourClock = e.Value is true)" /><span>24-hour clock</span></label>
                    </div>
                    @if (_channels.Count > 0)
                    {
                        <div class="field"><span>Channels listed (untick the guide channel itself)</span>
                            <div class="row row-wrap" style="gap:6px 16px;">
                                @foreach (GuideRow channel in _channels)
                                {
                                    <label class="check" style="margin:0;">
                                        <input type="checkbox" checked="@(!guide.HiddenChannels.Contains(channel.Number))"
                                               @onchange="e => Change(() => Toggle(guide.HiddenChannels, channel.Number, e.Value is not true))" />
                                        <span>@channel.Number @channel.Name</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <h3>Colours</h3>
                    <div class="grid grid-2">
                        @foreach ((string label, Func<string?> get, Action<string?> set, string fallback) in Colours(guide))
                        {
                            <div class="field"><span>@label</span>
                                <div class="row" style="gap:6px;">
                                    <input type="color" value="@(get() ?? fallback)" @onchange="e => Change(() => set(Text(e)))" style="width:56px;height:34px;padding:2px;" />
                                    @if (get() is not null)
                                    {
                                        <button class="btn btn-sm btn-ghost" type="button" @onclick="() => Change(() => set(null))">Theme's own</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <h3>Top panel</h3>
                    <div class="grid grid-2">
                        <label class="field"><span>Shows</span>
                            <select value="@guide.Top" @onchange="e => Change(() => SetTop(guide, Enum.Parse<TopPanel>(Text(e))))">
                                <option value="Info">Information (clock, message, what's on now)</option>
                                <option value="Ads">Commercials, round the clock</option>
                                <option value="Channel">A channel's picture</option>
                            </select></label>
                        <label class="field"><span>Height: @guide.TopPercent% of the screen</span>
                            <input type="range" min="0" max="70" step="1" value="@guide.TopPercent"
                                   @oninput="e => Change(() => guide.TopPercent = (int)Number(e, 45))" /></label>
                    </div>
                    <LowPowerNotice Inline="true" Title="@TopPanelWarning(guide)" />
                    <label class="field"><span>Message <span class="muted">({channel} is the guide's name)</span></span>
                        <input type="text" value="@guide.Message" @onchange="e => Change(() => guide.Message = Text(e))" /></label>
                    @if (guide.Top == TopPanel.Ads)
                    {
                        <label class="field"><span>Which commercials (a library query)</span>
                            <input type="text" value="@guide.AdsQuery" @onchange="e => Change(() => guide.AdsQuery = Text(e))" /></label>
                        <p class="hint">MP4 and WebM files play, shuffled and looping. For their sound, choose <em>The top panel's sound</em> below.</p>
                    }
                    @if (guide.Top == TopPanel.Channel)
                    {
                        <label class="check" style="margin-bottom:8px;"><input type="checkbox" checked="@guide.CycleChannels" @onchange="e => Change(() => guide.CycleChannels = e.Value is true)" />
                            <span>Cycle through channels at random</span></label>
                        @if (guide.CycleChannels)
                        {
                            <label class="field"><span>Change channel every: @guide.CycleMinutes @(guide.CycleMinutes == 1 ? "minute" : "minutes")</span>
                                <input type="range" min="1" max="30" step="1" value="@guide.CycleMinutes"
                                       @oninput="e => Change(() => guide.CycleMinutes = (int)Number(e, 5))" /></label>
                            @if (_channels.Count > 0)
                            {
                                <div class="field"><span>Channels to cycle through <span class="muted">(none ticked: every listed channel)</span></span>
                                    <div class="row row-wrap" style="gap:6px 16px;">
                                        @foreach (GuideRow channel in _channels)
                                        {
                                            <label class="check" style="margin:0;">
                                                <input type="checkbox" checked="@guide.CycleChannelNumbers.Contains(channel.Number)"
                                                       @onchange="e => Change(() => Toggle(guide.CycleChannelNumbers, channel.Number, e.Value is true))" />
                                                <span>@channel.Number @channel.Name</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                            <p class="hint">Each channel is asked for shortly before its turn, so the switch is quick.</p>
                        }
                        else
                        {
                            <label class="field"><span>Channel to show</span>
                                <select value="@(guide.WindowChannel?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="e => Change(() => guide.WindowChannel = Channel(e))">
                                    <option value="">Choose…</option>
                                    @foreach (GuideRow channel in _channels)
                                    {
                                        <option value="@channel.Number">@channel.Number @channel.Name</option>
                                    }
                                </select></label>
                        }
                    }
                    @if (guide.Top != TopPanel.Info && guide.Window is null)
                    {
                        <p class="hint warn">The top panel is too short for a video window; make it taller.</p>
                    }

                    <h3>Sound</h3>
                    <div class="grid grid-2">
                        <label class="field"><span>Plays</span>
                            <select value="@guide.Sound" @onchange="e => Change(() => guide.Sound = Enum.Parse<GuideSound>(Text(e)))">
                                <option value="Music">Music from a folder</option>
                                @if (guide.Top != TopPanel.Info)
                                {
                                    <option value="Window">The top panel's sound (@(guide.Top == TopPanel.Ads ? "the commercials" : "the channel shown"))</option>
                                }
                                <option value="Channel">A channel's sound</option>
                                <option value="Silence">Nothing</option>
                            </select></label>
                        <label class="field"><span>Volume: @((int)Math.Round(guide.Volume * 100))%</span>
                            <input type="range" min="0" max="1" step="0.05" value="@guide.Volume.ToString(CultureInfo.InvariantCulture)"
                                   @onchange="e => Change(() => guide.Volume = Number(e, 0.6))" /></label>
                    </div>
                    @if (guide.Sound == GuideSound.Music)
                    {
                        <label class="field"><span>Music folder <span class="muted">(shuffled)</span></span>
                            <input type="text" value="@guide.MusicFolder" placeholder="D:\Music\Smooth Jazz" @onchange="e => Change(() => guide.MusicFolder = Text(e))" /></label>
                        @if (!string.IsNullOrWhiteSpace(guide.MusicFolder) && !Directory.Exists(guide.MusicFolder))
                        {
                            <p class="hint warn">That folder doesn't exist on this computer; the guide will be silent.</p>
                        }
                    }
                    @if (guide.Sound == GuideSound.Channel)
                    {
                        <label class="field"><span>Channel to listen to</span>
                            <select value="@(guide.SoundChannel?.ToString(CultureInfo.InvariantCulture) ?? "")" @onchange="e => Change(() => guide.SoundChannel = Channel(e))">
                                <option value="">@(guide.Top == TopPanel.Channel ? "The one in the window" : "Choose…")</option>
                                @foreach (GuideRow channel in _channels)
                                {
                                    <option value="@channel.Number">@channel.Number @channel.Name</option>
                                }
                            </select></label>
                    }

                    <div class="row" style="gap:8px;margin-top:14px;">
                        <div class="spacer"></div>
                        <button class="btn btn-sm" type="button" @onclick="Done">Done</button>
                    </div>
                </div>

                <div class="tvg-preview-column">
                    <div class="tvg-preview">
                        <iframe name="tvGuidePreview" title="Live preview" src="@PreviewSource(guide)" @onload="PushPreviewAsync"></iframe>
                    </div>
                    <p class="hint">Live preview of your changes, with the real listings. A channel window shows where the channel will play.</p>
                </div>
            </div>
        }
    </div>
}

<div class="row" style="gap:8px;">
    <button class="btn btn-primary" type="button" @onclick="Add">Add a guide</button>
</div>

<SaveDock Dirty="Dirty" Label="Unsaved guides" OnSave="Save" OnDiscard="Discard" />

<div class="card" style="margin-top:16px;">
    <div class="card-head"><h2>How it works</h2></div>
    <ul class="hint" style="margin:0;padding-left:18px;line-height:1.6;">
        <li>Each guide is a show (under TV Shows and in collection pickers), with one "episode" per length.</li>
        <li><strong>24/7 guide channel:</strong> make the guide a channel's base rotation, with long lengths (30, 60).</li>
        <li><strong>Between programmes:</strong> add it to a channel's interstitial shows with short lengths (2–5 minutes).</li>
        <li>The listings come from the schedules as last published; untick the guide's own channel so it doesn't list itself.</li>
        <li>On air, a hidden browser shows the guide and ffmpeg streams it with the sound you chose, and the window's channel laid in.</li>
    </ul>
</div>

<style>
    .tvg-editor { display: grid; grid-template-columns: minmax(0, 1fr) 660px; gap: 22px; align-items: start; }
    @@media (max-width: 1300px) { .tvg-editor { grid-template-columns: minmax(0, 1fr); } }
    .tvg-form h3 { font-size: 13px; margin: 16px 0 8px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
    .tvg-form h3:first-child { margin-top: 0; }
    .tvg-preview-column { position: sticky; top: 16px; }
    .tvg-preview { width: 640px; height: 360px; overflow: hidden; border-radius: 10px; background: #000; border: 1px solid var(--line); }
    .tvg-preview iframe { width: 1280px; height: 720px; border: 0; transform: scale(.5); transform-origin: 0 0; display: block; }
    .tvg-snapshot { width: 100%; max-width: 640px; border-radius: 10px; display: block; margin-top: 8px; }
    .tvg-looks { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 8px; margin-bottom: 12px; }
    .tvg-look { text-align: left; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: transparent; color: inherit; cursor: pointer; }
    .tvg-look strong { display: block; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tvg-look span { font-size: 12px; color: var(--muted); }
    .tvg-look.on { border-color: var(--accent, #6f7fff); box-shadow: 0 0 0 1px var(--accent, #6f7fff); }
    .hint.warn { color: #ffd08a; }
</style>

@code {
    private List<GuideStation> _guides = [];

    // The running guides.
    private LiveStreamHub Hub => Running.Streams;

    private IEnumerable<string?> LowPowerAdvice =>
    [
        Settings.CaptureFrameRate > 15
            ? $"Capture frames per second is {Settings.CaptureFrameRate}. 10 to 15 scrolls a little less smoothly but halves the browser's work (plugin settings)."
            : null,
        _guides.Any(guide => !string.IsNullOrEmpty(guide.Id) && guide.Top != TopPanel.Info)
            ? "A guide shows commercials or a channel in its top panel: that's a second (and, while channels change, a third) video decoded and encoded alongside the guide, more than a Pi keeps up with."
            : null
    ];

    // Commercials and channels in the window are whole extra encodes on a Raspberry Pi.
    private static string? TopPanelWarning(GuideStation guide) => guide.Top switch
    {
        TopPanel.Ads => "Commercials in the window are each decoded and encoded again before the guide lays them in, on top of the guide's own encode: too heavy for a Pi. Information is the light choice here.",
        TopPanel.Channel => "A channel in the window has ErsatzTV encode that channel as well (on this Pi, if it runs here), and cycling warms the next one up early: too heavy for a Pi. Information is the light choice here.",
        _ => null
    };
    private GuideStation? _editing;
    private string? _confirmDelete;
    private IReadOnlyList<GuideRow> _channels = [];
    private string? _message;
    private bool _messageOk;
    private long _tick;
    private Timer? _refresh;

    protected override void OnInitialized()
    {
        Load();
        _channels = Data.Listings(Clock.GetUtcNow(), TimeSpan.FromMinutes(30));
        Hub.Changed += OnHubChanged;
        _refresh = new Timer(_ => InvokeAsync(() => { _tick++; if (Hub.Running.Count > 0) StateHasChanged(); }), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    public void Dispose()
    {
        Hub.Changed -= OnHubChanged;
        _refresh?.Dispose();
    }

    private void OnHubChanged() => _ = InvokeAsync(StateHasChanged);

    // Edits, new guides and deletions are held in _guides until Save in the bar along the bottom; Discard drops them.
    // What was loaded, to tell whether anything has changed since.
    private string _loaded = string.Empty;

    private bool Dirty => !string.Equals(Snapshot(_guides), _loaded, StringComparison.Ordinal);

    // Hidden channels in any order are the same choice (ticking one off and on again moves it to the end).
    private static string Snapshot(IEnumerable<GuideStation> guides) => System.Text.Json.JsonSerializer.Serialize(guides.Select(guide =>
    {
        GuideStation copy = guide.Copy();
        copy.HiddenChannels = [.. copy.HiddenChannels.Order()];
        return copy;
    }));

    private void Load()
    {
        _guides = [.. Store.Guides.Select(guide => guide.Copy())];
        _loaded = Snapshot(_guides);
        _editing = null;
        _confirmDelete = null;
    }

    private static string PreviewSource(GuideStation guide) =>
        $"plugins/tv-guide/view/{Uri.EscapeDataString(string.IsNullOrEmpty(guide.Id) ? "preview" : guide.Id)}?preview=true";

    // Another guide's editor closes, keeping its edits for the save bar.
    private void Edit(GuideStation guide)
    {
        _editing = guide;
        _message = null;
    }

    private void Add()
    {
        var guide = new GuideStation { HiddenChannels = [] };
        _guides.Add(guide);
        _editing = guide;
        _message = null;
    }

    private void Done() => _editing = null;

    private void Discard()
    {
        Load();
        _message = null;
    }

    private void AskDelete(GuideStation guide)
    {
        if (string.IsNullOrEmpty(guide.Id))
        {
            Remove(guide);
            return;
        }

        _confirmDelete = guide.Id;
    }

    private void Remove(GuideStation guide)
    {
        _confirmDelete = null;
        _guides.Remove(guide);
        if (ReferenceEquals(_editing, guide))
        {
            _editing = null;
        }
    }

    private void Save()
    {
        try
        {
            bool removed = Store.Guides.Any(saved => !_guides.Any(guide => string.Equals(guide.Id, saved.Id, StringComparison.OrdinalIgnoreCase)));
            Store.Save(_guides);
            Load();
            Say("Saved. Guides are under TV Shows (and in the show pickers); one that's on air starts again with its new settings."
                + (removed ? " Channels that used a deleted guide fill that time with their other programming from the next rebuild." : ""), ok: true);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Say($"Couldn't save: {ex.Message}", ok: false);
        }
    }

    private async Task Change(Action change)
    {
        change();
        await PushPreviewAsync();
    }

    /// <summary>Sends the settings being edited to the preview, which redraws without reloading.</summary>
    private async Task PushPreviewAsync()
    {
        if (_editing is not { } guide)
        {
            return;
        }

        GuideStation shown = guide.Copy();
        GuideStore.Tidy(shown);
        if (string.IsNullOrEmpty(shown.Id))
        {
            shown.Id = "preview";
        }

        try
        {
            // Looked up afresh each time: Blazor caches the function behind an identifier such as
            // "tvGuidePreview.postMessage" (bound to the first iframe's window, which is replaced whenever the editor
            // reopens), and its "is a function" check fails for a function from the iframe's own realm. The default
            // JSON encoder escapes < > & ' so the settings are a safe script literal.
            string message = System.Text.Json.JsonSerializer.Serialize(
                new { type = "tv-guide-settings", settings = GuidePageConfig.For(shown, preview: true) }, System.Text.Json.JsonSerializerOptions.Web);
            await JS.InvokeVoidAsync("eval", $"document.querySelector('iframe[name=\"tvGuidePreview\"]')?.contentWindow?.postMessage({message}, '*')");
        }
        catch (JSException)
        {
            // The preview hasn't loaded yet; it sends for the settings again when it has.
        }
        catch (InvalidOperationException)
        {
            // Prerendering: there's no browser to talk to yet.
        }
    }

    private static IEnumerable<(string Label, Func<string?> Get, Action<string?> Set, string Fallback)> Colours(GuideStation guide)
    {
        GuideThemes.Look look = GuideThemes.Of(guide.Theme);
        yield return ("Background", () => guide.Background, value => guide.Background = value, look.Background);
        yield return ("Rows", () => guide.RowColor, value => guide.RowColor = value, look.Row);
        yield return ("Text", () => guide.TextColor, value => guide.TextColor = value, look.Text);
        yield return ("Highlights", () => guide.AccentColor, value => guide.AccentColor = value, look.Accent);
    }

    /// <summary>
    /// Changes what's up top. Commercials are meant to be heard, so a guide still on its default music switches to
    /// their sound; and the top panel's sound goes back to music when there's no longer a window to hear.
    /// </summary>
    private static void SetTop(GuideStation guide, TopPanel top)
    {
        guide.Top = top;
        if (top == TopPanel.Ads && guide.Sound == GuideSound.Music)
        {
            guide.Sound = GuideSound.Window;
        }
        else if (top == TopPanel.Info && guide.Sound == GuideSound.Window)
        {
            guide.Sound = GuideSound.Music;
        }
    }

    private static void Toggle(List<int> hidden, int number, bool hide)
    {
        hidden.Remove(number);
        if (hide)
        {
            hidden.Add(number);
        }
    }

    private void Say(string message, bool ok)
    {
        _message = message;
        _messageOk = ok;
    }

    private static string Text(ChangeEventArgs e) => e.Value?.ToString()?.Trim() ?? string.Empty;

    private static double Number(ChangeEventArgs e, double fallback) =>
        double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double value) ? value : fallback;

    private static int? Channel(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int number) ? number : null;

    private static List<int> Lengths(ChangeEventArgs e) =>
        [.. Text(e).Split([',', ' ', ';'], StringSplitOptions.RemoveEmptyEntries)
            .Select(part => int.TryParse(part, NumberStyles.Integer, CultureInfo.InvariantCulture, out int minutes) ? minutes : 0)
            .Where(minutes => minutes is > 0 and <= 1440)
            .Distinct()
            .Order()];
}
