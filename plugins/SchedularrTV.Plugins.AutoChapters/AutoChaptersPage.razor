@page "/plugins/auto-chapters"
@* What Auto Chapters has found, what it's working on, and buttons to analyse the library or start over. *@
@implements IDisposable
@inject ChapterStore Store
@inject ChapterScanner Scanner
@inject AutoChaptersSettings Settings
@inject MidRollAligner Aligner
@inject IServiceProvider Services
@inject NavigationManager Nav

<div class="page-header">
    <div>
        <div class="eyebrow">Plugins</div>
        <h1>Auto chapters</h1>
        <p class="muted">
            Find natural ad breaks using fades to black@(Settings.RequireSilence ? " and silence" : "") in programmes without chapter markers.
        </p>
    </div>
</div>

@{ int waiting = Store.ReviewQueue().Count; }
<nav class="tabs" aria-label="Auto chapters sections">
    <a class="tab @(Reviewing ? "" : "active")" aria-current="@(Reviewing ? null : "page")" href="@Nav.GetUriWithQueryParameter("tab", (string?)null)">Overview</a>
    <a class="tab @(Reviewing ? "active" : "")" aria-current="@(Reviewing ? "page" : null)" href="@Nav.GetUriWithQueryParameter("tab", "review")">
        Review queue
        @if (waiting > 0)
        {
            <span class="pill pill-accent" style="margin-left:6px;">@waiting.ToString("N0")</span>
        }
    </a>
</nav>

@if (Reviewing)
{
    <ChapterReview />
}
else
{
if (!Settings.UseForMidRolls)
{
    <div class="banner banner-warn" role="status">
        Markers are being found but not used: <em>Use the markers found for mid-roll breaks</em> is off in this plugin's settings.
    </div>
}
if (_message is not null)
{
    <div class="banner @(_messageOk ? "banner-ok" : "banner-error")" role="status">@_message</div>
}

<LowPowerNotice Title="@($"Analysing programmes on {HardwareProfile.DeviceName}")" Advice="LowPowerAdvice">
    Each analysis decodes a whole programme: a few minutes for a 1080p H.264 episode here, longer for HEVC or 4K, and it
    competes with the channels on air.
</LowPowerNotice>

<div class="card">
    <div class="card-head"><h2>Mid-roll breaks coming up</h2><span class="muted" style="font-size:12px;">next two days, all channels</span></div>
    @{ MidRollSummary breaks = Aligner.Summary; }
    @if (breaks.Total == 0)
    {
        <p class="hint" style="margin:0;">
            No programmes with mid-roll breaks in the schedule yet. Breaks inside programmes are switched on per channel
            (or block) under mid-rolls; this fills in after the schedule is next published.
        </p>
    }
    else
    {
        <div class="ac-bar" role="img" aria-label="@BreakLabel(breaks)">
            <span class="ac-seg ac-ok" style="width:@Pct(breaks.AtBreakPoints, breaks.Total);"></span>
            <span class="ac-seg ac-own" style="width:@Pct(breaks.OwnChapters, breaks.Total);"></span>
            <span class="ac-seg ac-wait" style="width:@Pct(breaks.WaitingForAnalysis, breaks.Total);"></span>
            <span class="ac-seg ac-fixed" style="width:@Pct(breaks.NoneFound + breaks.NoPointNearby, breaks.Total);"></span>
        </div>
        <div class="row row-wrap" style="gap:8px;margin:10px 0 0;">
            <span class="pill pill-ok">@breaks.AtBreakPoints split at their fades to black</span>
            @if (breaks.OwnChapters > 0)
            {
                <span class="pill pill-accent">@breaks.OwnChapters split at their own chapter markers</span>
            }
            @if (breaks.WaitingForAnalysis > 0)
            {
                <span class="pill pill-muted">@breaks.WaitingForAnalysis on the fixed interval until analysed</span>
            }
            @if (breaks.NoneFound > 0)
            {
                <span class="pill pill-warn">@breaks.NoneFound on the fixed interval: no fades found</span>
            }
            @if (breaks.NoPointNearby > 0)
            {
                <span class="pill pill-warn" title="Either no fade was close enough to where a break was planned, or the programme was already on air when its fades were found.">
                    @breaks.NoPointNearby with a break left on the fixed interval
                </span>
            }
        </div>
        <p class="hint" style="margin:10px 0 0;">
            Programmes are planned before they're analysed, so breaks start out on the fixed interval (every 13 minutes or so).
            Once a programme's fades are found, its breaks are slid onto them (up to @((int)MidRollAligner.Reach.TotalMinutes) minutes) the next time
            the schedule goes out, without moving anything around it. A programme already on air is left alone until it ends.
        </p>
    }
</div>

<div class="card">
    <div class="card-head"><h2>Library analysed</h2></div>
    @if (_coverage is { } coverage)
    {
        <div class="ac-bar" role="img" aria-label="@($"{coverage.Analysed} of {coverage.Total} analysed")">
            <span class="ac-seg ac-ok" style="width:@Pct(coverage.Analysed, coverage.Total);"></span>
        </div>
        <p style="margin:8px 0 0;">
            <strong>@Percent(coverage.Analysed, coverage.Total)</strong>
            <span class="muted">· @coverage.Analysed.ToString("N0") of @coverage.Total.ToString("N0") episodes and movies without their own chapters</span>
        </p>
    }
    else if (_coverageError is not null)
    {
        <p class="hint warn" style="margin:0;">Couldn't read the library: @_coverageError</p>
    }
    else
    {
        <p class="hint" style="margin:0;">Counting the library…</p>
    }
    <p class="hint" style="margin:8px 0 0;">
        What's found is kept in <code>@Store.FilePath</code> and reused from then on: a programme is only analysed again if its
        file changes, or after <em>Start over</em>. @(Settings.ScanLibrary ? "The whole library is being worked through in the background." : "Only programmes coming up are analysed; use Analyse the whole library (or switch it on in the settings) to do the rest.")
    </p>
</div>

<div class="card">
    <div class="card-head"><h2>Progress</h2></div>
    @{
        (int found, int none, int failed) = Store.Totals();
        (int soon, int later) = Scanner.Queued;
        IReadOnlyList<string> working = Scanner.Working;
    }
    <div class="row row-wrap" style="gap:8px;margin-bottom:12px;">
        <span class="pill pill-ok">@found with break points</span>
        <span class="pill pill-muted">@none with none found</span>
        @if (failed > 0)
        {
            <span class="pill pill-error">@failed couldn't be read</span>
        }
        <span class="pill pill-accent">@(soon + later) waiting@(soon > 0 ? $" ({soon} airing soon)" : "")</span>
    </div>
    @if (working.Count > 0)
    {
        <p class="hint" style="margin:0 0 10px;">Analysing: <strong>@string.Join(", ", working)</strong></p>
    }
    else if (soon + later == 0)
    {
        <p class="hint" style="margin:0 0 10px;">Nothing waiting. Programmes coming up in the schedule are queued automatically as it's published.</p>
    }
    @if (Scanner.LastError is { } error)
    {
        <p class="hint warn" style="margin:0 0 10px;">Last problem: @error</p>
    }
    <div class="row row-wrap" style="gap:8px;">
        <button class="btn btn-sm btn-primary" type="button" disabled="@Scanner.ScanningLibrary" @onclick="QueueLibrary">
            @(Scanner.ScanningLibrary ? "Reading the library…" : "Analyse the whole library")
        </button>
        @if (soon + later > 0)
        {
            <button class="btn btn-sm" type="button" @onclick="ClearQueue">Stop waiting ones</button>
        }
        @if (failed > 0)
        {
            <button class="btn btn-sm" type="button" @onclick="RetryFailed">Try failed ones again</button>
        }
        <div class="spacer"></div>
        @if (_confirmForget)
        {
            <button class="btn btn-sm btn-danger" type="button" @onclick="ForgetAll">Forget everything found?</button>
            <button class="btn btn-sm" type="button" @onclick="() => _confirmForget = false">Keep</button>
        }
        else
        {
            <button class="btn btn-sm btn-ghost" type="button" @onclick="() => _confirmForget = true">Start over</button>
        }
    </div>
    <p class="hint" style="margin-top:10px;">
        Each programme is decoded once, in the background, at low priority, so a large library takes a while. Markers are used
        from the next schedule build on. <em>Start over</em> after changing how fades are detected (this plugin's settings).
    </p>
</div>

<div class="card">
    <div class="card-head"><h2>Recently analysed</h2></div>
    @{ IReadOnlyList<ChapterRecord> recent = Store.Recent(40); }
    @if (recent.Count == 0)
    {
        <div class="empty">Nothing yet.</div>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Programme</th><th>Break points</th><th class="num">Took</th></tr>
            </thead>
            <tbody>
                @foreach (ChapterRecord record in recent)
                {
                    <tr>
                        <td title="@record.Path">@(record.Title.Length > 0 ? record.Title : Path.GetFileName(record.Path))</td>
                        <td>
                            @if (record.Error is { } problem)
                            {
                                <span class="hint warn" style="margin:0;" title="@(record.ErrorDetail ?? problem)">@problem</span>
                            }
                            else if (record.Markers.Count == 0)
                            {
                                <span class="muted">None found</span>
                            }
                            else
                            {
                                @(string.Join("  ·  ", record.MarkerTimes.Select(Clock)))
                            }
                        </td>
                        <td class="num">@(record.Error is null ? $"{record.Seconds:0}s" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
}

<style>
    .ac-bar { display: flex; height: 10px; border-radius: 6px; overflow: hidden; background: rgba(255,255,255,.07); }
    .ac-seg { display: block; height: 100%; }
    .ac-ok { background: var(--ok, #3fbf7f); }
    .ac-own { background: var(--accent); }
    .ac-wait { background: rgba(255,255,255,.25); }
    .ac-fixed { background: var(--warn, #f3b74f); }
</style>

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private bool Reviewing => string.Equals(Tab, "review", StringComparison.OrdinalIgnoreCase);

    private string? _message;
    private bool _messageOk;
    private bool _confirmForget;

    private IEnumerable<string?> LowPowerAdvice =>
    [
        Settings.ScanLibrary ? "Analyse the whole library is on: for a large library that's days of full processor here. Programmes in the schedule are analysed anyway, as they come up." : null,
        Settings.Concurrency > 1 ? $"{Settings.Concurrency} programmes are analysed at once; keep it to 1 here." : null,
        Settings.HardwareDecode is null ? "Hardware decoding is off. auto lets the Pi's chip decode HEVC, far faster than the processor." : null,
        Settings.DecodeThreads is 0 or > 2 ? "Each analysis may use every processor thread; 2 (the default here) leaves the rest for channels on air." : null
    ];
    private HashSet<string>? _wanted;
    private (int Analysed, int Total)? _coverage;
    private string? _coverageError;
    private DateTime _countedAt;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        Scanner.Changed += OnChanged;
        Aligner.Changed += OnChanged;

        // Every episode and movie the plugin would analyse, once; how many are done is counted against it as it goes.
        try
        {
            if (Services.GetService(typeof(IMediaLibrary)) is IMediaLibrary library)
            {
                IReadOnlyList<MediaItem> items = await library.SearchAsync(
                    SchedularrTV.Core.Query.QueryParser.Parse("kind == 'Episode' OR kind == 'Movie'"));
                _wanted = [.. items.Where(ChapterEnricher.Wants).Select(item => item.Path!)];
                Count();
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _coverageError = ex.GetBaseException().Message;
        }
    }

    public void Dispose()
    {
        Store.Changed -= OnChanged;
        Scanner.Changed -= OnChanged;
        Aligner.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        // At most once a second while a scan saves a record every few seconds.
        if (DateTime.UtcNow - _countedAt > TimeSpan.FromSeconds(1))
        {
            Count();
        }

        StateHasChanged();
    });

    private void Count()
    {
        _countedAt = DateTime.UtcNow;
        if (_wanted is not null)
        {
            _coverage = (_wanted.Count(path => Store.Find(path) is not null), _wanted.Count);
        }
    }

    private static string Pct(int part, int total) =>
        (total == 0 ? 0 : part * 100.0 / total).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string Percent(int part, int total) =>
        total == 0 ? "Nothing to analyse" : (part * 100.0 / total).ToString(part == total ? "0" : "0.0", CultureInfo.InvariantCulture) + "% analysed";

    private static string BreakLabel(MidRollSummary breaks) =>
        $"{breaks.AtBreakPoints} of {breaks.Total} programmes split at break points";

    private async Task QueueLibrary()
    {
        try
        {
            int added = await Scanner.QueueLibraryAsync(CancellationToken.None);
            Say(added == 0 ? "Everything in the library has been analysed already." : $"Queued {added} programme(s) to analyse.", ok: true);
        }
        catch (Exception ex)
        {
            Say($"Couldn't read the library: {ex.Message}", ok: false);
        }
    }

    private void ClearQueue()
    {
        Scanner.ClearQueue();
        Say("Stopped the waiting ones; programmes coming up are queued again when the schedule is next published.", ok: true);
    }

    private void RetryFailed()
    {
        Store.Clear(failedOnly: true);
        Say("The failed ones will be tried again as they come up, or with Analyse the whole library.", ok: true);
    }

    private void ForgetAll()
    {
        _confirmForget = false;
        Scanner.ClearQueue();
        Store.Clear();
        Say("Forgot everything found. Programmes are analysed again as they come up.", ok: true);
    }

    private void Say(string message, bool ok)
    {
        _message = message;
        _messageOk = ok;
    }

    private static string Clock(TimeSpan at) =>
        at.TotalHours >= 1 ? at.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture) : at.ToString(@"m\:ss", CultureInfo.InvariantCulture);
}
