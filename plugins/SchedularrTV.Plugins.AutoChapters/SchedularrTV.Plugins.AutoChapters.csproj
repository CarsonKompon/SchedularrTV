<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Auto Chapters: finds the fades to black in programmes that have no chapter markers and uses them where
    mid-roll breaks go. Not part of the main download: it ships in the all-plugins zip of each release.
  -->
  <PropertyGroup>
    <RootNamespace>SchedularrTV.AutoChapters</RootNamespace>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <ScopedCssEnabled>false</ScopedCssEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplied by the scheduler at runtime, so it isn't copied into the plugin. -->
    <ProjectReference Include="..\..\src\SchedularrTV.Plugins.Abstractions\SchedularrTV.Plugins.Abstractions.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The review queue's player, evaluated in the page once (see ChapterReview.razor). -->
    <EmbeddedResource Include="ReviewPlayer.js" LogicalName="ReviewPlayer.js" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SchedularrTV.Plugins" />
    <Using Include="SchedularrTV.Core.Media" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
