@using Microsoft.JSInterop
@using SchedularrTV.GeneratedPromos
@using SkiaSharp
@inject IJSRuntime JS
@inject SqueezeRenderer Renderer
@implements IAsyncDisposable

<div class="visual-editor" @ref="_element" data-canvas-width="@(Canvas?.Width ?? 1280)" data-canvas-ratio="@Canvas?.AspectRatio">
    <div class="cs-canvas-picker">
        <nav class="cs-ratios" aria-label="Canvas aspect ratios">
        @foreach (var design in Look.Canvases)
        {
            <button type="button" class="btn btn-sm @(ReferenceEquals(design, Canvas) ? "btn-primary" : "")" aria-pressed="@(ReferenceEquals(design, Canvas))" title="@($"Edit {design.AspectRatio} canvas")" @onclick="() => Select(design)"><Icon Name="tv" />@design.AspectRatio</button>
        }
        </nav>
        <div class="spacer"></div>
        <select aria-label="New canvas aspect ratio" @bind="_ratio"><option value="">Add aspect ratio…</option>
                @foreach (string ratio in SqueezeCanvas.Ratios.Where(ratio => Look.Canvases.All(canvas => canvas.AspectRatio != ratio)))
                { <option value="@ratio">@ratio</option> }
        </select>
        <EditorIconButton Icon="plus" Label="Create canvas for selected aspect ratio" Disabled="@string.IsNullOrEmpty(_ratio)" OnClick="AddCanvas" />
    </div>
    @if (Canvas is null)
    {
        <div class="empty"><Icon Name="tv" /><p>Create a canvas to arrange the credits, a promo panel, and text.</p>
            <button type="button" class="btn btn-primary" @onclick="CreateDefaultCanvas"><Icon Name="plus" />Create 16:9 canvas</button></div>
    }
    @if (Canvas is { } canvas)
    {
        <CanvasWorkspace Help="Drag to move; use the corner handle or numeric bounds to resize. Ctrl/⌘ + scroll to zoom, middle-drag to pan, Ctrl/⌘ + 0 to fit. Add keyframes to animate the selected layer at the playhead.">
            <Tools><CanvasToolRail /></Tools>
            <Stage>
                <CanvasTools Width="canvas.Width" Height="canvas.Height" Add="AddLayer" Fit="Fit">
                    <button type="button" class="btn btn-sm" title="Add the original credits video" @onclick="AddSource"><Icon Name="film" />Source</button>
                    <button type="button" class="btn btn-sm" title="Add the promo / commercials panel" @onclick="AddPanel"><Icon Name="tv" />Panel</button>
                    <button type="button" class="btn btn-sm" title="Read the source credits with OCR and display them as text" @onclick="AddCreditsText"><Icon Name="type" />Credits text</button>
                </CanvasTools>
                <CanvasViewport @ref="_viewport" ViewportId="@(_id + "view")" CanvasId="@_id" StillId="@(_id + "still")"
                                Width="canvas.Width" Height="canvas.Height" Label="Credits squeeze canvas" Measure="Measure">
                    <img src="@_preview" alt="Squeeze canvas with stand-in video" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;" />
                    @foreach (var layer in canvas.Layers)
                    {
                        var pose = Pose(layer);
                        <div class="layer-box @(ReferenceEquals(_layer, layer) ? "selected" : "")" @key="layer"
                             style="left:@Pct(pose.Left, canvas.Width);top:@Pct(pose.Top, canvas.Height);width:@Pct(pose.Width, canvas.Width);height:@Pct(pose.Height, canvas.Height);"
                             data-squeeze-layer="@canvas.Layers.IndexOf(layer)">
                            <span class="layer-tag">@layer.Name</span>
                            @if (ReferenceEquals(_layer, layer))
                            {
                                <span class="handle handle-se" data-squeeze-resize></span>
                            }
                        </div>
                    }
                </CanvasViewport>
                <div class="ed-timeline">
                    <CanvasTransport Time="_time" Duration="_previewSeconds" Frame="CurrentFrame" FrameCount="FrameCount" FramesPerSecond="PreviewFps" Step="StepFrames" KeyboardHints="false" />
                    <input class="cs-playhead" data-squeeze-scrub type="range" aria-label="Preview time" aria-valuetext="@($"{_time:0.00} seconds")" min="0" max="@N(LastTime)" step="any" value="@N(_time)" />
                    <div class="cs-key-track" role="group" aria-label="Keyframes for selected layer">
                        <span class="ed-meta">0s</span><span class="spacer"></span><span class="ed-meta">@N(_previewSeconds)s</span>
                        @foreach (var key in _layer?.Keyframes ?? [])
                        {
                            if (key.At.TotalSeconds > LastTime) continue;
                            <button type="button" class="cs-key-marker @(IsCurrent(key) ? "active" : "")" style="left:@Pct(key.At.TotalSeconds, LastTime);" title="@($"Keyframe at {key.At.TotalSeconds:0.00}s")" aria-label="@($"Seek to keyframe at {key.At.TotalSeconds:0.00}s")" @onclick="() => Seek(key.At.TotalSeconds)"><Icon Name="keyframe" Size="12" /></button>
                        }
                    </div>
                    @if (_layer is { } timed)
                    {
                        <div class="ed-keybar">
                            <EditorIconButton Icon="arrow-left" Label="Previous keyframe" Disabled="@(!HasKey(-1))" OnClick="() => GoToKey(-1)" />
                            <button type="button" class="btn btn-sm" title="Capture the current pose at the playhead" @onclick="AddKey"><Icon Name="keyframe" />Add keyframe</button>
                            <EditorIconButton Icon="arrow-right" Label="Next keyframe" Disabled="@(!HasKey(1))" OnClick="() => GoToKey(1)" />
                            <span class="spacer"></span>
                            @if (timed.Keyframes is { Count: > 0 })
                            {
                                <button type="button" class="btn btn-sm btn-danger" title="Remove all keyframes, keeping the current pose" @onclick="StopAnimating"><Icon Name="stop" />Stop animating</button>
                            }
                        </div>
                    }
                </div>
                <p class="hint">Stand-in videos show the layout and channel fit. Use “Render a preview” below to see the actual credits and panel clips.
                    Keyframes are seconds from the start of the credits; the canvas runs for the full credits duration.</p>
                @if (canvas.UsesCreditsText)
                {
                    <p class="hint">Credits Text here is sample text paged over the preview length. Render a preview to read the source with OCR and review its extracted wording.</p>
                }
                <details class="studio-section">
                    <summary><Icon Name="sliders" /> Canvas &amp; preview settings</summary>
                    <p class="hint" role="note">Matching shows use this aspect ratio automatically. With one canvas, all shows use it. The preview uses stand-in video; render below to see real credits.</p>
                    <div class="grid grid-2">
                        <label class="field"><span>Stand-in source shape</span>
                            <select @bind="_sourceRatio" @bind:after="Refresh">@foreach (var ratio in SqueezeCanvas.Ratios) { <option value="@ratio">@ratio</option> }</select></label>
                        <label class="field"><span>Preview length (seconds)</span><input type="number" min="1" max="600" value="@N(_previewSeconds)" @onchange="SetPreviewLength" /></label>
                        <div class="field"><span>Canvas background</span><ScreenColourPicker Value="@canvas.BackgroundColor" ValueChanged="SetBackground" /></div>
                    </div>
                    <p class="hint" role="note">Preview length is only for editing. On air, the canvas runs for the full credits duration. Text from OCR is sampled here; review actual names in the rendered preview.</p>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="RemoveCanvas"><Icon Name="trash" />Delete @canvas.AspectRatio canvas</button>
                </details>
            </Stage>
            <Inspector>
                <div class="layer-actions"><Icon Name="layers" Size="14" /><strong class="ed-meta">Layers</strong><span class="ed-meta">@canvas.Layers.Count</span><span class="spacer"></span><span class="ed-meta">top first</span></div>
                <ol class="layer-list" aria-label="Layers, top first">
                @foreach (var item in canvas.Layers.AsEnumerable().Reverse())
                {
                    <li class="layer-row @(ReferenceEquals(_layer, item) ? "selected" : "")" @key="item">
                        <button type="button" class="layer-select" aria-pressed="@(ReferenceEquals(_layer, item))" @onclick="() => _layer = item"><Icon Name="@LayerIcon(item)" Size="14" /><span>@item.Name</span><small>@LayerKind(item)</small></button>
                    </li>
                }
                </ol>
                @if (canvas.Layers.Count == 0)
                {
                    <p class="hint" role="status">No layers yet. Add source video, a panel, or text above the canvas.</p>
                }
                @if (_layer is { } selected)
                {
                    <div class="inspector">
                    <div class="inspector-head">
                        <h3 class="ed-section">@LayerKind(selected)</h3><span class="spacer"></span>
                        <EditorIconButton Icon="copy" Label="Duplicate layer" OnClick="DuplicateLayer" />
                        <EditorIconButton Icon="trash" Label="Delete layer" Danger="true" OnClick="RemoveLayer" />
                    </div>
                    <label class="field"><span>Name</span><input @bind="selected.Name" @bind:after="Commit" /></label>
                    <div class="row row-wrap" style="gap:4px;">
                        <EditorIconButton Icon="arrow-up" Label="Bring layer forward" Disabled="@(canvas.Layers.IndexOf(selected) == canvas.Layers.Count - 1)" OnClick="() => Reorder(1)" />
                        <EditorIconButton Icon="arrow-down" Label="Send layer backward" Disabled="@(canvas.Layers.IndexOf(selected) == 0)" OnClick="() => Reorder(-1)" />
                    </div>
                    @if (selected.Kind == GeneratedLayerKind.Video)
                    {
                        var video = selected.Video ??= new();
                        <label class="field"><span>Video source</span><select @bind="video.Episode" @bind:after="Commit">
                            <option value="@SqueezeCanvas.Credits">Source credits video</option><option value="@SqueezeCanvas.Panel">Promo / commercials panel</option><option value="">Video file</option>
                        </select></label>
                        <label class="field"><span>Fit video to layer</span><select value="@(video.Stretch ? "stretch" : video.Fill ? "crop" : "fit")" @onchange="SetFit">
                            <option value="fit">Fit (keep its shape)</option><option value="crop">Fill (crop edges)</option><option value="stretch">Stretch / squeeze to bounds</option>
                        </select></label>
                        @if (string.IsNullOrEmpty(video.Episode))
                        {
                            <FilePathPicker Value="@selected.Path" ValueChanged="SetPath" Extensions="SchedularrTV.Service.Editor.FileBrowsing.Videos" KeepCopyIn="@SqueezePackages.AssetCategory" Label="video" />
                            <label class="check"><input type="checkbox" @bind="video.Loop" @bind:after="Commit" />Loop video</label>
                        }
                        <label class="check"><input type="checkbox" @bind="video.IncludeAudio" @bind:after="Commit" />Include audio</label>
                        <label class="field"><span>Volume</span><input type="number" min="0" max="1" step="0.05" @bind="video.Volume" @bind:after="Commit" /></label>
                    }
                    @if (selected.Kind == GeneratedLayerKind.Image)
                    {
                        <FilePathPicker Value="@selected.Path" ValueChanged="SetPath" Extensions="SchedularrTV.Service.Editor.FileBrowsing.Images" KeepCopyIn="@SqueezePackages.AssetCategory" Label="image" />
                    }
                    @if (selected.Kind == GeneratedLayerKind.Text)
                    {
                        @if (selected.CreditsText is { } credits)
                        {
                            <strong>Credits Text · source OCR</strong>
                            <p class="hint">Reads the original credits, even when their video layer is hidden. Pages share this layer's active time equally.
                                Set Tesseract and its languages in the Credit squeeze plugin settings. OCR can misread names; check the extracted text under the rendered preview.</p>
                            <label class="field"><span>Source lines per page</span><input type="number" min="1" max="30" value="@credits.LinesPerPage" @onchange="SetLinesPerPage" /></label>
                        }
                        else
                        {
                        <label class="field"><span>Text</span><textarea @bind="selected.Text" @bind:after="Commit"></textarea></label>
                        <p class="hint">Tokens: {show}, {next}, {time}, {channel}, {heading}.</p>
                        }
                        <label class="field"><span>Font</span><select @bind="selected.FontFamily" @bind:after="Commit">@foreach (string font in Fonts) { <option value="@font">@font</option> }</select></label>
                        <label class="field"><span>Font size</span><input type="number" min="1" max="400" @bind="selected.FontSize" @bind:after="Commit" /></label>
                        <div class="field"><span>Alignment</span><TextAlignPad Horizontal="selected.Align" Vertical="@(selected.VerticalAlign ?? GeneratedVerticalAlign.Top)" Changed="cell => SetAlign(cell.Vertical, cell.Horizontal)" /></div>
                        <label class="check"><input type="checkbox" @bind="selected.Bold" @bind:after="Commit" />Bold</label>
                        <label class="check"><input type="checkbox" checked="@(selected.WordWrap == true)" @onchange="e => SetWordWrap(e.Value is true)" />Wrap long lines to the box</label>
                    }
                    @if (selected.Kind is GeneratedLayerKind.Text or GeneratedLayerKind.Rect)
                    {
                        <div class="field"><span>Colour</span><ScreenColourPicker @key="selected" Value="@selected.Color" ValueChanged="SetColour" /></div>
                    }
                    <div class="grid grid-2">
                        @foreach (string field in new[] { "X", "Y", "Width", "Height" })
                        {
                            <label class="field"><span>@field</span><input type="number" step="1" value="@N(Coordinate(field))" @onchange="e => SetCoordinate(field, e)" /></label>
                        }
                    </div>
                    <label class="field"><span>Opacity · @((Opacity(selected) * 100).ToString("0"))%</span><input type="range" min="0" max="1" step="0.01" value="@N(Opacity(selected))" @onchange="SetOpacity" /></label>
                    <details class="studio-section">
                    <summary><Icon Name="clock" /> Timing</summary>
                    <div class="grid grid-2">
                        <label class="field"><span>Starts (seconds)</span><input type="number" min="0" step="0.1" value="@N(selected.Start.TotalSeconds)" @onchange="e => SetTiming(e, false)" /></label>
                        <label class="field"><span>Ends (blank: full credits)</span><input type="number" min="0" step="0.1" value="@(selected.End is { } end ? N(end.TotalSeconds) : "")" @onchange="e => SetTiming(e, true)" /></label>
                    </div>
                    </details>
                    @if (selected.Video?.Episode == SqueezeCanvas.Credits)
                    {
                        <button type="button" class="btn btn-sm" title="Replace this layer's keyframes with a one-second full-screen-to-box animation" @onclick="AnimateIn"><Icon Name="keyframe" />Animate squeeze-in</button>
                    }
                    @if (selected.Keyframes is { Count: > 0 })
                    {
                    <details class="studio-section" open>
                    <summary><Icon Name="keyframe" /> Keyframes (@selected.Keyframes.Count)</summary>
                    @foreach (var key in selected.Keyframes ?? [])
                    {
                        <div class="cs-key-row" @key="key">
                            <button type="button" class="btn btn-sm @(IsCurrent(key) ? "btn-primary" : "")" title="Seek to this keyframe" aria-pressed="@IsCurrent(key)" @onclick="() => SeekKey(key)">@N(key.At.TotalSeconds)s</button>
                            <select aria-label="Easing to next keyframe" @bind="key.Easing" @bind:after="Commit">@foreach (var easing in Enum.GetValues<GeneratedEasing>()) { <option value="@easing">@easing</option> }</select>
                            <EditorIconButton Icon="trash" Label="Delete keyframe" Danger="true" OnClick="() => RemoveKey(key)" />
                        </div>
                    }
                    </details>
                    }
                    </div>
                }
            </Inspector>
        </CanvasWorkspace>
        @if (Look.Canvases.Any(design => design.UsesCreditsText))
        {
            <details class="studio-section">
                <summary><Icon Name="type" /> Text recognition · @(RecognitionArea == "full" ? "automatic" : "area override")</summary>
                <p class="hint">Automatic recognition reads the whole source and checks text groups and nearby frames for each show independently. Credits can move, change position, or use several columns; no fixed credits area is needed.</p>
                <div class="grid grid-2">
                    <label class="field"><span>Source area (optional override)</span>
                        <select value="@RecognitionArea" @onchange="SetRecognitionArea">
                            <option value="full">Automatic · whole frame</option><option value="lower-third">Override: lower third</option><option value="lower-half">Override: lower half</option><option value="custom">Override: custom vertical area</option>
                        </select></label>
                    <label class="field"><span>Minimum confidence · @Look.Recognition.MinimumConfidence%</span>
                        <input type="range" min="0" max="95" step="5" value="@Look.Recognition.MinimumConfidence" @onchange="SetRecognitionConfidence" /></label>
                    @if (RecognitionArea != "full")
                    {
                        <label class="field"><span>Top (% down the original picture)</span><input type="number" min="0" max="95" value="@Look.Recognition.TopPercent" @onchange="e => SetRecognitionEdge(e, true)" /></label>
                        <label class="field"><span>Bottom (% down the original picture)</span><input type="number" min="5" max="100" value="@Look.Recognition.BottomPercent" @onchange="e => SetRecognitionEdge(e, false)" /></label>
                    }
                </div>
                <p class="hint">Lower confidence keeps more uncertain names; higher confidence removes more noise. A source-area override is only for templates dedicated to a known layout; use Automatic for mixed shows. Render again to regenerate the transcript.</p>
            </details>
        }
        <details class="studio-section">
        <summary><Icon Name="tv" /> Panel content · @PanelName(Look.Panel)</summary>
        <label class="field"><span>Panel content (for panel video layers)</span><select @bind="Look.Panel" @bind:after="Commit">
            <option value="@SqueezePanel.Promo">Promo</option><option value="@SqueezePanel.Commercials">Commercials</option><option value="@SqueezePanel.PromoThenCommercials">Promo, then commercials</option>
        </select></label>
        @if (Look.Panel != SqueezePanel.Commercials)
        {
            <div class="row row-wrap">
            @foreach (var kind in Enum.GetValues<SqueezePromo>())
            {
                <label class="check"><input type="checkbox" checked="@Look.Promos.Contains(kind)" @onchange="e => TogglePromo(kind, e.Value is true)" />@PromoName(kind)</label>
            }
            </div>
        }
        <label class="field"><span>Heading ({heading} token)</span><input @bind="Look.Heading" @bind:after="Commit" /></label>
        </details>
    }
</div>

@code {
    [Parameter, EditorRequired] public SqueezeLook Look { get; set; } = default!;
    [Parameter, EditorRequired] public ChannelConfig Channel { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<string?> SelectedRatio { get; set; }
    private SqueezeCanvas? Canvas;
    private GeneratedLayer? _layer;
    private string _ratio = "", _sourceRatio = "16:9", _preview = "";
    private readonly string _id = "squeeze-" + Guid.NewGuid().ToString("N");
    private CanvasViewport? _viewport;
    private double _time, _pixels = 640;
    private ElementReference _element;
    private IJSObjectReference? _interactions;
    private DotNetObjectReference<SqueezeCanvasEditor>? _self;
    private readonly PromoImageCache _images = new();
    private bool _disposed, _interactive;
    private int _gesture;
    private SKRect _dragBounds;
    private GeneratedLayer? _dragLayer;
    private PromoComposition? _composition;
    private IReadOnlyList<string>? _fonts;
    private IReadOnlyList<string> Fonts => _fonts ??= PromoFonts.Installed();
    private const int PreviewFps = 30;
    private double _previewSeconds = 60;
    private int FrameCount => Math.Max(1, (int)Math.Ceiling(_previewSeconds * PreviewFps));
    private int CurrentFrame => (int)Math.Round(_time * PreviewFps);
    private double LastTime => (FrameCount - 1d) / PreviewFps;
    private bool IsCurrent(GeneratedKeyframe key) => Math.Abs(key.At.TotalSeconds - _time) < 0.001;
    private static string LayerKind(GeneratedLayer layer) => layer.CreditsText is not null ? "Credits text" : layer.Video?.Episode switch
    {
        SqueezeCanvas.Credits => "Source video", SqueezeCanvas.Panel => "Panel", _ => layer.Kind == GeneratedLayerKind.Rect ? "Shape" : layer.Kind.ToString()
    };
    private static string LayerIcon(GeneratedLayer layer) => layer.Kind switch
    {
        GeneratedLayerKind.Text => "type", GeneratedLayerKind.Image => "image", GeneratedLayerKind.Video => "video", _ => "square"
    };
    private static string PanelName(SqueezePanel panel) => panel switch
    {
        SqueezePanel.Commercials => "Commercials", SqueezePanel.PromoThenCommercials => "Promo + commercials", _ => "Promo"
    };
    private static string PromoName(SqueezePromo kind) => kind switch
    {
        SqueezePromo.UpNext => "Up Next", SqueezePromo.ComingUp => "Coming Up", SqueezePromo.Eventually => "Eventually", _ => "Now Playing"
    };
    private Task CreateDefaultCanvas() { _ratio = "16:9"; return AddCanvas(); }
    private bool _customRecognition;
    private string RecognitionArea => _customRecognition ? "custom" : Look.Recognition switch
    {
        { TopPercent: 0, BottomPercent: 100 } => "full", { TopPercent: 65, BottomPercent: 100 } => "lower-third",
        { TopPercent: 50, BottomPercent: 100 } => "lower-half", _ => "custom"
    };
    private async Task SetRecognitionArea(ChangeEventArgs e)
    {
        _customRecognition = e.Value?.ToString() == "custom";
        if (_customRecognition) return;
        Look.Recognition = Look.Recognition with { TopPercent = e.Value?.ToString() switch { "lower-third" => 65, "lower-half" => 50, _ => 0 }, BottomPercent = 100 };
        await Commit();
    }
    private async Task SetRecognitionConfidence(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int value)) return;
        Look.Recognition = (Look.Recognition with { MinimumConfidence = value }).Normalized();
        await Commit();
    }
    private async Task SetRecognitionEdge(ChangeEventArgs e, bool top)
    {
        if (!int.TryParse(e.Value?.ToString(), out int value)) return;
        Look.Recognition = (top ? Look.Recognition with { TopPercent = value } : Look.Recognition with { BottomPercent = value }).Normalized();
        await Commit();
    }
    private async Task AddPanel() { await AddLayer("video"); _layer!.Video!.Episode = SqueezeCanvas.Panel; _layer.Name = "Promo / commercials panel"; await Commit(); }
    private async Task SetBackground(string colour) { if (Canvas is not null && !string.IsNullOrWhiteSpace(colour)) Canvas.BackgroundColor = colour; await Commit(); }
    private async Task SetColour(string colour) { if (_layer is not null && !string.IsNullOrWhiteSpace(colour)) _layer.Color = colour; await Commit(); }
    private async Task SetAlign(GeneratedVerticalAlign vertical, GeneratedTextAlign horizontal)
    {
        if (_layer is null) return;
        _layer.Align = horizontal; _layer.VerticalAlign = vertical;
        await Commit();
    }
    private async Task DuplicateLayer()
    {
        if (_layer is null || Canvas is null) return;
        var copy = System.Text.Json.JsonSerializer.Deserialize<GeneratedLayer>(System.Text.Json.JsonSerializer.Serialize(_layer))!;
        copy.Name += " copy";
        Canvas.Layers.Insert(Canvas.Layers.IndexOf(_layer) + 1, copy);
        _layer = copy;
        await Commit();
    }
    private void StepFrames(int frames) => Seek(Math.Round((_time * PreviewFps) + frames) / PreviewFps);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas-interactions.js");
        if (_disposed) return;
        _interactions = await module.InvokeAsync<IJSObjectReference>("attach", _element, _self);
        if (_disposed) { await _interactions.InvokeVoidAsync("dispose"); await _interactions.DisposeAsync(); }
    }

    public sealed record Interaction(string Kind, string Ratio, double Time, int Id, int Layer, bool Resize, double Dx, double Dy, bool Final);

    [JSInvokable]
    public async Task UpdateInteraction(Interaction update)
    {
        if (_disposed || Canvas is null || update.Ratio != Canvas.AspectRatio) return;
        _interactive = !update.Final;
        if (update.Kind == "scrub" && double.IsFinite(update.Time))
            _time = Math.Clamp(Math.Round(update.Time * PreviewFps) / PreviewFps, 0, LastTime);
        else if (update.Kind == "drag" && double.IsFinite(update.Dx) && double.IsFinite(update.Dy))
        {
            if (update.Layer < 0 || update.Layer >= Canvas.Layers.Count) return;
            if (_gesture != update.Id || _dragLayer is null)
            {
                _gesture = update.Id;
                _dragLayer = Canvas.Layers[update.Layer];
                _dragBounds = Pose(_dragLayer);
            }
            if (!Canvas.Layers.Contains(_dragLayer)) return;
            _layer = _dragLayer;
            SetPose(update.Resize
                ? SKRect.Create(_dragBounds.Left, _dragBounds.Top, Math.Max(2, _dragBounds.Width + (float)update.Dx), Math.Max(2, _dragBounds.Height + (float)update.Dy))
                : SKRect.Create(_dragBounds.Left + (float)update.Dx, _dragBounds.Top + (float)update.Dy, _dragBounds.Width, _dragBounds.Height));
        }
        Refresh();
        if (update.Final && update.Kind == "drag") { _dragLayer = null; await Changed.InvokeAsync(); }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_interactions is not null) { await _interactions.InvokeVoidAsync("dispose"); await _interactions.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
        _images.Dispose();
    }
    private void SetPreviewLength(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double seconds) && double.IsFinite(seconds))
        {
            _previewSeconds = Math.Clamp(seconds, 1, 600);
            Seek(_time);
        }
    }
    private IEnumerable<GeneratedKeyframe> AdjacentKeys(int direction) => (_layer?.Keyframes ?? [])
        .Where(key => direction < 0 ? key.At.TotalSeconds < _time - 0.001 : key.At.TotalSeconds > _time + 0.001)
        .OrderBy(key => direction < 0 ? -key.At.TotalSeconds : key.At.TotalSeconds);
    private bool HasKey(int direction) => AdjacentKeys(direction).Any();
    private void GoToKey(int direction) { if (AdjacentKeys(direction).FirstOrDefault() is { } key) SeekKey(key); }
    private void SeekKey(GeneratedKeyframe key)
    {
        _previewSeconds = Math.Max(_previewSeconds, key.At.TotalSeconds + 1);
        Seek(key.At.TotalSeconds);
    }
    private async Task StopAnimating()
    {
        if (_layer is null) return;
        var pose = Pose(_layer);
        float opacity = Opacity(_layer);
        var draw = DrawLayer(_layer);
        if (draw is not null) _layer.Rotation = PromoAnimation.RotationAt(draw.Rotation, draw.Keyframes, TimeSpan.FromSeconds(_time));
        _layer.Keyframes = null;
        _layer.Opacity = opacity;
        SetPose(pose);
        await Commit();
    }
    private async Task SetOpacity(ChangeEventArgs e)
    {
        if (_layer is null || !float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out float value) || !float.IsFinite(value)) return;
        value = Math.Clamp(value, 0, 1);
        if (_layer.Keyframes is { Count: > 0 })
        {
            SetPose(Pose(_layer));
            _layer.Keyframes.First(key => IsCurrent(key)).Opacity = value;
        }
        else _layer.Opacity = value;
        await Commit();
    }

    protected override void OnParametersSet()
    {
        if (Canvas is null || !Look.Canvases.Contains(Canvas)) Select(Look.Canvases.FirstOrDefault());
    }
    private void Select(SqueezeCanvas? canvas)
    {
        bool changed = !ReferenceEquals(Canvas, canvas);
        Canvas = canvas; _layer = canvas?.Layers.LastOrDefault(); _time = 0;
        _dragLayer = null;
        _sourceRatio = canvas?.AspectRatio ?? "16:9";
        Refresh();
        if (changed) _ = SelectedRatio.InvokeAsync(canvas?.AspectRatio);
    }
    private async Task AddCanvas()
    {
        if (!SqueezeCanvas.Ratios.Contains(_ratio) || Look.Canvases.Any(canvas => canvas.AspectRatio == _ratio)) return;
        var canvas = SqueezeCanvas.Create(_ratio); Look.Canvases.Add(canvas); _ratio = ""; Select(canvas); await Commit();
    }
    private async Task RemoveCanvas() { if (Canvas is not null) Look.Canvases.Remove(Canvas); Select(Look.Canvases.FirstOrDefault()); await Commit(); }
    private async Task Commit() { Refresh(); await Changed.InvokeAsync(); }
    private async Task Fit() { if (_viewport is not null) await _viewport.ResetAsync(); await Measure(); }
    private static string N(double number) => number.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Pct(double number, double size) => N(number / size * 100) + "%";
    private async Task Measure() { _pixels = await JS.InvokeAsync<double>("eval", $"document.getElementById('{_id}')?.getBoundingClientRect().width || 640"); }
    private async Task AddSource() { await AddLayer("video"); _layer!.Video!.Episode = SqueezeCanvas.Credits; _layer.Name = "Source credits video"; await Commit(); }
    private async Task AddCreditsText()
    {
        if (Canvas is null) return;
        _layer = new GeneratedLayer
        {
            Name = "Credits Text", Kind = GeneratedLayerKind.Text, CreditsText = new(),
            X = Math.Max(0, Canvas.Width - 460), Y = 100, Width = 420, Height = 500,
            FontSize = 32, Bold = false, WordWrap = true, Align = GeneratedTextAlign.Center,
            TransitionIn = GeneratedTransition.None, TransitionOut = GeneratedTransition.None
        };
        Canvas.Layers.Add(_layer);
        await Commit();
    }
    private async Task SetLinesPerPage(ChangeEventArgs e)
    {
        if (_layer?.CreditsText is not { } credits || !int.TryParse(e.Value?.ToString(), out int lines)) return;
        credits.LinesPerPage = Math.Clamp(lines, 1, 30);
        await Commit();
    }
    private async Task SetWordWrap(bool wrap) { if (_layer is not null) _layer.WordWrap = wrap; await Commit(); }
    private async Task AddLayer(string kind)
    {
        if (Canvas is null) return;
        _layer = new GeneratedLayer { Name = kind, Kind = kind switch { "text" => GeneratedLayerKind.Text, "image" => GeneratedLayerKind.Image, "video" => GeneratedLayerKind.Video, _ => GeneratedLayerKind.Rect },
            X = 40, Y = 40, Width = 400, Height = 200, Text = "Up next: {next}", FontSize = 40,
            TransitionIn = GeneratedTransition.None, TransitionOut = GeneratedTransition.None,
            Video = kind == "video" ? new GeneratedVideoOptions { Stretch = true, IncludeAudio = true } : null };
        Canvas.Layers.Add(_layer); await Commit();
    }
    private async Task RemoveLayer() { if (_layer is not null) Canvas!.Layers.Remove(_layer); _layer = Canvas?.Layers.LastOrDefault(); await Commit(); }
    private async Task Reorder(int direction)
    {
        if (_layer is null || Canvas is null) return;
        int at = Canvas.Layers.IndexOf(_layer), to = Math.Clamp(at + direction, 0, Canvas.Layers.Count - 1);
        Canvas.Layers.RemoveAt(at); Canvas.Layers.Insert(to, _layer); await Commit();
    }
    private async Task SetPath(string? path) { if (_layer is not null) _layer.Path = path; await Commit(); }
    private async Task SetFit(ChangeEventArgs e)
    {
        if (_layer?.Video is not { } video) return;
        video.Stretch = e.Value?.ToString() == "stretch"; video.Fill = e.Value?.ToString() == "crop"; await Commit();
    }
    private async Task SetTiming(ChangeEventArgs e, bool end)
    {
        if (_layer is null) return;
        if (end && string.IsNullOrWhiteSpace(e.Value?.ToString())) _layer.End = null;
        else if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double seconds) && double.IsFinite(seconds))
        {
            var time = TimeSpan.FromSeconds(Math.Clamp(seconds, 0, 600));
            if (end) _layer.End = time > _layer.Start ? time : _layer.Start + TimeSpan.FromSeconds(0.1);
            else { _layer.Start = time; if (_layer.End <= time) _layer.End = null; }
        }
        await Commit();
    }
    private async Task TogglePromo(SqueezePromo kind, bool on) { Look.Promos.Remove(kind); if (on) Look.Promos.Add(kind); await Commit(); }
    private PromoLayer? DrawLayer(GeneratedLayer layer) => _composition?.Layers.FirstOrDefault(draw => draw.Id == Canvas!.Layers.IndexOf(layer).ToString(CultureInfo.InvariantCulture));
    private SKRect Pose(GeneratedLayer layer) => DrawLayer(layer) is { } draw
        ? PromoAnimation.Pose(draw.Bounds, draw.Opacity, draw.Keyframes, TimeSpan.FromSeconds(_time)).Bounds
        : SKRect.Create(layer.X, layer.Y, layer.Width, layer.Height);
    private float Opacity(GeneratedLayer layer) => DrawLayer(layer) is { } draw
        ? PromoAnimation.Pose(draw.Bounds, draw.Opacity, draw.Keyframes, TimeSpan.FromSeconds(_time)).Opacity : layer.Opacity;
    private double Coordinate(string field) { var pose = Pose(_layer!); return field switch { "X" => pose.Left, "Y" => pose.Top, "Width" => pose.Width, _ => pose.Height }; }
    private async Task SetCoordinate(string field, ChangeEventArgs e)
    {
        if (_layer is null || !float.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out float value) || !float.IsFinite(value)) return;
        var pose = Pose(_layer); float x = pose.Left, y = pose.Top, w = pose.Width, h = pose.Height;
        switch (field) { case "X": x = value; break; case "Y": y = value; break; case "Width": w = Math.Max(2, value); break; default: h = Math.Max(2, value); break; }
        SetPose(SKRect.Create(x, y, w, h)); await Commit();
    }
    private void SetPose(SKRect pose)
    {
        if (_layer is null) return;
        if (_layer.Keyframes is { Count: > 0 })
        {
            var key = _layer.Keyframes.FirstOrDefault(key => Math.Abs(key.At.TotalSeconds - _time) < 0.001);
            if (key is null)
            {
                var draw = DrawLayer(_layer);
                key = new GeneratedKeyframe { At = TimeSpan.FromSeconds(_time), Opacity = Opacity(_layer),
                    Rotation = draw is null ? _layer.Rotation ?? 0 : PromoAnimation.RotationAt(draw.Rotation, draw.Keyframes, TimeSpan.FromSeconds(_time)) };
                _layer.Keyframes.Add(key);
            }
            key.X = pose.Left; key.Y = pose.Top; key.Width = pose.Width; key.Height = pose.Height;
            _layer.Keyframes.Sort((a, b) => a.At.CompareTo(b.At));
        }
        else { _layer.X = pose.Left; _layer.Y = pose.Top; _layer.Width = pose.Width; _layer.Height = pose.Height; }
    }
    private async Task AddKey()
    {
        if (_layer is null) return;
        var pose = Pose(_layer); _layer.Keyframes ??= [];
        if (_layer.Keyframes.Count == 0) _layer.Keyframes.Add(new GeneratedKeyframe { At = TimeSpan.FromSeconds(_time), Opacity = _layer.Opacity, Rotation = _layer.Rotation ?? 0 });
        SetPose(pose); await Commit();
    }
    private async Task RemoveKey(GeneratedKeyframe key) { _layer?.Keyframes?.Remove(key); await Commit(); }
    private void Seek(double time) { _time = Math.Clamp(time, 0, LastTime); Refresh(); }
    private async Task AnimateIn()
    {
        if (_layer is null || Canvas is null) return;
        var pose = Pose(_layer);
        _layer.Keyframes = [new GeneratedKeyframe { Width = Canvas.Width, Height = Canvas.Height, Easing = GeneratedEasing.EaseInOut },
            new GeneratedKeyframe { At = TimeSpan.FromSeconds(1), X = pose.Left, Y = pose.Top, Width = pose.Width, Height = pose.Height }];
        _time = 1; await Commit();
    }
    private void Refresh()
    {
        if (Canvas is null) return;
        var job = Renderer.ForChannel(new SqueezeJob("__credits__", TimeSpan.Zero, TimeSpan.FromSeconds(_previewSeconds), new("Next programme", null, "8:30 PM", null), [],
            Channel.Name, Look.Heading, Look.AccentColor, Canvas.BackgroundColor, 1, false, PromoPath: "__panel__", EndingShow: "Current programme")
        {
            Canvases = [Canvas],
            OcrTranscript = Canvas.UsesCreditsText ? new CreditsOcrResult(Enumerable.Range(1, 16).Select(index => new CreditsOcrLine($"Sample credits line {index}", 100)).ToArray(), 0) : null
        }, Channel);
        _composition = Canvas.Compose(job);
        float scale = Math.Min(1, (_interactive ? 480f : 960f) / Math.Max(Canvas.Width, Canvas.Height));
        using var surface = SKSurface.Create(new SKImageInfo(Math.Max(1, (int)(Canvas.Width * scale)), Math.Max(1, (int)(Canvas.Height * scale))));
        surface.Canvas.Scale(scale);
        using var videos = new StandInFrames(SqueezeCanvas.ParseAspect(_sourceRatio));
        PromoRenderer.DrawFrame(surface.Canvas, _composition, TimeSpan.FromSeconds(_time), _images, videos: videos);
        using var image = surface.Snapshot(); using var data = image.Encode(SKEncodedImageFormat.Jpeg, _interactive ? 65 : 85);
        _preview = "data:image/jpeg;base64," + Convert.ToBase64String(data.ToArray());
    }

    private sealed class StandInFrames(double sourceAspect) : IPromoVideoFrames, IDisposable
    {
        private readonly List<SKImage> _images = [];
        public SKImage Frame(PromoVideoLayer layer, TimeSpan playback)
        {
            (int w, int h) = layer.FrameSize;
            float scale = Math.Min(1, 480f / Math.Max(w, h));
            w = Math.Max(1, (int)(w * scale)); h = Math.Max(1, (int)(h * scale));
            using var surface = SKSurface.Create(new SKImageInfo(w, h)); surface.Canvas.Clear(SKColors.Black);
            float width = w, height = h;
            if (layer.SourceAspect is { } aspect && !layer.SourceCrop)
            {
                if (sourceAspect > aspect) height *= (float)(aspect / sourceAspect); else width *= (float)(sourceAspect / aspect);
            }
            using var paint = new SKPaint { Color = layer.Path == "__credits__" ? new SKColor(55, 65, 85) : new SKColor(85, 55, 65) };
            surface.Canvas.DrawRect((w - width) / 2, (h - height) / 2, width, height, paint);
            using var font = new SKFont(SKTypeface.Default, Math.Min(w / 18f, h / 10f)); paint.Color = SKColors.White;
            surface.Canvas.DrawText(layer.Path == "__credits__" ? "Source credits video" : "Video", w / 2f, h / 2f, SKTextAlign.Center, font, paint);
            var image = surface.Snapshot(); _images.Add(image); return image;
        }
        public void Dispose() { foreach (var image in _images) image.Dispose(); }
    }
}
