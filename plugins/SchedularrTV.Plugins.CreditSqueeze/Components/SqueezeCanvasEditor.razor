        _time = 1; await Commit();
    }
    private void Refresh() => RefreshPreview(requestVideo: true);
    private void RefreshPreview(bool requestVideo)
    {
        if (Canvas is null) return;
        var job = Renderer.ForChannel(new SqueezeJob("__credits__", TimeSpan.Zero, TimeSpan.FromSeconds(_previewSeconds), new("Next programme", null, "8:30 PM", null), [],
            Channel.Name, Look.Heading, Look.AccentColor, Canvas.BackgroundColor, 1, false, PromoPath: "__panel__", EndingShow: "Current programme")
        {
            Canvases = [Canvas],
            OcrTranscript = Canvas.UsesCreditsText
                ? _previewFallback ? new CreditsOcrResult([], 0, Failure: "Previewing default text")
                    : SampleCredits()
                : null
        }, Channel);
        _composition = Canvas.Compose(job);
        float scale = Math.Min(1, (_interactive ? 480f : 960f) / Math.Max(Canvas.Width, Canvas.Height));
        using var surface = SKSurface.Create(new SKImageInfo(Math.Max(1, (int)(Canvas.Width * scale)), Math.Max(1, (int)(Canvas.Height * scale))));
        surface.Canvas.Scale(scale);
        using var videos = new StandInFrames(SqueezeCanvas.ParseAspect(_sourceRatio), _videoImages);
        PromoRenderer.DrawFrame(surface.Canvas, _composition, TimeSpan.FromSeconds(_time), _images, videos: videos);
        using var image = surface.Snapshot(); using var data = image.Encode(SKEncodedImageFormat.Jpeg, _interactive ? 65 : 85);
        _preview = "data:image/jpeg;base64," + Convert.ToBase64String(data.ToArray());
        if (requestVideo && !_disposed)
        {
            _videoVersion++;
            _pendingVideos = (_composition, TimeSpan.FromSeconds(_time), Canvas, _videoVersion);
            if (!_loadingVideos) _videoWork = LoadVideoPreviews();
        }
    }

    private async Task LoadVideoPreviews()
    {
        _loadingVideos = true;
        try
        {
            while (!_disposed && _pendingVideos is { } request)
            {
                _pendingVideos = null;
                var files = request.Composition.Layers.OfType<PromoVideoLayer>().Where(layer => layer.Path is not ("__credits__" or "__panel__")
                    && PromoAnimation.Evaluate(layer, request.Time, request.Composition.Duration, request.Composition.Height) is not null).ToArray();
                string? problem = null;
                foreach (var layer in files)
                {
                    try
                    {
                        _videoDecoder ??= Renderer.CreateCanvasVideoPreview();
                        byte[] data = await _videoDecoder.FrameAsync(layer, layer.PlaybackAt(request.Time), PreviewFps, _videoStop.Token);
                        if (_disposed || request.Version != _videoVersion || !ReferenceEquals(Canvas, request.Canvas)) break;
                        var image = SKImage.FromEncodedData(data) ?? throw new IOException("Video preview frame could not be read.");
                        string id = layer.Id!;
                        if (_videoImages.Remove(id, out var previous)) previous.Image.Dispose();
                        _videoImages[id] = (layer.Path, image);
                    }
                    catch (Exception ex) when (ex is IOException or InvalidOperationException or System.ComponentModel.Win32Exception or System.Text.Json.JsonException)
                    {
                        problem = ex.Message;
                    }
                    catch (OperationCanceledException) when (!_videoStop.IsCancellationRequested)
                    {
                        problem = $"Video preview timed out: {Path.GetFileName(layer.Path)}";
                    }
                }
                if (_disposed) return;
                if (request.Version == _videoVersion && ReferenceEquals(Canvas, request.Canvas))
                {
                    _videoPreviewProblem = problem;
                    var active = files.Select(layer => layer.Id!).ToHashSet(StringComparer.Ordinal);
                    foreach (string old in _videoImages.Keys.Where(id => !active.Contains(id)).ToArray())
                    { _videoImages[old].Image.Dispose(); _videoImages.Remove(old); }
                    if (files.Length > 0) { RefreshPreview(requestVideo: false); StateHasChanged(); }
                }
            }
        }
        catch (OperationCanceledException) when (_videoStop.IsCancellationRequested) { }
        finally { _loadingVideos = false; }
    }

    private sealed class StandInFrames(double sourceAspect, IReadOnlyDictionary<string, (string Path, SKImage Image)> fileFrames) : IPromoVideoFrames, IDisposable
    {
        private readonly List<SKImage> _images = [];
        public SKImage Frame(PromoVideoLayer layer, TimeSpan playback)
        {
            if (layer.Id is { } id && fileFrames.TryGetValue(id, out var frame) && frame.Path == layer.Path) return frame.Image;
            (int w, int h) = layer.FrameSize;
            float scale = Math.Min(1, 480f / Math.Max(w, h));
            w = Math.Max(1, (int)(w * scale)); h = Math.Max(1, (int)(h * scale));
            using var surface = SKSurface.Create(new SKImageInfo(w, h)); surface.Canvas.Clear(SKColors.Black);
            float width = w, height = h;
            if (layer.SourceAspect is { } aspect && !layer.SourceCrop)
            {
                if (sourceAspect > aspect) height *= (float)(aspect / sourceAspect); else width *= (float)(sourceAspect / aspect);
            }
            using var paint = new SKPaint { Color = layer.Path == "__credits__" ? new SKColor(55, 65, 85) : new SKColor(85, 55, 65) };
            surface.Canvas.DrawRect((w - width) / 2, (h - height) / 2, width, height, paint);
            using var font = new SKFont(SKTypeface.Default, Math.Min(w / 18f, h / 10f)); paint.Color = SKColors.White;
            string label = layer.Path == "__credits__" ? "Source credits video" : layer.Path == "__panel__" ? "Promo / commercials panel" : "Loading video…";
            surface.Canvas.DrawText(label, w / 2f, h / 2f, SKTextAlign.Center, font, paint);
            var image = surface.Snapshot(); _images.Add(image); return image;
        }
        public void Dispose() { foreach (var image in _images) image.Dispose(); }
    }
