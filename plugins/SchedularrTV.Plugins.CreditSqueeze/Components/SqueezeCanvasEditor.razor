    public sealed record Interaction(string Kind, string Ratio, double Time, int Id, int Layer, bool Resize, double Dx, double Dy, bool Final, bool LockAspect = false,
        int Key = -1, bool Toggle = false, bool Range = false, double Delta = 0, string? Command = null);

    [JSInvokable]
    public async Task UpdateInteraction(Interaction update)
    {
        if (_disposed || Canvas is null || update.Ratio != Canvas.AspectRatio) return;
        _interactive = !update.Final;
        if (update.Kind == "scrub" && double.IsFinite(update.Time))
        {
            _keys.Clear();
            _time = Math.Clamp(Math.Round(update.Time * PreviewFps) / PreviewFps, 0, LastTime);
        }
        else if (update.Kind == "keys" && double.IsFinite(update.Delta))
        {
            if (_layer?.Keyframes is not { } keys || update.Layer != Canvas.Layers.IndexOf(_layer)) return;
            if (_keyGesture != update.Id || !ReferenceEquals(_keyLayer, _layer))
            {
                if (update.Key < 0 || update.Key >= keys.Count) return;
                _keyGesture = update.Id; _keyLayer = _layer; _keyAnchor = keys[update.Key];
                _ = SelectedKeys;
                _keyMovable = _keys.Click(_keyAnchor, keys, update.Toggle, update.Range);
                _keyStarts = SelectedKeys.Select(key => (key, key.At.TotalSeconds)).ToList();
                _keyChanged = false;
            }
            if (_keyMovable)
            {
                double delta = SchedularrTV.Core.Editing.KeyframeMoves.Delta(_keyStarts.Select(start => start.At), update.Delta, LastTime, PreviewFps);
                foreach (var start in _keyStarts) start.Key.At = TimeSpan.FromSeconds(delta == 0 ? start.At : Math.Round(start.At + delta, 4));
                keys.Sort((a, b) => a.At.CompareTo(b.At));
                _time = Math.Clamp(_keyAnchor!.At.TotalSeconds, 0, LastTime);
                _keyChanged = delta != 0;
            }
        }
        else if (update.Kind == "command")
        {
            switch (update.Command)
            {
                case "left": StepFrames(update.Range ? -PreviewFps : -1); break;
                case "right": StepFrames(update.Range ? PreviewFps : 1); break;
                case "home": Seek(0); break;
                case "end": Seek(LastTime); break;
                case "previous": GoToKey(-1); break;
                case "next": GoToKey(1); break;
                case "add": await AddKey(); break;
                case "escape": _keys.Clear(); break;
                case "delete":
                    if (SelectedKeys.Count > 0) await RemoveSelectedKeys();
                    else if (EditingKey is { } key) await RemoveKey(key);
                    break;
            }
            StateHasChanged(); return;
        }
        else if (update.Kind == "drag" && double.IsFinite(update.Dx) && double.IsFinite(update.Dy))
        {
            if (update.Layer < 0 || update.Layer >= Canvas.Layers.Count) return;
            if (Canvas.Layers[update.Layer].Locked) return;
            if (_gesture != update.Id || _dragLayer is null)
            {
                _gesture = update.Id;
                _dragLayer = Canvas.Layers[update.Layer];
                _dragBounds = Pose(_dragLayer);
            }
            if (!Canvas.Layers.Contains(_dragLayer)) return;
            _layer = _dragLayer;
            double dx = update.Dx, dy = update.Dy;
            if (update.Resize && update.LockAspect)
            {
                double width = Math.Max(2, _dragBounds.Width), height = Math.Max(2, _dragBounds.Height);
                double change = Math.Abs(dx / width) >= Math.Abs(dy / height) ? dx / width : dy / height;
                double scale = Math.Max(Math.Max(2 / width, 2 / height), 1 + change);
                dx = width * scale - width; dy = height * scale - height;
            }
            SetPose(update.Resize
                ? SKRect.Create(_dragBounds.Left, _dragBounds.Top, Math.Max(2, _dragBounds.Width + (float)dx), Math.Max(2, _dragBounds.Height + (float)dy))
                : SKRect.Create(_dragBounds.Left + (float)dx, _dragBounds.Top + (float)dy, _dragBounds.Width, _dragBounds.Height));
        }
        Refresh();
        if (update.Final && update.Kind == "drag") { _dragLayer = null; await Changed.InvokeAsync(); }
        if (update.Final && update.Kind == "keys") { if (_keyChanged) await Changed.InvokeAsync(); _keyLayer = null; }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _videoStop.Cancel();
        if (_videoWork is not null) await _videoWork;
        foreach (var frame in _videoImages.Values) frame.Image.Dispose();
        _videoImages.Clear();
        _videoStop.Dispose();
        try { if (_interactions is not null) { await _interactions.InvokeVoidAsync("dispose"); await _interactions.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
        _images.Dispose();
    }
    private void SetPreviewLength(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double seconds) && double.IsFinite(seconds))
        {
