            }
        }
    }

    /// <summary>What the show picker offers: every show and movie in the library, what the channel airs, and any with a layout.</summary>
    private IEnumerable<string> ShowOptions(CreditSqueezeSection section) =>
        ShowsFor(section).Concat(_libraryTitles).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.CurrentCultureIgnoreCase);

    /// <summary>The shows given a layout of their own, here or on every channel.</summary>
    private List<string> OwnLayouts(CreditSqueezeSection section) =>
        [.. section.Shows.Keys.Concat(_everywhere?.Shows.Keys ?? Enumerable.Empty<string>())
            .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.CurrentCultureIgnoreCase)];

    /// <summary>
    /// For a show the schedule doesn't air now: one of its episodes from the library, followed by the channel's next
    /// programme (or something else), so its squeeze can be previewed all the same.
    /// </summary>
    private async Task<List<ScheduleEntry>?> StandInAsync(string show, ChannelSchedule schedule, (string Path, TimeSpan Length)? outro = null)
    {
        if (Library is not { } library)
        {
            return null;
        }

        IReadOnlyList<MediaItem> programmes = await library.GetProgrammesAsync();
        MediaItem? episode = programmes
            .Where(item => item.Path is { Length: > 0 } && item.Duration > TimeSpan.FromMinutes(1)
                           && string.Equals(SqueezePlanner.ShowOf(item), show, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(item => Credits.CreditsOf(item) is not null)
            .ThenBy(item => item.Id, StringComparer.Ordinal)
            .FirstOrDefault();
        if (episode is null)
        {
            return null;
        }

        DateTimeOffset start = DateTimeOffset.UtcNow;
        MediaItem? following = schedule.Entries
            .FirstOrDefault(entry => entry.Kind == ScheduleEntryKind.Program && entry.Start >= start && !entry.IsSlotOutro && entry.Item is { Path.Length: > 0 })?.Item
            ?? programmes.FirstOrDefault(item => item.Path is { Length: > 0 } && !string.Equals(SqueezePlanner.ShowOf(item), show, StringComparison.OrdinalIgnoreCase));
        if (following is null)
        {
            return null;
        }

        List<ScheduleEntry> entries = [new ScheduleEntry { Start = start, Duration = episode.Duration, Kind = ScheduleEntryKind.Program, Item = episode }];
        DateTimeOffset at = start + episode.Duration;
        if (outro is { } own)
        {
            // The show's own outro, played after its episode as it airs.
            MediaItem clip = new() { Id = $"outro:{own.Path}", Title = $"{show} outro", Duration = own.Length, Path = own.Path };
            entries.Add(new ScheduleEntry { Start = at, Duration = own.Length, Kind = ScheduleEntryKind.Program, Item = clip, IsSlotOutro = true });
            at += own.Length;
        }

        entries.Add(new ScheduleEntry { Start = at, Duration = following.Duration, Kind = ScheduleEntryKind.Program, Item = following });
        return entries;
    }

    /// <summary>
    /// The outro a show plays after its episodes, as set up (under Titles, or on a collection this channel plays), with how
    /// long it runs; null when it has none (or its length can't be read).
    /// </summary>
    private async Task<(string Path, TimeSpan Length)?> ConfiguredOutroAsync(string show)
    {
        List<string> paths = [];
        foreach ((string title, TitleDefaults defaults) in Context.Config.Titles)
        {
            if (string.Equals(title, show, StringComparison.OrdinalIgnoreCase))
            {
                paths.AddRange(defaults.Bumpers.Where(bumper => bumper.Position == BumperPosition.Outro).SelectMany(bumper => bumper.Clips).Select(clip => clip.Path));
            }
        }

        IEnumerable<ContentSelector> selectors = Channel.Blocks.SelectMany(block => block.Shows)
            .Concat(Channel.BaseRotation is { } rotation ? new[] { rotation } : Array.Empty<ContentSelector>());
        foreach (ContentInclude include in selectors.SelectMany(selector => selector.Include)
                     .Where(include => string.Equals(include.Show, show, StringComparison.OrdinalIgnoreCase)))
        {
            if (!string.IsNullOrWhiteSpace(include.Outro))
            {
                paths.Add(include.Outro);
            }

            paths.AddRange(include.Bumpers.Where(bumper => bumper.Position == BumperPosition.Outro).SelectMany(bumper => bumper.Clips).Select(clip => clip.Path));
        }

        foreach (string path in paths.Where(path => !string.IsNullOrWhiteSpace(path)).Distinct(StringComparer.OrdinalIgnoreCase).OrderByDescending(File.Exists))
        {
            if (await Renderer.DurationAsync(path, CancellationToken.None) is { } length)
            {
                return (path, length);
            }
        }

        return null;
    }

    /// <summary>The shows to pick from: what the channel airs, and any already given a layout.</summary>
    private List<string> ShowsFor(CreditSqueezeSection section)
    {
        HashSet<string> shows = new(StringComparer.OrdinalIgnoreCase);
        if (Schedule() is { } schedule)
        {
            shows.UnionWith(SqueezePlanner.ShowsOn(schedule.Entries));
        }

        shows.UnionWith(section.Shows.Keys);
        if (_everywhere is not null)
        {
            shows.UnionWith(_everywhere.Shows.Keys);
        }

        return [.. shows.Order(StringComparer.CurrentCultureIgnoreCase)];
    }

    private string ShowMark(CreditSqueezeSection section, string show) =>
        section.ShowLayout(show) is not null ? "  (own layout here)" : _everywhere?.ShowLayout(show) is not null ? "  (own layout, every channel)" : "";

    /// <summary>The layout being edited (or, for a show without its own, the one it uses), and where it lives.</summary>
    private (SqueezeLayoutChoice Choice, LayoutHome Home) Current(CreditSqueezeSection section)
    {
        if (_show is null)
        {
            return (Look(section).OwnLayout(), LayoutHome.Section);
        }

        if (section.ShowLayout(_show) is { } here)
        {
            return (here, LayoutHome.Here);
        }

        if (_everywhere?.ShowLayout(_show) is { } everywhere)
        {
            return (everywhere, LayoutHome.Everywhere);
        }

        return (Look(section).OwnLayout(), LayoutHome.Inherited);
    }

    private void ChangeLayout(CreditSqueezeSection section, Action<SqueezeLayoutChoice> change)
    {
        (SqueezeLayoutChoice choice, LayoutHome home) = Current(section);
        change(choice);
        choice.SplitPercent = Math.Clamp(choice.SplitPercent, SqueezeLayout.MinSplit, SqueezeLayout.MaxSplit);
        switch (home)
        {
            case LayoutHome.Section:
                Look(section).UseLayout(choice);
                Commit();
                break;
            case LayoutHome.Here:
                Commit();
                break;
            case LayoutHome.Everywhere:
                CommitEverywhere();
                break;
        }
    }

    /// <summary>Gives the picked show a layout of its own, starting from the one it uses now.</summary>
    private void GiveOwnLayout(CreditSqueezeSection section, bool everywhere)
    {
        if (_show is not { } show)
        {
            return;
        }

        SqueezeLayoutChoice start = section.LayoutFor(show, _everywhere, Look(section)).Copy();
        if (everywhere)
        {
            _everywhere ??= new CreditSqueezeSection { Enabled = false };
            RemoveShow(_everywhere.Shows, show);
            _everywhere.Shows[show] = start;
            CommitEverywhere();
        }
        else
        {
            RemoveShow(section.Shows, show);
            section.Shows[show] = start;
            Commit();
        }
    }

    /// <summary>Moves the picked show's layout between this channel and every channel.</summary>
    private void MoveLayout(CreditSqueezeSection section, bool everywhere)
    {
        if (_show is not { } show || Current(section) is not { Home: LayoutHome.Here or LayoutHome.Everywhere } current)
        {
            return;
        }

        SqueezeLayoutChoice layout = current.Choice.Copy();
        RemoveShow(section.Shows, show);
        if (_everywhere is not null)
        {
            RemoveShow(_everywhere.Shows, show);
        }

        if (everywhere)
        {
            _everywhere ??= new CreditSqueezeSection { Enabled = false };
            _everywhere.Shows[show] = layout;
        }
        else
        {
            section.Shows[show] = layout;
        }

        Commit();
        CommitEverywhere();
    }

    private void RemoveLayout(CreditSqueezeSection section)
    {
        if (_show is not { } show)
        {
            return;
        }

        // The nearest one goes: this channel's, else every channel's.
        if (section.ShowLayout(show) is not null)
        {
            RemoveShow(section.Shows, show);
            Commit();
        }
        else if (_everywhere is not null)
        {
            RemoveShow(_everywhere.Shows, show);
            CommitEverywhere();
        }
    }

    private static void RemoveShow(Dictionary<string, SqueezeLayoutChoice> shows, string show)
    {
        foreach (string key in shows.Keys.Where(name => string.Equals(name, show, StringComparison.OrdinalIgnoreCase)).ToList())
        {
            shows.Remove(key);
        }
    }

    /// <summary>
    /// Writes the layouts for every channel into the schedule's settings. That section is off (so it never turns a channel
    /// on by itself) and only its shows' layouts are used.
    /// </summary>
    private void CommitEverywhere()
    {
        Dictionary<string, object?> sections = Context.Config.Settings.Plugins ?? new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        string key = sections.Keys.FirstOrDefault(existing => string.Equals(existing, CreditSqueezeSection.PluginId, StringComparison.OrdinalIgnoreCase))
                     ?? CreditSqueezeSection.PluginId;
        if (_everywhere is null || _everywhere.Shows.Count == 0)
        {
            sections.Remove(key);
        }
        else
        {
            _everywhere.Enabled = false;
            sections[key] = _everywhere;
        }

        Context.Config.Settings.Plugins = sections.Count > 0 ? sections : null;
        Context.NotifyChanged();
    }

