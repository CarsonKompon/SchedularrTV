    /// <summary>The look being edited: the selected template, else the section's own.</summary>
    private SqueezeLook Look(CreditSqueezeSection section) =>
        _template >= 0 && _template < section.Templates.Count ? section.Templates[_template] : section;

    private string LookName(CreditSqueezeSection section) => Look(section) is SqueezeTemplate template ? template.Name : CreditSqueezeSection.MainLook;

    /// <summary>A look's share of the squeezes, as shown on its button.</summary>
    private static string WeightText(CreditSqueezeSection section, SqueezeLook look)
    {
        if (look is SqueezeTemplate { Enabled: false })
        {
            return "off";
        }

        IReadOnlyList<SqueezeLook> looks = section.Looks();
        double total = looks.Sum(candidate => candidate.Weight);
        return looks.Contains(look) && total > 0 ? $"{Math.Round(look.Weight / total * 100)}%" : "0%";
    }

    private void SelectTemplate(int index)
    {
        _template = index;
        _frameKey = null;
        _previewNote = null;
        _previewProblem = null;
    }

    /// <summary>A new template, starting as a copy of the one being edited.</summary>
    private void AddTemplate(CreditSqueezeSection section)
    {
        int number = section.Templates.Count + 2;
        string name = $"Look {number}";
        while (section.Templates.Any(template => string.Equals(template.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            name = $"Look {++number}";
        }

        section.Templates.Add(SqueezeTemplate.Of(Look(section), name));
        _template = section.Templates.Count - 1;
        Commit();
    }

    private void DeleteTemplate(CreditSqueezeSection section)
    {
        if (_template >= 0 && _template < section.Templates.Count)
        {
            section.Templates.RemoveAt(_template);
            _template = -1;
            Commit();
        }
    }

