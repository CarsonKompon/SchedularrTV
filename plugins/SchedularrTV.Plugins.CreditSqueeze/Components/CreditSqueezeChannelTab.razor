    /// <summary>
    /// Fills the show picker in the background. (Awaiting it in OnInitializedAsync would hold back OnParametersSet, and
    /// with it the whole tab, until the library answered.)
    /// </summary>
    private async Task LoadLibraryTitlesAsync()
    {
        if (Library is not { } library)
        {
            return;
        }

        try
        {
            IReadOnlyList<SchedularrTV.Service.Editor.LibraryShow> shows = await library.GetShowsAsync(_stop.Token);
            IReadOnlyList<SchedularrTV.Service.Editor.LibraryMovie> movies = await library.GetMoviesAsync(_stop.Token);
            _libraryTitles = [.. shows.Select(show => show.Name).Concat(movies.Select(movie => movie.Title))
                .Where(name => !string.IsNullOrWhiteSpace(name)).Distinct(StringComparer.OrdinalIgnoreCase)];
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is not OperationCanceledException and not ObjectDisposedException)
        {
            // The picker still offers what the channel airs.
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
        }
    }

