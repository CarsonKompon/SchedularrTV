    /// <summary>
    /// A real squeeze from the channel's current schedule, whatever the odds, made with these settings and cut to 20
    /// seconds: of the picked show (its outro, else its marked credits, else the last seconds of an episode), or else the
    /// first credits or outro there is.
    /// </summary>
    private async Task RenderPreviewAsync(CreditSqueezeSection section)
    {
        _previewProblem = null;
        _previewNote = null;
        if (Schedule() is not { } schedule)
        {
            _previewProblem = "The channel hasn't been built yet; save it first.";
            return;
        }

        // Previews the selected template's look (whichever an airing would pick).
        CreditSqueezeSection trial = section.WithOnly(Look(section));
        trial.Enabled = true;
        trial.CreditsChance = 1;
        trial.OutroChance = 1;
        trial.Outros.Clear();
        TimeZoneInfo zone = SchedulingEngine.ResolveTimeZone(string.IsNullOrWhiteSpace(Channel.TimeZone) ? Context.Config.Settings.TimeZone : Channel.TimeZone);
        SqueezePlan? plan;
        if (_show is { } show)
        {
            // From the schedule when it airs the show (with its outro), else from one of its episodes in the library, followed by
            // its outro if it has one set up (the schedule only plays a new outro once it's been rebuilt).
            var found = SqueezePlanner.PreviewFor(schedule.Entries, show, trial, _everywhere, Channel.Id, Channel.Name, zone, Credits.CreditsOf, PreviewCredits,
                Settings.AssumedCredits);
            if (found is not { Source: SqueezePlanner.PreviewSource.Outro } && await ConfiguredOutroAsync(show) is { } outro)
            {
                found = await StandInAsync(show, schedule, outro) is { } withOutro
                    ? SqueezePlanner.PreviewFor(withOutro, show, trial, _everywhere, Channel.Id, Channel.Name, zone, Credits.CreditsOf, PreviewCredits,
                        Settings.AssumedCredits) ?? found
                    : found;
            }

            if (found is null && await StandInAsync(show, schedule) is { } standIn)
            {
                found = SqueezePlanner.PreviewFor(standIn, show, trial, _everywhere, Channel.Id, Channel.Name, zone, Credits.CreditsOf, PreviewCredits,
                    Settings.AssumedCredits);
            }

            if (found is null)
            {
                _previewProblem = $"Couldn't find an episode of {show} to preview (the library has none with a file the scheduler can read).";
                return;
            }

            plan = found.Value.Plan;
            _previewNote = found.Value.Source switch
            {
                SqueezePlanner.PreviewSource.Outro => $"From {show}'s own outro.",
                SqueezePlanner.PreviewSource.Credits => "From an episode's marked credits.",
                SqueezePlanner.PreviewSource.Assumed => $"From the last {AssumedText(trial)} of an episode, as its credits aren't known.",
                _ => Credits.Status().Waiting > 0
                    ? "From the end of an episode: Jellyfin is still being asked where its credits start."
                    : "From the end of an episode: its credits aren't known, so it's only squeezed on air if you set how much of the end to squeeze (under How often)."
            };
        }
        else
        {
            plan = SqueezePlanner.Plan(schedule.Entries, Channel.Id, Channel.Name, zone, _ => trial, Credits.CreditsOf, _everywhere, Settings.AssumedCredits)
                .FirstOrDefault();
            if (plan is null)
            {
                // Nothing marked: show the layout against the end of the first show's episode anyway.
                string? first = SqueezePlanner.ShowsOn(schedule.Entries).FirstOrDefault();
                if (first is null || SqueezePlanner.PreviewFor(schedule.Entries, first, trial, _everywhere, Channel.Id, Channel.Name, zone, Credits.CreditsOf,
                        PreviewCredits, Settings.AssumedCredits) is not { } any)
                {
                    _previewProblem = "Nothing to preview: the channel's schedule has no episode with something after it.";
                    return;
                }

                plan = any.Plan;
                _previewNote = $"No credits are known on the schedule yet, so this is the end of a {first} episode.";
            }
        }

        // A stand-in (an episode and its outro from the library, as a show with its own outro is previewed) has no breaks, so
        // a panel of commercials takes the ones the channel's real schedule airs over the next few hours.
        if (plan.Job.Panel != SqueezePanel.Promo && plan.Job.Commercials is not { Count: > 0 })
        {
            plan = plan with { Job = plan.Job with { Commercials = SqueezePlanner.CommercialsFrom(schedule.Entries, DateTimeOffset.UtcNow, Channel.Id) } };
        }

        _previewing = true;
        _makingPromo = plan.Job.WantsMadePromo && PromoMaker is not null;
        StateHasChanged();
        try
        {
            // As long as its promo needs (the renderer knows once it has it, made or not), else the usual 20 seconds.
            SqueezeJob job = plan.Job.PromoPath is not null || plan.Job.WantsMadePromo || plan.Job.Panel != SqueezePanel.Promo
                ? plan.Job with { FitToPromo = true }
                : plan.Job with { Length = plan.Job.Length < PreviewLength ? plan.Job.Length : PreviewLength };
            string name = await Renderer.PreviewAsync(job, Channel.Id, CancellationToken.None);
            _previewUrl = $"api/credit-squeeze/preview/{Uri.EscapeDataString(name)}";
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException or System.ComponentModel.Win32Exception)
        {
            _previewProblem = $"Couldn't make the preview: {ex.Message}";
        }
        finally
        {
            _previewing = false;
        }
    }

    private static string ModeOf(CreditSqueezeSection? section, bool isBlock) => section switch
    {
        null => isBlock ? InheritMode : OwnMode,
        { Enabled: false } when isBlock => OffMode,
        _ => OwnMode
    };

    private static string ModeName(string mode) => mode switch
    {
        InheritMode => "Same as this channel",
        OffMode => "No squeezes",
        _ => "Its own settings"
    };

    private void SelectScope(ChangeEventArgs e)
    {
        _blockIndex = int.TryParse(e.Value?.ToString(), out int index) ? index : -1;
        Load();
    }

    private void SetMode(ChangeEventArgs e)
    {
        _section = (e.Value?.ToString() ?? OwnMode) switch
        {
            InheritMode => null,
            OffMode => new CreditSqueezeSection { Enabled = false },
            // A block starts from the channel's settings.
            _ => Enable((Read(Channel.Plugins) ?? new CreditSqueezeSection()).Copy())
        };
        Commit();
    }

    private static CreditSqueezeSection Enable(CreditSqueezeSection section)
    {
        section.Enabled = true;
        return section;
    }

    /// <summary>
    /// The shows on this channel with an outro of their own (under Titles, or set on a collection the channel plays), plus
    /// any already given odds here.
    /// </summary>
    private List<string> OutroShows(ChannelConfig channel, CreditSqueezeSection section)
    {
        HashSet<string> shows = new(StringComparer.OrdinalIgnoreCase);
        foreach ((string title, TitleDefaults defaults) in Context.Config.Titles)
        {
            if (defaults.Bumpers.Any(bumper => bumper.Position == BumperPosition.Outro))
            {
                shows.Add(title);
            }
        }

        IEnumerable<ContentSelector> selectors = channel.Blocks.SelectMany(block => block.Shows)
            .Concat(channel.BaseRotation is { } rotation ? new[] { rotation } : Array.Empty<ContentSelector>());
        foreach (ContentInclude include in selectors.SelectMany(selector => selector.Include))
        {
            if (include.Show is { Length: > 0 } show && (!string.IsNullOrWhiteSpace(include.Outro) || include.Bumpers.Any(bumper => bumper.Position == BumperPosition.Outro)))
            {
                shows.Add(show);
            }
        }

        shows.UnionWith(section.Outros.Keys);
        return [.. shows.Order(StringComparer.CurrentCultureIgnoreCase)];
    }

    private static void SetOutro(CreditSqueezeSection section, string show, double chance)
    {
        ClearOutro(section, show);
        section.Outros[show] = Math.Clamp(chance, 0, 1);
    }

    private static void ClearOutro(CreditSqueezeSection section, string show)
    {
        foreach (string key in section.Outros.Keys.Where(name => string.Equals(name, show, StringComparison.OrdinalIgnoreCase)).ToList())
        {
            section.Outros.Remove(key);
        }
    }

    private void Set(Action change)
    {
        change();
        Commit();
    }

    /// <summary>Writes the section back into the channel or block, so the schedule editor offers to save it.</summary>
    private void Commit()
    {
        if (Block is { } block)
        {
            Dictionary<string, object?> sections = block.Plugins ?? new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
            string key = sections.Keys.FirstOrDefault(existing => string.Equals(existing, CreditSqueezeSection.PluginId, StringComparison.OrdinalIgnoreCase))
                         ?? CreditSqueezeSection.PluginId;
            if (_section is null)
            {
                sections.Remove(key);
            }
            else
            {
                sections[key] = _section;
            }

            block.Plugins = sections.Count > 0 ? sections : null;
            Context.NotifyChanged();
        }
        else
        {
            Context.Write(_section);
        }
    }

    private static string Percent(double value) => $"{Math.Round(value * 100)}%";

    private static double Number(ChangeEventArgs e, double fallback) =>
        double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double value) ? value : fallback;

    private static string Text(ChangeEventArgs e, string fallback) => e.Value?.ToString()?.Trim() is { Length: > 0 } text ? text : fallback;
}
