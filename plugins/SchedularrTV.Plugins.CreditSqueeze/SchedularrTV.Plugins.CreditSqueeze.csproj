<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Credit squeeze: as a show's end credits (or its own outro) roll, they shrink into a box and the rest of the picture
    says what's on next. Credits come from chapters named for them, or Jellyfin's media segments. Not part of the main
    download: it ships in the all-plugins zip.

    It builds against the scheduler itself (the editor's shared components, SkiaSharp, the Jellyfin client), so it has
    to come from the same release as the scheduler it runs in.
  -->
  <PropertyGroup>
    <RootNamespace>SchedularrTV.CreditSqueeze</RootNamespace>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <ScopedCssEnabled>false</ScopedCssEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplied by the scheduler at runtime (SkiaSharp included), so none of it is copied into the plugin. -->
    <ProjectReference Include="..\..\src\SchedularrTV.Service\SchedularrTV.Service.csproj" Private="false" ExcludeAssets="runtime;native" />
    <ProjectReference Include="..\..\src\SchedularrTV.Plugins.Abstractions\SchedularrTV.Plugins.Abstractions.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SchedularrTV.Plugins" />
    <Using Include="SchedularrTV.Plugins.Playout" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
