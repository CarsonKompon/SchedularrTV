@* Shown in the Local AI writer's settings dialog under its fields: the engine and models to download, a model to use,
   models on a server, and a box to try it. Downloads carry on when the dialog is closed. *@
@implements IDisposable
@inject IServiceProvider Services

<div class="local-ai-panel">
    <h3>Built-in AI</h3>
    @if (LocalAiPaths.RuntimeId() is null)
    {
        <p class="hint warn">The built-in AI can't run on this kind of computer. Use an Ollama or LM Studio server instead (above).</p>
    }
    else if (Downloads is { } downloads)
    {
        <div class="local-ai-row">
            <div class="local-ai-text">
                <strong>AI engine</strong>
                <span class="hint">llama.cpp for this computer, about 30 to 120 MB, from NuGet.</span>
            </div>
            @if (downloads.IsFinishing(LocalAiDownloads.EngineKey))
            {
                <span class="hint">Unpacking…</span>
            }
            else if (downloads.Progress(LocalAiDownloads.EngineKey) is { } engineDone)
            {
                <progress max="1" value="@Fraction(engineDone)"></progress>
                <span class="hint">@Percent(engineDone)</span>
                <button class="btn btn-sm" type="button" @onclick="() => downloads.Cancel(LocalAiDownloads.EngineKey)">Stop</button>
            }
            else if (downloads.EngineInstalled)
            {
                <span class="pill pill-ok">@(downloads.JustFinished(LocalAiDownloads.EngineKey) ? JustInstalled : Installed)</span>
            }
            else
            {
                <button class="btn btn-sm btn-primary" type="button" @onclick="downloads.StartEngine">Download</button>
            }
        </div>
        @if (downloads.Error(LocalAiDownloads.EngineKey) is { } engineError)
        {
            <p class="hint warn">Couldn't download the engine: @engineError</p>
        }
        @if (LocalAiGpu.Supported)
        {
            <div class="local-ai-row" style="border:1px solid var(--line);border-radius:8px;margin-top:8px;">
                <div class="local-ai-text">
                    <strong>Graphics card add-on</strong>
                    <span class="hint">Runs the model on an NVIDIA, AMD or Intel graphics card (Vulkan): many times faster, and it leaves the processor free. Tens of MB, from NuGet; the engine above is still needed.</span>
                    @if (LlamaGpuStatus() is { } llamaStatus)
                    {
                        <span class="hint @(llamaStatus.Warn ? "warn" : string.Empty)">@llamaStatus.Text</span>
                    }
                </div>
                @if (downloads.IsFinishing(LocalAiDownloads.GpuEngineKey))
                {
                    <span class="hint">Unpacking…</span>
                }
                else if (downloads.Progress(LocalAiDownloads.GpuEngineKey) is { } gpuDone)
                {
                    <progress max="1" value="@Fraction(gpuDone)"></progress>
                    <span class="hint">@Percent(gpuDone)</span>
                    <button class="btn btn-sm" type="button" @onclick="() => downloads.Cancel(LocalAiDownloads.GpuEngineKey)">Stop</button>
                }
                else if (downloads.GpuEngineInstalled)
                {
                    <span class="pill pill-ok">@(downloads.JustFinished(LocalAiDownloads.GpuEngineKey) ? JustInstalled : Installed)</span>
                }
                else
                {
                    <button class="btn btn-sm @(LocalAiGpu.DriverFound ? "btn-primary" : string.Empty)" type="button" @onclick="downloads.StartGpuEngine">Download</button>
                }
            </div>
            @if (downloads.Error(LocalAiDownloads.GpuEngineKey) is { } gpuError)
            {
                <p class="hint warn">Couldn't download the graphics card add-on: @gpuError</p>
            }
        }

        <LowPowerNotice Title="@($"The built-in AI on {HardwareProfile.DeviceName}")" Advice="LowPowerAdvice">
            It runs on the processor only, so expect roughly 10 to 40 seconds per voice-over or caption, and it shares the
            processor with the channels on air.
        </LowPowerNotice>
        <p class="hint" style="margin:12px 0 6px;">Models (each is downloaded once, into <code>@ModelsFolder</code>):</p>
        <div class="local-ai-list">
            @foreach (LocalAiModel model in LocalAiModels.All)
            {
                string file = Path.Combine(ModelsFolder, model.File);
                bool have = File.Exists(file);
                bool chosen = string.Equals(ChosenModel, model.Id, StringComparison.OrdinalIgnoreCase);
                <div class="local-ai-row">
                    <div class="local-ai-text">
                        <strong>@model.Name</strong>
                        <span class="hint">@model.Description @Size(model.Size).</span>
                    </div>
                    @if (downloads.IsFinishing(model.Id))
                    {
                        <span class="hint">Finishing…</span>
                    }
                    else if (downloads.Progress(model.Id) is { } done)
                    {
                        <progress max="1" value="@Fraction(done)"></progress>
                        <span class="hint">@Percent(done)</span>
                        <button class="btn btn-sm" type="button" @onclick="() => downloads.Cancel(model.Id)">Stop</button>
                    }
                    else if (!have)
                    {
                        <button class="btn btn-sm @(chosen ? "btn-primary" : string.Empty)" type="button" @onclick="() => downloads.StartModel(model, ModelsFolder)">Download</button>
                    }
                    else
                    {
                        <span class="pill pill-ok">@(downloads.JustFinished(model.Id) ? JustDownloaded : Downloaded)</span>
                        @if (chosen)
                        {
                            <span class="pill pill-accent">In use</span>
                        }
                        else
                        {
                            <button class="btn btn-sm" type="button" @onclick="() => Choose(model.Id)">Use this</button>
                            <button class="btn btn-sm btn-ghost" type="button" title="Delete the downloaded file" @onclick="() => Remove(file)">Delete</button>
                        }
                    }
                </div>
                @if (downloads.Error(model.Id) is { } modelError)
                {
                    <p class="hint warn">Couldn't download @model.Name: @modelError</p>
                }
            }
            <div class="local-ai-row">
                <div class="local-ai-text">
                    <strong>Your own model file</strong>
                    <span class="hint">@(OwnFile is { } own ? Path.GetFileName(own) : ChooseFileFirst)</span>
                </div>
                @if (string.Equals(ChosenModel, LocalAiModels.Custom, StringComparison.OrdinalIgnoreCase))
                {
                    <span class="pill pill-ok">In use</span>
                }
                else
                {
                    <button class="btn btn-sm" type="button" disabled="@(OwnFile is null)" @onclick="() => Choose(LocalAiModels.Custom)">Use this</button>
                }
            </div>
        </div>
        <p class="hint" style="margin-top:8px;">
            Downloads carry on if you close this window. A model you choose here is used once you save.
        </p>
    }

    <h3 style="margin-top:18px;">Speech recognition (Whisper)</h3>
    <p class="hint" style="margin:0 0 8px;">
        For promos whose clips are curated by AI: each episode is transcribed once, so the writer can pick its moments
        and talk about them. Transcripts are kept, so an episode is only ever done once.
    </p>
    @if (WhisperEngine.RuntimeFolder() is null)
    {
        <p class="hint warn">Speech recognition can't run on this kind of computer.</p>
    }
    else if (Downloads is { } whisperDownloads)
    {
        <div class="local-ai-row" style="border:1px solid var(--line);border-radius:8px;">
            <div class="local-ai-text">
                <strong>Speech recognition engine</strong>
                <span class="hint">whisper.cpp for this computer@(WhisperEngine.NeedsNoAvx ? " (the build for processors without AVX)" : string.Empty), about 5 to 40 MB, from NuGet.</span>
            </div>
            @if (whisperDownloads.IsFinishing(LocalAiDownloads.WhisperEngineKey))
            {
                <span class="hint">Unpacking…</span>
            }
            else if (whisperDownloads.Progress(LocalAiDownloads.WhisperEngineKey) is { } whisperDone)
            {
                <progress max="1" value="@Fraction(whisperDone)"></progress>
                <span class="hint">@Percent(whisperDone)</span>
                <button class="btn btn-sm" type="button" @onclick="() => whisperDownloads.Cancel(LocalAiDownloads.WhisperEngineKey)">Stop</button>
            }
            else if (whisperDownloads.WhisperEngineInstalled)
            {
                <span class="pill pill-ok">@(whisperDownloads.JustFinished(LocalAiDownloads.WhisperEngineKey) ? JustInstalled : Installed)</span>
            }
            else
            {
                <button class="btn btn-sm btn-primary" type="button" @onclick="whisperDownloads.StartWhisperEngine">Download</button>
            }
        </div>
        @if (whisperDownloads.Error(LocalAiDownloads.WhisperEngineKey) is { } whisperError)
        {
            <p class="hint warn">Couldn't download the speech recognition engine: @whisperError</p>
        }
        @if (LocalAiGpu.Supported)
        {
            <div class="local-ai-row" style="border:1px solid var(--line);border-radius:8px;margin-top:8px;">
                <div class="local-ai-text">
                    <strong>Graphics card add-on for speech recognition</strong>
                    <span class="hint">Transcribes on the graphics card (Vulkan): an episode in well under a minute on most cards. Tens of MB, from NuGet.</span>
                    @if (WhisperGpuStatus() is { } whisperStatus)
                    {
                        <span class="hint @(whisperStatus.Warn ? "warn" : string.Empty)">@whisperStatus.Text</span>
                    }
                </div>
                @if (whisperDownloads.IsFinishing(LocalAiDownloads.WhisperGpuKey))
                {
                    <span class="hint">Unpacking…</span>
                }
                else if (whisperDownloads.Progress(LocalAiDownloads.WhisperGpuKey) is { } whisperGpuDone)
                {
                    <progress max="1" value="@Fraction(whisperGpuDone)"></progress>
                    <span class="hint">@Percent(whisperGpuDone)</span>
                    <button class="btn btn-sm" type="button" @onclick="() => whisperDownloads.Cancel(LocalAiDownloads.WhisperGpuKey)">Stop</button>
                }
                else if (whisperDownloads.WhisperGpuInstalled)
                {
                    <span class="pill pill-ok">@(whisperDownloads.JustFinished(LocalAiDownloads.WhisperGpuKey) ? JustInstalled : Installed)</span>
                }
                else
                {
                    <button class="btn btn-sm @(LocalAiGpu.DriverFound ? "btn-primary" : string.Empty)" type="button" @onclick="whisperDownloads.StartWhisperGpu">Download</button>
                }
            </div>
            @if (whisperDownloads.Error(LocalAiDownloads.WhisperGpuKey) is { } whisperGpuError)
            {
                <p class="hint warn">Couldn't download the speech recognition graphics card add-on: @whisperGpuError</p>
            }
        }

        <div class="local-ai-list" style="margin-top:8px;">
            @foreach (LocalAiModel model in WhisperModels.All)
            {
                string file = Path.Combine(ModelsFolder, model.File);
                bool have = File.Exists(file);
                bool chosen = string.Equals(ChosenWhisperModel, model.Id, StringComparison.OrdinalIgnoreCase);
                <div class="local-ai-row">
                    <div class="local-ai-text">
                        <strong>@model.Name</strong>
                        <span class="hint">@model.Description @Size(model.Size).</span>
                    </div>
                    @if (whisperDownloads.IsFinishing(model.Id))
                    {
                        <span class="hint">Finishing…</span>
                    }
                    else if (whisperDownloads.Progress(model.Id) is { } done)
                    {
                        <progress max="1" value="@Fraction(done)"></progress>
                        <span class="hint">@Percent(done)</span>
                        <button class="btn btn-sm" type="button" @onclick="() => whisperDownloads.Cancel(model.Id)">Stop</button>
                    }
                    else if (!have)
                    {
                        <button class="btn btn-sm @(chosen ? "btn-primary" : string.Empty)" type="button" @onclick="() => whisperDownloads.StartModel(model, ModelsFolder)">Download</button>
                    }
                    else
                    {
                        <span class="pill pill-ok">@(whisperDownloads.JustFinished(model.Id) ? JustDownloaded : Downloaded)</span>
                        @if (chosen)
                        {
                            <span class="pill pill-accent">In use</span>
                        }
                        else
                        {
                            <button class="btn btn-sm" type="button" @onclick="() => Editor.Set(WhisperModelKey, model.Id)">Use this</button>
                            <button class="btn btn-sm btn-ghost" type="button" title="Delete the downloaded file" @onclick="() => Remove(file)">Delete</button>
                        }
                    }
                </div>
                @if (whisperDownloads.Error(model.Id) is { } modelError)
                {
                    <p class="hint warn">Couldn't download @model.Name: @modelError</p>
                }
            }
            <div class="local-ai-row">
                <div class="local-ai-text">
                    <strong>Your own Whisper model</strong>
                    <span class="hint">@(OwnWhisperFile is { } ownWhisper ? Path.GetFileName(ownWhisper) : ChooseWhisperFileFirst)</span>
                </div>
                @if (string.Equals(ChosenWhisperModel, WhisperModels.Custom, StringComparison.OrdinalIgnoreCase))
                {
                    <span class="pill pill-ok">In use</span>
                }
                else
                {
                    <button class="btn btn-sm" type="button" disabled="@(OwnWhisperFile is null)" @onclick="() => Editor.Set(WhisperModelKey, WhisperModels.Custom)">Use this</button>
                }
            </div>
        </div>
        <LowPowerNotice Title="@($"Speech recognition on {HardwareProfile.DeviceName}")" Advice="WhisperLowPowerAdvice">
            Transcribing runs on the processor only: expect several minutes per episode with the base model. Each
            episode is only transcribed once.
        </LowPowerNotice>
    }

    <h3 style="margin-top:18px;">Server</h3>
    <div class="row row-wrap" style="gap:8px;align-items:center;">
        <button class="btn btn-sm" type="button" disabled="@_finding" @onclick="FindModels">@(_finding ? "Looking…" : "Find models on the server")</button>
        <span class="hint" style="margin:0;">Uses the server type and address above (saved or not).</span>
    </div>
    @if (_serverModels is { Count: > 0 } models)
    {
        <div class="row row-wrap" style="gap:6px;margin-top:8px;">
            @foreach (string name in models)
            {
                bool picked = string.Equals(Editor.Get(ServerModelKey) ?? Saved.ServerModel, name, StringComparison.OrdinalIgnoreCase);
                <button class="btn btn-sm @(picked ? "btn-primary" : string.Empty)" type="button" @onclick="() => Editor.Set(ServerModelKey, name)">@name</button>
            }
        </div>
    }
    else if (_serverModels is not null)
    {
        <p class="hint">The server has no models yet. With Ollama, run <code>ollama pull qwen3.5:2b</code> first.</p>
    }
    @if (_serverMessage is not null)
    {
        <p class="hint warn">@_serverMessage</p>
    }

    <h3 style="margin-top:18px;">Try it</h3>
    <p class="hint" style="margin:0 0 6px;">Uses the saved settings: save first to try a change.</p>
    <div class="row row-wrap" style="gap:8px;margin-bottom:6px;">
        <select value="@_tryWith" @onchange="e => _tryWith = e.Value?.ToString() ?? LlamaTextGenerator.GeneratorId" aria-label="Writer to try">
            <option value="@LlamaTextGenerator.GeneratorId">Built in</option>
            <option value="@ServerTextGenerator.GeneratorId">Server</option>
        </select>
    </div>
    <textarea rows="3" style="width:100%;" value="@_tryPrompt" @onchange="e => _tryPrompt = e.Value?.ToString() ?? string.Empty" aria-label="What to ask"></textarea>
    <div class="row row-wrap" style="gap:8px;align-items:center;margin-top:6px;">
        <button class="btn btn-sm" type="button" disabled="@_trying" @onclick="RunTry">@(_trying ? "Writing…" : "Write it")</button>
        @if (_tryTime is { } took)
        {
            <span class="hint" style="margin:0;">@TookText(took)</span>
        }
    </div>
    @if (_tryReply is not null)
    {
        <blockquote class="local-ai-reply">@_tryReply</blockquote>
    }
    @if (_tryError is not null)
    {
        <p class="hint warn" role="status">@_tryError</p>
    }
</div>

<style>
    .local-ai-panel { border-top: 1px solid var(--line); margin-top: 6px; padding-top: 14px; }
    .local-ai-panel h3 { font-size: 13px; margin: 0 0 8px; }
    .local-ai-list { border: 1px solid var(--line); border-radius: 8px; }
    .local-ai-row { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-bottom: 1px solid var(--line); }
    .local-ai-list .local-ai-row:last-child { border-bottom: 0; }
    .local-ai-panel > .local-ai-row { border: 1px solid var(--line); border-radius: 8px; }
    .local-ai-text { flex: 1; min-width: 0; display: grid; gap: 2px; }
    .local-ai-text .hint { margin: 0; }
    .local-ai-row progress { width: 120px; }
    .local-ai-reply { margin: 8px 0 0; padding: 8px 12px; border-radius: 8px; background: rgba(255,255,255,.05); white-space: pre-line; }
    .local-ai-panel .hint.warn { color: #ffd08a; }
</style>

@code {
    [Parameter] public PluginSettingsEditor Editor { get; set; } = default!;

    private const string ModelKey = "Model";
    private const string ModelFileKey = "ModelFile";
    private const string ModelsFolderKey = "ModelsFolder";
    private const string ServerModelKey = "ServerModel";
    private const string WhisperModelKey = "WhisperModel";
    private const string WhisperModelFileKey = "WhisperModelFile";
    private const string ChooseWhisperFileFirst = "Choose a ggml file in Your own Whisper model file above first.";

    private string ChosenWhisperModel => Editor.Get(WhisperModelKey) ?? Saved.WhisperModel;

    private string? OwnWhisperFile => (Editor.Get(WhisperModelFileKey) ?? Saved.WhisperModelFile) is { Length: > 0 } own && own.Trim().Length > 0 ? own.Trim() : null;

    private static IEnumerable<string?> WhisperLowPowerAdvice =>
    [
        "Use Whisper tiny or base here; small takes a long while per episode on a board's processor.",
        "Transcribing shares the processor with the channels on air, so the first promos for a new episode may take a while to be ready."
    ];
    private const string DefaultTry =
        "Write the announcer's voice-over for an Up Next promo on the channel \"The Zone\": SpongeBob SquarePants is next, then more SpongeBob SquarePants at 6:30, then Rugrats at 7. At most 25 words.";

    private readonly CancellationTokenSource _closing = new();
    private LocalAiDownloads? _downloads;
    private bool _finding;
    private IReadOnlyList<string>? _serverModels;
    private string? _serverMessage;
    private string _tryWith = LlamaTextGenerator.GeneratorId;
    private string _tryPrompt = DefaultTry;
    private bool _trying;
    private string? _tryReply;
    private string? _tryError;
    private TimeSpan? _tryTime;
    private bool _tryLoaded;
    private DateTime _lastPaint;

    private LocalAiDownloads? Downloads => _downloads;

    private LocalAiOptions Saved => Services.GetService<IOptions<LocalAiOptions>>()?.Value ?? new LocalAiOptions();

    private LocalAiPaths Paths => Services.GetService<LocalAiPaths>() ?? new LocalAiPaths(Path.GetTempPath());

    private string ChosenModel => Editor.Get(ModelKey) ?? Saved.Model;

    private string ModelsFolder => Paths.ModelsFolder(Editor.Get(ModelsFolderKey) ?? Saved.ModelsFolder);

    // On a Raspberry Pi: which model fits its memory, and where to keep it.
    private IEnumerable<string?> LowPowerAdvice
    {
        get
        {
            double memory = HardwareProfile.Detected.MemoryGb;
            string chosen = ChosenModel;
            return
            [
                string.Equals(chosen, "qwen3.5-4b", StringComparison.OrdinalIgnoreCase) && memory < 7
                    ? "Qwen3.5 4B needs about 3 GB on its own; with the browsers and ffmpegs of the channels that's more than this board has. Choose 0.8B or 2B."
                    : string.Equals(chosen, "qwen3.5-4b", StringComparison.OrdinalIgnoreCase)
                        ? "Qwen3.5 4B is about twice as slow as 2B here (a minute or more per piece)."
                        : null,
                string.Equals(chosen, LocalAiModels.Default, StringComparison.OrdinalIgnoreCase) && memory < 3
                    ? "Qwen3.5 2B takes about 1.5 GB; on a board with under 3 GB choose 0.8B, or use a model on another computer's Ollama (Server, below)."
                    : null,
                "Each time it's loaded the model is read in full (0.5 to 2.7 GB); keep the models folder on a USB SSD rather than the SD card, and raise \"Free memory after\" if it's reloading often.",
                "Or run the model on a stronger computer with Ollama or LM Studio and point the Server settings at it; the Pi then only waits for the answer."
            ];
        }
    }

    protected override void OnInitialized()
    {
        _downloads = Services.GetService<LocalAiDownloads>();
        if (_downloads is not null)
        {
            _downloads.Changed += OnDownloadChanged;
        }
    }

    public void Dispose()
    {
        if (_downloads is not null)
        {
            _downloads.Changed -= OnDownloadChanged;
        }

        _closing.Cancel();
        _closing.Dispose();
    }

    // Progress arrives on download threads; it's painted a few times a second, but a start or an end always is (an
    // end skipped here would leave the bar at 100% with nothing saying it's done).
    private void OnDownloadChanged(bool milestone)
    {
        if (!milestone && DateTime.UtcNow - _lastPaint < TimeSpan.FromMilliseconds(250))
        {
            return;
        }

        _lastPaint = DateTime.UtcNow;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Choose(string id) => Editor.Set(ModelKey, id);

    private void Remove(string file)
    {
        try
        {
            File.Delete(file);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _tryError = $"Couldn't delete {Path.GetFileName(file)}: {ex.Message} (it may be in use; try again in a few minutes).";
        }
    }

    private async Task FindModels()
    {
        _finding = true;
        _serverMessage = null;
        _serverModels = null;
        try
        {
            if (Services.GetService<ServerTextGenerator>() is not { } server)
            {
                return;
            }

            // What's in the fields now, so an address can be tried before it's saved.
            LocalAiOptions saved = Saved;
            var settings = new LocalAiOptions
            {
                ServerKind = Editor.Get("ServerKind") ?? saved.ServerKind,
                ServerUrl = Editor.Get("ServerUrl") ?? saved.ServerUrl,
                ServerApiKey = Editor.Get("ServerApiKey") ?? saved.ServerApiKey
            };
            _serverModels = await server.ListModelsAsync(settings, _closing.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _serverMessage = $"Couldn't ask the server for its models: {ex.GetBaseException().Message}";
        }
        finally
        {
            _finding = false;
        }
    }

    private async Task RunTry()
    {
        _trying = true;
        _tryReply = null;
        _tryError = null;
        _tryTime = null;
        try
        {
            ITextGenerator? generator = _tryWith == ServerTextGenerator.GeneratorId
                ? Services.GetService<ServerTextGenerator>()
                : Services.GetService<LlamaTextGenerator>();
            if (generator is null)
            {
                _tryError = "The writer isn't available; is the plugin switched on?";
                return;
            }

            if (generator.SetupProblem is { } problem)
            {
                _tryError = problem;
                return;
            }

            _tryLoaded = _tryWith == LlamaTextGenerator.GeneratorId && Services.GetService<LlamaEngine>()?.Loaded is null;
            var started = DateTime.UtcNow;
            _tryReply = await generator.GenerateAsync(
                new TextGenerationRequest("You write short, lively copy for a TV channel. Reply with only the words asked for.", _tryPrompt),
                _closing.Token);
            _tryTime = DateTime.UtcNow - started;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _tryError = ex.GetBaseException().Message;
        }
        finally
        {
            _trying = false;
        }
    }

    private const string GpuKey = "Gpu";

    private bool GpuWanted => !string.Equals((Editor.Get(GpuKey) ?? Saved.Gpu)?.Trim(), LocalAiGpu.Off, StringComparison.OrdinalIgnoreCase);

    private sealed record GpuStatus(string Text, bool Warn);

    /// <summary>Whether the graphics card is used for the model, and if not, why; null when there's nothing to say.</summary>
    private GpuStatus? LlamaGpuStatus()
    {
        bool installed = Downloads?.GpuEngineInstalled == true;
        LlamaEngine? engine = Services.GetService<LlamaEngine>();
        return CommonGpuStatus(installed, LlamaEngine.EngineChosen, LlamaEngine.GpuOffered)
            ?? (engine?.GpuProblem is { } problem ? new GpuStatus(problem, true)
                : engine?.Device is { } device ? new GpuStatus($"In use: {device}.", false)
                : new GpuStatus("Used the next time the model is loaded.", false));
    }

    /// <summary>Whether the graphics card is used for Whisper, and if not, why; null when there's nothing to say.</summary>
    private GpuStatus? WhisperGpuStatus()
    {
        bool installed = Downloads?.WhisperGpuInstalled == true;
        WhisperEngine? engine = Services.GetService<WhisperEngine>();
        return CommonGpuStatus(installed, WhisperEngine.EngineChosen, WhisperEngine.GpuOffered)
            ?? (engine?.GpuProblem is { } problem ? new GpuStatus(problem, true)
                : engine?.UsedGpu == true ? new GpuStatus("In use: the last episode was transcribed on the graphics card.", false)
                : new GpuStatus("Used for the next episode transcribed.", false));
    }

    private GpuStatus? CommonGpuStatus(bool installed, bool engineChosen, bool gpuOffered)
    {
        if (!installed)
        {
            return LocalAiGpu.DriverFound ? null
                : new GpuStatus("No Vulkan graphics driver was found on this computer; install or update the graphics card's driver first.", true);
        }

        if (!GpuWanted)
        {
            return engineChosen && gpuOffered
                ? new GpuStatus("Switched off in the Graphics card setting above: restart SchedularrTV to keep it off the graphics card.", true)
                : new GpuStatus("Switched off in the Graphics card setting above, so the processor is used.", false);
        }

        if (!LocalAiGpu.DriverFound)
        {
            return new GpuStatus("No Vulkan graphics driver was found on this computer, so the processor is used. Install or update the graphics card's driver.", true);
        }

        return engineChosen && !gpuOffered
            ? new GpuStatus("Restart SchedularrTV to start using it: the engine was started on the processor before this was downloaded (or switched on).", true)
            : null;
    }

    private const string Installed = "Installed";
    private const string JustInstalled = "Installed ✓";
    private const string Downloaded = "Downloaded";
    private const string JustDownloaded = "Downloaded ✓";

    private const string ChooseFileFirst ="Choose a GGUF file in Your own model file above first.";

    private string? OwnFile => (Editor.Get(ModelFileKey) ?? Saved.ModelFile) is { Length: > 0 } own && own.Trim().Length > 0 ? own.Trim() : null;

    private string TookText(TimeSpan took) =>
        $"Took {took.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture)} s{(_tryLoaded ? ", including loading the model" : string.Empty)}.";

    private static string Fraction(double value) => Math.Clamp(value, 0, 1).ToString("0.###", CultureInfo.InvariantCulture);

    private static string Percent(double value) => $"{(int)(Math.Clamp(value, 0, 1) * 100)}%";

    private static string Size(long bytes) => bytes >= 1_000_000_000 ? $"{bytes / 1_000_000_000.0:0.0} GB" : $"{bytes / 1_000_000.0:0} MB";
}
