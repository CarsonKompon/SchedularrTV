<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A local build is numbered from the latest v* tag (0.2.1-dev after v0.2.0); CI passes its own -p:Version. -->
  <Import Project="..\..\build\GitVersion.targets" />

  <PropertyGroup>
    <RootNamespace>SchedularrTV.Service</RootNamespace>
    <UserSecretsId>schedularrtv-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchedularrTV.Core\SchedularrTV.Core.csproj" />
    <ProjectReference Include="..\SchedularrTV.Plugins.Abstractions\SchedularrTV.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\SchedularrTV.Providers.ErsatzTv\SchedularrTV.Providers.ErsatzTv.csproj" />
    <ProjectReference Include="..\SchedularrTV.Providers.Jellyfin\SchedularrTV.Providers.Jellyfin.csproj" />
    <ProjectReference Include="..\SchedularrTV.Providers.FileSystem\SchedularrTV.Providers.FileSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the tray as source, so neither has to reference the other's dependencies. -->
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <!-- Windows and macOS natives come with SkiaSharp itself; Linux needs its own package. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <!-- Reads ErsatzTV's and Tunarr's databases (read-only) to import their channels. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pinned past the SQLite it brings by default (2.1.11 bundles a SQLite with CVE-2025-6965, GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <!-- Renders the guides in docs/ for the in-app Documentation pages. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The guides are built into the app, so the Documentation pages always match the version that's running. -->
    <EmbeddedResource Include="..\..\docs\*.md" LogicalName="docs/%(Filename)%(Extension)" Link="docs\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A local schedule.yaml is copied for development only, where the app then uses the files beside it.
      Release builds ship none, so a downloaded copy keeps its data in the per-user folder and starts clean.
    -->
    <None Update="config\*.yaml" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="config\schedule.example.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="config\schedule.yaml" Condition="'$(Configuration)' == 'Debug'" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
