{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Updates": {
    "Repository": "CarsonKompon/SchedularrTV",
    "Enabled": true
  },
  "Cors": {
    "Origins": []
  },
  "Scheduler": {
    "ConfigPath": "config/schedule.yaml",
    "StatePath": "state/playback-state.json",
    "LogoPath": "logos",
    "AutoRebuild": true,
    "WatchConfig": true,
    "ApiKey": null
  },
  "Jellyfin": {
    "BaseUrl": "http://localhost:8096",
    "ApiKey": "",
    "UserId": null,
    "PageSize": 500
  },
  "FileSystemLibrary": {
    "FfprobePath": "ffprobe",
    "CachePath": "state/probe-cache.json",
    "Folders": []
  },
  "ErsatzTv": {
    "ConfigRoot": "etv/config",
    "XmltvFolder": "xmltv",
    "WriteLineup": true,
    "GuideMode": "Programs",
    "PathMappings": [],
    "ManageProcess": false,
    "ExecutablePath": null,
    "RestartDelay": "00:00:05",
    "Lineup": {
      "BindAddress": "0.0.0.0",
      "Port": 8409,
      "OutputFolder": "hls"
    }
  }
}
