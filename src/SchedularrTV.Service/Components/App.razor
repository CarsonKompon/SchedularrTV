<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0c11" />
    <title>SchedularrTV</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="SchedularrTV.Service.styles.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%236f7fff'/%3E%3Cstop offset='1' stop-color='%23c07bff'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='24' height='24' rx='6' fill='url(%23g)'/%3E%3Crect x='5' y='8.5' width='14' height='10' rx='2' fill='none' stroke='white' stroke-width='1.8'/%3E%3Cpath d='M15 4.5l-3 4-3-4' fill='none' stroke='white' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <HeadOutlet @rendermode="Interactive" />
</head>
<body>
    <Routes @rendermode="Interactive" IsLocal="IsLocal" />
    <script src="_framework/blazor.web.js"></script>
    <script src="file-drop.js"></script>
</body>
</html>

@code {
    // Set while this page is rendered for the initial request, before the interactive connection exists.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// Whether the browser is on this machine. Decided from the real connection here, then handed to the
    /// interactive part as a protected component parameter the browser can't alter.
    /// </summary>
    private bool IsLocal => HttpContext?.Connection.RemoteIpAddress is { } address
        && System.Net.IPAddress.IsLoopback(address.IsIPv4MappedToIPv6 ? address.MapToIPv4() : address);

    // Prerendering would run every page's initial load twice and, worse, block the first byte on a
    // full library scan. The shell is tiny, so rendering only once interactively is faster.
    private static readonly InteractiveServerRenderMode Interactive = new(prerender: false);
}
