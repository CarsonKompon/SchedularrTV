@* The three interstitial tiers, shared by channels and blocks. *@
@inject LibraryBrowser Library

<div class="card">
    <div class="card-head"><h2>@(ShowAds ? "Ad break settings" : "Interstitials")</h2></div>
    @if (ShowAds)
    {
        @if (BrandContent is not null) { @BrandContent }
        else { <BrandTagsEditor Values="Commercials.BaseTags" ValuesChanged="OnBrandsChanged" /> }
    }

    @if (ShowShows)
    {
    <h3>Tier 1 &mdash; interstitial shows</h3>
    <div class="grid grid-2">
        <label class="field">
            <span>Max interstitial shows per timeslot</span>
            <input type="number" min="0" step="1" placeholder="Inherit (default: unlimited)"
                   value="@(Interstitials.MaxShowsPerSlot?.ToString() ?? "")"
                   @onchange="e => { Interstitials.MaxShowsPerSlot = Int(e); Changed.InvokeAsync(); }" />
        </label>
        <label class="field">
            <span>Chance to use a short when one fits (%)</span>
            <input type="number" min="0" max="100" step="5" placeholder="Inherit (default: @InterstitialsConfig.DefaultShowChance%)"
                   value="@(Interstitials.ShowChance?.ToString() ?? "")"
                   @onchange="e => { Interstitials.ShowChance = Int(e) is { } percent ? Math.Clamp(percent, 0, 100) : null; Changed.InvokeAsync(); }" />
        </label>
    </div>
    <p class="hint">Checked for each short, so breaks aren't always opened with one; a miss leaves the rest of the break to the adverts. 100 always uses one.</p>
    @if (Shows is null)
    {
        <button class="btn btn-sm" @onclick="AddShows">Add a shorts pool</button>
        <p class="hint">Without this, a long gap is filled entirely with adverts.</p>
    }
    else
    {
        <SelectorEditor Selector="Shows" Label="Short programmes"
                        Changed="Changed" OnRemove="RemoveShows" />
    }

    }

    @if (ShowAds && InheritAds)
    {
        <p class="hint">This channel has no ad breaks configuration; it inherits the global one.</p>
        <button type="button" class="btn btn-primary" @onclick="ConfigureAds">Configure for this channel</button>
    }
    else if (ShowAds)
    {
    <h3>Tier 2 &mdash; commercials</h3>
    <TagChipPicker Label="Clip folders to use"
                   Hint="Only whole clips that fit the remaining gap are used, so nothing is cut off."
                   Available="_folders.Types"
                   Selected="Commercials.Types"
                   SelectedChanged="OnCommercialTypesChanged" />

    <h3>Tier 3 &mdash; filler</h3>
    <label class="check">
        <input type="checkbox" checked="@Filler.IsEnabled"
               @onchange="e => { Filler.Fallback = (bool)(e.Value ?? true); Changed.InvokeAsync(); }" />
        <span>Use filler to close the last few seconds</span>
    </label>

    @if (Filler.IsEnabled)
    {
        <TagChipPicker Label="Clip folders to use"
                       Hint="These may be trimmed, so keep it to bumpers and station IDs rather than adverts."
                       Available="_folders.Types"
                       Selected="Filler.Types"
                       SelectedChanged="OnFillerTypesChanged" />

    }

    <details>
        <summary style="cursor:pointer;color:var(--muted);font-size:12px;margin:12px 0 8px;">Advanced</summary>

        <h3>Tier 2 &mdash; commercials</h3>
        <div class="grid grid-2">
            <label class="field">
                <span>Base query</span>
                <input type="text" value="@Commercials.BaseQuery" placeholder="tag:&quot;Commercials&quot;"
                       @onchange="e => { Commercials.BaseQuery = Text(e); Changed.InvokeAsync(); }" />
            </label>
            <label class="field">
                <span>Extra filter</span>
                <input type="text" value="@Commercials.Filter" placeholder="year >= 1990"
                       @onchange="e => { Commercials.Filter = Text(e); Changed.InvokeAsync(); }" />
            </label>
        </div>

        <div class="grid grid-4">
            <DurationInput Label="Shortest item" Value="Commercials.MinItemDuration"
                           ValueChanged="v => { Commercials.MinItemDuration = v; Changed.InvokeAsync(); }" />
            <DurationInput Label="Longest item" Value="Commercials.MaxItemDuration"
                           ValueChanged="v => { Commercials.MaxItemDuration = v; Changed.InvokeAsync(); }" />
            <DurationInput Label="Tolerance" Value="Commercials.Tolerance"
                           ValueChanged="v => { Commercials.Tolerance = v; Changed.InvokeAsync(); }" />
            <label class="field">
                <span>Repeats per break</span>
                <input type="number" min="1" value="@(Commercials.MaxRepeatsPerBreak?.ToString() ?? "")"
                       @onchange="e => { Commercials.MaxRepeatsPerBreak = Int(e); Changed.InvokeAsync(); }" />
            </label>
        </div>

        <label class="check">
            <input type="checkbox" checked="@Commercials.IsStrictFit"
                   @onchange="e => { Commercials.StrictFit = (bool)(e.Value ?? true); Changed.InvokeAsync(); }" />
            <span>Strict fit &mdash; never trim a commercial (recommended)</span>
        </label>

        <h3>Tier 3 &mdash; filler</h3>
        <label class="field">
            <span>Filler query (replaces the folder picks above)</span>
            <input type="text" value="@Filler.Query" placeholder="tag:&quot;Bumpers&quot; OR tag:&quot;StationID&quot;"
                   @onchange="e => { Filler.Query = Text(e); Changed.InvokeAsync(); }" />
        </label>

        <div class="grid grid-3">
            <DurationInput Label="Shortest item" Value="Filler.MinItemDuration"
                           ValueChanged="v => { Filler.MinItemDuration = v; Changed.InvokeAsync(); }" />
            <DurationInput Label="Longest item" Value="Filler.MaxItemDuration"
                           ValueChanged="v => { Filler.MaxItemDuration = v; Changed.InvokeAsync(); }" />
            <DurationInput Label="Min trimmed length" Value="Filler.MinTrimmedDuration"
                           ValueChanged="v => { Filler.MinTrimmedDuration = v; Changed.InvokeAsync(); }" />
        </div>

        <label class="check">
            <input type="checkbox" checked="@Filler.IsTrimmable"
                   @onchange="e => { Filler.Trimmable = (bool)(e.Value ?? true); Changed.InvokeAsync(); }" />
            <span>Allow trimming to land exactly on the boundary</span>
        </label>
        <label class="check">
            <input type="checkbox" checked="@(Filler.StopBeforeEnd ?? false)"
                   @onchange="e => { Filler.StopBeforeEnd = (bool)(e.Value ?? false); Changed.InvokeAsync(); }" />
            <span>Stop before the end rather than hard-cutting</span>
        </label>
    </details>
    }
</div>

@code {
    [Parameter, EditorRequired] public InterstitialsConfig Interstitials { get; set; } = new();
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public bool ShowShows { get; set; } = true;
    [Parameter] public bool ShowAds { get; set; } = true;
    [Parameter] public bool InheritAds { get; set; }
    [Parameter] public EventCallback ConfigureAds { get; set; }
    [Parameter] public RenderFragment? BrandContent { get; set; }
    [Parameter] public ContentSelector? ShowsOverride { get; set; }
    [Parameter] public EventCallback ClearShowsOverride { get; set; }
    private ContentSelector? Shows => ShowsOverride ?? Interstitials.Shows;

    private CommercialsConfig Commercials => Interstitials.Commercials ??= new CommercialsConfig();
    private FillerTierConfig Filler => Interstitials.Filler ??= new FillerTierConfig();

    private CommercialFolders _folders = new([], [], [], []);

    protected override async Task OnInitializedAsync() => _folders = await Library.GetCommercialFoldersAsync();

    private async Task OnBrandsChanged(List<string>? tags)
    {
        Commercials.BaseTags = tags;
        Filler.BaseTags = tags;
        await Changed.InvokeAsync();
    }

    private async Task OnCommercialTypesChanged(List<string>? tags)
    {
        Commercials.Types = tags;
        await Changed.InvokeAsync();
    }

    private async Task OnFillerTypesChanged(List<string>? tags)
    {
        Filler.Types = tags;
        await Changed.InvokeAsync();
    }

    private async Task AddShows()
    {
        await ClearShowsOverride.InvokeAsync();
        Interstitials.Shows = new ContentSelector();
        await Changed.InvokeAsync();
    }

    private async Task RemoveShows()
    {
        await ClearShowsOverride.InvokeAsync();
        Interstitials.Shows = null;
        await Changed.InvokeAsync();
    }

    private static string? Text(ChangeEventArgs e) =>
        string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString();

    private static int? Int(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out int v) ? v : null;
}
