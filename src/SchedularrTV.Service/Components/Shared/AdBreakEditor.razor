@* One ad break collection: its folders (picked in the commercials libraries' folder trees), its promos and settings. *@
@inject ConfigEditor Editor
@inject TimeProvider Clock

<AdBreakTimeline Name="@Name" AdBreak="AdBreak" />

<div class="ab-summary row row-wrap">
    <span class="pill job-ads">@Count(AdFolderRole.Ads) ads folder(s)</span>
    <span class="pill job-bumpers">@Count(AdFolderRole.Bumpers) bumper folder(s)</span>
    <span class="pill job-filler">@Count(AdFolderRole.Filler) filler folder(s)</span>
    <span class="pill job-promo">@(AdBreak.Promos.Count + AdBreak.PromoRoots.Count) promo folder(s)</span>
    @if (AdBreak.Seasonal)
    {
        <span class="pill pill-muted">Seasonal</span>
    }
</div>

@if (_suggestions.Count > 0)
{
    <div class="banner ab-suggest">
        <div class="row row-wrap">
            <strong>Folders that look ready to use</strong>
            <div class="spacer"></div>
            <button class="btn btn-sm btn-primary" type="button" @onclick="AddAllSuggestions"><Icon Name="sparkles" Size="14" />Add all</button>
        </div>
        <div class="ab-suggest-list">
            @foreach (FolderSuggestion suggestion in _suggestions)
            {
                <button class="btn btn-sm" type="button" title="@suggestion.Path" @onclick="() => Apply(suggestion)">
                    <Icon Name="plus" Size="12" /><code>@suggestion.FolderName</code>&nbsp;as @suggestion.Label
                </button>
            }
        </div>
    </div>
}

<div class="ab-layout">
    <section class="card ab-tree-card">
        <div class="card-head">
            <h2>Folders</h2>
            <span class="muted">Pick what each folder holds. Folders inside it follow along unless you pick otherwise.</span>
            <div class="spacer"></div>
            @if (Roots.Count > 0)
            {
                <button class="btn btn-sm" type="button" @onclick="() => _pickingRoot = !_pickingRoot">
                    <Icon Name="folder" Size="14" />@(AdBreak.Root is null ? "Choose its folder" : "Change folder")
                </button>
            }
        </div>

        @if (_pickingRoot)
        {
            <div class="banner">
                <p class="hint">The folder holding everything this ad break uses. Only it is shown below.</p>
                <FolderTreePicker Roots="Roots" Selected="@AdBreak.Root" SelectedChanged="SetRoot" />
            </div>
        }
        else if (AdBreak.Root is null && Roots.Count > 0)
        {
            <p class="hint">
                Showing every commercials library. Choose the folder that holds this ad break's clips to see just that one.
            </p>
        }
        else if (_rootMissing)
        {
            <p class="hint warn">Its folder, <code>@AdBreak.Root</code>, isn't in your commercials libraries any more; showing them all.</p>
        }

        @if (Outside.Count > 0)
        {
            <div class="banner banner-warn">
                <p>These folders are outside <code>@AdBreakPaths.Name(AdBreak.Root ?? "")</code> but still used:</p>
                @foreach (string path in Outside)
                {
                    <div class="row">
                        <code class="ab-path" title="@path">@path</code>
                        <span class="pill pill-muted">@(AdBreakFolderJobs.Explicit(AdBreak, path)?.Label)</span>
                        <div class="spacer"></div>
                        <button class="btn btn-sm" type="button" @onclick="() => { AdBreakFolderJobs.Set(AdBreak, path, AdBreakFolderJobs.None); Notify(); }">Stop using</button>
                    </div>
                }
            </div>
        }

        @if (Roots.Count == 0)
        {
            <div class="empty">
                <Icon Name="folder" Size="28" StrokeWidth="1.5" />
                <div class="empty-title">No commercials libraries yet</div>
                <div>Add a folder of commercials under <a href="settings/app">App settings</a>, then come back to pick its folders.</div>
            </div>
        }
        else
        {
            <div class="ab-tree" role="tree">
                @foreach (CommercialFolder root in TreeRoots)
                {
                    <AdBreakFolderNode @key="root.Path" Folder="root" Depth="0" AdBreak="AdBreak" Open="_open" Shows="_shows"
                                       Temporal="Temporal" Now="_now" OnToggle="Toggle" OnPick="SetJob" />
                }
            </div>
            <p class="hint ab-legend">
                <span class="ab-phantom-sample">Greyed-out folders</span> are ones this ad break would look for if you made them.
                Counts are clips in the folder and everything inside it.
            </p>
        }
    </section>

    <div class="ab-side">
        <section class="card">
            <div class="card-head"><h2>Settings</h2></div>
            <label class="check">
                <input type="checkbox" checked="@AdBreak.Seasonal" @onchange="e => { AdBreak.Seasonal = e.Value is true; Notify(); }" />
                <span>Seasonal folders (dates, months, holidays)</span>
            </label>
            <p class="hint">
                Clips in a folder named for a month, season, holiday or date (<code>December</code>, <code>Winter</code>,
                <code>Christmas</code>, <code>12-25</code>) only play then. Everything else plays all year.
            </p>

            <label class="field">
                <span>Bumpers go</span>
                <select value="@AdBreak.BumperPlacement" @onchange="e => { AdBreak.BumperPlacement = Enum.Parse<BumperPlacement>(e.Value?.ToString() ?? nameof(BumperPlacement.Mixed)); Notify(); }">
                    <option value="@BumperPlacement.Mixed">Mixed in with the ads</option>
                    <option value="@BumperPlacement.StartAndEnd">At the start and end of each break</option>
                    <option value="@BumperPlacement.Start">At the start of each break</option>
                    <option value="@BumperPlacement.End">At the end of each break</option>
                </select>
            </label>

            <details>
                <summary class="ab-advanced">Advanced</summary>
                <div class="grid grid-2">
                    <label class="field">
                        <span>"Any show" folder name</span>
                        <input type="text" value="@AdBreak.AnyShowFolder" placeholder="@AdBreakConfig.DefaultAnyShowFolder"
                               @onchange="e => { AdBreak.AnyShowFolder = Text(e); Notify(); }" />
                    </label>
                    <label class="field">
                        <span>Most Coming Up promos per break</span>
                        <input type="number" min="0" value="@(AdBreak.MaxPromosPerBreak?.ToString() ?? "")" placeholder="2"
                               @onchange="e => { AdBreak.MaxPromosPerBreak = Int(e); Notify(); }" />
                    </label>
                    <DurationInput Label="Look ahead for Coming Up" Value="AdBreak.Lookahead" Placeholder="12h"
                                   ValueChanged="v => { AdBreak.Lookahead = v; Notify(); }" />
                </div>

                <h3>Ads</h3>
                <div class="grid grid-2">
                    <DurationInput Label="Shortest ad" Value="Commercials.MinItemDuration"
                                   ValueChanged="v => { Commercials.MinItemDuration = v; NotifyTuning(); }" />
                    <DurationInput Label="Longest ad" Value="Commercials.MaxItemDuration"
                                   ValueChanged="v => { Commercials.MaxItemDuration = v; NotifyTuning(); }" />
                    <DurationInput Label="Tolerance" Value="Commercials.Tolerance" Placeholder="500ms"
                                   ValueChanged="v => { Commercials.Tolerance = v; NotifyTuning(); }" />
                    <label class="field">
                        <span>Same ad per break, at most</span>
                        <input type="number" min="1" value="@(Commercials.MaxRepeatsPerBreak?.ToString() ?? "")" placeholder="1"
                               @onchange="e => { Commercials.MaxRepeatsPerBreak = Int(e); NotifyTuning(); }" />
                    </label>
                </div>
                <label class="field">
                    <span>Only ads matching <span class="opt">(query)</span></span>
                    <input type="text" value="@Commercials.Filter" placeholder="duration <= 60"
                           @onchange="e => { Commercials.Filter = Text(e); NotifyTuning(); }" />
                </label>
                <label class="check">
                    <input type="checkbox" checked="@Commercials.IsStrictFit"
                           @onchange="e => { Commercials.StrictFit = e.Value is true ? null : false; NotifyTuning(); }" />
                    <span>Never cut an ad short (recommended)</span>
                </label>

                <h3>Filler</h3>
                <label class="check">
                    <input type="checkbox" checked="@Filler.IsTrimmable"
                           @onchange="e => { Filler.Trimmable = e.Value is true ? null : false; NotifyTuning(); }" />
                    <span>Cut filler off to land exactly on the next show</span>
                </label>
                <label class="check">
                    <input type="checkbox" checked="@(Filler.Loop ?? false)"
                           @onchange="e => { Filler.Loop = e.Value is true ? true : null; NotifyTuning(); }" />
                    <span>Loop filler to fill a long gap</span>
                </label>
                <label class="check">
                    <input type="checkbox" checked="@(Filler.StopBeforeEnd ?? false)"
                           @onchange="e => { Filler.StopBeforeEnd = e.Value is true ? true : null; NotifyTuning(); }" />
                    <span>Stop at the boundary rather than hard-cutting</span>
                </label>
                <DurationInput Label="Don't bother with filler shorter than" Value="Filler.MinTrimmedDuration"
                               ValueChanged="v => { Filler.MinTrimmedDuration = v; NotifyTuning(); }" />
            </details>
        </section>

        <section class="card">
            <div class="card-head"><h2>Promos</h2></div>
            @foreach (AdBreakPromoRoot promoRoot in AdBreak.PromoRoots.ToList())
            {
                <div class="ab-promo">
                    <div class="row">
                        <label class="check ab-promo-title">
                            <input type="checkbox" checked="@promoRoot.Enabled" @onchange="e => { promoRoot.Enabled = e.Value is true; Notify(); }" />
                            <strong>All promo types</strong>
                        </label>
                        <code class="ab-path" title="@promoRoot.Path">@ShortPath(promoRoot.Path)</code>
                        <div class="spacer"></div>
                        <button class="btn btn-sm btn-icon btn-danger" type="button" title="Remove" aria-label="Remove promo folder"
                                @onclick="() => { AdBreak.PromoRoots.Remove(promoRoot); Notify(); }"><Icon Name="trash" Size="13" /></button>
                    </div>
                    <p class="hint">
                        Sorted by show and type in either order (<code>Looney Tunes/Back To The Show</code> or
                        <code>Up Next/Top Cat</code>); each type is found by its folder's name.
                        @if (TypesIn(promoRoot.Path) is { Count: > 0 } found)
                        {
                            <text> Found: @string.Join(", ", found).</text>
                        }
                    </p>
                    <div class="check-row">
                        <label class="check">
                            <input type="checkbox" checked="@promoRoot.AnyShow" @onchange="e => { promoRoot.AnyShow = e.Value is true; Notify(); }" />
                            <span>Clips in no show's folder suit any show</span>
                        </label>
                        <label class="check">
                            <input type="checkbox" checked="@promoRoot.Times" @onchange="e => { promoRoot.Times = e.Value is true; Notify(); }" />
                            <span>Start time folders</span>
                        </label>
                        <label class="check">
                            <input type="checkbox" checked="@promoRoot.Days" @onchange="e => { promoRoot.Days = e.Value is true; Notify(); }" />
                            <span>Weekday folders</span>
                        </label>
                    </div>
                </div>
            }

            @if (AdBreak.Promos.Count == 0 && AdBreak.PromoRoots.Count == 0)
            {
                <p class="hint">
                    Set a folder of promos sorted by show and type (<code>Promos/Looney Tunes/Up Next</code>) to
                    <strong>Promos: all types</strong> in the tree, or a folder of one type to that type (Up Next, Now Playing,
                    This Has Been, You're Watching, Back To The Show, Coming Up, Later Today, Eventually).
                </p>
            }
            @foreach (AdBreakPromo promo in AdBreak.Promos.ToList())
            {
                <div class="ab-promo">
                    <div class="row">
                        <label class="check ab-promo-title">
                            <input type="checkbox" checked="@promo.Enabled" @onchange="e => { promo.Enabled = e.Value is true; Notify(); }" />
                            <strong>@AdBreakPromo.FolderName(promo.Type)</strong>
                        </label>
                        <code class="ab-path" title="@promo.Path">@ShortPath(promo.Path)</code>
                        <div class="spacer"></div>
                        <button class="btn btn-sm btn-icon btn-danger" type="button" title="Remove" aria-label="Remove promo"
                                @onclick="() => { AdBreak.Promos.Remove(promo); Notify(); }"><Icon Name="trash" Size="13" /></button>
                    </div>
                    <p class="hint">@Describe(promo.Type)</p>
                    <div class="check-row">
                        <label class="check">
                            <input type="checkbox" checked="@promo.PerShow" @onchange="e => { promo.PerShow = e.Value is true; Notify(); }" />
                            <span>Show folders</span>
                        </label>
                        <label class="check">
                            <input type="checkbox" checked="@promo.AnyShow" @onchange="e => { promo.AnyShow = e.Value is true; Notify(); }" />
                            <span>Other clips suit any show</span>
                        </label>
                        <label class="check">
                            <input type="checkbox" checked="@promo.Times" @onchange="e => { promo.Times = e.Value is true; Notify(); }" />
                            <span>Start time folders</span>
                        </label>
                        <label class="check">
                            <input type="checkbox" checked="@promo.Days" @onchange="e => { promo.Days = e.Value is true; Notify(); }" />
                            <span>Weekday folders</span>
                        </label>
                    </div>

                    @switch (promo.Type)
                    {
                        case AdPromoType.UpNext:
                            <label class="field">
                                <span>Plays</span>
                                <select value="@(promo.Placement ?? UpNextPlacement.AnyBreak)"
                                        @onchange="e => { promo.Placement = Enum.Parse<UpNextPlacement>(e.Value?.ToString() ?? nameof(UpNextPlacement.AnyBreak)); Notify(); }">
                                    <option value="@UpNextPlacement.AnyBreak">In any break of the show before, among the ads</option>
                                    <option value="@UpNextPlacement.BeforeShow">Last thing before the next show</option>
                                </select>
                            </label>
                            break;
                        case AdPromoType.ComingUp:
                        case AdPromoType.LaterToday:
                            <DurationInput Label="For a show starting within" Value="promo.Within"
                                           Placeholder="@DurationText.Format(AdBreakPromo.DefaultWithin(promo.Type))"
                                           ValueChanged="v => { promo.Within = v; Notify(); }" />
                            break;
                        case AdPromoType.Eventually:
                            <div class="grid grid-2">
                                <label class="field">
                                    <span>Chance a break has one (%)</span>
                                    <input type="number" min="0" max="100" step="5" value="@(promo.Chance is { } chance ? Math.Round(chance * 100).ToString() : "")" placeholder="25"
                                           @onchange="e => { promo.Chance = Int(e) is { } percent ? Math.Clamp(percent, 0, 100) / 100.0 : null; Notify(); }" />
                                </label>
                                <DurationInput Label="For a show airing within" Value="promo.Horizon" Placeholder="7d"
                                               ValueChanged="v => { promo.Horizon = v; Notify(); }" />
                            </div>
                            break;
                    }

                    @if (promo.Type is AdPromoType.UpNext or AdPromoType.NowPlaying or AdPromoType.ThisHasBeen)
                    {
                        <label class="check">
                            <input type="checkbox" checked="@(promo.SkipWhenSameSeries ?? true)"
                                   @onchange="e => { promo.SkipWhenSameSeries = e.Value is true ? null : false; Notify(); }" />
                            <span>Skip it when the same show is on either side of the break</span>
                        </label>
                    }
                </div>
            }
        </section>

        @if (AdBreak.TagRules is { } rules)
        {
            <section class="card">
                <div class="card-head">
                    <h2>Tag rules</h2>
                    <span class="muted">Moved from the older break and promo settings</span>
                </div>
                <p class="hint">
                    Clips picked by folder tag and query, the way breaks were filled before ad breaks. They're pooled with
                    the folders on the left. Once those folders cover the same clips, remove the rules.
                </p>
                @if (rules.Commercials is { } tagAds)
                {
                    <label class="check">
                        <input type="checkbox" checked="@(tagAds.AutoTemporalTags ?? false)"
                               @onchange="e => { tagAds.AutoTemporalTags = e.Value is true ? true : null; Notify(); }" />
                        <span>Match seasonal tags for ads (January, Winter, 12-25, Christmas…)</span>
                    </label>
                }
                @if (rules.Filler is { } tagFiller)
                {
                    <label class="check">
                        <input type="checkbox" checked="@(tagFiller.AutoTemporalTags ?? false)"
                               @onchange="e => { tagFiller.AutoTemporalTags = e.Value is true ? true : null; Notify(); }" />
                        <span>Match seasonal tags for filler</span>
                    </label>
                }
                <button class="btn btn-sm btn-danger" type="button" @onclick="RemoveTagRules">Remove tag rules</button>
            </section>

            @if (_tagBreaks is not null)
            {
                <InterstitialsEditor Interstitials="_tagBreaks" ShowShows="false" Changed="CommitTagBreaks" />
            }

            @if (rules.Promos is not null)
            {
                <PromoEditor Config="rules.Promos" Changed="Notify">
                    <BrandContent>
                        <BrandTagsEditor Values="rules.PromoBaseTags" ValuesChanged="SetPromoBrands" />
                    </BrandContent>
                </PromoEditor>
            }
        }

        @if (UsedBy.Count > 0)
        {
            <section class="card">
                <div class="card-head"><h2>Used by</h2></div>
                <div class="row row-wrap">
                    @foreach ((string label, string href) in UsedBy)
                    {
                        <a class="pill pill-muted" href="@href">@label</a>
                    }
                </div>
            </section>
        }
    </div>
</div>

<section class="card ab-glossary">
    <div class="card-head">
        <h2>Promo types</h2>
        <span class="muted">What each one is for, and where in a break it plays</span>
    </div>
    <div class="ab-glossary-grid">
        @foreach (PromoTypeInfo info in PromoTypeGuide)
        {
            <div class="ab-glossary-item">
                <div class="ab-glossary-head">
                    <strong>@AdBreakPromo.FolderName(info.Type)</strong>
                    <span class="pill pill-muted">@info.Where</span>
                </div>
                <p>@info.What</p>
                <p class="hint">@info.When</p>
            </div>
        }
    </div>
    <p class="hint">
        Name a folder after a type (any of these spellings work: "Up Next", "UpNext", "up_next") to have it found
        automatically inside a <strong>Promos: all types</strong> folder.
    </p>
</section>

@code {
    private sealed record PromoTypeInfo(AdPromoType Type, string Where, string What, string When);

    private static readonly PromoTypeInfo[] PromoTypeGuide =
    [
        new(AdPromoType.ThisHasBeen, "Opens the break after a show",
            "A sign-off for the show that just ended: \"This has been Looney Tunes.\"",
            "Plays once a show's slot is over, so a run of back-to-back episodes signs off once, not after every episode. Left out when the same show is on again next."),
        new(AdPromoType.YoureWatching, "Opens a mid-roll",
            "A reminder of what's on: \"You're watching Looney Tunes.\"",
            "Plays at the start of a break the same show comes back from: a mid-roll, or between two episodes in the same slot."),
        new(AdPromoType.ComingUp, "After the openers",
            "\"Coming up at 8:\" a show starting within a few hours (3 hours unless you change it).",
            "Plays in the break before a new show, after any interstitial shows. Time folders (8pm) are preferred when the show starts then."),
        new(AdPromoType.LaterToday, "After the openers",
            "\"Later today:\" a show starting further off the same day (12 hours unless you change it).",
            "Like Coming Up, for shows further away. Breaks carry a couple of these at most."),
        new(AdPromoType.Eventually, "Mixed in with the ads",
            "A trailer for a show airing later in the week.",
            "Now and then (a 25% chance per break unless you change it), only for shows this channel really airs. Weekday and time folders (Saturday/8pm) must match the airing."),
        new(AdPromoType.UpNext, "Among the ads, or last",
            "\"Up next: Looney Tunes,\" for the show that follows.",
            "In one of the breaks of the show before it (mid-rolls included), or as the last thing before the new show, whichever you pick. Left out when the same show continues."),
        new(AdPromoType.BackToTheShow, "Closes a mid-roll",
            "\"And now, back to Looney Tunes.\"",
            "Plays last in a break the same show comes back from, straight before it resumes."),
        new(AdPromoType.NowPlaying, "Closes the break before a show",
            "An ident for the show about to start: \"Now playing: Looney Tunes.\"",
            "The very last thing before a new show, after Up Next. Left out when the same show continues.")
    ];

    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public AdBreakConfig AdBreak { get; set; } = new();
    [Parameter] public IReadOnlyList<CommercialFolder> Roots { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }

    private readonly HashSet<string> _open = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<FolderSuggestion> _suggestions = [];
    private IReadOnlyList<string> _shows = [];
    private IReadOnlyList<CommercialFolder>? _openedFor;

    private TemporalTagOptions Temporal => Editor.Working.Settings.TemporalTags;

    private CommercialsConfig Commercials => AdBreak.Commercials ?? _commercials;
    private readonly CommercialsConfig _commercials = new();
    private FillerTierConfig Filler => AdBreak.Filler ?? _filler;
    private readonly FillerTierConfig _filler = new();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_openedFor, Roots))
        {
            // Roots, and the way down to every folder already in use, start open.
            _openedFor = Roots;
            foreach (CommercialFolder root in TreeRoots)
            {
                _open.Add(root.Path);
                foreach (CommercialFolder folder in root.Descendants())
                {
                    if (AdBreakFolderJobs.Explicit(AdBreak, folder.Path) is not null)
                    {
                        foreach (CommercialFolder ancestor in folder.Ancestors())
                        {
                            _open.Add(ancestor.Path);
                        }
                    }
                }
            }
        }

        _now = Clock.GetLocalNow();
        _shows = ExampleShows();
        SyncTagBreaks();
        Refresh();
    }

    private DateTimeOffset _now;

    private void Refresh() =>
        _suggestions = AdBreakFolderJobs.Suggest(AdBreak, Roots, within: TreeRoots.Count == 1 && AdBreak.Root is not null ? TreeRoots[0].Path : null, temporal: Temporal);

    private bool _pickingRoot;
    private bool _rootMissing;

    /// <summary>The ad break's own folder when it has one (and it's still there), else every commercials library.</summary>
    private IReadOnlyList<CommercialFolder> TreeRoots
    {
        get
        {
            _rootMissing = false;
            if (AdBreak.Root is not { } path)
            {
                return Roots;
            }

            foreach (CommercialFolder library in Roots)
            {
                if (library.Descendants().FirstOrDefault(folder => AdBreakPaths.Same(folder.Path, path)) is { } found)
                {
                    return [found];
                }
            }

            _rootMissing = Roots.Count > 0;
            return Roots;
        }
    }

    /// <summary>Folders given a job that lie outside the ad break's own folder.</summary>
    private List<string> Outside => AdBreak.Root is not { } root
        ? []
        :
        [
            .. AdBreak.Folders.Select(folder => folder.Path)
                .Concat(AdBreak.Promos.Select(promo => promo.Path))
                .Concat(AdBreak.PromoRoots.Select(promoRoot => promoRoot.Path))
                .Where(path => !AdBreakPaths.Same(path, root) && !AdBreakPaths.IsUnder(path, root))
                .Distinct(StringComparer.OrdinalIgnoreCase)
        ];

    private async Task SetRoot(CommercialFolder folder)
    {
        AdBreak.Root = folder.Path;
        _pickingRoot = false;

        // A new folder with no job of its own (or from above) plays as ads, as one picked when the ad break was made does.
        if (AdBreakFolderJobs.Explicit(AdBreak, folder.Path) is null && AdBreakFolderJobs.Inherited(AdBreak, folder) is null)
        {
            AdBreakFolderJobs.Set(AdBreak, folder.Path, "ads");
        }

        _open.Add(folder.Path);
        await Notify();
    }

    // The tag rules' pools, in the shape the tag-based breaks editor edits. Rebuilt only when the rules themselves change.
    private InterstitialsConfig? _tagBreaks;
    private AdBreakTagRules? _tagBreaksFor;

    private void SyncTagBreaks()
    {
        if (ReferenceEquals(_tagBreaksFor, AdBreak.TagRules))
        {
            return;
        }

        _tagBreaksFor = AdBreak.TagRules;
        _tagBreaks = AdBreak.TagRules is { } rules
            ? new InterstitialsConfig
            {
                Commercials = rules.Commercials ?? new CommercialsConfig(),
                Filler = rules.Filler ?? new FillerTierConfig { Fallback = false }
            }
            : null;
    }

    private Task CommitTagBreaks()
    {
        if (AdBreak.TagRules is { } rules && _tagBreaks is not null)
        {
            rules.Commercials = _tagBreaks.Commercials;
            rules.Filler = _tagBreaks.Filler is { IsEnabled: true } filler ? filler : null;
        }

        return Notify();
    }

    private Task SetPromoBrands(List<string>? brands)
    {
        if (AdBreak.TagRules is { } rules)
        {
            rules.PromoBaseTags = brands;
        }

        return Notify();
    }

    private Task RemoveTagRules()
    {
        AdBreak.TagRules = null;
        SyncTagBreaks();
        return Notify();
    }

    private async Task Notify()
    {
        Refresh();
        await Changed.InvokeAsync();
    }

    // The tuning sections are only kept once something in them is set, so an untouched ad break stays short in the YAML.
    private Task NotifyTuning()
    {
        AdBreak.Commercials ??= _commercials;
        AdBreak.Filler ??= _filler;
        return Notify();
    }

    private int Count(AdFolderRole role) => AdBreak.Folders.Count(folder => folder.Role == role);

    /// <summary>The promo types named by folders inside a folder, for a promo folder's summary.</summary>
    private List<string> TypesIn(string path) =>
    [
        .. Roots.SelectMany(library => library.Descendants())
            .Where(folder => AdBreakPaths.IsUnder(folder.Path, path))
            .Select(folder => AdBreakPromo.FromFolderName(folder.Name))
            .OfType<AdPromoType>()
            .Distinct()
            .Select(AdBreakPromo.FolderName)
    ];

    private void Toggle(CommercialFolder folder)
    {
        if (!_open.Remove(folder.Path))
        {
            _open.Add(folder.Path);
        }
    }

    private async Task SetJob(FolderPick pick)
    {
        AdBreakFolderJobs.Set(AdBreak, pick.Folder.Path, pick.Choice);
        if (pick.Choice.Length > 0)
        {
            _open.Add(pick.Folder.Path);
        }

        await Notify();
    }

    private async Task Apply(FolderSuggestion suggestion)
    {
        AdBreakFolderJobs.Set(AdBreak, suggestion.Path, suggestion.Choice);
        OpenTo(suggestion.Path);
        await Notify();
    }

    private async Task AddAllSuggestions()
    {
        // Applied one at a time: a folder made a promo folder stops a folder inside it being suggested too.
        for (int guard = 0; guard < 50 && _suggestions.Count > 0; guard++)
        {
            FolderSuggestion next = _suggestions[0];
            AdBreakFolderJobs.Set(AdBreak, next.Path, next.Choice);
            OpenTo(next.Path);
            Refresh();
        }

        await Notify();
    }

    private void OpenTo(string path)
    {
        foreach (CommercialFolder root in Roots)
        {
            if (root.Descendants().FirstOrDefault(folder => AdBreakPaths.Same(folder.Path, path)) is { } found)
            {
                _open.Add(found.Path);
                foreach (CommercialFolder ancestor in found.Ancestors())
                {
                    _open.Add(ancestor.Path);
                }
            }
        }
    }

    private static string Describe(AdPromoType type) => type switch
    {
        AdPromoType.UpNext => "\"Up next…\" for the show that follows.",
        AdPromoType.NowPlaying => "Ident for the show about to start, the last thing before it.",
        AdPromoType.ThisHasBeen => "Sign-off for the show that just finished, first in the break after it.",
        AdPromoType.YoureWatching => "Opens a break the same show comes back from.",
        AdPromoType.BackToTheShow => "Closes a break the same show comes back from.",
        AdPromoType.ComingUp => "For a show starting soon, after any interstitial shows.",
        AdPromoType.LaterToday => "For a show starting later today, after any interstitial shows.",
        AdPromoType.Eventually => "Trailers for a show airing later in the week, now and then among the ads.",
        _ => string.Empty
    };

    /// <summary>The last two folders of a path, which is usually enough to tell them apart.</summary>
    private static string ShortPath(string path)
    {
        string[] parts = AdBreakPaths.Key(path).Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length <= 2 ? string.Join('/', parts) : $"…/{parts[^2]}/{parts[^1]}";
    }

    /// <summary>Shows on the channels using this ad break (or any channel), for the example show folders.</summary>
    private IReadOnlyList<string> ExampleShows()
    {
        List<ChannelConfig> users = [.. Editor.Working.Channels.Where(channel => Uses(channel))];
        IEnumerable<ChannelConfig> source = users.Count > 0 ? users : Editor.Working.Channels;
        return [.. source.SelectMany(channel => FolderLayouts.ExampleShows(channel)).Distinct(StringComparer.OrdinalIgnoreCase).Take(3)];
    }

    private bool Uses(ChannelConfig channel) =>
        (channel.AdBreaks?.Contains(Name, StringComparer.OrdinalIgnoreCase) ?? false)
        || channel.Blocks.Any(block => block.AdBreaks?.Contains(Name, StringComparer.OrdinalIgnoreCase) ?? false);

    private List<(string Label, string Href)> UsedBy =>
    [
        .. Editor.Working.Channels
            .Where(Uses)
            .OrderBy(channel => channel.Number)
            .Select(channel => ($"{channel.Number} · {channel.Name}", $"channels/{Uri.EscapeDataString(channel.Id)}?tab=breaks"))
    ];

    private static string? Text(ChangeEventArgs e) =>
        string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim();

    private static int? Int(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out int value) ? value : null;
}
