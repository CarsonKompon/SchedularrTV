@* The right-click menu on the TV shows and Movies library lists: put the items in a collection or take them out, or
   open a show's intros and outros. Acts on the right-clicked item, or on the whole selection when one of the selected
   was clicked. *@

<ContextMenu X="X" Y="Y" Heading="@Heading" OnClose="OnClose" OnKeyDown="OnKey">
    <div class="ctx-item has-sub @(_open == AddMenu ? "open" : "") @(Addable.Count == 0 ? "disabled" : "")" role="menuitem"
         aria-haspopup="true" aria-expanded="@(_open == AddMenu ? "true" : "false")" aria-disabled="@(Addable.Count == 0 ? "true" : "false")"
         title="@(Addable.Count == 0 ? AddUnavailable : null)"
         tabindex="0" @onclick="() => Toggle(AddMenu, Addable.Count)" @onmouseenter="() => Hover(AddMenu, Addable.Count)">
        <Icon Name="plus" Size="14" />
        <span>Add to collection</span>
        <span class="ctx-caret" aria-hidden="true">›</span>

        @if (_open == AddMenu && Addable.Count > 0)
        {
            <div class="ctx-menu ctx-sub" role="menu" aria-label="Collections to add to" @onclick:stopPropagation="true">
                @foreach (string collection in Addable)
                {
                    <button class="ctx-item" type="button" role="menuitem" @onclick="() => Pick(OnAdd, collection)">
                        <span>@collection</span>
                    </button>
                }
            </div>
        }
    </div>

    <div class="ctx-item has-sub @(_open == RemoveMenu ? "open" : "") @(Collections.Count == 0 ? "disabled" : "")" role="menuitem"
         aria-haspopup="true" aria-expanded="@(_open == RemoveMenu ? "true" : "false")" aria-disabled="@(Collections.Count == 0 ? "true" : "false")"
         title="@(Collections.Count == 0 ? (Count == 1 ? "Not in any collection" : "None of these are in a collection") : null)"
         tabindex="0" @onclick="() => Toggle(RemoveMenu, Collections.Count)" @onmouseenter="() => Hover(RemoveMenu, Collections.Count)">
        <Icon Name="trash" Size="14" />
        <span>Remove from collection</span>
        <span class="ctx-caret" aria-hidden="true">›</span>

        @if (_open == RemoveMenu && Collections.Count > 0)
        {
            <div class="ctx-menu ctx-sub" role="menu" aria-label="Collections to remove from" @onclick:stopPropagation="true">
                @foreach (string collection in Collections)
                {
                    <button class="ctx-item" type="button" role="menuitem" @onclick="() => Pick(OnRemove, collection)">
                        <span>@collection</span>
                    </button>
                }
                <div class="ctx-sep" role="separator"></div>
                <button class="ctx-item danger" type="button" role="menuitem" @onclick="() => Pick(OnRemoveAll)">
                    <span>Remove from all</span>
                </button>
            </div>
        }
    </div>

    @if (OnIntros.HasDelegate)
    {
        <div class="ctx-sep" role="separator"></div>
        <button class="ctx-item" type="button" role="menuitem" disabled="@(Count != 1)" @onmouseenter="() => _open = null"
                title="@(Count == 1 ? null : "Pick one show to set its intros and outros")" @onclick="() => Pick(OnIntros)">
            <Icon Name="film" Size="14" />
            <span>Intros/outros…</span>
        </button>
    }
</ContextMenu>

@code {
    /// <summary>Where the right-click was, in the window (client coordinates).</summary>
    [Parameter, EditorRequired] public double X { get; set; }
    [Parameter, EditorRequired] public double Y { get; set; }

    /// <summary>What the menu acts on, as its heading says ("Rugrats", "3 shows").</summary>
    [Parameter, EditorRequired] public string Heading { get; set; } = "";

    /// <summary>How many items it acts on.</summary>
    [Parameter] public int Count { get; set; } = 1;

    /// <summary>The collections any of the items are in, to remove them from.</summary>
    [Parameter] public IReadOnlyList<string> Collections { get; set; } = [];

    /// <summary>The collections that don't yet hold all of the items, to add them to.</summary>
    [Parameter] public IReadOnlyList<string> Addable { get; set; } = [];

    /// <summary>Why nothing can be added (no collections, or they're in every one).</summary>
    [Parameter] public string AddUnavailable { get; set; } = "Already in every collection";

    [Parameter] public EventCallback<string> OnAdd { get; set; }
    [Parameter] public EventCallback<string> OnRemove { get; set; }
    [Parameter] public EventCallback OnRemoveAll { get; set; }

    /// <summary>Opens the show's intros and outros; leave unset where there are none (movies).</summary>
    [Parameter] public EventCallback OnIntros { get; set; }

    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }

    private const string AddMenu = "add";
    private const string RemoveMenu = "remove";

    private string? _open;

    private void Toggle(string menu, int entries) => _open = _open == menu || entries == 0 ? null : menu;

    private void Hover(string menu, int entries) => _open = entries > 0 ? menu : null;

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft")
        {
            _open = null;
        }
        else if (e.Key == "ArrowRight" && _open is null)
        {
            _open = Addable.Count > 0 ? AddMenu : Collections.Count > 0 ? RemoveMenu : null;
        }
    }

    // The action runs before the menu closes, so the page still knows what it was opened on.
    private async Task Pick(EventCallback action)
    {
        await action.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    private async Task Pick(EventCallback<string> action, string value)
    {
        await action.InvokeAsync(value);
        await OnClose.InvokeAsync();
    }
}
