@* The list of explicitly picked shows/movies inside a collection. *@
@inject LibraryBrowser Library
@inject ConfigEditor Editor

<div class="field">
    <span style="display:block;font-size:12px;color:var(--muted);margin-bottom:6px;">
        Titles (@Includes.Count)
    </span>

    @if (Includes.Count == 0)
    {
        <div class="empty" style="padding:14px;">
            Nothing picked yet. Add titles from the TV Shows or Movies pages, or add one below.
        </div>
    }

    @foreach (ContentInclude include in Includes)
    {
        <div class="list-row">
            <Artwork Id="@ArtId(include)" Title="@(include.Show ?? include.Describe())" Class="art-sm" Width="80" />
            <div style="flex:1;min-width:0;">
                <div class="title">@include.Describe()</div>
                @if (!string.IsNullOrWhiteSpace(include.Show))
                {
                    <div class="meta">
                        @if (include.IsWholeShow)
                        {
                            <span>all seasons</span>
                        }
                        else if (include.Episodes.Count > 0)
                        {
                            <span>@include.Episodes.Count episode(s)</span>
                        }
                        else if (include.Seasons.Count > 0)
                        {
                            <span>@include.Seasons.Count season(s)</span>
                        }
                        else
                        {
                            <span title="Seasons added later are included">all but @include.ExcludeSeasons.Count season(s)</span>
                        }

                        @if (Find(include) is { VersionedEpisodes: > 0 } versioned)
                        {
                            <span class="pill pill-warn" title="@versioned.VersionHint">@versioned.VersionedEpisodes with versions</span>
                        }

                        @if (include.Timeslots.Count > 0)
                        {
                            <span class="pill pill-accent" title="Only considered at these times">
                                <Icon Name="clock" Size="12" />@(string.Join("; ", include.Timeslots.Select(slot => slot.Describe())))
                            </span>
                        }

                        @if (BlockCount(include) is > 0 and var blocks)
                        {
                            <span class="pill pill-ok" title="Intro and outro blocks">
                                @blocks block(s)@(include.Bumpers.Count > 0 ? ", this collection" : "")
                            </span>
                        }
                    </div>
                }
            </div>
            <label class="inline-field" title="Overrides the collection's episode order for this title">
                <span>Order</span>
                <select value="@(include.Order?.ToString() ?? "")"
                        @onchange="e => SetOrder(include, e)">
                    <option value="">Collection default</option>
                    @foreach (PlaybackOrder option in Enum.GetValues<PlaybackOrder>())
                    {
                        <option value="@option">@SelectorEditor.Describe(option)</option>
                    }
                </select>
            </label>

            <label class="inline-field" title="Turns per rotation; 2 plays twice as often as 1">
                <span>Weight</span>
                <input type="number" min="1" max="20" style="width:62px;"
                       value="@(include.Weight?.ToString() ?? "")" placeholder="1"
                       @onchange="e => SetWeight(include, e)" />
            </label>

            @if (include.Order == PlaybackOrder.Drop || include.Drop is not null)
            {
                <button class="btn btn-sm" title="@(include.Drop?.Describe() ?? "Uses the collection's drop schedule")"
                        @onclick="() => _dropFor = include">Drops…</button>
            }
            @if (!string.IsNullOrWhiteSpace(include.Show))
            {
                <button class="btn btn-sm" @onclick="() => EditBumpers(include)">Intros/outros…</button>
                <button class="btn btn-sm" @onclick="() => Edit(include)">Seasons…</button>
            }
            @if (!string.IsNullOrWhiteSpace(include.Show) || !string.IsNullOrWhiteSpace(include.Movie))
            {
                <button class="btn btn-sm" title="When this title may be scheduled" @onclick="() => OpenSlots(include)">Timeslots…</button>
            }
            <button class="btn btn-sm btn-danger" @onclick="() => Remove(include)">Remove</button>
        </div>
    }

    <div class="row include-add-row" style="margin-top:8px;">
        <select class="include-add-kind" @onchange="OnPickerChanged" value="@_pickerKind">
            <option value="show">Show</option>
            <option value="movie">Movie</option>
            @if (_hasCollections || _pickerKind == CollectionKind)
            {
                <option value="collection">Collection from your library</option>
            }
        </select>
        @* Picking a suggestion adds it straight away; a name typed out is added with the button (or Enter). *@
        <TitlePicker @key="_pickerKind" Class="include-add-picker" Options="_options" Value="@_pending" ValueChanged="v => _pending = v" OnPicked="AddPicked"
                     Thumbnails="@(_pickerKind != CollectionKind)" AriaLabel="@($"Add a {_pickerKind}")"
                     Placeholder="@(_pickerKind == CollectionKind ? SearchCollections : SearchTitles)" />
        <button class="btn btn-sm" @onclick="Add">Add</button>
    </div>
</div>

<style>
    /* Kind of title on a third, the search on two thirds; selects are width:100% by default, which would squeeze the search. */
    .include-add-row > .include-add-kind { flex: 1 1 0; width: auto; min-width: 0; }
    .include-add-row > .title-picker.include-add-picker { flex: 2 1 0; }
    .include-add-row > .btn { flex: none; }
</style>

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="() => _editing = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2 style="margin-top:0;">@_editing.Show</h2>
            <p class="hint">Leave everything unticked to include the whole show.</p>

            <div class="row" style="align-items:center;gap:12px;">
                <h3 style="margin:0;">Seasons</h3>
                <label class="inline-field" title="Excluding keeps seasons added to the library later in the rotation">
                    <span>Ticked seasons are</span>
                    <select value="@(_excludeSeasons ? "exclude" : "include")" @onchange="SetSeasonMode">
                        <option value="include">the only ones played</option>
                        <option value="exclude">left out</option>
                    </select>
                </label>
            </div>
            <p class="hint" style="margin-top:4px;">
                @if (_excludeSeasons)
                {
                    <text>Every other season plays, including seasons added to the library later.</text>
                }
                else
                {
                    <text>Only these play; a season added to the library later has to be ticked here before it does.</text>
                }
            </p>
            <div class="row row-wrap">
                @foreach (int season in _editSeasons)
                {
                    <label class="check" style="margin-right:12px;">
                        <input type="checkbox" checked="@(SeasonList.Contains(season))"
                               @onchange="e => ToggleSeason(season, (bool)(e.Value ?? false))" />
                        <span>@(season == 0 ? "Specials" : $"Season {season}")</span>
                    </label>
                }
            </div>
            @if (_editing.Episodes.Count > 0 && SeasonList.Count > 0)
            {
                <p class="hint warn">Individual episodes are picked below, so they're what plays; the seasons here are ignored until they're cleared.</p>
            }

            <h3>Individual episodes</h3>
            <div class="scroll-list" style="max-height:220px;">
                <table>
                    @foreach (LibraryEpisode episode in _editEpisodes)
                    {
                        <tr>
                            <td style="width:34px;">
                                <input type="checkbox" checked="@_editing.Episodes.Contains(episode.Code)"
                                       @onchange="e => ToggleEpisode(episode.Code, (bool)(e.Value ?? false))" />
                            </td>
                            <td style="width:70px;color:var(--muted);">@episode.Code</td>
                            <td>@episode.Title</td>
                        </tr>
                    }
                </table>
            </div>

            <div class="row" style="margin-top:16px;">
                <div class="spacer"></div>
                <button class="btn btn-primary" @onclick="CloseEdit">Done</button>
            </div>
        </div>
    </div>
}

@if (_slotsFor is not null)
{
    <div class="modal-backdrop" @onclick="() => _slotsFor = null">
        <div class="modal" role="dialog" aria-modal="true" aria-label="Timeslots" @onclick:stopPropagation="true">
            <div class="row" style="align-items:center;gap:12px;margin-bottom:8px;">
                <h2 style="margin:0;">@_slotsFor.Describe() &mdash; timeslots</h2>
                <div class="spacer"></div>
                <div class="segmented" aria-label="Timeslot mode">
                    <button type="button" class="@(_slotsAdvanced ? "" : "on")" aria-pressed="@(_slotsAdvanced ? "false" : "true")" @onclick="() => SetSlotsAdvanced(false)">Simple</button>
                    <button type="button" class="@(_slotsAdvanced ? "on" : "")" aria-pressed="@(_slotsAdvanced ? "true" : "false")" @onclick="() => SetSlotsAdvanced(true)">Per day</button>
                </div>
            </div>
            <p class="hint">
                The only times this title is considered when the schedule is planned, in the channel's time zone. It isn't
                guaranteed to air then; the collection's other titles fill the rest of the time. Leave everything empty for any time.
            </p>

            @if (!_slotsAdvanced)
            {
                <div class="check-row" role="group" aria-label="Days">
                    @foreach (DayOfWeek day in Week)
                    {
                        <label class="check">
                            <input type="checkbox" checked="@_slotDays[(int)day]" @onchange="e => _slotDays[(int)day] = e.Value is true" />
                            <span>@day</span>
                        </label>
                    }
                </div>
                <div class="grid grid-2" style="margin-top:8px;">
                    <label class="field"><span>From <span class="opt">(optional)</span></span>
                        <input type="time" value="@Hm(_slotStart[0])" @onchange="e => _slotStart[0] = ParseTime(e)" /></label>
                    <label class="field"><span>Until <span class="opt">(optional)</span></span>
                        <input type="time" value="@Hm(_slotEnd[0])" @onchange="e => _slotEnd[0] = ParseTime(e)" /></label>
                </div>
                <p class="hint">No days ticked with times set means those times every day. An end before the start runs past midnight.</p>
            }
            else
            {
                <table class="media-table">
                    <thead><tr><th>Day</th><th>From</th><th>Until</th></tr></thead>
                    <tbody>
                        @foreach (DayOfWeek day in Week)
                        {
                            int index = (int)day;
                            <tr>
                                <td><label class="check"><input type="checkbox" checked="@_slotDays[index]" @onchange="e => _slotDays[index] = e.Value is true" /><span>@day</span></label></td>
                                <td><input type="time" disabled="@(!_slotDays[index])" value="@Hm(_slotStart[index])" @onchange="e => _slotStart[index] = ParseTime(e)" /></td>
                                <td><input type="time" disabled="@(!_slotDays[index])" value="@Hm(_slotEnd[index])" @onchange="e => _slotEnd[index] = ParseTime(e)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="hint">Unticked days it isn't considered at all. Empty times mean the whole day; an end before the start runs past midnight.</p>
            }

            <div class="row" style="margin-top:16px;gap:8px;">
                <button class="btn btn-ghost" type="button" @onclick="ClearSlots">Any time</button>
                <div class="spacer"></div>
                <button class="btn btn-ghost" type="button" @onclick="() => _slotsFor = null">Cancel</button>
                <button class="btn btn-primary" type="button" @onclick="SaveSlots">Done</button>
            </div>
        </div>
    </div>
}

@if (_dropFor is not null)
{
    <div class="modal-backdrop" @onclick="() => _dropFor = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2 style="margin-top:0;">@_dropFor.Describe() &mdash; drops</h2>
            <label class="check">
                <input type="checkbox" checked="@(_dropFor.Drop is not null)" @onchange="OnOwnDropChanged" />
                <span>Give this title its own drop schedule</span>
            </label>
            @if (_dropFor.Drop is { } ownDrop)
            {
                <DropEditor Drop="ownDrop" ShowTime="true" Changed="Changed" />
            }
            else
            {
                <p class="hint">Uses the collection's drop schedule (one episode every Friday when the collection sets none), at the show's normal airings.</p>
            }
            <div class="row" style="margin-top:16px;">
                <div class="spacer"></div>
                <button class="btn btn-primary" @onclick="() => _dropFor = null">Done</button>
            </div>
        </div>
    </div>
}

@if (_bumpersFor is not null)
{
    <BumperEditor Include="_bumpersFor" Changed="Changed" OnClose="() => _bumpersFor = null" />
}

@code {
    /// <summary>The library has collections (Jellyfin's BoxSets, local movies' sets…), so they can be picked.</summary>
    private bool _hasCollections;

    [Parameter, EditorRequired] public List<ContentInclude> Includes { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }

    private const string CollectionKind = "collection";
    private const string SearchTitles = "Type a name to search the library…";
    private const string SearchCollections = "Type a collection name…";

    private Task AddPicked(string name)
    {
        _pending = name;
        return Add();
    }

    private string _pickerKind = "show";
    private string _pending = "";
    private List<string> _options = [];

    private ContentInclude? _editing;
    private IReadOnlyList<int> _editSeasons = [];
    private IReadOnlyList<LibraryEpisode> _editEpisodes = [];

    private ContentInclude? _bumpersFor;

    private void EditBumpers(ContentInclude include) => _bumpersFor = include;

    private ContentInclude? _dropFor;

    private async Task OnOwnDropChanged(ChangeEventArgs e)
    {
        if (_dropFor is null) return;
        _dropFor.Drop = (bool)(e.Value ?? false) ? _dropFor.Drop ?? new DropConfig() : null;
        await Changed.InvokeAsync();
    }

    private int BlockCount(ContentInclude include) =>
        include.Bumpers.Count > 0
            ? include.Bumpers.Count
            : include.Show is { Length: > 0 } show && Editor.Working.Titles.TryGetValue(show, out TitleDefaults? d)
                ? d.Bumpers.Count
                : 0;

    private Dictionary<string, LibraryShow> _showsById = new(StringComparer.Ordinal);
    private Dictionary<string, LibraryShow> _showsByName = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string?> _movieIds = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        IReadOnlyList<LibraryShow> shows = await Library.GetShowsAsync();
        _hasCollections = (await Library.GetLibraryCollectionsAsync()).Count > 0;

        _showsById = shows.ToDictionary(s => s.Id, s => s, StringComparer.Ordinal);

        // Two series can share a name; the first is only used when an entry has no pinned id.
        _showsByName = shows
            .GroupBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        _movieIds = (await Library.GetMoviesAsync())
            .DistinctBy(m => m.Title, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(m => m.Title, m => m.Id, StringComparer.OrdinalIgnoreCase);

        await LoadOptions();
    }

    private string? ArtId(ContentInclude include) =>
        include.ShowId is { Length: > 0 } id ? id
        : Find(include)?.Id
        ?? (include.Movie is { Length: > 0 } movie ? _movieIds.GetValueOrDefault(movie) : null);

    private LibraryShow? Find(ContentInclude include)
    {
        if (!string.IsNullOrWhiteSpace(include.ShowId) && _showsById.TryGetValue(include.ShowId, out LibraryShow? byId))
        {
            return byId;
        }

        return include.Show is { Length: > 0 } name && _showsByName.TryGetValue(name, out LibraryShow? byName)
            ? byName
            : null;
    }

    private async Task OnPickerChanged(ChangeEventArgs e)
    {
        _pickerKind = e.Value?.ToString() ?? "show";
        _pending = "";
        await LoadOptions();
    }

    private async Task LoadOptions() => _options = _pickerKind switch
    {
        "movie" => (await Library.GetMoviesAsync()).Select(m => m.Title).ToList(),
        "collection" => (await Library.GetLibraryCollectionsAsync()).ToList(),
        _ => (await Library.GetShowsAsync()).Select(s => s.Name).ToList()
    };

    private async Task Add()
    {
        string value = _pending.Trim();
        if (value.Length == 0)
        {
            return;
        }

        Includes.Add(_pickerKind switch
        {
            "movie" => new ContentInclude { Movie = value },
            "collection" => new ContentInclude { Collection = value },
            _ => new ContentInclude { Show = value }
        });

        _pending = "";
        await Changed.InvokeAsync();
    }

    private async Task Remove(ContentInclude include)
    {
        Includes.Remove(include);
        await Changed.InvokeAsync();
    }

    private async Task SetOrder(ContentInclude include, ChangeEventArgs e)
    {
        string value = e.Value?.ToString() ?? "";
        include.Order = value.Length == 0 ? null : Enum.Parse<PlaybackOrder>(value);
        if (include.Order == PlaybackOrder.Drop && include.Drop is null)
        {
            _dropFor = include;
        }
        await Changed.InvokeAsync();
    }

    private async Task SetWeight(ContentInclude include, ChangeEventArgs e)
    {
        include.Weight = int.TryParse(e.Value?.ToString(), out int weight) && weight > 1 ? weight : null;
        await Changed.InvokeAsync();
    }

    // ---- Timeslots ----

    private static readonly DayOfWeek[] Week =
        [DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday];

    private ContentInclude? _slotsFor;
    private bool _slotsAdvanced;
    // By day of week (Sunday = 0). In simple mode only index 0 of the times is used, for every ticked day.
    private readonly bool[] _slotDays = new bool[7];
    private readonly TimeSpan?[] _slotStart = new TimeSpan?[7];
    private readonly TimeSpan?[] _slotEnd = new TimeSpan?[7];

    private void OpenSlots(ContentInclude include)
    {
        _slotsFor = include;
        Array.Clear(_slotDays);
        Array.Clear(_slotStart);
        Array.Clear(_slotEnd);

        // One slot is the simple form (days and times); several (each with its own times) is per day.
        _slotsAdvanced = include.Timeslots.Count > 1;
        if (!_slotsAdvanced && include.Timeslots.FirstOrDefault() is { } slot)
        {
            foreach (DayOfWeek day in slot.Days) _slotDays[(int)day] = true;
            _slotStart[0] = slot.Start;
            _slotEnd[0] = slot.End;
        }
        else
        {
            foreach (TitleTimeslot each in include.Timeslots)
            {
                IEnumerable<DayOfWeek> days = each.Days.Count == 0 ? Week : each.Days;
                foreach (DayOfWeek day in days)
                {
                    _slotDays[(int)day] = true;
                    _slotStart[(int)day] = each.Start;
                    _slotEnd[(int)day] = each.End;
                }
            }
        }
    }

    /// <summary>Switches between the simple and per-day forms, carrying the days and times across.</summary>
    private void SetSlotsAdvanced(bool advanced)
    {
        if (advanced == _slotsAdvanced) return;
        if (advanced)
        {
            // The simple form's times for each of its days (every day, when times are set but no day is ticked).
            bool everyDay = !_slotDays.Any(on => on) && (_slotStart[0] is not null || _slotEnd[0] is not null);
            TimeSpan? start = _slotStart[0], end = _slotEnd[0];
            for (int day = 0; day < 7; day++)
            {
                _slotDays[day] |= everyDay;
                _slotStart[day] = _slotDays[day] ? start : null;
                _slotEnd[day] = _slotDays[day] ? end : null;
            }
        }
        else
        {
            // One set of times for all the ticked days: the first ticked day's.
            int first = Array.FindIndex(_slotDays, on => on);
            TimeSpan? start = first >= 0 ? _slotStart[first] : null, end = first >= 0 ? _slotEnd[first] : null;
            Array.Clear(_slotStart);
            Array.Clear(_slotEnd);
            _slotStart[0] = start;
            _slotEnd[0] = end;
        }

        _slotsAdvanced = advanced;
    }

    private void ClearSlots()
    {
        Array.Clear(_slotDays);
        Array.Clear(_slotStart);
        Array.Clear(_slotEnd);
    }

    private async Task SaveSlots()
    {
        if (_slotsFor is null) return;
        List<TitleTimeslot> slots = [];
        if (_slotsAdvanced)
        {
            foreach (DayOfWeek day in Week.Where(day => _slotDays[(int)day]))
            {
                slots.Add(new TitleTimeslot { Days = [day], Start = _slotStart[(int)day], End = _slotEnd[(int)day] });
            }
        }
        else
        {
            List<DayOfWeek> days = [.. Week.Where(day => _slotDays[(int)day])];
            if (days.Count > 0 || _slotStart[0] is not null || _slotEnd[0] is not null)
            {
                // All seven ticked is the same as none: every day.
                slots.Add(new TitleTimeslot { Days = days.Count == 7 ? [] : days, Start = _slotStart[0], End = _slotEnd[0] });
            }
        }

        _slotsFor.Timeslots = slots;
        _slotsFor = null;
        await Changed.InvokeAsync();
    }

    private static string Hm(TimeSpan? time) => time is { } value ? $"{(int)value.TotalHours:00}:{value.Minutes:00}" : "";

    private static TimeSpan? ParseTime(ChangeEventArgs e) =>
        TimeSpan.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out TimeSpan time) && time > TimeSpan.Zero && time < TimeSpan.FromDays(1)
            ? time : null;

    /// <summary>The popup's ticked seasons are ones left out (<see cref="ContentInclude.ExcludeSeasons"/>) rather than the only ones played.</summary>
    private bool _excludeSeasons;

    private List<int> SeasonList => _editing is null ? [] : _excludeSeasons ? _editing.ExcludeSeasons : _editing.Seasons;

    /// <summary>Switches what ticking means, keeping what's ticked: the same seasons, now included or now left out.</summary>
    private void SetSeasonMode(ChangeEventArgs e)
    {
        if (_editing is null) return;
        bool exclude = e.Value?.ToString() == "exclude";
        if (exclude == _excludeSeasons) return;

        List<int> ticked = [.. SeasonList];
        _editing.Seasons.Clear();
        _editing.ExcludeSeasons.Clear();
        _excludeSeasons = exclude;
        SeasonList.AddRange(ticked);
    }

    private async Task Edit(ContentInclude include)
    {
        _editing = include;
        _excludeSeasons = include.Seasons.Count == 0 && include.ExcludeSeasons.Count > 0;

        // Episodes are kept by series id, not name: the show as this entry means it (its pinned id, else its name).
        LibraryShow? show = Find(include);
        _editSeasons = show?.Seasons ?? [];
        _editEpisodes = show is null ? [] : await Library.GetEpisodesAsync(show.Id);
    }

    private void ToggleSeason(int season, bool on)
    {
        if (_editing is null) return;
        List<int> seasons = SeasonList;
        if (on) { if (!seasons.Contains(season)) seasons.Add(season); } else { seasons.Remove(season); }
    }

    private void ToggleEpisode(string code, bool on)
    {
        if (_editing is null) return;
        if (on) { _editing.Episodes.Add(code); } else { _editing.Episodes.Remove(code); }
    }

    private async Task CloseEdit()
    {
        _editing = null;
        await Changed.InvokeAsync();
    }
}
