@* Clip blocks played around a title's episodes, laid out as a timeline. *@
@* Every running source that can list extras (Jellyfin, local folders, library plugins). *@
@inject IEnumerable<IExtrasSource> ExtrasSources
@inject LibraryBrowser Library
@inject ConfigEditor Editor

<div class="modal-backdrop" @onclick="Close">
    <div class="modal modal-wide" role="dialog" aria-label="@($"{Include.Show} intros and outros")" @onclick:stopPropagation="true">
        <div class="modal-head">
            <h2>@Include.Show &mdash; intros &amp; outros</h2>
            <div class="spacer"></div>
            <button class="btn btn-ghost btn-icon btn-sm" type="button" title="Close" aria-label="Close" @onclick="Close"><Icon Name="x" Size="16" /></button>
        </div>

        <p class="hint">
            Clips that play before and after each episode. Group them into blocks: a block holds a few clips and
            picks one each time it plays.
        </p>

        @if (ShowWide)
        {
            <div class="banner">
                These play wherever the show is scheduled. A collection can give the show its own blocks instead
                (from the collection's <strong>Intros/outros…</strong>).
                @if (OverriddenIn.Count > 0)
                {
                    <text> Right now @string.Join(", ", OverriddenIn) @(OverriddenIn.Count == 1 ? "does" : "do"), so these don't play there.</text>
                }
            </div>
        }
        else
        {
            <div class="segmented" role="radiogroup" aria-label="Where these blocks apply" style="margin-bottom:6px;">
                <button type="button" role="radio" aria-checked="@(!IsOverride)" class="@(!IsOverride ? "on" : "")" @onclick="() => SetScope(false)">Everywhere this show plays</button>
                <button type="button" role="radio" aria-checked="@IsOverride" class="@(IsOverride ? "on" : "")" @onclick="() => SetScope(true)">Only in this collection</button>
            </div>
            <p class="hint">
                @(IsOverride
                    ? "These blocks replace the show's own for this collection only."
                    : "Editing these changes the show wherever it is scheduled.")
            </p>
        }

        <div class="bumper-timeline" aria-label="Playback order">
            @foreach (BumperBlock block in Ordered(BumperPosition.Intro))
            {
                <div class="bumper-chip">
                    <div class="bumper-chip-name">@Label(block)</div>
                    <div class="bumper-chip-meta">@Summarise(block)</div>
                </div>
            }

            <div class="bumper-chip bumper-chip-episode">
                <div class="bumper-chip-name">Episode</div>
                <div class="bumper-chip-meta">@(Include.Show ?? "the programme")</div>
            </div>

            @foreach (BumperBlock block in Ordered(BumperPosition.Outro))
            {
                <div class="bumper-chip">
                    <div class="bumper-chip-name">@Label(block)</div>
                    <div class="bumper-chip-meta">@Summarise(block)</div>
                </div>
            }
        </div>

        @if (_error is not null)
        {
            <div class="banner banner-warn">@_error</div>
        }

        @foreach (BumperPosition position in (BumperPosition[])[BumperPosition.Intro, BumperPosition.Outro])
        {
            <div class="section-title" style="margin:22px 0 10px;">
                <h2>@(position == BumperPosition.Intro ? "Before the episode" : "After the episode")</h2>
                <div class="spacer"></div>
                <button class="btn btn-sm" type="button" @onclick="() => AddBlock(position)"><Icon Name="plus" Size="14" />Add block</button>
            </div>

            @if (!Ordered(position).Any())
            {
                <div class="empty" style="padding:22px;">
                    Nothing plays @(position == BumperPosition.Intro ? "before" : "after") the episode yet.
                </div>
            }

            @foreach (BumperBlock block in Ordered(position))
            {
                <div class="bumper-block">
                    <div class="row">
                        <input type="text" class="bumper-name" aria-label="Block name" placeholder="Block name, e.g. Opening theme" value="@block.Name"
                               @onchange="e => Rename(block, e)" />
                        <div class="spacer"></div>
                        <button class="btn btn-sm btn-ghost btn-icon" type="button" title="Move up" aria-label="Move up" disabled="@IsFirst(block)" @onclick="() => Move(block, -1)">↑</button>
                        <button class="btn btn-sm btn-ghost btn-icon" type="button" title="Move down" aria-label="Move down" disabled="@IsLast(block)" @onclick="() => Move(block, 1)">↓</button>
                        <button class="btn btn-sm btn-ghost btn-icon btn-danger" type="button" title="Remove block" aria-label="Remove block" @onclick="() => RemoveBlock(block)"><Icon Name="trash" Size="14" /></button>
                    </div>

                    @if (block.Clips.Count == 0)
                    {
                        <div class="bumper-empty">
                            <span class="muted">No clips yet.</span>
                            <button class="btn btn-sm btn-primary" type="button" @onclick="() => OpenAdd(block)"><Icon Name="plus" Size="14" />Add clips</button>
                        </div>
                    }
                    else
                    {
                        <ul class="bumper-clips">
                            @foreach (BumperClip clip in block.Clips.ToList())
                            {
                                <li>
                                    <Icon Name="film" Size="15" />
                                    <span class="bumper-clip-name" title="@clip.Path">@ClipName(clip)</span>
                                    <span class="meta">@LengthOf(clip)</span>
                                    <div class="spacer"></div>
                                    <button class="pill @(clip.Episodes.Count == 0 ? "pill-muted" : "pill-ok") bumper-pin" type="button"
                                            title="Choose which episodes this clip plays with" @onclick="() => PinTo(block, clip)">
                                        @(clip.Episodes.Count == 0 ? "Any episode" : string.Join(", ", clip.Episodes))
                                    </button>
                                    <button class="btn btn-sm btn-ghost btn-icon" type="button" title="Remove clip" aria-label="Remove clip" @onclick="() => RemoveClip(block, clip)"><Icon Name="x" Size="14" /></button>
                                </li>
                            }
                        </ul>
                        <button class="btn btn-sm" type="button" @onclick="() => OpenAdd(block)"><Icon Name="plus" Size="14" />Add clips</button>
                    }

                    <details class="bumper-options">
                        <summary>
                            Options
                            <span class="meta">· @(block.Clips.Count > 1 ? Describe(block.Selection) : "One clip")
                                · @(block.Seasons.Count == 0 ? "all seasons" : "seasons " + string.Join(", ", block.Seasons.Order()))
                                @(block.SkipWhenFileContains.Count > 0 ? "· skip rules" : "")</span>
                        </summary>

                        <div class="grid grid-2" style="margin-top:12px;">
                            <label class="field">
                                <span>When there are several clips, play</span>
                                <select value="@block.Selection" @onchange="e => SetSelection(block, e)">
                                    @foreach (BumperSelection option in Enum.GetValues<BumperSelection>())
                                    {
                                        <option value="@option">@Describe(option)</option>
                                    }
                                </select>
                            </label>
                        </div>

                        <fieldset class="bumper-seasons" aria-label="Seasons for @Label(block)">
                            <legend>Only play in <span class="opt">(none ticked = every season)</span></legend>
                            <div class="check-row">
                                @foreach (int season in _seasons.Concat(block.Seasons).Distinct().Order())
                                {
                                    <label class="check">
                                        <input type="checkbox" checked="@block.Seasons.Contains(season)"
                                               @onchange="args => ToggleSeason(block, season, args.Value is true)" />
                                        <span>@(season == 0 ? "Specials" : $"Season {season}")</span>
                                    </label>
                                }
                            </div>
                        </fieldset>

                        <TagListEditor Label="Skip this block when the episode's file name contains"
                                       Placeholder="(with Intro)"
                                       Values="block.SkipWhenFileContains" Changed="Changed" />
                        <p class="hint">
                            For copies that already have the sequence baked in. Case does not matter.
                        </p>
                    </details>
                </div>
            }
        }

        @if (_adding is { } target)
        {
            <div class="modal-backdrop" @onclick="CloseAdd">
                <div class="modal bumper-add" role="dialog" aria-label="Add clips" @onclick:stopPropagation="true">
                    <div class="modal-head">
                        <h2>Add clips to &ldquo;@Label(target)&rdquo;</h2>
                    </div>

                    <FilePathPicker Multiple="true" ButtonText="Browse files on disk…" Extensions="FileBrowsing.Videos" Label="clips"
                                    OnPicked="picked => AddFromDisk(target, picked)" />

                    <h3>From this show's extras</h3>

                    @if (_extras is null)
                    {
                        <p class="hint">@(_error is null ? "Loading extras…" : "Extras aren't available. Browse files on disk instead.")</p>
                    }
                    else
                    {
                        List<ExtraClip> available = [.. _extras.Where(x => !target.Clips.Any(c => SamePath(c.Path, x.Path)))];
                        List<ExtraClip> shown = [.. available.Where(x => string.IsNullOrWhiteSpace(_filter) || x.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase))];

                        @if (_extras.Count == 0)
                        {
                            <div class="empty" style="padding:22px;">@NoExtras</div>
                        }
                        else if (available.Count == 0)
                        {
                            <div class="empty" style="padding:22px;">Every extra is already in this block.</div>
                        }
                        else
                        {
                            <div class="row" style="margin-bottom:8px;">
                                <div class="search-field" style="max-width:none;">
                                    <Icon Name="search" Size="15" />
                                    <input type="text" placeholder="Filter extras" aria-label="Filter extras" value="@_filter" @oninput="e => _filter = e.Value?.ToString()" />
                                </div>
                                <button class="btn btn-sm" type="button" disabled="@(shown.Count == 0)" @onclick="() => SelectShown(shown)">Select all</button>
                                <button class="btn btn-sm btn-ghost" type="button" disabled="@(_picked.Count == 0)" @onclick="() => _picked.Clear()">Clear</button>
                            </div>

                            <div class="scroll-list" style="max-height:300px;">
                                @foreach (ExtraClip extra in shown)
                                {
                                    <label class="check bumper-extra">
                                        <input type="checkbox" checked="@_picked.Contains(extra.Path)"
                                               @onchange="e => TogglePick(extra.Path, e.Value is true)" />
                                        <span>@extra.Name</span>
                                        <span class="meta" style="margin-left:auto;">@($"{extra.Duration.TotalSeconds:0}s")</span>
                                    </label>
                                }
                                @if (shown.Count == 0)
                                {
                                    <div class="hint" style="padding:12px;">Nothing matches &ldquo;@_filter&rdquo;.</div>
                                }
                            </div>
                        }
                    }

                    <div class="wizard-foot">
                        <div class="spacer"></div>
                        <button class="btn" type="button" @onclick="CloseAdd">Cancel</button>
                        <button class="btn btn-primary" type="button" disabled="@(_picked.Count == 0)" @onclick="() => AddPicked(target)">
                            @(_picked.Count == 0 ? "Add extras" : $"Add {_picked.Count} {(_picked.Count == 1 ? "extra" : "extras")}")
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (_pinning is not null)
        {
            <div class="modal-backdrop" @onclick="() => _pinning = null">
                <div class="modal" role="dialog" aria-label="Episodes for this clip" @onclick:stopPropagation="true">
                    <div class="modal-head"><h2>Episodes for @ClipName(_pinning)</h2></div>
                    <p class="hint">Tick the episodes this clip is reserved for. Leave everything unticked to keep it in the general pool.</p>

                    @if (_episodes.Count == 0)
                    {
                        <div class="empty">No episodes found for this show.</div>
                    }
                    else
                    {
                        <div class="scroll-list" style="max-height:320px;">
                            @foreach (LibraryEpisode episode in _episodes)
                            {
                                <label class="check bumper-extra">
                                    <input type="checkbox" checked="@_pinning.Episodes.Contains(episode.Code)"
                                           @onchange="e => TogglePin(episode.Code, (bool)(e.Value ?? false))" />
                                    <span>@episode.Code <span class="meta">@episode.Title</span></span>
                                </label>
                            }
                        </div>
                    }

                    <div class="wizard-foot">
                        <button class="btn btn-ghost btn-sm" type="button" disabled="@(_pinning.Episodes.Count == 0)" @onclick="ClearPins">Clear</button>
                        <div class="spacer"></div>
                        <button class="btn btn-primary" type="button" @onclick="() => _pinning = null">Done</button>
                    </div>
                </div>
            </div>
        }

        <div class="wizard-foot">
            <div class="spacer"></div>
            <button class="btn btn-primary" type="button" @onclick="Close">Done</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ContentInclude Include { get; set; } = new();
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Opened from the TV Shows page: edits only the show's own blocks, with no collection to override them in.</summary>
    [Parameter] public bool ShowWide { get; set; }

    // Collections whose own blocks replace the show's, named so the TV Shows page can say where these don't apply.
    private List<string> OverriddenIn => [.. Editor.Working.GlobalCollections
        .Where(pair => pair.Value.Include.Any(include => include.Bumpers.Count > 0
            && string.Equals(include.Show, Include.Show, StringComparison.OrdinalIgnoreCase)))
        .Select(pair => pair.Key)];

    /// <summary>One of the show's extras, from Jellyfin or from its local folder.</summary>
    private sealed record ExtraClip(string Name, string Path, TimeSpan Duration);

    private IReadOnlyList<ExtraClip>? _extras;
    /// <summary>Whether a running source owns the show, so its having no extras is an answer rather than a gap.</summary>
    private bool _owned;

    private string NoExtras => _owned
        ? "This show has no extras (for a local show: videos in an Extras, Trailers or Featurettes folder, or named like Show-trailer.mkv). Browse files on disk instead."
        : "This show's extras can't be listed here: none of your media sources can say. Browse files on disk instead.";
    private IReadOnlyList<LibraryEpisode> _episodes = [];
    private IReadOnlyList<int> _seasons = [];
    private string? _seriesId;
    private BumperBlock? _adding;
    private readonly HashSet<string> _picked = new(StringComparer.OrdinalIgnoreCase);
    private string? _filter;
    private BumperClip? _pinning;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Resolved here rather than taken from the caller: the show list may still be loading
            // when the dialog opens, and a null id would otherwise stick for the whole session.
            IReadOnlyList<LibraryShow> shows = await Library.GetShowsAsync();

            LibraryShow? show = shows.FirstOrDefault(s =>
                (Include.ShowId is not null && string.Equals(s.Id, Include.ShowId, StringComparison.Ordinal))
                || string.Equals(s.Name, Include.Show, StringComparison.OrdinalIgnoreCase));

            if (show is null)
            {
                _error = "This title is not in the library, so its extras cannot be listed. You can still add files from disk.";
                return;
            }

            _seriesId = show.Id;
            _seasons = show.Seasons;
            _extras = await ExtrasAsync(show.Id);
        }
        catch (Exception ex)
        {
            _error = $"Could not read extras: {ex.Message}";
        }
    }

    /// <summary>The show's extras, from the running source that owns it (none, rather than an error, when no source does).</summary>
    private async Task<IReadOnlyList<ExtraClip>> ExtrasAsync(string showId)
    {
        if (ExtrasSources.FirstOrDefault(source => source.Owns(showId)) is not { } owner)
        {
            return [];
        }

        _owned = true;
        return [.. (await owner.GetExtrasAsync(showId)).Select(extra => new ExtraClip(extra.Name, extra.Path, extra.Duration))];
    }

    private IEnumerable<BumperBlock> Ordered(BumperPosition position) =>
        Blocks.Where(b => b.Position == position);

    /// <summary>Blocks named on the collection win; otherwise the show's own are edited in place.</summary>
    private bool IsOverride => !ShowWide && Include.Bumpers.Count > 0;

    private List<BumperBlock> Blocks =>
        IsOverride ? Include.Bumpers : Shared?.Bumpers ?? [];

    private TitleDefaults? Shared =>
        Include.Show is { Length: > 0 } show && Editor.Working.Titles.TryGetValue(show, out TitleDefaults? defaults)
            ? defaults
            : null;

    private List<BumperBlock> EnsureTarget()
    {
        if (IsOverride)
        {
            return Include.Bumpers;
        }

        string show = Include.Show ?? string.Empty;

        if (!Editor.Working.Titles.TryGetValue(show, out TitleDefaults? defaults))
        {
            defaults = new TitleDefaults();
            Editor.Working.Titles[show] = defaults;
        }

        return defaults.Bumpers;
    }

    private async Task SetScope(bool over)
    {
        if (over == IsOverride)
        {
            return;
        }

        string show = Include.Show ?? string.Empty;

        if (over)
        {
            // Start the override from whatever the show already does, so nothing silently changes.
            Include.Bumpers = [.. Blocks.Select(Copy)];
        }
        else
        {
            List<BumperBlock> moving = Include.Bumpers;
            Include.Bumpers = [];

            if (moving.Count > 0)
            {
                EnsureTarget().AddRange(moving);
            }
        }

        Prune(show);
        await Changed.InvokeAsync();
    }

    private static BumperBlock Copy(BumperBlock block) => new()
    {
        Name = block.Name,
        Position = block.Position,
        Selection = block.Selection,
        Seasons = [.. block.Seasons],
        SkipWhenFileContains = [.. block.SkipWhenFileContains],
        Clips = [.. block.Clips.Select(c => new BumperClip { Path = c.Path, Name = c.Name, Episodes = [.. c.Episodes] })]
    };

    // An empty entry would otherwise be written back to the config for every show ever opened.
    private void Prune(string show)
    {
        if (Editor.Working.Titles.TryGetValue(show, out TitleDefaults? defaults) && defaults.Bumpers.Count == 0)
        {
            Editor.Working.Titles.Remove(show);
        }
    }

    private static string Label(BumperBlock block) =>
        string.IsNullOrWhiteSpace(block.Name) ? "Untitled" : block.Name;

    private static string ClipName(BumperClip clip) =>
        string.IsNullOrWhiteSpace(clip.Name) ? System.IO.Path.GetFileNameWithoutExtension(clip.Path) : clip.Name!;

    private string Summarise(BumperBlock block) =>
        block.Clips.Count switch
        {
            0 => "no clips",
            1 => $"1 clip · {LengthOf(block.Clips[0])}",
            _ => $"{block.Clips.Count} clips · {Describe(block.Selection).ToLowerInvariant()}"
        };

    private static string Describe(BumperSelection selection) => selection switch
    {
        BumperSelection.LongestThatFits => "Longest that fits",
        BumperSelection.ShortestThatFits => "Shortest that fits",
        _ => "Random"
    };

    private string LengthOf(BumperClip clip)
    {
        ExtraClip? extra = _extras?.FirstOrDefault(x => SamePath(x.Path, clip.Path));
        return extra is null ? "—" : $"{extra.Duration.TotalSeconds:0}s";
    }

    // Jellyfin and the saved config can disagree on casing, and the engine matches paths the same way.
    private static bool SamePath(string? left, string? right) =>
        string.Equals(left, right, StringComparison.OrdinalIgnoreCase);

    private bool IsFirst(BumperBlock block) => Ordered(block.Position).First() == block;

    private bool IsLast(BumperBlock block) => Ordered(block.Position).Last() == block;

    private async Task AddBlock(BumperPosition position)
    {
        var block = new BumperBlock
        {
            Name = position == BumperPosition.Intro ? "Opening" : "Closing",
            Position = position
        };

        EnsureTarget().Add(block);
        await Changed.InvokeAsync();
    }

    private async Task RemoveBlock(BumperBlock block)
    {
        Blocks.Remove(block);

        if (_adding == block)
        {
            CloseAdd();
        }

        Prune(Include.Show ?? string.Empty);
        await Changed.InvokeAsync();
    }

    /// <summary>Reorders within a position, which is what the list order means to the engine.</summary>
    private async Task Move(BumperBlock block, int delta)
    {
        List<BumperBlock> side = [.. Ordered(block.Position)];
        int from = side.IndexOf(block);
        int to = from + delta;

        if (to < 0 || to >= side.Count)
        {
            return;
        }

        (side[from], side[to]) = (side[to], side[from]);

        List<BumperBlock> target = Blocks;
        List<BumperBlock> rebuilt = [];
        int index = 0;

        foreach (BumperBlock existing in target)
        {
            rebuilt.Add(existing.Position == block.Position ? side[index++] : existing);
        }

        target.Clear();
        target.AddRange(rebuilt);
        await Changed.InvokeAsync();
    }

    private async Task Rename(BumperBlock block, ChangeEventArgs e)
    {
        block.Name = e.Value?.ToString() ?? string.Empty;
        await Changed.InvokeAsync();
    }

    private async Task SetSelection(BumperBlock block, ChangeEventArgs e)
    {
        block.Selection = Enum.Parse<BumperSelection>(e.Value?.ToString() ?? nameof(BumperSelection.Random));
        await Changed.InvokeAsync();
    }

    private async Task ToggleSeason(BumperBlock block, int season, bool selected)
    {
        if (selected && !block.Seasons.Contains(season)) block.Seasons.Add(season);
        else if (!selected) block.Seasons.Remove(season);
        block.Seasons.Sort();
        await Changed.InvokeAsync();
    }

    private void OpenAdd(BumperBlock block)
    {
        _adding = block;
        _picked.Clear();
        _filter = null;
    }

    private void CloseAdd()
    {
        _adding = null;
        _picked.Clear();
    }

    private void TogglePick(string path, bool on)
    {
        if (on)
        {
            _picked.Add(path);
        }
        else
        {
            _picked.Remove(path);
        }
    }

    private void SelectShown(IEnumerable<ExtraClip> shown)
    {
        foreach (ExtraClip extra in shown)
        {
            _picked.Add(extra.Path);
        }
    }

    private async Task AddPicked(BumperBlock block)
    {
        foreach (ExtraClip extra in (_extras ?? []).Where(x => _picked.Contains(x.Path)))
        {
            if (!block.Clips.Any(c => SamePath(c.Path, extra.Path)))
            {
                block.Clips.Add(new BumperClip { Path = extra.Path, Name = extra.Name });
            }
        }

        CloseAdd();
        await Changed.InvokeAsync();
    }

    private async Task AddFromDisk(BumperBlock block, IReadOnlyList<string> paths)
    {
        foreach (string path in paths.Where(p => !block.Clips.Any(c => SamePath(c.Path, p))))
        {
            block.Clips.Add(new BumperClip { Path = path, Name = System.IO.Path.GetFileNameWithoutExtension(path) });
        }

        CloseAdd();
        await Changed.InvokeAsync();
    }

    private async Task RemoveClip(BumperBlock block, BumperClip clip)
    {
        block.Clips.Remove(clip);

        if (_pinning == clip)
        {
            _pinning = null;
        }

        await Changed.InvokeAsync();
    }

    private async Task PinTo(BumperBlock block, BumperClip clip)
    {
        _pinning = clip;

        if (_episodes.Count == 0 && _seriesId is not null)
        {
            _episodes = await Library.GetEpisodesAsync(_seriesId);
        }
    }

    private async Task ClearPins()
    {
        _pinning?.Episodes.Clear();
        await Changed.InvokeAsync();
    }

    private async Task TogglePin(string code, bool on)
    {
        if (_pinning is null)
        {
            return;
        }

        if (on && !_pinning.Episodes.Contains(code, StringComparer.OrdinalIgnoreCase))
        {
            _pinning.Episodes.Add(code);
        }
        else if (!on)
        {
            _pinning.Episodes.RemoveAll(e => string.Equals(e, code, StringComparison.OrdinalIgnoreCase));
        }

        await Changed.InvokeAsync();
    }

    private Task Close() => OnClose.InvokeAsync();
}
