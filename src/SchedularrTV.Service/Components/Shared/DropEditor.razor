@* Edits a DropConfig: when new episodes drop, how many at a time, and how dropped episodes repeat in between. *@

<div class="drop-editor" style="border-left:3px solid var(--accent, #6aa0ff);padding-left:10px;margin:6px 0;">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div style="font-size:12px;color:var(--muted);margin-bottom:4px;">@Title</div>
    }

    <div class="field">
        <span>Drop on</span>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
            @foreach (DayOfWeek day in Week)
            {
                <label class="check" style="margin:0;">
                    <input type="checkbox" checked="@Drop.DropDays.Contains(day)" @onchange="e => ToggleDay(day, e)" />
                    <span>@(day.ToString()[..3])</span>
                </label>
            }
        </div>
    </div>

    <div class="grid grid-2">
        @if (Drop.DropDays.Count == 0)
        {
            <DurationInput Label="Or every" Placeholder="7d" Value="Drop.Every"
                           ValueChanged="v => Set(() => Drop.Every = v ?? TimeSpan.FromDays(7))" />
        }
        @if (ShowTime)
        {
            <label class="field">
                <span>At (time of day) <span class="muted">(optional)</span></span>
                <input type="text" placeholder="Normal air times" value="@TimeText" @onchange="OnTimeChanged" />
            </label>
        }
        <label class="field">
            <span>Episodes per drop</span>
            <input type="number" min="1" value="@Drop.Count" @onchange="e => Set(() => Drop.Count = Math.Max(1, Int(e, 1)))" />
        </label>
        <label class="field">
            <span>Next episode by</span>
            <select value="@Drop.ReleaseOrder" @onchange="e => Set(() => Drop.ReleaseOrder = Enum.Parse<DropReleaseOrder>(e.Value?.ToString() ?? nameof(DropReleaseOrder.EpisodeOrder)))">
                <option value="@DropReleaseOrder.EpisodeOrder">Episode order (season, episode)</option>
                <option value="@DropReleaseOrder.AirDate">Air date</option>
            </select>
        </label>
        <label class="field">
            <span>Between drops, repeats play</span>
            <select value="@Drop.Repeats" @onchange="e => Set(() => Drop.Repeats = Enum.Parse<PlaybackOrder>(e.Value?.ToString() ?? nameof(PlaybackOrder.Shuffle)))">
                <option value="@PlaybackOrder.Shuffle">Shuffled (no repeats until all have played)</option>
                <option value="@PlaybackOrder.Random">At random</option>
                <option value="@PlaybackOrder.SeasonEpisode">In episode order</option>
                <option value="@PlaybackOrder.Chronological">In air-date order</option>
            </select>
        </label>
        <label class="field">
            <span>First drop</span>
            <input type="date" value="@Drop.Start" @onchange="e => Set(() => Drop.Start = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString())" />
        </label>
        <label class="field">
            <span>Already out before the first drop</span>
            <input type="number" min="0" value="@Drop.AlreadyOut" @onchange="e => Set(() => Drop.AlreadyOut = Math.Max(0, Int(e, 0)))" />
        </label>
        <label class="field">
            <span>Break between seasons <span class="muted">(optional)</span></span>
            <div style="display:flex;gap:6px;">
                <input type="number" min="0" step="1" placeholder="None" value="@BreakAmount" style="max-width:110px;"
                       @onchange="OnBreakAmountChanged" />
                <select value="@_breakUnit" @onchange="OnBreakUnitChanged">
                    <option value="days">days</option>
                    <option value="weeks">weeks</option>
                </select>
            </div>
        </label>
        <label class="field">
            <span>When the last episode has dropped</span>
            <select value="@Drop.AtEnd" @onchange="e => Set(() => Drop.AtEnd = Enum.Parse<DropEndAction>(e.Value?.ToString() ?? nameof(DropEndAction.Stop)))">
                <option value="@DropEndAction.Stop">Stop dropping (repeats carry on)</option>
                <option value="@DropEndAction.Restart">Start over from the first episode@(Drop.HasSeasonBreak ? " after the break" : "")</option>
            </select>
        </label>
    </div>
    <p class="hint">
        @(Drop.Describe()). From each drop day, the show's first airings (at its normal times) are the new
        episodes@(ShowTime ? "; set a time to air them then instead, ahead of whatever else is due." : ".")
        Until the next drop only episodes that have already dropped play, as repeats. Leave <em>First drop</em>
        empty to start from the next build (the latest drop counts, so one is out straight away).
        @if (Drop.HasSeasonBreak)
        {
            <text>
                Once a season's last episode drops, the next season's first drops on the first drop day at least
                @DropConfig.GapText(Drop.Break) later; a drop never runs on into the next season.
            </text>
        }
        A drop show can be put back to any episode from the channel's <em>Drops</em> tab.
    </p>
</div>

@code {
    [Parameter, EditorRequired] public DropConfig Drop { get; set; } = new();
    [Parameter] public string? Title { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>Offers a set air time, which only an individual show has; a collection's shows keep their own airings.</summary>
    [Parameter] public bool ShowTime { get; set; }

    private static readonly DayOfWeek[] Week =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    private string TimeText => Drop.Time is { } time ? time.ToString(@"hh\:mm") : "";

    // The break is kept as a duration; it's edited as a whole number of days or weeks.
    private string _breakUnit = "weeks";

    protected override void OnParametersSet()
    {
        if (Drop.HasSeasonBreak)
        {
            double days = Drop.Break.TotalDays;
            _breakUnit = days >= 7 && Math.Abs(days / 7 - Math.Round(days / 7)) < 1e-9 ? "weeks" : "days";
        }
    }

    private string BreakAmount
    {
        get
        {
            if (!Drop.HasSeasonBreak)
            {
                return "";
            }

            double amount = _breakUnit == "weeks" ? Drop.Break.TotalDays / 7 : Drop.Break.TotalDays;
            return amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private Task OnBreakAmountChanged(ChangeEventArgs e) => Set(() =>
    {
        string text = e.Value?.ToString()?.Trim() ?? "";
        if (!double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double amount)
            || amount <= 0)
        {
            Drop.SeasonBreak = null;
            return;
        }

        Drop.SeasonBreak = TimeSpan.FromDays(_breakUnit == "weeks" ? amount * 7 : amount);
    });

    private Task OnBreakUnitChanged(ChangeEventArgs e) => Set(() =>
    {
        string unit = e.Value?.ToString() == "days" ? "days" : "weeks";
        if (unit == _breakUnit)
        {
            return;
        }

        // The number stays as typed; it now counts the other unit.
        if (Drop.HasSeasonBreak)
        {
            double amount = _breakUnit == "weeks" ? Drop.Break.TotalDays / 7 : Drop.Break.TotalDays;
            Drop.SeasonBreak = TimeSpan.FromDays(unit == "weeks" ? amount * 7 : amount);
        }

        _breakUnit = unit;
    });

    private async Task Set(Action change)
    {
        change();
        await Changed.InvokeAsync();
    }

    private Task ToggleDay(DayOfWeek day, ChangeEventArgs e) => Set(() =>
    {
        // The Friday shown by default becomes a real choice once a day is changed.
        if (Drop.Days.Count == 0 && Drop.Every is null)
        {
            Drop.Days = [.. DropConfig.DefaultDays];
        }

        if ((bool)(e.Value ?? false))
        {
            if (!Drop.Days.Contains(day)) Drop.Days.Add(day);
            Drop.Days.Sort((a, b) => (((int)a + 6) % 7).CompareTo(((int)b + 6) % 7));
        }
        else
        {
            Drop.Days.Remove(day);

            // No days ticked: drops go by interval instead (a week, until changed), rather than back to Fridays.
            if (Drop.Days.Count == 0)
            {
                Drop.Every ??= TimeSpan.FromDays(7);
            }
        }

        // Ticking a day after an interval goes back to weekdays.
        if (Drop.Days.Count > 0)
        {
            Drop.Every = null;
        }
    });

    private Task OnTimeChanged(ChangeEventArgs e) => Set(() =>
    {
        string text = e.Value?.ToString()?.Trim() ?? "";
        if (text.Length == 0)
        {
            Drop.Time = null;
        }
        else if (TimeSpan.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, out TimeSpan time)
            && time >= TimeSpan.Zero && time < TimeSpan.FromDays(1))
        {
            Drop.Time = time;
        }
        // Anything else (8pm, say) keeps the time it had; the box shows it again as hh:mm.
    });

    private static int Int(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), out int value) ? value : fallback;
}
