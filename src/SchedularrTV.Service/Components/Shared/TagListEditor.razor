@* Edits a list of free-text values (tags, promo types) as removable chips. *@

<div class="field">
    <span style="display:block;font-size:12px;color:var(--muted);margin-bottom:4px;">@Label</span>
    <div class="row row-wrap" style="margin-bottom:6px;">
        @foreach (string tag in Values)
        {
            <span class="pill pill-muted">
                @tag
                <a href="#" style="margin-left:6px;color:var(--muted);" @onclick:preventDefault
                   @onclick="() => Remove(tag)">&times;</a>
            </span>
        }
        @if (Values.Count == 0)
        {
            <span class="meta" style="color:var(--muted);font-size:12px;">none</span>
        }
    </div>
    <div class="row">
        <input type="text" placeholder="@Placeholder" value="@_pending"
               @oninput="e => _pending = e.Value?.ToString() ?? string.Empty"
               @onkeydown="OnKeyDown" />
        <button class="btn btn-sm" @onclick="Add">Add</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "add a value";
    [Parameter, EditorRequired] public List<string> Values { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }

    private string _pending = "";

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Add();
        }
    }

    private async Task Add()
    {
        string value = _pending.Trim();
        if (value.Length > 0 && !Values.Contains(value, StringComparer.OrdinalIgnoreCase))
        {
            Values.Add(value);
            _pending = "";
            await Changed.InvokeAsync();
        }
    }

    private async Task Remove(string tag)
    {
        Values.Remove(tag);
        await Changed.InvokeAsync();
    }
}
