@* Hardware profile and video encoding (ErsatzTV channels, live page channels, rendered clips); part of App settings. *@
@using SchedularrTV.Service.Hosting
@using SchedularrTV.Providers.ErsatzTv
@using SchedularrTV.Core.Configuration
@inject IServiceProvider Services

<div class="grid grid-2">
    <div class="field">
        <span>This computer</span>
        <code style="padding:8px 0;">@HardwareProfile.Detected.Summary</code>
    </div>
    <label class="field">
        <span>Hardware profile</span>
        <select value="@Form.PerformanceValue(HardwareProfile.SettingKey)" @onchange="e => Edit(HardwareProfile.SettingKey, e.Value?.ToString())">
            <option value="">Automatic (@(HardwareProfile.Detected.LooksLowPower ? "low-power" : "standard") for this computer)</option>
            <option value="@nameof(HardwareMode.LowPower)">Low-power (Raspberry Pi and similar)</option>
            <option value="@nameof(HardwareMode.Standard)">Standard</option>
        </select>
    </label>
</div>
<p class="hint">
    @if (HardwareProfile.IsLowPower)
    {
        <text>Using the <strong>low-power</strong> defaults: smaller and faster encodes, fewer things at once, and warnings beside settings that are known to be heavy here.</text>
    }
    else
    {
        <text>Using the standard defaults. The low-power profile lightens them for a Raspberry Pi or a similar small computer, and shows warnings where settings are heavy.</text>
    }
    Only defaults change; anything you've set yourself is kept. A changed profile applies once saved.
</p>
<LowPowerNotice Title="@($"Running on {HardwareProfile.DeviceName}")" Advice="GeneralAdvice" />

<h3 style="margin:18px 0 6px;">ErsatzTV channels</h3>
<p class="hint">
    The defaults for every channel ErsatzTV plays; encoding is usually the heaviest work on this computer. A channel can
    override any of them on its General tab.
</p>
<div class="grid grid-3">
    <label class="field">
        <span>Encode on</span>
        <select value="@EtvDefaults.Hardware" @onchange="e => Edit(EtvHardwareKey, e.Value?.ToString())">
            @foreach (ErsatzTvHardware choice in ErsatzTvEncoding.Hardware)
            {
                <option value="@choice.Value">@choice.Label</option>
            }
        </select>
    </label>
    <EncodingPictureSettings Value="EtvPicture" Inherited="EtvDefaults" AllowInheritance="false" Changed="SetEtvPicture" />
    <label class="field">
        <span>Media sizing</span>
        <select value="@EtvDefaults.ScalingMode" @onchange="e => Edit(EtvScalingKey, e.Value?.ToString())">
            <option value="scale_and_pad">Fit — entire image, black bars if needed</option>
            <option value="crop">Fill — crop edges to fill the frame</option>
        </select>
    </label>
    <label class="field">
        <span>Bitrate (kbps)</span>
        <input type="number" min="300" max="100000" value="@EtvDefaults.BitrateKbps"
               @onchange="e => Edit(EtvBitrateKey, e.Value?.ToString())" />
    </label>
</div>
<p class="hint">@HintFor(EtvDefaults.Hardware)</p>
<p class="hint">
    Default output: @(EtvDefaults.Width)×@(EtvDefaults.Height) pixels. Use 640×480 for 4:3 or 854×480 for widescreen.
    Dimensions are rounded down to even pixels. Source-based channels keep their source size and passthrough behavior unless overridden on the channel.
</p>
@if (EtvDefaults.Hardware == "vaapi")
{
    <div class="grid grid-2">
        <label class="field">
            <span>VA-API device</span>
            <input type="text" value="@Form.PerformanceValue(EtvVaapiDeviceKey)" placeholder="/dev/dri/renderD128"
                   @onchange="e => Edit(EtvVaapiDeviceKey, e.Value?.ToString())" />
        </label>
        <label class="field">
            <span>VA-API driver</span>
            <select value="@Form.PerformanceValue(EtvVaapiDriverKey)" @onchange="e => Edit(EtvVaapiDriverKey, e.Value?.ToString())">
                <option value="">Let libva choose</option>
                <option value="ihd">ihd (Intel, newer)</option>
                <option value="i965">i965 (Intel, older)</option>
                <option value="radeonsi">radeonsi (AMD)</option>
            </select>
        </label>
    </div>
}
@if (DetectedGpu is { } gpu && EtvDefaults.Hardware == ErsatzTvEncoding.Software)
{
    <p class="hint">This computer has an <strong>@gpu</strong>: choose NVIDIA (CUDA / NVENC) to take ErsatzTV's encoding off the processor.</p>
}
@if (EtvDefaults.Hardware != ErsatzTvEncoding.Software)
{
    <p class="hint warn">
        ErsatzTV checks for the hardware when a channel starts and falls back to the processor if it isn't there (see its log).
        Check the Performance page afterwards.
    </p>
}
<p class="hint">Saving a change restarts ErsatzTV, so anyone watching drops for a few seconds.</p>

<h3 style="margin:18px 0 6px;">Live page channels</h3>
<p class="hint">Web page channels, radio stations, the TV guide channel and streamer channels: each one on air is a hidden browser and one live encode.</p>
<div class="grid grid-3">
    <label class="field">
        <span>Encoder</span>
        <select value="@Form.PerformanceValue(LiveEncoderKey)" @onchange="e => Edit(LiveEncoderKey, e.Value?.ToString())">
            <option value="">Default (@LiveDefaults.Video.Encoder.Label)</option>
            @foreach (H264Encoder encoder in H264Encoder.All)
            {
                <option value="@encoder.Name">@encoder.Label</option>
            }
        </select>
    </label>
    <label class="field">
        <span>x264 speed preset</span>
        <select value="@Form.PerformanceValue(LivePresetKey)" @onchange="e => Edit(LivePresetKey, e.Value?.ToString())">
            <option value="">Default (@LiveDefaults.Video.Preset)</option>
            @foreach (string preset in X264Presets.All)
            {
                <option value="@preset">@preset</option>
            }
        </select>
    </label>
    <label class="field">
        <span>Picture size</span>
        <select value="@Form.PerformanceValue(LiveHeightKey)" @onchange="e => Edit(LiveHeightKey, e.Value?.ToString())">
            <option value="">Default (@(LiveDefaults.Height)p)</option>
            @foreach (int height in LiveEncodingSettings.Heights)
            {
                <option value="@height">@(height)p (@(LiveEncodingSettings.WidthFor(height))×@height)</option>
            }
        </select>
    </label>
    <label class="field">
        <span>Frames per second</span>
        <select value="@Form.PerformanceValue(LiveFrameRateKey)" @onchange="e => Edit(LiveFrameRateKey, e.Value?.ToString())">
            <option value="">Default (@LiveDefaults.FrameRate)</option>
            @foreach (int fps in LiveEncodingSettings.FrameRates)
            {
                <option value="@fps">@fps</option>
            }
        </select>
    </label>
    <label class="field">
        <span>Bitrate (kbps)</span>
        <input type="number" min="300" max="20000" value="@Form.PerformanceValue(LiveBitrateKey)" placeholder="@LiveDefaults.BitrateKbps"
               @onchange="e => Edit(LiveBitrateKey, e.Value?.ToString())" />
    </label>
    <label class="field">
        <span>Encoder threads</span>
        <input type="number" min="0" max="16" value="@Form.PerformanceValue(LiveThreadsKey)" placeholder="All of them"
               @onchange="e => Edit(LiveThreadsKey, e.Value?.ToString())" />
    </label>
</div>
<p class="hint">
    Pages are still laid out at 1280×720 and scaled to the size chosen. Blank fields use the defaults for this computer.
    Channels on air restart with new settings the next time they're tuned.
</p>
<LowPowerNotice Inline="true" Advice="LiveWarnings" />
@if (Live.Video.Encoder.Hardware)
{
    <p class="hint warn">
        A hardware encoder only works if this computer has it and ffmpeg was built with it; if not, live channels stop as soon
        as they start. Watch one after saving.
    </p>
}

<h3 style="margin:18px 0 6px;">Rendered clips</h3>
<p class="hint">Generated promos and credit squeezes, made ahead of time in the background. A slower preset makes smaller files at the same quality.</p>
<div class="grid grid-3">
    <label class="field">
        <span>Encoder</span>
        <select value="@Form.PerformanceValue(RenderEncoderKey)" @onchange="e => Edit(RenderEncoderKey, e.Value?.ToString())">
            <option value="">Default (@H264Encoder.Software.Label)</option>
            @foreach (H264Encoder encoder in H264Encoder.All)
            {
                <option value="@encoder.Name">@encoder.Label</option>
            }
        </select>
    </label>
    <label class="field">
        <span>x264 speed preset</span>
        <select value="@Form.PerformanceValue(RenderPresetKey)" @onchange="e => Edit(RenderPresetKey, e.Value?.ToString())">
            <option value="">Default (@(HardwareProfile.IsLowPower ? "superfast" : "medium for promos, veryfast for squeezes"))</option>
            @foreach (string preset in X264Presets.All)
            {
                <option value="@preset">@preset</option>
            }
        </select>
    </label>
    <label class="field">
        <span>Encoder threads</span>
        <input type="number" min="0" max="16" value="@Form.PerformanceValue(RenderThreadsKey)" placeholder="@RenderThreadsPlaceholder"
               @onchange="e => Edit(RenderThreadsKey, e.Value?.ToString())" />
    </label>
    <label class="field">
        <span>Hardware encoder bitrate at 1080p (kbps)</span>
        <input type="number" min="500" max="40000" value="@Form.PerformanceValue(RenderBitrateKey)" placeholder="@RenderingDefaults.HardwareBitrateKbps"
               @onchange="e => Edit(RenderBitrateKey, e.Value?.ToString())" />
    </label>
</div>
<p class="hint">
    Software encodes aim for a quality; hardware encoders have no quality setting, so they use this bitrate (scaled to the
    clip's size). If a hardware encoder fails, the clip is made in software instead, so promos and squeezes are never lost.
</p>
<LowPowerNotice Inline="true" Advice="RenderingWarnings" />

@code {
    [Parameter, EditorRequired] public AppSettingsForm Form { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }

    // Kept as constants so the markup's attributes don't need quotes inside quotes.
    private const string LiveEncoderKey = "LiveEncoding:Encoder";
    private const string LivePresetKey = "LiveEncoding:Preset";
    private const string LiveHeightKey = "LiveEncoding:Height";
    private const string LiveFrameRateKey = "LiveEncoding:FrameRate";
    private const string LiveBitrateKey = "LiveEncoding:BitrateKbps";
    private const string LiveThreadsKey = "LiveEncoding:Threads";
    private const string RenderEncoderKey = "Rendering:Encoder";
    private const string RenderPresetKey = "Rendering:Preset";
    private const string RenderThreadsKey = "Rendering:Threads";
    private const string RenderBitrateKey = "Rendering:HardwareBitrateKbps";
    private const string EtvHardwareKey = AppSettingsForm.ErsatzEncodingPrefix + "Hardware";
    private const string EtvHeightKey = AppSettingsForm.ErsatzEncodingPrefix + "Height";
    private const string EtvWidthKey = AppSettingsForm.ErsatzEncodingPrefix + "Width";
    private const string EtvAspectKey = AppSettingsForm.ErsatzEncodingPrefix + "AspectRatio";
    private const string EtvRateKey = AppSettingsForm.ErsatzEncodingPrefix + "FrameRate";
    private const string EtvScalingKey = AppSettingsForm.ErsatzEncodingPrefix + "ScalingMode";
    private const string EtvBitrateKey = AppSettingsForm.ErsatzEncodingPrefix + "BitrateKbps";
    private const string EtvVaapiDeviceKey = AppSettingsForm.ErsatzEncodingPrefix + "VaapiDevice";
    private const string EtvVaapiDriverKey = AppSettingsForm.ErsatzEncodingPrefix + "VaapiDriver";

    // What every channel gets, with what's typed here and the defaults for anything not set.
    private EffectiveEncoding EtvDefaults => ErsatzTvEncoding.Defaults(new ErsatzTvEncodingOptions
    {
        Hardware = Typed(EtvHardwareKey),
        Height = Typed(EtvHeightKey),
        Width = Typed(EtvWidthKey),
        AspectRatio = Typed(EtvAspectKey),
        FrameRate = Typed(EtvRateKey),
        ScalingMode = Typed(EtvScalingKey),
        BitrateKbps = Typed(EtvBitrateKey),
        VaapiDevice = Typed(EtvVaapiDeviceKey),
        VaapiDriver = Typed(EtvVaapiDriverKey)
    });

    private ChannelEncodingConfig EtvPicture => new()
    {
        Height = EtvDefaults.Height,
        Width = int.TryParse(Typed(EtvWidthKey), out int width) ? width : null,
        AspectRatio = Typed(EtvAspectKey),
        FrameRate = Typed(EtvRateKey)
    };

    private async Task SetEtvPicture(ChannelEncodingConfig value)
    {
        Form.SetPerformance(EtvHeightKey, value.Height?.ToString());
        Form.SetPerformance(EtvWidthKey, value.Width?.ToString());
        Form.SetPerformance(EtvAspectKey, value.AspectRatio);
        Form.SetPerformance(EtvRateKey, value.FrameRate);
        await Changed.InvokeAsync();
    }

    private static string? HintFor(string? hardware) =>
        ErsatzTvEncoding.Hardware.FirstOrDefault(choice => choice.Value == hardware)?.Hint;

    // An NVIDIA card the Performance page has seen, to point at it; other cards aren't read.
    private string? DetectedGpu =>
        Services.GetService<SchedularrTV.Service.Performance.ResourceMonitor>()?.Latest?.Gpus.FirstOrDefault()?.Name;

    private static string RenderThreadsPlaceholder => HardwareProfile.IsLowPower ? "2" : "All of them";

    private static LiveEncodingSettings LiveDefaults => LiveEncodingSettings.Defaults;

    private static RenderEncodingSettings RenderingDefaults => RenderEncodingSettings.Defaults("medium");

    // The settings as they'd be with what's typed here (blank fields take this computer's defaults).
    private string? Typed(string key) => Form.PerformanceValue(key) is { Length: > 0 } value ? value : null;

    private LiveEncodingSettings Live => LiveEncodingSettings.From(Typed);

    private RenderEncodingSettings Rendering => RenderEncodingSettings.From(Typed, "medium");

    private static IEnumerable<string?> GeneralAdvice =>
    [
        "The scheduler itself is light here. What's heavy is encoding video: ErsatzTV re-encodes every channel being watched, and the live page channels, generated promos, credit squeezes and Auto Chapters each run ffmpeg too.",
        HardwareProfile.HasV4l2H264Encoder
            ? "This Pi has a hardware H.264 encoder: choose \"Raspberry Pi 4 hardware (h264_v4l2m2m)\" below to take live channels and rendered clips off the processor."
            : HardwareProfile.Detected is { IsRaspberryPi: true, PiGeneration: >= 5 }
                ? "The Pi 5 has no hardware H.264 encoder, so everything is encoded in software: keep the presets fast and the sizes small."
                : null,
        HardwareProfile.Detected.MemoryGb is > 0 and < 3
            ? "With under 3 GB of memory, keep to one live page channel at a time (each hidden browser takes 300–500 MB) and avoid the IPTV guide grabber and the larger Local AI models."
            : null,
        "Keep the data folder (and ErsatzTV's hls folder) on a USB SSD rather than the SD card: playback state, playouts and stream segments are rewritten often."
    ];

    private IEnumerable<string?> LiveWarnings
    {
        get
        {
            LiveEncodingSettings live = Live;
            bool software = !live.Video.Encoder.Hardware;
            return
            [
                software && X264Presets.All.ToList().IndexOf(live.Video.Preset) > X264Presets.All.ToList().IndexOf("superfast")
                    ? $"x264 \"{live.Video.Preset}\" is slow for a live encode here; ultrafast or superfast keeps up."
                    : null,
                live.Height >= 720 && live.FrameRate >= 30 && software
                    ? "720p at 30 fps is about twice the work of 540p; one such channel can take most of the processor."
                    : null,
                live.BitrateKbps > 4000 ? "Over 4 Mbps adds little for page channels and costs more to encode and send." : null,
                live.Video.Encoder.Name == "h264_v4l2m2m" && !HardwareProfile.HasV4l2H264Encoder
                    ? "This computer has no V4L2 H.264 encoder (the Raspberry Pi 5 doesn't), so h264_v4l2m2m won't work here."
                    : null,
                live.Video.Encoder.Hardware && live.Video.Encoder.Name != "h264_v4l2m2m" && HardwareProfile.Detected.IsRaspberryPi
                    ? $"A Raspberry Pi has no {live.Video.Encoder.Label} encoder."
                    : null
            ];
        }
    }

    private IEnumerable<string?> RenderingWarnings
    {
        get
        {
            RenderEncodingSettings rendering = Rendering;
            bool software = !rendering.Video.Encoder.Hardware;
            string? preset = Typed(RenderPresetKey);
            return
            [
                software && preset is not null && X264Presets.IsSlow(preset)
                    ? $"x264 \"{preset}\" can take several minutes per promo here; superfast or veryfast are much quicker."
                    : null,
                software && rendering.Video.Threads == 0
                    ? "With every thread, a render can make the channels on air stutter; 2 leaves room for them."
                    : null,
                rendering.Video.Encoder.Name == "h264_v4l2m2m" && !HardwareProfile.HasV4l2H264Encoder
                    ? "This computer has no V4L2 H.264 encoder (the Raspberry Pi 5 doesn't); clips would be made in software anyway."
                    : null
            ];
        }
    }

    private Task Edit(string key, string? value)
    {
        Form.SetPerformance(key, value);
        return Changed.InvokeAsync();
    }
}
