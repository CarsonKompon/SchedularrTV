@* A path box with a Browse button that opens the system's own file dialog, on the computer running SchedularrTV. *@
@inject IServiceProvider Services

@if (Multiple)
{
    @if (CanBrowse)
    {
        <button class="btn btn-sm" type="button" disabled="@(_browsing || _copying)" @onclick="Browse">@(_copying ? "Copying…" : _browsing ? "Choosing…" : ButtonText)</button>
    }
    else
    {
        @* The dialog would open on the server's screen, so from another computer paths are typed, one at a time. *@
        <div class="file-field">
            <input type="text" value="@_typed" placeholder="@($"Full path of {Label} on the server")" aria-label="@Label"
                   @onchange="e => _typed = e.Value?.ToString()" />
            <button class="btn btn-sm" type="button" disabled="@string.IsNullOrWhiteSpace(_typed)" @onclick="AddTyped">Add</button>
        </div>
    }
}
else
{
    <div class="file-field">
        <input type="text" value="@Value" placeholder="@Placeholder" aria-label="@Label" @onchange="Typed" />
        @if (CanBrowse)
        {
            <button class="btn btn-sm" type="button" disabled="@(_browsing || _copying)" @onclick="Browse">@(_copying ? "Copying…" : _browsing ? "Choosing…" : "Browse…")</button>
        }
    </div>
}
@if (_problem is not null)
{
    <span class="field-error" role="alert">@_problem</span>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter, EditorRequired] public string[] Extensions { get; set; } = [];
    [Parameter] public string Label { get; set; } = "a file";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public Environment.SpecialFolder StartIn { get; set; } = Environment.SpecialFolder.MyVideos;
    /// <summary>Pick several files at once, reported through <see cref="OnPicked"/>.</summary>
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public string ButtonText { get; set; } = "Add files…";
    [Parameter] public EventCallback<IReadOnlyList<string>> OnPicked { get; set; }
    /// <summary>Choose a folder instead of a file.</summary>
    [Parameter] public bool PickFolder { get; set; }
    /// <summary>
    /// Keeps a copy of each chosen file in the data folder (under <c>assets/&lt;this&gt;</c>) and hands back the copy's
    /// path, so what uses it keeps working if the original is moved or deleted. Null uses the file where it is.
    /// </summary>
    [Parameter] public string? KeepCopyIn { get; set; }

    /// <summary>Whether the browser is on the computer running SchedularrTV, where the dialog opens.</summary>
    [CascadingParameter] public LocalAccess? Local { get; set; }

    // One user edits at a time, so remembering the last folder per file kind is enough.
    private static readonly Dictionary<string, string> LastFolders = new(StringComparer.Ordinal);

    private bool _browsing;
    private bool _copying;
    private string? _problem;
    private string? _typed;

    private bool CanBrowse => Local?.IsLocal ?? true;

    private string KindKey => PickFolder ? "folder" : string.Join(',', Extensions);

    private string FilterName =>
        Extensions.SequenceEqual(FileBrowsing.Audio) ? "Audio"
        : Extensions.SequenceEqual(FileBrowsing.Images) ? "Images"
        : Extensions.SequenceEqual(FileBrowsing.Videos) ? "Videos"
        : Extensions.SequenceEqual(SettingsFiles.Programs) && Extensions.Length > 0 ? "Programs"
        : "Supported files";

    private async Task Browse()
    {
        _browsing = true;
        _problem = null;
        try
        {
            string title = Multiple ? ButtonText.TrimEnd('…', '.') : $"Choose {Label}";
            var request = new FileDialogRequest(title, Extensions, FileBrowsing.StartFolder(Multiple ? null : Value, LastFolders.GetValueOrDefault(KindKey), StartIn),
                Multiple, PickFolder) { FilterName = FilterName };
            FileDialogResult result = await NativeFileDialog.ShowAsync(request);
            _problem = result.Problem;
            if (result.Paths.Count == 0)
            {
                return;
            }

            string first = result.Paths[0];
            if (FileBrowsing.StartFolder(first, null, StartIn) is { } folder)
            {
                LastFolders[KindKey] = folder;
            }

            _browsing = false;
            IReadOnlyList<string> picked = await KeepAsync(result.Paths);
            if (Multiple)
            {
                await OnPicked.InvokeAsync(picked);
            }
            else
            {
                await ValueChanged.InvokeAsync(picked[0]);
            }
        }
        finally
        {
            _browsing = false;
        }
    }

    private async Task Typed(ChangeEventArgs e)
    {
        string typed = Clean(e.Value?.ToString());
        _problem = null;
        if (typed.Length > 0)
        {
            typed = (await KeepAsync([typed]))[0];
        }

        await ValueChanged.InvokeAsync(typed.Length == 0 ? null : typed);
    }

    /// <summary>With <see cref="KeepCopyIn"/>, the paths of copies kept in the data folder; otherwise the paths as given.</summary>
    private async Task<IReadOnlyList<string>> KeepAsync(IReadOnlyList<string> paths)
    {
        if (PickFolder || KeepCopyIn is not { Length: > 0 } category || Services.GetService(typeof(TemplateAssets)) is not TemplateAssets assets)
        {
            return paths;
        }

        _copying = true;
        StateHasChanged();
        try
        {
            List<string> kept = [];
            foreach (string path in paths)
            {
                kept.Add(await Task.Run(() => assets.KeepAsync(category, path)));
            }

            return kept;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _problem = $"Couldn't keep a copy in the data folder, so the file is used where it is: {ex.Message}";
            return paths;
        }
        finally
        {
            _copying = false;
        }
    }

    private async Task AddTyped()
    {
        string typed = Clean(_typed);
        if (typed.Length == 0)
        {
            return;
        }

        _typed = null;
        await OnPicked.InvokeAsync(await KeepAsync([typed]));
    }

    private static string Clean(string? text) => (text ?? string.Empty).Trim().Trim('"');
}
