@page "/performance"
@implements IDisposable
@using System.Globalization
@using SchedularrTV.Service.Performance
@inject ResourceMonitor Monitor
@inject AlwaysOnKeeper AlwaysOn

<PageHeader Title="Performance" Eyebrow="System">
    <ChildContent>
        Last @((int)ResourceMonitor.HistoryLength.TotalMinutes) minutes · updated every @((int)ResourceMonitor.Interval.TotalSeconds)s.
        CPU is measured across all cores, and put down to the plugin and job that used it.
    </ChildContent>
</PageHeader>

@if (_latest is not { } latest)
{
    <div class="empty">Taking the first measurements…</div>
}
else
{
    UsageGroup? ersatz = latest.Group(ResourceMonitor.ErsatzKey);
    GpuUsage? gpu = latest.Gpus.FirstOrDefault();
    SourceStats? busiest = _sources.Where(source => source.Source != ResourceMonitor.AppSource || source.Action != ResourceMonitor.AppAction)
        .OrderByDescending(source => source.Now).FirstOrDefault();

    <div class="stat-grid dash-stats">
        <div class="stat @(latest.SetupCpuPercent > 70 ? "warn" : "")">
            <div class="stat-label"><Icon Name="activity" Size="14" />CPU, this setup</div>
            <div class="stat-value">@Pct(latest.SetupCpuPercent)</div>
            <div class="stat-sub">
                @(latest.SystemCpuPercent is not null ? $"{Maybe(latest.SystemCpuPercent)} for the whole computer · " : "")@latest.Cores cores
            </div>
        </div>
        <div class="stat">
            <div class="stat-label"><Icon Name="layers" Size="14" />Busiest right now</div>
            @if (busiest is { Now: >= 0.5 })
            {
                <div class="stat-value">@Pct(busiest.Now)</div>
                <div class="stat-sub perf-ellipsis" title="@busiest.Key">@busiest.Key</div>
            }
            else
            {
                <div class="stat-value">–</div>
                <div class="stat-sub">Nothing's working hard</div>
            }
        </div>
        <div class="stat">
            <div class="stat-label"><Icon Name="layers" Size="14" />Memory, this setup</div>
            <div class="stat-value">@ResourceMonitor.Bytes(latest.SetupMemoryBytes)</div>
            <div class="stat-sub">
                @if (latest.SystemMemoryTotalBytes is not null)
                {
                    @(latest.SystemMemoryUsedBytes is not null
                        ? $"{ResourceMonitor.Bytes(latest.SystemMemoryUsedBytes.Value)} of {ResourceMonitor.Bytes(latest.SystemMemoryTotalBytes.Value)} in use overall"
                        : $"{ResourceMonitor.Bytes(latest.SystemMemoryTotalBytes.Value)} installed")
                }
            </div>
        </div>
        <div class="stat">
            <div class="stat-label"><Icon Name="radio" Size="14" />Channels transcoding</div>
            <div class="stat-value">@latest.Transcodes</div>
            <div class="stat-sub">
                @TranscodingNote(ersatz)
            </div>
        </div>
        <div class="stat">
            <div class="stat-label"><Icon Name="dashboard" Size="14" />Graphics card</div>
            @if (gpu is not null)
            {
                <div class="stat-value">@Maybe(gpu.Encoder ?? gpu.Utilization)</div>
                <div class="stat-sub" title="@gpu.Name">
                    @(gpu.Encoder is not null ? "video encoder" : "busy") · @gpu.Name
                </div>
            }
            else
            {
                <div class="stat-value">–</div>
                <div class="stat-sub">@(Monitor.GpuProblem ?? "Not read yet")</div>
            }
        </div>
    </div>

    @if (_advice.Count > 0)
    {
        <div class="perf-advice">
            @foreach (PerformanceAdvice advice in _advice)
            {
                <div class="activity @(advice.Level == AdviceLevel.Warning ? "warn" : "")">
                    <Icon Name="@(advice.Level == AdviceLevel.Warning ? "alert" : "activity")" Size="16" />
                    <div class="activity-body">
                        <div class="activity-title">@advice.Title</div>
                        <div class="activity-detail">@advice.Detail</div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="perf-split">
        <div class="card">
            <div class="card-head">
                <h2>CPU</h2>
                <div class="segmented perf-toggle" role="group" aria-label="Lines by">
                    <button type="button" class="@(_byGroup ? "" : "on")" @onclick="() => _byGroup = false">By source</button>
                    <button type="button" class="@(_byGroup ? "on" : "")" @onclick="() => _byGroup = true">By group</button>
                </div>
            </div>
            @{
                IReadOnlyList<Series> cpu = _byGroup ? GroupCpuSeries() : SourceCpuSeries();
            }
            @Chart(_history, 100, "%", cpu)
            @LegendFor(cpu)
        </div>

        <div class="card">
            <div class="card-head">
                <h2>Memory</h2>
                <span class="muted">In use</span>
            </div>
            @{
                double memoryMax = Math.Max(256L << 20, _history.Count == 0 ? 0 : _history.Max(sample => (double)sample.SetupMemoryBytes)) * 1.15;
                IReadOnlyList<Series> memory = _byGroup ? GroupMemorySeries() : SourceMemorySeries();
            }
            @Chart(_history, memoryMax / (1 << 30), "GB", memory)
            @LegendFor(memory)
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <h2>Where it's going</h2>
            <div class="segmented perf-toggle" role="group" aria-label="Sort by">
                <button type="button" class="@(_sourcesByPeak ? "on" : "")" @onclick="() => _sourcesByPeak = true">Biggest spikes</button>
                <button type="button" class="@(_sourcesByPeak ? "" : "on")" @onclick="() => _sourcesByPeak = false">Right now</button>
            </div>
        </div>
        <p class="hint" style="margin-top:0;">
            Each plugin and what it was doing. Processes it started (ffmpeg, browsers, Piper) are measured exactly; work done inside
            SchedularrTV itself (Whisper, the AI writer, drawing promo frames) is its share of the app's CPU above its usual idle level, so it's an estimate.
        </p>
        @{
            List<SourceStats> shown = [.. (_sourcesByPeak
                    ? _sources.OrderByDescending(source => source.Peak).ThenByDescending(source => source.Average)
                    : _sources.OrderByDescending(source => source.Now).ThenByDescending(source => source.Peak))
                .Where(source => source.Peak >= 0.05 || source.Memory > 0 || source.Running > 0)];
            const string sourcesKey = "sources";
        }
        @if (shown.Count == 0)
        {
            <p class="muted" style="margin:0;">Nothing measured yet.</p>
        }
        else
        {
            <table class="perf-table">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th class="num">Now</th>
                        <th class="num">Average</th>
                        <th class="num">Peak</th>
                        <th class="num">Memory</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (SourceStats source in shown.Take(_expanded.Contains(sourcesKey) ? int.MaxValue : 12))
                    {
                        <tr>
                            <td>
                                <span class="perf-swatch" style="background:@ColourFor(source.Key)"></span><strong>@source.Source</strong> – @source.Action
                                @if (source.Running > 1)
                                {
                                    <span class="muted" title="Running at once"> × @source.Running</span>
                                }
                                @if (source.Via is not null || source.Processes > 0 || source.InApp)
                                {
                                    <div class="muted" style="font-size:12px;margin-left:18px;">
                                        @Detail(source)
                                    </div>
                                }
                            </td>
                            <td class="num">@Pct(source.Now)</td>
                            <td class="num">@Pct(source.Average)</td>
                            <td class="num" title="@(source.Peak > 0 ? $"Peaked at {Clock(source.PeakAt)}" : null)">
                                @Pct(source.Peak)
                                @if (source.Peak >= 1)
                                {
                                    <div class="muted" style="font-size:12px;">@Ago(source.PeakAt)</div>
                                }
                            </td>
                            <td class="num">@(source.Memory > 0 ? ResourceMonitor.Bytes(source.Memory) : "–")</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (shown.Count > 12)
            {
                <button class="btn btn-sm btn-ghost" type="button" style="margin-top:8px;" @onclick="() => Toggle(sourcesKey)">
                    @(_expanded.Contains(sourcesKey) ? "Show fewer" : $"Show all {shown.Count}")
                </button>
            }
        }
    </div>

    <div class="card">
        <div class="card-head">
            <h2>Recent work</h2>
            <div class="segmented perf-toggle" role="group" aria-label="Sort by">
                <button type="button" class="@(_workByPeak ? "" : "on")" @onclick="() => _workByPeak = false">Newest</button>
                <button type="button" class="@(_workByPeak ? "on" : "")" @onclick="() => _workByPeak = true">Heaviest</button>
            </div>
        </div>
        <p class="hint" style="margin-top:0;">Every job plugins have run in the last @((int)ResourceMonitor.HistoryLength.TotalMinutes) minutes, with what it cost while it ran: find a hitch's time here.</p>
        @{
            List<WorkUsage> work = [.. (_workByPeak
                ? _work.OrderByDescending(item => item.PeakCpuPercent).ThenByDescending(item => item.AverageCpuPercent)
                : _work.OrderByDescending(item => item.Ended is null).ThenByDescending(item => item.Started))];
            const string workKey = "work";
        }
        @if (work.Count == 0)
        {
            <p class="muted" style="margin:0;">Nothing's run yet.</p>
        }
        else
        {
            <table class="perf-table">
                <thead>
                    <tr>
                        <th>Job</th>
                        <th class="num">Started</th>
                        <th class="num">Took</th>
                        <th class="num">Average</th>
                        <th class="num">Peak</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (WorkUsage item in work.Take(_expanded.Contains(workKey) ? int.MaxValue : 15))
                    {
                        <tr>
                            <td>
                                <span class="perf-swatch" style="background:@ColourFor(item.Label)"></span><strong>@item.Source</strong> – @item.Action
                                @if (item.Subject is not null || item.Via is not null)
                                {
                                    <div class="muted" style="font-size:12px;margin-left:18px;">
                                        @WorkDetail(item)
                                    </div>
                                }
                            </td>
                            <td class="num muted" title="@Clock(item.Started)">@Ago(item.Started)</td>
                            <td class="num">
                                @if (item.Ended is null)
                                {
                                    <span class="pill pill-ok">Running</span> <span>@Duration(item.Duration)</span>
                                }
                                else
                                {
                                    @Duration(item.Duration)
                                }
                            </td>
                            <td class="num">@Pct(item.AverageCpuPercent)</td>
                            <td class="num">@Pct(item.PeakCpuPercent)</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (work.Count > 15)
            {
                <button class="btn btn-sm btn-ghost" type="button" style="margin-top:8px;" @onclick="() => Toggle(workKey)">
                    @(_expanded.Contains(workKey) ? "Show fewer" : $"Show all {work.Count}")
                </button>
            }
        }
    </div>

    @foreach (UsageGroup group in latest.Groups)
    {
        bool showSource = group.Key == ResourceMonitor.HelpersKey;
        <div class="card">
            <div class="card-head">
                <h2><span class="perf-swatch" style="background:@Colour(group.Key)"></span>@group.Name</h2>
                <span class="muted">@Pct(group.CpuPercent) CPU · @ResourceMonitor.Bytes(group.MemoryBytes)</span>
            </div>
            <p class="hint" style="margin-top:0;">@group.Description</p>
            @if (group.Processes.Count == 0)
            {
                <p class="muted" style="margin:0;">Nothing running right now.</p>
            }
            else
            {
                <table class="perf-table">
                    <thead>
                        <tr>
                            <th>Process</th><th>What it is</th>
                            @if (showSource)
                            {
                                <th>Started for</th>
                            }
                            <th class="num">PID</th><th class="num">CPU</th><th class="num">Memory</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ProcessUsage process in group.Processes.Take(_expanded.Contains(group.Key) ? int.MaxValue : 8))
                        {
                            <tr>
                                <td>@process.Name</td>
                                <td class="muted">@process.Role</td>
                                @if (showSource)
                                {
                                    <td>@(process.Source ?? "Not named")</td>
                                }
                                <td class="num muted">@process.Pid</td>
                                <td class="num">@Pct(process.CpuPercent)</td>
                                <td class="num">@ResourceMonitor.Bytes(process.MemoryBytes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (group.Processes.Count > 8)
                {
                    <button class="btn btn-sm btn-ghost" type="button" style="margin-top:8px;" @onclick="() => Toggle(group.Key)">
                        @(_expanded.Contains(group.Key) ? "Show fewer" : $"Show all {group.Processes.Count}")
                    </button>
                }
            }
        </div>
    }

    @if (AlwaysOn.Statuses is { Count: > 0 } statuses)
    {
        <div class="card">
            <div class="card-head">
                <h2>24/7 channels</h2>
                <span class="muted">Kept playing in ErsatzTV, checked every @((int)AlwaysOnKeeper.Interval.TotalSeconds) seconds</span>
            </div>
            <table class="perf-table">
                <thead><tr><th>Channel</th><th>State</th></tr></thead>
                <tbody>
                    @foreach (AlwaysOnStatus status in statuses)
                    {
                        <tr>
                            <td>@status.Number · @status.Name</td>
                            <td>
                                @if (status.Problem is not null)
                                {
                                    <span class="pill pill-warn">Not playing</span> <span class="muted">@status.Problem</span>
                                }
                                else
                                {
                                    <span class="pill pill-ok">Playing</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (latest.Gpus.Count > 0)
    {
        <div class="card">
            <div class="card-head"><h2>Graphics cards</h2></div>
            <table class="perf-table">
                <thead>
                    <tr><th>Card</th><th class="num">Busy</th><th class="num">Encoder</th><th class="num">Decoder</th><th class="num">Memory</th></tr>
                </thead>
                <tbody>
                    @foreach (GpuUsage card in latest.Gpus)
                    {
                        <tr>
                            <td>@card.Name</td>
                            <td class="num">@Maybe(card.Utilization)</td>
                            <td class="num">@Maybe(card.Encoder)</td>
                            <td class="num">@Maybe(card.Decoder)</td>
                            <td class="num">@(card.MemoryUsedBytes is not null && card.MemoryTotalBytes is not null ? $"{ResourceMonitor.Bytes(card.MemoryUsedBytes.Value)} / {ResourceMonitor.Bytes(card.MemoryTotalBytes.Value)}" : "–")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const double Width = 600;
    private const double Height = 160;
    private const double Gutter = 40;

    /// <summary>How many sources get a line of their own on the charts.</summary>
    private const int ChartLines = 6;

    // Distinct in both themes; handed out in order as sources first appear, so a source keeps its colour.
    private static readonly string[] Palette =
        ["#5b8def", "#f28e2b", "#e15759", "#4fb6ac", "#59a14f", "#e0b93a", "#b07aa1", "#ff9da7", "#a0785a", "#8cc2e8", "#9c9ede", "#c7c95b"];

    private ResourceSample? _latest;
    private IReadOnlyList<ResourceSample> _history = [];
    private IReadOnlyList<PerformanceAdvice> _advice = [];
    private IReadOnlyList<SourceStats> _sources = [];
    private IReadOnlyList<WorkUsage> _work = [];
    private readonly HashSet<string> _expanded = [];
    private readonly Dictionary<string, string> _colours = new(StringComparer.Ordinal);
    private bool _byGroup;
    private bool _sourcesByPeak = true;
    private bool _workByPeak;

    /// <summary>One line on a chart: its name, colour, dashed or not, and its value at a sample (null leaves a gap).</summary>
    public sealed record Series(string Name, string Colour, bool Dashed, Func<ResourceSample, double?> Value);

    /// <summary>A source over the whole history: now, on average, at its peak.</summary>
    public sealed record SourceStats(
        string Key,
        string Source,
        string Action,
        string? Via,
        double Now,
        double Average,
        double Peak,
        DateTimeOffset PeakAt,
        long Memory,
        long PeakMemory,
        int Processes,
        int Running,
        bool InApp);

    protected override void OnInitialized()
    {
        Refresh();
        Monitor.Sampled += OnSampled;
    }

    public void Dispose() => Monitor.Sampled -= OnSampled;

    private void OnSampled() => InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private void Refresh()
    {
        _history = Monitor.History;
        _latest = _history.Count > 0 ? _history[^1] : null;
        _advice = Monitor.Advice();
        _work = Monitor.RecentWork;
        _sources = Summarise(_history);
    }

    /// <summary>Each source's numbers across the history; a sample it's missing from counts as nothing.</summary>
    private static List<SourceStats> Summarise(IReadOnlyList<ResourceSample> history)
    {
        if (history.Count == 0)
        {
            return [];
        }

        ResourceSample latest = history[^1];
        Dictionary<string, (SourceUsage Last, double Sum, double Peak, DateTimeOffset PeakAt, long PeakMemory, bool InApp)> seen = new(StringComparer.Ordinal);
        foreach (ResourceSample sample in history)
        {
            foreach (SourceUsage source in sample.Sources)
            {
                (SourceUsage Last, double Sum, double Peak, DateTimeOffset PeakAt, long PeakMemory, bool InApp) known =
                    seen.TryGetValue(source.Key, out var found) ? found : (source, 0d, -1d, sample.At, 0L, false);
                known.Last = source;
                known.Sum += source.CpuPercent;
                if (source.CpuPercent > known.Peak)
                {
                    known.Peak = source.CpuPercent;
                    known.PeakAt = sample.At;
                }

                known.PeakMemory = Math.Max(known.PeakMemory, source.MemoryBytes);
                known.InApp |= source.InAppCpuPercent > 0.05;
                seen[source.Key] = known;
            }
        }

        return [.. seen.Select(pair =>
        {
            SourceUsage? now = latest.Source(pair.Key);
            SourceUsage last = pair.Value.Last;
            return new SourceStats(pair.Key, last.Source, last.Action, now?.Via ?? last.Via,
                now?.CpuPercent ?? 0, pair.Value.Sum / history.Count, Math.Max(0, pair.Value.Peak), pair.Value.PeakAt,
                now?.MemoryBytes ?? 0, pair.Value.PeakMemory, now?.Processes ?? 0, now?.Running ?? 0, pair.Value.InApp);
        })];
    }

    private void Toggle(string key)
    {
        if (!_expanded.Remove(key))
        {
            _expanded.Add(key);
        }
    }

    private static string Colour(string key) => key switch
    {
        ResourceMonitor.SetupKey => "var(--accent)",
        ResourceMonitor.ErsatzKey => "var(--ok)",
        ResourceMonitor.HelpersKey => "var(--warn)",
        _ => "var(--muted)"
    };

    /// <summary>A source's colour: SchedularrTV's own and ErsatzTV's keep their usual ones, the rest come from the palette.</summary>
    private string ColourFor(string key)
    {
        if (key == $"{ResourceMonitor.AppSource} – {ResourceMonitor.AppAction}")
        {
            return "var(--accent)";
        }

        if (!_colours.TryGetValue(key, out string? colour))
        {
            _colours[key] = colour = Palette[_colours.Count % Palette.Length];
        }

        return colour;
    }

    private static string Detail(SourceStats source)
    {
        List<string> parts = [];
        if (source.Via is not null)
        {
            parts.Add($"for {source.Via}");
        }

        if (source.Processes > 0 && source.Source != ResourceMonitor.AppSource)
        {
            parts.Add($"{source.Processes} process{(source.Processes == 1 ? "" : "es")}");
        }

        if (source.InApp)
        {
            parts.Add("inside the app (estimated)");
        }

        return string.Join(" · ", parts);
    }

    private IReadOnlyList<Series> SourceCpuSeries()
    {
        List<Series> series = [new("Whole computer", "var(--muted)", true, sample => sample.SystemCpuPercent)];
        foreach (SourceStats source in _sources.Where(source => source.Peak >= 0.5).OrderByDescending(source => source.Peak).Take(ChartLines))
        {
            string key = source.Key;
            series.Add(new Series(key, ColourFor(key), false, sample => sample.Source(key)?.CpuPercent ?? 0));
        }

        series.Add(new Series("GPU encoder", "#b07ad0", true, sample => sample.Gpus.FirstOrDefault()?.Encoder));
        return series;
    }

    private IReadOnlyList<Series> SourceMemorySeries()
    {
        List<Series> series = [];
        foreach (SourceStats source in _sources.Where(source => source.PeakMemory > 0).OrderByDescending(source => source.PeakMemory).Take(ChartLines))
        {
            string key = source.Key;
            series.Add(new Series(key, ColourFor(key), false, sample => Gigabytes(sample.Source(key)?.MemoryBytes ?? 0)));
        }

        return series;
    }

    private static IReadOnlyList<Series> GroupCpuSeries() =>
    [
        new("Whole computer", "var(--muted)", true, sample => sample.SystemCpuPercent),
        new("SchedularrTV", Colour(ResourceMonitor.SetupKey), false, sample => sample.Group(ResourceMonitor.SetupKey)?.CpuPercent),
        new("ErsatzTV", Colour(ResourceMonitor.ErsatzKey), false, sample => sample.Group(ResourceMonitor.ErsatzKey)?.CpuPercent),
        new("Helpers", Colour(ResourceMonitor.HelpersKey), false, sample => sample.Group(ResourceMonitor.HelpersKey)?.CpuPercent),
        new("GPU encoder", "#b07ad0", true, sample => sample.Gpus.FirstOrDefault()?.Encoder)
    ];

    private static double? Gigabytes(long? bytes) => bytes is { } value ? value / (double)(1 << 30) : null;

    private static IReadOnlyList<Series> GroupMemorySeries() =>
    [
        new("SchedularrTV", Colour(ResourceMonitor.SetupKey), false, sample => Gigabytes(sample.Group(ResourceMonitor.SetupKey)?.MemoryBytes)),
        new("ErsatzTV", Colour(ResourceMonitor.ErsatzKey), false, sample => Gigabytes(sample.Group(ResourceMonitor.ErsatzKey)?.MemoryBytes)),
        new("Helpers", Colour(ResourceMonitor.HelpersKey), false, sample => Gigabytes(sample.Group(ResourceMonitor.HelpersKey)?.MemoryBytes))
    ];

    private static RenderFragment LegendFor(IReadOnlyList<Series> series) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "perf-legend");
        foreach (Series line in series)
        {
            builder.OpenElement(2, "span");
            builder.OpenElement(3, "i");
            builder.AddAttribute(4, "class", line.Dashed ? "dashed" : null);
            builder.AddAttribute(5, "style", $"border-color:{line.Colour}");
            builder.CloseElement();
            builder.AddContent(6, line.Name);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private string TranscodingNote(UsageGroup? ersatz) =>
        $"{AlwaysOn.Statuses.Count} set to 24/7" + (ersatz is { Processes.Count: 0 } ? " · ErsatzTV isn't running" : string.Empty);

    private static string Maybe(double? value) => value is { } known ? Pct(known) : "–";

    private static string Pct(double value) => value < 10 ? $"{value.ToString("0.0", CultureInfo.CurrentCulture)}%" : $"{value.ToString("0", CultureInfo.CurrentCulture)}%";

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private static string Clock(DateTimeOffset at) => at.ToLocalTime().ToString("T", CultureInfo.CurrentCulture);

    private static string WorkDetail(WorkUsage item) =>
        string.Join(" · ", new[] { item.Subject, item.Via is null ? null : $"for {item.Via}" }.OfType<string>());

    private static string Ago(DateTimeOffset at)
    {
        TimeSpan ago = DateTimeOffset.UtcNow - at;
        return ago < TimeSpan.FromMinutes(1) ? "just now"
            : ago < TimeSpan.FromHours(1) ? $"{(int)ago.TotalMinutes} min ago"
            : $"{(int)ago.TotalHours} h ago";
    }

    private static string Duration(TimeSpan span) => span switch
    {
        { TotalSeconds: < 1 } => "<1s",
        { TotalMinutes: < 1 } => $"{(int)span.TotalSeconds}s",
        { TotalHours: < 1 } => $"{(int)span.TotalMinutes}m {span.Seconds:00}s",
        _ => $"{(int)span.TotalHours}h {span.Minutes:00}m"
    };

    /// <summary>A line chart of <paramref name="series"/> over the history, from 0 to <paramref name="max"/>, across the whole window.</summary>
    private static RenderFragment Chart(IReadOnlyList<ResourceSample> history, double max, string unit, IReadOnlyList<Series> series) => builder =>
    {
        DateTimeOffset end = history.Count > 0 ? history[^1].At : DateTimeOffset.UtcNow;
        DateTimeOffset start = end - ResourceMonitor.HistoryLength;
        double X(DateTimeOffset at) => Gutter + (at - start).TotalSeconds / ResourceMonitor.HistoryLength.TotalSeconds * (Width - Gutter);
        double Y(double value) => Height - Math.Clamp(value / max, 0, 1) * Height;

        int seq = 0;
        builder.OpenElement(seq++, "svg");
        builder.AddAttribute(seq++, "class", "perf-chart");
        builder.AddAttribute(seq++, "viewBox", $"0 0 {F(Width)} {F(Height + 22)}");
        builder.AddAttribute(seq++, "role", "img");

        foreach (double tick in new[] { 0, 0.25, 0.5, 0.75, 1 })
        {
            double y = Y(tick * max);
            builder.OpenElement(seq++, "line");
            builder.AddAttribute(seq++, "class", "grid-line");
            builder.AddAttribute(seq++, "x1", F(Gutter));
            builder.AddAttribute(seq++, "x2", F(Width));
            builder.AddAttribute(seq++, "y1", F(y));
            builder.AddAttribute(seq++, "y2", F(y));
            builder.CloseElement();

            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "class", "axis");
            builder.AddAttribute(seq++, "x", "0");
            builder.AddAttribute(seq++, "y", F(y + 3));
            double label = tick * max;
            builder.AddContent(seq++, unit == "%" ? $"{label:0}%" : $"{label.ToString(label < 1 ? "0.##" : "0.#", CultureInfo.CurrentCulture)} {unit}");
            builder.CloseElement();
        }

        foreach ((string text, DateTimeOffset at, string anchor) in new[] { ($"-{(int)ResourceMonitor.HistoryLength.TotalMinutes} min", start, "start"), ("now", end, "end") })
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "class", "axis");
            builder.AddAttribute(seq++, "x", F(X(at)));
            builder.AddAttribute(seq++, "y", F(Height + 16));
            builder.AddAttribute(seq++, "text-anchor", anchor);
            builder.AddContent(seq++, text);
            builder.CloseElement();
        }

        foreach (Series line in series)
        {
            // A gap in the data (null, or the app restarting) starts a new line rather than joining across it.
            List<List<string>> runs = [[]];
            foreach (ResourceSample sample in history)
            {
                if (line.Value(sample) is { } value)
                {
                    runs[^1].Add($"{F(X(sample.At))},{F(Y(value))}");
                }
                else if (runs[^1].Count > 0)
                {
                    runs.Add([]);
                }
            }

            foreach (List<string> run in runs.Where(run => run.Count > 1))
            {
                builder.OpenElement(seq++, "polyline");
                builder.AddAttribute(seq++, "class", line.Dashed ? "line dashed" : "line");
                builder.AddAttribute(seq++, "style", $"stroke:{line.Colour}");
                builder.AddAttribute(seq++, "points", string.Join(' ', run));
                // Hovering a line names it.
                builder.OpenElement(seq++, "title");
                builder.AddContent(seq++, line.Name);
                builder.CloseElement();
                builder.CloseElement();
            }
        }

        builder.CloseElement();
    };
}
