@page "/collections"
@inherits EditorPage
@inject LibraryBrowser Library
@inject IJSRuntime JS

<PageHeader Title="Collections" Eyebrow="Programming">
    <ChildContent>Shared programming for channels.</ChildContent>
    <Actions>
        <button class="btn btn-primary" @onclick="OpenCreate"><Icon Name="plus" Size="15" />Create</button>
    </Actions>
</PageHeader>

<dialog class="modal" @ref="_createDialog" aria-labelledby="create-collection-title">
    <form @onsubmit="Add" @onsubmit:preventDefault="true">
        <div class="modal-head">
            <h2 id="create-collection-title">Create collection</h2>
        </div>
        <label class="field">
            <span>Collection name</span>
            <input type="text" @bind="_newName" @bind:event="oninput" required autofocus
                   aria-invalid="@(_error is not null ? "true" : "false")"
                   aria-describedby="@(_error is not null ? "create-collection-error" : null)" />
        </label>
        @if (_error is not null)
        {
            <p class="field-error" id="create-collection-error" role="alert">@_error</p>
        }
        <div class="wizard-foot">
            <div class="spacer"></div>
            <button class="btn" type="button" @onclick="CloseCreate">Cancel</button>
            <button class="btn btn-primary" type="submit" disabled="@(_newName.Trim().Length == 0)">Create</button>
        </div>
    </form>
</dialog>

@if (Editor.Working.GlobalCollections.Count == 0)
{
    <div class="empty">
        <Icon Name="layers" Size="32" StrokeWidth="1.5" />
        <div class="empty-title">No collections yet</div>
        <div>Create one above, then add titles to it from the TV Shows or Movies pages.</div>
    </div>
}

@foreach ((string key, ContentSelector selector) in Editor.Working.GlobalCollections.OrderBy(c => c.Key))
{
    bool open = _expanded.Contains(key);
    <div class="card" @key="key">
        <div class="card-head collapsible @(open ? "" : "collapsed")" @onclick="() => Toggle(key)"
             role="button" aria-expanded="@(open ? "true" : "false")">
            <Icon Name="@(open ? "chevron-down" : "chevron-right")" Size="16" Class="muted" />
            <div class="poster-stack">
                @foreach (ContentInclude include in selector.Include.Take(6))
                {
                    <Artwork Id="@ArtId(include)" Title="@(include.Show ?? include.Describe())" Width="72" />
                }
                @if (selector.Include.Count > 6)
                {
                    <span class="more">+@(selector.Include.Count - 6)</span>
                }
            </div>
            <h2>@key</h2>
            <span class="pill pill-muted">@Summarise(selector)</span>
            <div class="spacer"></div>
            <div class="row" @onclick:stopPropagation="true">
                @if (_confirmDelete == key)
                {
                    <button class="btn btn-sm btn-danger confirm" @onclick="() => Remove(key)">Delete?</button>
                    <button class="btn btn-sm btn-icon" title="Cancel" aria-label="Cancel delete" @onclick="() => _confirmDelete = null"><Icon Name="x" Size="14" /></button>
                }
                else
                {
                    <button class="btn btn-sm btn-icon btn-danger" title="Delete" aria-label="@($"Delete {key}")" @onclick="() => _confirmDelete = key"><Icon Name="trash" Size="14" /></button>
                }
            </div>
        </div>

        @if (open)
        {
            <SelectorEditor Selector="selector" Label="Contents" DefaultMode="include" Changed="Editor.MarkDirty" />
        }
    </div>
}

@code {
    private string _newName = "";
    private ElementReference _createDialog;
    private string? _error;
    private string? _confirmDelete;
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> _showIds = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string?> _movieIds = new(StringComparer.OrdinalIgnoreCase);

    // Artwork for entries saved before show ids were recorded; the library loads in the background.
    protected override async Task OnInitializedAsync()
    {
        _showIds = (await Library.GetShowsAsync())
            .DistinctBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(s => s.Name, s => s.Id, StringComparer.OrdinalIgnoreCase);
        _movieIds = (await Library.GetMoviesAsync())
            .DistinctBy(m => m.Title, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(m => m.Title, m => m.Id, StringComparer.OrdinalIgnoreCase);
    }

    private string? ArtId(ContentInclude include) =>
        include.ShowId is { Length: > 0 } id ? id
        : include.Show is { Length: > 0 } show ? _showIds.GetValueOrDefault(show)
        : include.Movie is { Length: > 0 } movie ? _movieIds.GetValueOrDefault(movie)
        : null;

    private void Toggle(string key)
    {
        if (!_expanded.Add(key))
        {
            _expanded.Remove(key);
        }
    }

    private async Task OpenCreate()
    {
        _newName = "";
        _error = null;
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
        await module.InvokeVoidAsync("show", _createDialog);
    }

    private async Task CloseCreate()
    {
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
        await module.InvokeVoidAsync("close", _createDialog);
    }

    private async Task Add()
    {
        string key = _newName.Trim();
        _error = null;

        if (key.Length == 0)
        {
            return;
        }

        if (Editor.Working.GlobalCollections.ContainsKey(key))
        {
            _error = $"A collection called \"{key}\" already exists.";
            return;
        }

        Editor.Working.GlobalCollections[key] = new ContentSelector
        {
            Order = PlaybackOrder.Shuffle,
            TitleOrder = TitleOrder.Shuffle
        };

        // A collection you just named is the one you want to fill in.
        _expanded.Add(key);
        _newName = "";
        Editor.MarkDirty();
        await CloseCreate();
    }

    private void Remove(string key)
    {
        _confirmDelete = null;
        Editor.Working.GlobalCollections.Remove(key);
        _expanded.Remove(key);
        Editor.MarkDirty();
    }

    private static string Summarise(ContentSelector selector)
    {
        if (selector.Include.Count > 0)
        {
            return $"{selector.Include.Count} title(s)";
        }

        return string.IsNullOrWhiteSpace(selector.Query) ? "empty" : "query";
    }
}
