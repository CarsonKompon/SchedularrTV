@page "/"
@implements IDisposable
@using System.Globalization
@using SchedularrTV.Service.Stats
@inject IEnumerable<DashboardCard> Cards
@inject ConfigEditor Editor
@inject ScheduleCoordinator Coordinator
@inject IEnumerable<IMediaSourceInfo> MediaSources
@inject ViewingStore Viewing
@inject ViewingRecorder Recorder
@inject Microsoft.Extensions.Options.IOptionsMonitor<SchedularrTV.Providers.ErsatzTv.ErsatzTvOptions> Ersatz
@inject NavigationManager Navigation
@inject IJSRuntime JS

<header class="dashboard-heading">
    <div><h1>Dashboard</h1><span class="dashboard-date">@DateTimeOffset.Now.ToString("dddd, d MMMM")</span></div>
    <span class="pill @(Coordinator.Failures.Count > 0 ? "pill-warn" : Coordinator.IsBuilding ? "pill-accent" : "pill-muted")">
        @if (Coordinator.IsBuilding) { <span class="spinner spinner-sm"></span> }
        @(Coordinator.IsBuilding ? "Building schedules" : Coordinator.Failures.Count > 0 ? $"{Coordinator.Failures.Count} build failure(s)" : "Schedule overview")
    </span>
</header>

<div class="dashboard-overview">
    <section class="dashboard-panel player-panel" aria-labelledby="player-heading">
        <div class="panel-heading">
            <h2 id="player-heading"><Icon Name="tv" Size="17" />IPTV player links</h2>
            <span class="panel-caption">Playlist + programme guide</span>
        </div>
        <div class="player-addresses">
            @foreach ((string label, string url) in WatchLinks)
            {
                <div class="player-address">
                    <label for="@(label == "Playlist · M3U" ? "playlist-url" : "guide-url")">@label</label>
                    <div class="player-address-controls">
                        <input id="@(label == "Playlist · M3U" ? "playlist-url" : "guide-url")" type="text" readonly value="@url" spellcheck="false" />
                        <button type="button" class="btn btn-sm" @onclick="() => Copy(url)" aria-label="@($"Copy {label}")">
                            <Icon Name="@(_copied == url ? "check" : "copy")" Size="14" />@(_copied == url ? "Copied" : "Copy")
                        </button>
                        <a class="btn btn-sm btn-ghost btn-icon" href="@url" target="_blank" rel="noopener noreferrer" aria-label="@($"Open {label}")" title="Open link"><Icon Name="external-link" Size="14" /></a>
                    </div>
                </div>
            }
        </div>
        <div class="player-footnote" role="status">
            @if (_copyFailed)
            {
                <span class="copy-problem">Clipboard unavailable. Select and copy the address.</span>
            }
            else
            {
                <span>Add both URLs to your IPTV player.</span>
            }
            @if (!Ersatz.CurrentValue.ManageProcess)
            {
                <span>ErsatzTV must be running.</span>
            }
        </div>
    </section>

    <section class="dashboard-panel audience-panel" aria-labelledby="audience-heading">
        <div class="panel-heading">
            <h2 id="audience-heading"><Icon Name="activity" Size="17" />Viewing</h2>
            <span class="panel-caption">Last 24 hours</span>
        </div>
        <div class="audience-total">
            <strong>@(_statsLoaded ? Duration(_recent.Sum(row => row.ViewerMinutes)) : "—")</strong>
            <span>viewer time <span aria-hidden="true">·</span> @(_statsLoaded ? $"{_recent.Count} watched channels" : "awaiting history")</span>
        </div>
        @if (_recent.Count > 0)
        {
            <ol class="audience-ranking" aria-label="Most watched channels in the last 24 hours">
                @foreach (ChannelViewingTotal top in _recent.Take(3))
                {
                    <li>
                        <div class="ranking-line">
                            @if (Editor.FindChannel(top.ChannelId) is { } channel)
                            {
                                <a href="@($"channels/{Uri.EscapeDataString(channel.Id)}?tab=stats")" title="@channel.Name">@channel.Name</a>
                            }
                            else
                            {
                                <span class="ranking-name" title="@ChannelName(top.ChannelId)">@ChannelName(top.ChannelId)</span>
                            }
                            <span>@Duration(top.ViewerMinutes)</span>
                        </div>
                        <div class="ranking-meter" aria-hidden="true"><span style="width:@((100.0 * top.ViewerMinutes / _recent[0].ViewerMinutes).ToString("0.#", CultureInfo.InvariantCulture))%"></span></div>
                    </li>
                }
            </ol>
        }
        else
        {
            <p class="audience-empty">@(_statsError is not null ? "Viewing history unavailable" : _statsLoaded ? "No viewing recorded in the last 24 hours" : "Loading viewing history…")</p>
        }
        <div class="history-leader" title="Based on retained viewing history">
            <span>All-history leader</span>
            @if (_allTime.FirstOrDefault() is { } leader)
            {
                <strong title="@ChannelName(leader.ChannelId)">@ChannelName(leader.ChannelId)</strong>
                <span>@Duration(leader.ViewerMinutes)</span>
            }
            else
            {
                <span>@(_statsLoaded ? "No viewing yet" : "—")</span>
            }
        </div>
    </section>

    <dl class="dashboard-status" aria-label="Live overview">
        <div>
            <dt>On air</dt>
            <dd><strong>@OnAirCount</strong><span>/ @(Editor.Working.Channels.Count + Coordinator.External.Count) channels</span></dd>
        </div>
        <div title="@SampleDescription">
            <dt>Viewers · latest sample</dt>
            <dd><strong>@(HasRecentSample ? Recorder.Now.Values.Sum(viewers => viewers.Count).ToString("N0") : "—")</strong><span>@(HasRecentSample ? "watching" : "awaiting sample")</span></dd>
        </div>
        <div>
            <dt>Guide coverage · earliest end</dt>
            <dd><strong class="status-time">@(GuideThrough is { } through ? through.ToLocalTime().ToString("ddd HH:mm") : "—")</strong><span>@(GuideThrough is { } end && end <= DateTimeOffset.UtcNow ? "expired" : "scheduled")</span></dd>
        </div>
        <div>
            <dt>Last schedule build</dt>
            <dd><strong class="status-time">@(Coordinator.LastBuiltAt is { } built ? built.ToLocalTime().ToString("ddd HH:mm") : "—")</strong><span>@(Coordinator.IsBuilding ? "rebuilding" : "local time")</span></dd>
        </div>
    </dl>
</div>
@if (_statsError is not null)
{
    <div class="banner banner-warn" role="status">@_statsError</div>
}

@if (Editor.Warnings.Count > 0)
{
    <details class="card">
        <summary>@Editor.Warnings.Count configuration warning(s)</summary>
        <ul>@foreach (string warning in Editor.Warnings) { <li>@warning</li> }</ul>
    </details>
}

@foreach (IMediaSourceInfo source in _sources)
{
    @if (source.Loading is { } loading)
    {
        <div class="activity" role="status">
            <div class="spinner spinner-sm"></div>
            <div class="activity-body">
                <div class="activity-title">Reading @source.Name</div>
                <div class="activity-detail">@loading.Stage · @loading.Items.ToString("N0") items</div>
                @if (loading.Percent is { } percent)
                {
                    <progress aria-label="Library progress" max="100" value="@percent.ToString("0.#", CultureInfo.InvariantCulture)"></progress>
                }
            </div>
        </div>
    }
}
@foreach (MediaSourceActivity scan in _serverActivity)
{
    <div class="activity" role="status">
        <div class="spinner spinner-sm"></div>
        <div class="activity-body">
            <div class="activity-title">@scan.Description</div>
            @if (scan.Percent is { } percent)
            {
                <progress aria-label="@scan.Description" max="100" value="@percent.ToString("0.#", CultureInfo.InvariantCulture)"></progress>
            }
        </div>
    </div>
}
@if (Coordinator.IsBuilding)
{
    <div class="activity" role="status">
        <div class="spinner spinner-sm"></div>
        <div class="activity-body">
            <div class="activity-title">Building schedules</div>
            @if (Coordinator.Progress is { } progress)
            {
                <div class="activity-detail">@progress.CompletedChannels of @progress.TotalChannels · @progress.ChannelName · @progress.Stage</div>
                <progress aria-label="Schedule build progress" max="100" value="@progress.Percent.ToString("0.#", CultureInfo.InvariantCulture)"></progress>
            }
        </div>
    </div>
}
@foreach (DashboardCard card in Cards.OrderBy(card => card.Order))
{
    <DynamicComponent Type="card.Component" />
}
@foreach (ChannelBuildFailure failure in Coordinator.Failures.Values.OrderBy(f => f.ChannelName))
{
    <div class="activity danger" role="alert">
        <Icon Name="alert" Size="18" />
        <div class="activity-body">
            <div class="activity-title">@failure.ChannelName · build failed</div>
            <div class="activity-detail">@failure.Message</div>
            <div class="activity-detail">@(Coordinator.Latest.Any(s => s.ChannelId == failure.ChannelId) ? "Playing the previous schedule." : "Off air: no previous schedule.")</div>
        </div>
        <a class="btn btn-sm" href="@($"channels/{Uri.EscapeDataString(failure.ChannelId)}")">Edit</a>
        <button class="btn btn-sm" disabled="@(_rebuilding is not null)" @onclick="() => Rebuild(failure.ChannelId)">@(_rebuilding == failure.ChannelId ? "Rebuilding…" : "Rebuild")</button>
    </div>
}
@if (_rebuildError is not null)
{
    <div class="banner banner-error" role="alert">@_rebuildError</div>
}

<section class="card" aria-label="Channel guide">
    <div class="card-head"><h2>Guide</h2><span class="muted">@AllSchedules.Count channels · Local time</span></div>
    @if (AllSchedules.Count > 0)
    {
        <GuideGrid Schedules="AllSchedules" />
    }
    else
    {
        <div class="empty">
            <Icon Name="radio" Size="32" />
            <div class="empty-title">@(Coordinator.IsBuilding ? "Building your guide…" : "No schedules yet")</div>
            @if (!Coordinator.IsBuilding)
            {
                <a class="btn btn-primary" href="channels">Set up a channel</a>
            }
        </div>
    }
</section>

@code {
    private readonly CancellationTokenSource _life = new();
    private IMediaSourceInfo[] _sources = [];
    private IReadOnlyList<MediaSourceActivity> _serverActivity = [];
    private IReadOnlyList<ChannelViewingTotal> _allTime = [], _recent = [];
    private bool _statsLoaded, _copyFailed;
    private string? _statsError, _copied, _rebuilding, _rebuildError;
    private DateTimeOffset _statsAt = DateTimeOffset.MinValue;

    private IReadOnlyList<ChannelSchedule> AllSchedules => [.. Coordinator.Latest, .. Coordinator.External.Select(e => e.Schedule)];
    private int OnAirCount => AllSchedules.Count(s => s.Entries.Any(e => e.Start <= DateTimeOffset.UtcNow && e.End > DateTimeOffset.UtcNow));
    private string ChannelName(string id) => Editor.FindChannel(id)?.Name ?? Coordinator.External.FirstOrDefault(e => e.Schedule.ChannelId == id)?.Schedule.ChannelName ?? id;
    private DateTimeOffset? GuideThrough => AllSchedules.Select(s => (DateTimeOffset?)s.End).Min();
    private bool HasRecentSample => Recorder.LastSample is { } sample && DateTimeOffset.UtcNow - sample < TimeSpan.FromMinutes(2);
    private string SampleDescription => Recorder.LastSample is { } sample ? $"Last sampled {sample.ToLocalTime():ddd HH:mm:ss}" : "No audience sample recorded yet";
    private static string Duration(long minutes) => minutes >= 60 ? $"{minutes / 60:N0}h {minutes % 60}m" : $"{minutes}m";

    private IEnumerable<(string Label, string Url)> WatchLinks
    {
        get
        {
            string host = new Uri(Navigation.BaseUri).DnsSafeHost;
            if (host.Contains(':')) host = $"[{host}]";
            string root = $"http://{host}:{Ersatz.CurrentValue.Lineup.Port}";
            yield return ("Playlist · M3U", $"{root}/channels.m3u");
            yield return ("Guide · XMLTV", $"{root}/xmltv.xml");
        }
    }

    protected override void OnInitialized()
    {
        _sources = [.. MediaSources];
        Coordinator.StateChanged += OnChanged;
        Editor.Changed += OnChanged;
        foreach (IMediaSourceInfo source in _sources) source.LoadingChanged += OnChanged;
        _ = PollAsync(_life.Token);
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        try
        {
            do
            {
                if (DateTimeOffset.UtcNow - _statsAt >= TimeSpan.FromMinutes(1))
                {
                    try
                    {
                        long now = ViewingStore.ToMinute(DateTimeOffset.UtcNow);
                        var totals = await Task.Run(() => (Viewing.ChannelTotals(0, now + 1), Viewing.ChannelTotals(now + 1 - 1440, now + 1)), token);
                        _allTime = totals.Item1;
                        _recent = totals.Item2;
                        _statsLoaded = true;
                        _statsError = null;
                    }
                    catch (Exception ex) when (ex is not OperationCanceledException)
                    {
                        _statsError = "Viewing stats are unavailable. Retrying in a minute.";
                    }
                    _statsAt = DateTimeOffset.UtcNow;
                }
                List<MediaSourceActivity> activity = [];
                foreach (IMediaSourceInfo source in _sources.Where(s => s.IsConfigured))
                {
                    try
                    {
                        if (await source.GetActivityAsync(token) is { } scan) activity.Add(scan);
                    }
                    catch (Exception ex) when (ex is not OperationCanceledException) { }
                }
                _serverActivity = activity;
                if (!token.IsCancellationRequested) await InvokeAsync(StateHasChanged);
            }
            while (await timer.WaitForNextTickAsync(token));
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task Copy(string url)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copied = url;
            _copyFailed = false;
        }
        catch (JSException) { _copyFailed = true; }
        catch (JSDisconnectedException) { }
    }

    private async Task Rebuild(string id)
    {
        if (_rebuilding is not null) return;
        _rebuilding = id;
        _rebuildError = null;
        try { await Coordinator.RebuildChannelAsync(id, _life.Token); }
        catch (OperationCanceledException) when (_life.IsCancellationRequested) { }
        catch (Exception ex) { _rebuildError = ex.Message; }
        finally { _rebuilding = null; }
    }

    public void Dispose()
    {
        Coordinator.StateChanged -= OnChanged;
        Editor.Changed -= OnChanged;
        foreach (IMediaSourceInfo source in _sources) source.LoadingChanged -= OnChanged;
        _life.Cancel();
        _life.Dispose();
    }
}
