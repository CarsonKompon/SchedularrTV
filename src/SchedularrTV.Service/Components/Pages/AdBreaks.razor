@page "/ad-breaks"
@inherits EditorPage
@inject CommercialTree Tree
@inject NavigationManager Nav

<PageHeader Title="Ad Breaks" Eyebrow="Programming">
    <ChildContent>Sets of ads, bumpers, filler and promos from your commercials libraries, for channels to pick from.</ChildContent>
    <Actions>
        <button class="btn btn-primary" type="button" @onclick="OpenCreate"><Icon Name="plus" Size="15" />Create</button>
    </Actions>
</PageHeader>

@if (_wizardOpen)
{
    <AdBreakWizard Roots="_roots" OnCreated="Created" OnCancel="() => _wizardOpen = false" />
}

@if (Editor.Working.AdBreaks.Count == 0)
{
    <div class="empty">
        <Icon Name="megaphone" Size="32" StrokeWidth="1.5" />
        <div class="empty-title">No ad breaks yet</div>
        <div>
            Create one from the folder that holds its commercials, then channels pick it on their <strong>Ad breaks</strong> tab.
        </div>
    </div>
}
else
{
    <div class="card ab-list">
        @foreach ((string key, AdBreakConfig adBreak) in Editor.Working.AdBreaks.OrderBy(entry => entry.Key, StringComparer.OrdinalIgnoreCase))
        {
            int users = UsedBy(key);
            <div class="list-row" @key="key">
                <a class="ab-list-main" href="@Href(key)">
                    <Icon Name="megaphone" Size="18" />
                    <div>
                        <div class="title">@key</div>
                        <div class="meta">
                            @Summarise(adBreak)
                            @if (!string.IsNullOrWhiteSpace(adBreak.Root))
                            {
                                <text> · <code>@AdBreakPaths.Name(adBreak.Root)</code></text>
                            }
                            · @(users == 0 ? "not used by any channel" : users == 1 ? "1 channel" : $"{users} channels")
                        </div>
                    </div>
                </a>
                <div class="spacer"></div>
                @if (_confirmDelete == key)
                {
                    <button class="btn btn-sm btn-danger confirm" @onclick="() => Remove(key)">Delete?</button>
                    <button class="btn btn-sm btn-icon" title="Cancel" aria-label="Cancel delete" @onclick="() => _confirmDelete = null"><Icon Name="x" Size="14" /></button>
                }
                else
                {
                    <a class="btn btn-sm" href="@Href(key)"><Icon Name="pencil" Size="14" />Edit</a>
                    <button class="btn btn-sm btn-icon btn-danger" title="Delete" aria-label="@($"Delete {key}")" @onclick="() => _confirmDelete = key"><Icon Name="trash" Size="14" /></button>
                }
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<CommercialFolder> _roots = [];
    private bool _wizardOpen;
    private string? _confirmDelete;

    public static string Href(string name) => $"ad-breaks/{Uri.EscapeDataString(name)}";

    private async Task OpenCreate()
    {
        _roots = await Tree.GetRootsAsync();
        _wizardOpen = true;
    }

    private void Created(string name)
    {
        _wizardOpen = false;
        Nav.NavigateTo(Href(name));
    }

    private int UsedBy(string name) => Editor.Working.Channels.Count(channel =>
        (channel.AdBreaks?.Contains(name, StringComparer.OrdinalIgnoreCase) ?? false)
        || channel.Blocks.Any(block => block.AdBreaks?.Contains(name, StringComparer.OrdinalIgnoreCase) ?? false));

    private void Remove(string key)
    {
        _confirmDelete = null;
        AdBreakNames.Remove(Editor.Working, key);
        Editor.MarkDirty();
    }

    public static string Summarise(AdBreakConfig adBreak)
    {
        int folders = adBreak.Folders.Count(folder => folder.Role != AdFolderRole.Skip);
        int promos = adBreak.Promos.Count + adBreak.PromoRoots.Count;
        bool tagRules = adBreak.TagRules is { IsEmpty: false };
        if (folders == 0 && promos == 0 && !tagRules)
        {
            return "empty";
        }

        return $"{folders} folder(s) · {promos} promo folder(s){(tagRules ? " · tag rules" : "")}";
    }
}
