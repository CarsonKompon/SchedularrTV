@page "/channels"
@inherits EditorPage
@inject NavigationManager Nav
@inject ScheduleCoordinator Coordinator
@inject TimeProvider Clock
@inject LibraryBrowser Library
@inject SuggestionStore IgnoredSuggestions

<PageHeader Title="Channels" Eyebrow="Programming">
    <ChildContent>@Editor.Working.Channels.Count configured channels</ChildContent>
    <Actions>
        @if (Editor.Working.Channels.Count > 0)
        {
            <button class="btn" @onclick="() => { _menuOpen = false; _numbersOpen = true; }">
                <Icon Name="hash" Size="15" />Edit channel numbers
            </button>
        }
        <div class="dropdown">
            <button class="btn btn-primary" aria-haspopup="menu" aria-expanded="@(_menuOpen ? "true" : "false")" @onclick="() => _menuOpen = !_menuOpen">
                <Icon Name="plus" Size="15" />New channel<Icon Name="chevron-down" Size="14" />
            </button>
            @if (_menuOpen)
            {
                <div class="dropdown-scrim" @onclick="() => _menuOpen = false"></div>
                <div class="dropdown-menu" role="menu">
                    <button class="dropdown-item" role="menuitem" @onclick="OpenWizard">
                        <Icon Name="sparkles" Size="15" />
                        <span>Channel Creation Wizard<small>Guided: pick what plays, slots, ad breaks and a block.</small></span>
                    </button>
                    <button class="dropdown-item" role="menuitem" @onclick="AddChannel">
                        <Icon Name="plus" Size="15" />
                        <span>New empty channel<small>Start from a blank channel in the editor.</small></span>
                    </button>
                    <a class="dropdown-item" role="menuitem" href="import">
                        <Icon Name="download" Size="15" />
                        <span>Import from ErsatzTV or Tunarr<small>Bring over another app's channels and schedules.</small></span>
                    </a>
                </div>
            }
        </div>
    </Actions>
</PageHeader>

<PluginFaultBanner Faults="Coordinator.PluginFaults" />

<div class="tile-grid">
    @foreach ((ChannelConfig? own, ExternalChannel? external) in Tiles())
    {
        if (external is not null)
        {
            ChannelSchedule schedule = external.Schedule;
            string? onNow = OnNow(schedule);
            <article class="card channel-tile" @key="schedule.ChannelId" @onclick="() => OpenExternal(external)">
                <div class="channel-tile-head">
                    <div class="logo-tile lg">
                        @if (!string.IsNullOrWhiteSpace(schedule.ChannelLogo))
                        {
                            <img src="@schedule.ChannelLogo" alt="" />
                        }
                        else
                        {
                            <Icon Name="plug" Size="24" StrokeWidth="1.6" />
                        }
                    </div>
                    <div style="flex:1;min-width:0;">
                        <h2>@schedule.ChannelName</h2>
                        <div class="row">
                            <span class="channel-number">@schedule.ChannelNumber</span>
                            <span class="pill pill-muted" title="Made by a plugin">@external.Source</span>
                        </div>
                    </div>
                    <div class="channel-tile-actions" @onclick:stopPropagation="true">
                        <button class="btn btn-sm btn-icon" title="Watch live" aria-label="@($"Watch {schedule.ChannelName} live")"
                                @onclick="() => _previewing = (schedule.ChannelNumber, schedule.ChannelName)">
                            <Icon Name="play" Size="14" />
                        </button>
                        <button class="btn btn-sm btn-icon" title="Guide: what airs and when" aria-label="@($"Guide for {schedule.ChannelName}")"
                                @onclick="() => _guide = new GuideTarget(schedule.ChannelId, schedule.ChannelNumber, schedule.ChannelName, schedule.ChannelLogo, schedule)">
                            <Icon Name="calendar-clock" Size="14" />
                        </button>
                        @if (external.EditPath is not null)
                        {
                            <button class="btn btn-sm btn-icon" title="@($"Edit on the {external.Source} page")" aria-label="@($"Edit {schedule.ChannelName}")"
                                    @onclick="() => OpenExternal(external)">
                                <Icon Name="pencil" Size="14" />
                            </button>
                        }
                    </div>
                </div>

                <div class="meta-row">
                    <span class="meta-chip"><Icon Name="plug" Size="13" />Set up in <strong>@external.Source</strong></span>
                    @if (!string.IsNullOrWhiteSpace(schedule.ChannelGroup))
                    {
                        <span class="meta-chip">Group <strong>@schedule.ChannelGroup</strong></span>
                    }
                </div>
                @if (onNow is not null)
                {
                    <p class="hint" style="margin:0;">On now: <strong>@onNow</strong></p>
                }
            </article>
        }
        else if (own is { } channel)
        {
        <article class="card channel-tile" @key="channel" @onclick="() => Open(channel)">
            <div class="channel-tile-head">
                <div class="logo-tile lg">
                    @if (!string.IsNullOrWhiteSpace(channel.Logo))
                    {
                        <img src="@channel.Logo" alt="" />
                    }
                    else
                    {
                        <Icon Name="tv" Size="24" StrokeWidth="1.6" />
                    }
                </div>
                <div style="flex:1;min-width:0;">
                    <h2>@channel.Name</h2>
                    <div class="row">
                        <span class="channel-number">@channel.Number</span>
                        <span class="pill pill-muted">@channel.TvgId</span>
                        @if (Coordinator.PluginFaultsFor(channel.Id) is { Count: > 0 } channelFaults)
                        {
                            <span class="pill pill-warn" title="@FaultSummary(channelFaults)"><Icon Name="alert" Size="12" />Plugin error</span>
                        }
                    </div>
                </div>
                <div class="channel-tile-actions" @onclick:stopPropagation="true">
                    <button class="btn btn-sm btn-icon" title="Watch live" aria-label="@($"Watch {channel.Name} live")" @onclick="() => _previewing = (channel.Number, channel.Name)">
                        <Icon Name="play" Size="14" />
                    </button>
                    <button class="btn btn-sm btn-icon" title="Guide: what airs and when" aria-label="@($"Guide for {channel.Name}")"
                            @onclick="() => _guide = new GuideTarget(channel.Id, channel.Number, channel.Name, channel.Logo, null)">
                        <Icon Name="calendar-clock" Size="14" />
                    </button>
                    <button class="btn btn-sm btn-icon" title="Edit" aria-label="@($"Edit {channel.Name}")" @onclick="() => Open(channel)">
                        <Icon Name="pencil" Size="14" />
                    </button>
                    @if (_confirmDelete == channel.Id)
                    {
                        <button class="btn btn-sm btn-danger confirm" @onclick="() => Remove(channel)">Delete?</button>
                        <button class="btn btn-sm btn-icon" title="Cancel" aria-label="Cancel delete" @onclick="() => _confirmDelete = null">
                            <Icon Name="x" Size="14" />
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-icon btn-danger" title="Delete" aria-label="@($"Delete {channel.Name}")" @onclick="() => _confirmDelete = channel.Id">
                            <Icon Name="trash" Size="14" />
                        </button>
                    }
                </div>
            </div>

            <div class="meta-row">
                <span class="meta-chip"><Icon Name="layers" Size="13" /><strong>@channel.Blocks.Count</strong> block(s)</span>
                <span class="meta-chip"><Icon Name="clock" Size="13" /><strong>@channel.Anchors.Count</strong> anchor(s)</span>
                <span class="meta-chip">Grid <strong>@(channel.PadToNearest is { } p ? DurationText.Format(p) : "off")</strong></span>
                <span class="meta-chip">Mid-roll <strong>@(channel.MidRoll?.Mode.ToString().ToLowerInvariant() ?? "off")</strong></span>
            </div>

            <DayTimeline Blocks="channel.Blocks" AnchorTimes="AnchorTimes(channel)" />
        </article>
        }
    }

    <div class="card new-tile">
        <Icon Name="plus" Size="26" />
        <span>Add a channel</span>
        <div class="row row-wrap" style="justify-content:center;gap:8px;">
            <button class="btn btn-sm btn-primary" @onclick="OpenWizard"><Icon Name="sparkles" Size="14" />Use the wizard</button>
            <button class="btn btn-sm" @onclick="AddChannel">Start empty</button>
        </div>
    </div>
</div>

@if (Coordinator.External.Count > 0)
{
    <p class="hint" style="margin-top:12px;">Plugin channels are edited on their plugin's page.</p>
}

@{
    List<SuggestedChannel> allSuggestions = _suggestionsLoading ? [] : Suggestions;
    List<SuggestedChannel> suggestions = [.. allSuggestions.Where(s => !s.Ignored)];
    List<SuggestedChannel> ignored = [.. allSuggestions.Where(s => s.Ignored)];
    bool paged = suggestions.Count > SuggestionPageSize;
    // Hidden suggestions go after the whole visible list, so they're only offered once it's all on screen.
    bool canShowHidden = ignored.Count > 0 && (!paged || _showAllSuggestions);
    IEnumerable<SuggestedChannel> shown = suggestions.Take(paged && !_showAllSuggestions ? SuggestionPageSize : int.MaxValue)
        .Concat(canShowHidden && _showHiddenSuggestions ? ignored : []);
}
@if (_suggestionsLoading || allSuggestions.Count > 0)
{
    <div class="section-title">
        <Icon Name="sparkles" Size="16" />
        <h2>Suggested Channels</h2>
        @if (!_suggestionsLoading)
        {
            <span class="count">@suggestions.Count</span>
        }
    </div>
    <p class="hint" style="margin-top:-6px;">Networks your shows originally aired on. Each starts with every show from that network.</p>

    @if (_suggestionsLoading)
    {
        <p class="hint">Reading your library…</p>
    }
    else
    {
        <div class="tile-grid">
            @foreach (SuggestedChannel suggestion in shown)
            {
                <article class="card channel-tile suggestion-tile @(suggestion.Ignored ? "ignored" : "")" @key="suggestion.Network">
                    <div class="channel-tile-head">
                        <div class="logo-tile lg">
                            <Icon Name="radio" Size="24" StrokeWidth="1.6" />
                        </div>
                        <div style="flex:1;min-width:0;">
                            <h2 title="@suggestion.Network">@suggestion.Network</h2>
                            <div class="row">
                                <span class="pill pill-network">Network</span>
                                @if (suggestion.Ignored)
                                {
                                    <span class="pill pill-muted">Ignored</span>
                                }
                            </div>
                        </div>
                        <div class="channel-tile-actions">
                            @if (suggestion.Ignored)
                            {
                                <button class="btn btn-sm btn-icon" title="Restore suggestion" aria-label="@($"Restore the {suggestion.Network} suggestion")"
                                        @onclick="() => IgnoredSuggestions.Restore(suggestion.Network)">
                                    <Icon Name="undo" Size="14" />
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-icon" title="Ignore suggestion" aria-label="@($"Ignore the {suggestion.Network} suggestion")"
                                        @onclick="() => IgnoredSuggestions.Ignore(suggestion.Network)">
                                    <Icon Name="x" Size="14" />
                                </button>
                            }
                            <button class="btn btn-sm btn-primary" @onclick="() => OpenSuggestion(suggestion)">
                                <Icon Name="plus" Size="14" />Create Channel
                            </button>
                        </div>
                    </div>

                    <div class="meta-row">
                        <span class="meta-chip"><Icon Name="tv" Size="13" /><strong>@suggestion.Shows.Count</strong> show(s)</span>
                        <span class="meta-chip"><strong>@suggestion.Episodes.ToString("N0")</strong> episode(s)</span>
                        <span class="meta-chip"><Icon Name="clock" Size="13" /><strong>@suggestion.Runtime</strong></span>
                    </div>

                    <div class="suggested-shows">
                        @foreach (LibraryShow show in suggestion.Shows)
                        {
                            <span class="pill pill-muted" @key="show.Id" title="@show.Name">@show.Name</span>
                        }
                    </div>
                </article>
            }
        </div>

        @if (paged || ignored.Count > 0)
        {
            <div class="load-more">
                <span>
                    Showing @(paged && !_showAllSuggestions ? SuggestionPageSize : suggestions.Count) of @suggestions.Count
                    @if (ignored.Count > 0)
                    {
                        <text> · @ignored.Count ignored</text>
                    }
                </span>
                @if (paged)
                {
                    <button class="btn btn-sm" @onclick="() => _showAllSuggestions = !_showAllSuggestions">
                        @(_showAllSuggestions ? "Show fewer" : "Show all")
                    </button>
                }
                @if (canShowHidden)
                {
                    <button class="btn btn-sm" aria-pressed="@(_showHiddenSuggestions ? "true" : "false")"
                            @onclick="() => _showHiddenSuggestions = !_showHiddenSuggestions">
                        @(_showHiddenSuggestions ? "Hide ignored" : $"Show ignored ({ignored.Count})")
                    </button>
                }
            </div>
        }
    }
}

@if (_wizardOpen)
{
    <ChannelWizard @key="_wizardSuggestion" SuggestedName="@_wizardSuggestion?.Network" SuggestedShows="_wizardSuggestion?.Shows"
                   OnCreated="Created" OnCancel="CloseWizard" />
}

@if (_numbersOpen)
{
    <ChannelNumbersEditor OnClose="() => _numbersOpen = false" />
}

@if (_previewing is { } previewing)
{
    <ChannelPreview @key="previewing" Number="previewing.Number" Name="@previewing.Name" OnClose="() => _previewing = null" />
}

@if (_guide is { } guide)
{
    <ChannelGuidePreview @key="guide" ChannelId="@guide.Id" Number="guide.Number" Name="@guide.Name" Logo="@guide.Logo"
                         Schedule="guide.Schedule" OnClose="() => _guide = null" />
}

@code {
    /// <summary><c>?wizard=1</c> opens the channel wizard, e.g. straight after first-run setup.</summary>
    [SupplyParameterFromQuery(Name = "wizard")] public string? Wizard { get; set; }

    private string? _confirmDelete;
    private bool _menuOpen;
    private bool _wizardOpen;
    private bool _numbersOpen;
    private (int Number, string Name)? _previewing;

    /// <summary>The channel whose guide is open; a plugin's channel brings its own schedule.</summary>
    private sealed record GuideTarget(string Id, int Number, string Name, string? Logo, ChannelSchedule? Schedule);

    private GuideTarget? _guide;

    /// <summary>A network with enough shows in the library to make a channel of its own.</summary>
    private sealed record SuggestedChannel(string Network, IReadOnlyList<LibraryShow> Shows, bool Ignored)
    {
        public int Episodes => Shows.Sum(show => show.EpisodeCount);

        public string Runtime
        {
            get
            {
                TimeSpan total = Shows.Aggregate(TimeSpan.Zero, (sum, show) => sum + show.TotalRuntime);
                return total.TotalHours >= 1 ? $"{(int)total.TotalHours:N0}h" : $"{total.Minutes}m";
            }
        }
    }

    // One show isn't much of a channel; two or more from the same network is.
    private const int MinimumShows = 4;
    private const int SuggestionPageSize = 9;

    private IReadOnlyList<LibraryShow> _shows = [];
    private bool _suggestionsLoading = true;
    private bool _showAllSuggestions;
    private bool _showHiddenSuggestions;
    private SuggestedChannel? _wizardSuggestion;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Coordinator.StateChanged += OnCoordinatorChanged;
        Library.Changed += OnLibraryChanged;
        IgnoredSuggestions.Changed += OnCoordinatorChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _shows = await Library.GetShowsAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Suggestions are a nicety; a library that can't be read just means there are none.
            _shows = [];
        }
        finally
        {
            _suggestionsLoading = false;
        }
    }

    public override void Dispose()
    {
        Coordinator.StateChanged -= OnCoordinatorChanged;
        Library.Changed -= OnLibraryChanged;
        IgnoredSuggestions.Changed -= OnCoordinatorChanged;
        base.Dispose();
    }

    private void OnLibraryChanged() => _ = InvokeAsync(async () =>
    {
        if (!Library.Updating)
        {
            try { _shows = await Library.GetShowsAsync(); }
            catch (Exception ex) when (ex is not OperationCanceledException) { }
        }

        StateHasChanged();
    });

    /// <summary>
    /// Networks from the shows' metadata, biggest first, skipping any that already have a channel
    /// of the same name.
    /// </summary>
    private List<SuggestedChannel> Suggestions
    {
        get
        {
            HashSet<string> existing = new(
                Editor.Working.Channels.Select(channel => channel.Name.Trim())
                    .Concat(Coordinator.External.Select(external => external.Schedule.ChannelName.Trim())),
                StringComparer.OrdinalIgnoreCase);

            return _shows
                .SelectMany(show => show.Networks
                    .Where(network => !string.IsNullOrWhiteSpace(network))
                    .Select(network => network.Trim())
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .Select(network => (Network: network, Show: show)))
                .GroupBy(pair => pair.Network, StringComparer.OrdinalIgnoreCase)
                .Where(group => !existing.Contains(group.Key))
                .Select(group => new SuggestedChannel(
                    // The spelling most shows use, so "Cartoon Network" wins over a stray "cartoon network".
                    group.GroupBy(pair => pair.Network).OrderByDescending(g => g.Count()).First().Key,
                    [.. group.Select(pair => pair.Show).DistinctBy(show => show.Id).OrderBy(show => show.Name, StringComparer.OrdinalIgnoreCase)],
                    IgnoredSuggestions.IsIgnored(group.Key)))
                .Where(suggestion => suggestion.Shows.Count >= MinimumShows)
                .OrderByDescending(suggestion => suggestion.Shows.Count)
                .ThenBy(suggestion => suggestion.Network, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private void OpenSuggestion(SuggestedChannel suggestion)
    {
        _menuOpen = false;
        _wizardSuggestion = suggestion;
        _wizardOpen = true;
    }

    private void CloseWizard()
    {
        _wizardOpen = false;
        _wizardSuggestion = null;
    }

    private void OnCoordinatorChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>What failed for a channel, for its tile's tooltip.</summary>
    private static string FaultSummary(IReadOnlyList<PluginFault> faults) =>
        string.Join("\n", faults.Select(fault => $"{fault.Plugin} failed while {fault.Stage}: {fault.Message}"));

    /// <summary>The schedule file's channels and the plugins' (IPTV, streamers…) together, by number.</summary>
    private IEnumerable<(ChannelConfig? Own, ExternalChannel? External)> Tiles() =>
        Editor.Working.Channels.Select(channel => (channel.Number, (ChannelConfig?)channel, (ExternalChannel?)null))
            .Concat(Coordinator.External.Select(external => (external.Schedule.ChannelNumber, (ChannelConfig?)null, (ExternalChannel?)external)))
            .OrderBy(tile => tile.Item1)
            .Select(tile => (tile.Item2, tile.Item3));

    private string? OnNow(ChannelSchedule schedule)
    {
        DateTimeOffset now = Clock.GetUtcNow();
        return schedule.Entries.FirstOrDefault(entry => entry.Start <= now && entry.End > now)?.Item?.Title;
    }

    private void OpenExternal(ExternalChannel external)
    {
        if (external.EditPath is { } path)
        {
            Nav.NavigateTo(path);
        }
    }

    // Parameters, not initialisation: arriving here from setup while already on this page reuses the component.
    protected override void OnParametersSet()
    {
        if (Wizard is "1" or "true")
        {
            _wizardOpen = true;

            // Drop the flag so a refresh or Back doesn't reopen the wizard after it's closed.
            Nav.NavigateTo("channels", replace: true);
        }
    }

    private void OpenWizard()
    {
        _menuOpen = false;
        _wizardSuggestion = null;
        _wizardOpen = true;
    }

    private void Created(string id)
    {
        _wizardOpen = false;
        _wizardSuggestion = null;
        Nav.NavigateTo($"channels/{id}");
    }

    private void Open(ChannelConfig channel) => Nav.NavigateTo($"channels/{channel.Id}");

    private static List<TimeSpan> AnchorTimes(ChannelConfig channel) =>
        channel.Anchors.Select(a => a.Time)
            .Concat(channel.Blocks.Where(b => b.IsAnchorSlot && b.Time is not null).Select(b => b.Time!.Value))
            .Concat(channel.Blocks.SelectMany(b => b.Anchors).Select(a => a.Time))
            .ToList();

    private void AddChannel()
    {
        _menuOpen = false;
        int number = Editor.NextChannelNumber();
        var channel = new ChannelConfig
        {
            Id = Editor.NextChannelId(),
            Name = $"Channel {number}",
            Number = number,
            Group = "SchedularrTV",
            BaseRotation = new ContentSelector { Query = "kind == 'Episode'" }
        };

        Editor.Working.Channels.Add(channel);
        Editor.MarkDirty();
        Nav.NavigateTo($"channels/{channel.Id}");
    }

    private void Remove(ChannelConfig channel)
    {
        _confirmDelete = null;
        Editor.Working.Channels.Remove(channel);
        Editor.MarkDirty();
    }
}
