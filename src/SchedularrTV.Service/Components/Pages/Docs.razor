@page "/docs"
@page "/docs/{Slug}"
@implements IAsyncDisposable
@using SchedularrTV.Service.Docs
@inject DocsLibrary Library
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_page is null ? "Documentation" : _page.Title) · SchedularrTV</PageTitle>

<div class="docs @(_page is null ? "docs-home" : "")">
    <aside class="docs-nav" aria-label="Guides">
        <label class="docs-search">
            <Icon Name="search" Size="15" />
            <input type="search" placeholder="Search the guides" aria-label="Search the guides"
                   @bind="_query" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <button type="button" class="docs-search-clear" title="Clear search" @onclick="ClearSearch"><Icon Name="x" Size="14" /></button>
            }
        </label>

        @if (!string.IsNullOrWhiteSpace(_query))
        {
            IReadOnlyList<DocPage> results = Library.Search(_query);
            <div class="docs-nav-section docs-results-head">@(results.Count == 0 ? "No matches" : results.Count == 1 ? "1 guide" : $"{results.Count} guides")</div>
            @foreach (DocPage result in results)
            {
                <NavLink class="docs-nav-link docs-result" href="@($"docs/{result.Slug}")" @onclick="ClearSearch">
                    <span>@result.Title</span>
                    <small>@result.Section</small>
                </NavLink>
            }
        }
        else
        {
            <NavLink class="docs-nav-link" href="docs" Match="NavLinkMatch.All">Overview</NavLink>
            @foreach (DocSection section in Library.Sections)
            {
                <div class="docs-nav-section"><Icon Name="@section.Icon" Size="13" />@section.Name</div>
                @foreach (DocPage page in section.Pages)
                {
                    <NavLink class="docs-nav-link" href="@($"docs/{page.Slug}")">@page.Title</NavLink>
                }
            }
        }
    </aside>

    <div class="docs-main">
        @if (Slug is null)
        {
            <PageHeader Title="Documentation" Eyebrow="Help">
                Guides to setting up SchedularrTV, building channels and getting the most from its plugins.
            </PageHeader>

            @foreach (DocSection section in Library.Sections)
            {
                <section class="docs-group">
                    <h2><Icon Name="@section.Icon" Size="15" />@section.Name</h2>
                    <div class="docs-cards">
                        @foreach (DocPage page in section.Pages)
                        {
                            <a class="docs-card" href="@($"docs/{page.Slug}")">
                                <span class="docs-card-title">@page.Title<Icon Name="arrow-right" Size="14" /></span>
                                @if (page.Summary.Length > 0)
                                {
                                    <span class="docs-card-summary">@page.Summary</span>
                                }
                            </a>
                        }
                    </div>
                </section>
            }
        }
        else if (_page is null)
        {
            <PageHeader Title="Guide not found" Eyebrow="Documentation" />
            <div class="empty">
                There's no guide called “@Slug”. <a href="docs">See all guides</a>.
            </div>
        }
        else
        {
            <PageHeader Title="@_page.Title">
                <ChildContent>@_page.Summary</ChildContent>
                <Actions>
                    <a class="btn btn-sm btn-ghost" href="@Library.SourceUrl(_page)" target="_blank" rel="noopener noreferrer">
                        <Icon Name="external-link" Size="14" />View on GitHub
                    </a>
                </Actions>
            </PageHeader>

            <div class="docs-crumb"><a href="docs">Documentation</a><Icon Name="chevron-right" Size="12" />@_page.Section</div>

            <article class="markdown">
                @((MarkupString)_page.Html)
            </article>

            @if (Library.Neighbours(_page) is var (previous, next) && (previous is not null || next is not null))
            {
                <nav class="docs-pager" aria-label="More guides">
                    @if (previous is not null)
                    {
                        <a class="docs-pager-link" href="@($"docs/{previous.Slug}")">
                            <small><Icon Name="arrow-left" Size="12" />Previous</small>
                            <span>@previous.Title</span>
                        </a>
                    }
                    else
                    {
                        <span></span>
                    }
                    @if (next is not null)
                    {
                        <a class="docs-pager-link next" href="@($"docs/{next.Slug}")">
                            <small>Next<Icon Name="arrow-right" Size="12" /></small>
                            <span>@next.Title</span>
                        </a>
                    }
                </nav>
            }
        }
    </div>

    @if (_page is { Headings.Count: > 1 })
    {
        <nav class="docs-toc" aria-label="On this page">
            <div class="docs-toc-title">On this page</div>
            @foreach (DocHeading heading in _page.Headings)
            {
                <a class="docs-toc-link level-@heading.Level" href="@($"docs/{_page.Slug}#{heading.Id}")">@heading.Text</a>
            }
        </nav>
    }
</div>

@code {
    [Parameter] public string? Slug { get; set; }

    private DocPage? _page;
    private string? _query;
    private string? _shownSlug;
    private bool _scrollPending;
    private IJSObjectReference? _module;

    protected override void OnParametersSet()
    {
        _page = Library.Find(Slug);

        // A new guide (or back to the index) starts at the top, or at the heading the link pointed to.
        if (!string.Equals(_shownSlug, Slug, StringComparison.OrdinalIgnoreCase))
        {
            _shownSlug = Slug;
            _scrollPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollPending)
        {
            return;
        }

        _scrollPending = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/docs.js");
            string fragment = new Uri(Navigation.Uri).Fragment.TrimStart('#');
            await _module.InvokeVoidAsync("scrollToFragment", Uri.UnescapeDataString(fragment));
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void ClearSearch() => _query = null;

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
