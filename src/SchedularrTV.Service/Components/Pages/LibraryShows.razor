@page "/library/shows"
@implements IDisposable
@inject ConfigEditor Editor
@inject LibraryBrowser Library
@inject NavigationManager Nav

<PageHeader Title="TV Shows" Eyebrow="Library">
    <ChildContent>
        @if (_loading)
        {
            <span>Reading your library&hellip;</span>
        }
        else
        {
            <span>@_shows.Count.ToString("N0") shows &middot; @_shows.Sum(s => s.EpisodeCount).ToString("N0") episodes</span>
            @if (Library.Updating)
            {
                <span class="pill pill-muted" style="margin-left:8px;"><span class="spinner spinner-sm"></span> Updating…</span>
            }
        }
    </ChildContent>
    <Actions>
        <button class="btn" disabled="@_refreshing" @onclick="Refresh">
            @if (_refreshing)
            {
                <span class="spinner spinner-sm"></span><span>Rescanning…</span>
            }
            else
            {
                <Icon Name="refresh" Size="15" /><span>Rescan</span>
            }
        </button>
    </Actions>
</PageHeader>

@if (Editor.Working.GlobalCollections.Count == 0)
{
    <div class="banner banner-warn">Create a collection first on the <a href="collections">Collections</a> page, then add shows to it here.</div>
}

@if (_message is not null)
{
    <div class="banner banner-ok" role="status">@_message</div>
}

<div class="library-toolbar">
    <div class="search-field">
        <Icon Name="search" Size="15" />
        <input type="text" placeholder="Search shows, or network:abc" aria-label="Filter shows" value="@_filter"
               @oninput="e => { _filter = e.Value?.ToString() ?? string.Empty; _limit = PageSize; }" />
    </div>

    <div class="segmented" aria-label="Layout">
        <button class="@(Grid ? "on" : "")" title="Poster grid" aria-pressed="@(Grid ? "true" : "false")" @onclick="@(() => SetView("grid"))"><Icon Name="grid" Size="14" /></button>
        <button class="@(Grid ? "" : "on")" title="Detailed list" aria-pressed="@(Grid ? "false" : "true")" @onclick="@(() => SetView("list"))"><Icon Name="list" Size="14" /></button>
    </div>

    @if (Grid)
    {
        <select style="min-width:150px;" aria-label="Sort by" value="@_sort.Column" @onchange="e => _sort.Set(Enum.Parse<LibrarySortColumn>(e.Value?.ToString() ?? nameof(LibrarySortColumn.Default)), _sort.Descending)">
            <option value="@LibrarySortColumn.Default">Title</option>
            <option value="@LibrarySortColumn.Year">Year</option>
            <option value="@LibrarySortColumn.Episodes">Episodes</option>
            <option value="@LibrarySortColumn.Runtime">Runtime</option>
            <option value="@LibrarySortColumn.AverageEpisode">Episode length</option>
        </select>
        @if (_sort.Column != LibrarySortColumn.Default)
        {
            <button class="btn btn-icon" title="@(_sort.Descending ? "Descending" : "Ascending")" @onclick="() => _sort.Set(_sort.Column, !_sort.Descending)">
                @(_sort.Descending ? "↓" : "↑")
            </button>
        }
    }

    <div class="toolbar-group">
    <span class="selection-count"><strong>@_selected.Count</strong> selected</span>
    <button class="btn btn-sm btn-ghost" @onclick="SelectVisible">Select shown</button>
    @if (_selected.Count > 0)
    {
        <button class="btn btn-sm btn-ghost" @onclick="() => _selected.Clear()">Clear</button>
    }

    <select aria-label="Target collection" @onchange="e => _targetCollection = e.Value?.ToString() ?? string.Empty" value="@_targetCollection">
        <option value="">Choose a collection…</option>
        @foreach (string key in Editor.Working.GlobalCollections.Keys.OrderBy(k => k))
        {
            <option value="@key">@key</option>
        }
    </select>
    <button class="btn btn-primary" disabled="@(_selected.Count == 0 || _targetCollection.Length == 0)" @onclick="AddSelected">
        <Icon Name="plus" Size="15" />Add @(_selected.Count > 0 ? _selected.Count.ToString() : "")
    </button>
    </div>
</div>

@if (_loading)
{
    <LibraryProgress />
    <div class="media-grid" aria-hidden="true">
        @for (int i = 0; i < 18; i++)
        {
            <div><div class="skeleton" style="aspect-ratio:2/3;border-radius:12px;"></div><div class="skeleton" style="height:12px;margin-top:10px;width:70%;"></div></div>
        }
    </div>
}
else if (!VisibleShows.Any())
{
    <div class="empty">
        <Icon Name="search" Size="30" StrokeWidth="1.5" />
        <div class="empty-title">No shows match</div>
        <div>Try a different name, or <code>network:</code> followed by part of a network name.</div>
    </div>
}
else if (Grid)
{
    <div class="media-grid">
        @foreach (LibraryShow show in VisibleShows.Take(_limit))
        {
            bool selected = _selected.Contains(show.Id);
            <div class="media-card @(selected ? "selected" : "")" @key="show.Id" tabindex="0" role="checkbox"
                 aria-checked="@(selected ? "true" : "false")" aria-label="@show.Name"
                 @onclick="() => Toggle(show.Id)" @onkeydown="e => OnCardKey(e, show.Id)">
                <span class="media-card-check" aria-hidden="true"><Icon Name="check" Size="14" StrokeWidth="3" /></span>
                <div class="media-card-poster">
                    <Artwork Id="@show.Id" Title="@show.Name" Width="320" />
                    @if (Membership(show).ToList() is { Count: > 0 } member)
                    {
                        <div class="media-card-in">
                            @foreach (string collection in member.Take(2))
                            {
                                <span class="pill pill-accent">@collection</span>
                            }
                            @if (member.Count > 2)
                            {
                                <span class="pill pill-muted">+@(member.Count - 2)</span>
                            }
                        </div>
                    }
                    <div class="media-card-actions" @onkeydown:stopPropagation="true">
                        <a class="btn btn-sm" href="@ShowUrl(show)" @onclick:stopPropagation="true">View show</a>
                    </div>
                </div>
                <div class="media-card-title" title="@show.Name">@show.Name</div>
                <div class="media-card-meta">
                    <span>@(show.Year?.ToString() ?? "—")</span>
                    <span>&middot;</span>
                    <span>@show.EpisodeCount eps</span>
                    @if (show.VersionedEpisodes > 0)
                    {
                        <span class="pill pill-warn" title="@show.VersionHint" style="height:17px;font-size:10px;padding:0 6px;">versions</span>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="media-table-wrap">
        <table class="library-shows-table media-table">
            <thead>
                <tr>
                    <th style="width:44px;">
                        <input type="checkbox" aria-label="Select all shown" checked="@AllShownSelected"
                               @onchange="e => SelectShown((bool)(e.Value ?? false))" />
                    </th>
                    <th>Show</th>
                    <LibrarySortHeader Sort="_sort" Column="LibrarySortColumn.Year" Label="Year" Width="85px" OnSort="_sort.Toggle" />
                    <th style="width:100px;">Seasons</th>
                    <LibrarySortHeader Sort="_sort" Column="LibrarySortColumn.Episodes" Label="Episodes" Width="110px" OnSort="_sort.Toggle" />
                    <LibrarySortHeader Sort="_sort" Column="LibrarySortColumn.Runtime" Label="Runtime" Width="115px" OnSort="_sort.Toggle" />
                    <LibrarySortHeader Sort="_sort" Column="LibrarySortColumn.AverageEpisode" Label="Avg. episode" Width="135px" OnSort="_sort.Toggle" />
                    <th style="width:170px;">In collections</th>
                    <th style="width:110px;">Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (LibraryShow show in VisibleShows.Take(_limit))
                {
                    bool selected = _selected.Contains(show.Id);
                    <tr class="selectable @(selected ? "selected" : "")" @key="show.Id" @onclick="() => Toggle(show.Id)">
                        <td>
                            <input type="checkbox" aria-label="@($"Select {show.Name}")" checked="@selected"
                                   @onclick:stopPropagation="true" @onchange="() => Toggle(show.Id)" />
                        </td>
                        <td>
                            <div class="media-title">
                                <Artwork Id="@show.Id" Title="@show.Name" Width="96" />
                                <div style="min-width:0;">
                                    <div class="media-name">@show.Name</div>
                                    <div class="media-sub">
                                        @if (_duplicateNames.Contains(show.Name))
                                        {
                                            <span class="pill pill-muted" title="Another series shares this name. Picks are pinned by id, so the two stay separate.">duplicate name</span>
                                        }
                                        @if (show.VersionedEpisodes > 0)
                                        {
                                            <span class="pill pill-warn" title="@show.VersionHint">@show.VersionedEpisodes with versions</span>
                                        }
                                        @foreach (string network in show.Networks.Take(2))
                                        {
                                            <span class="pill pill-network">@network</span>
                                        }
                                        @if (show.Networks.Count > 2)
                                        {
                                            <span class="pill pill-muted" title="@string.Join(", ", show.Networks.Skip(2))">+@(show.Networks.Count - 2)</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="num muted">@(show.Year?.ToString() ?? "—")</td>
                        <td class="num">@show.Seasons.Count</td>
                        <td class="num">@show.EpisodeCount</td>
                        <td class="num muted">@show.Runtime</td>
                        <td class="num muted" title="Mean of available episode runtimes">@show.AverageEpisodeRuntime</td>
                        <td>
                            <div class="collection-tags">
                                @foreach (string collection in Membership(show))
                                {
                                    <span class="pill pill-accent">@collection</span>
                                }
                            </div>
                        </td>
                        <td><a class="btn btn-sm" href="@ShowUrl(show)" @onclick:stopPropagation="true">View show</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!_loading && VisibleShows.Count() is var total && total > 0)
{
    <div class="load-more">
        <span>Showing @Math.Min(_limit, total).ToString("N0") of @total.ToString("N0")</span>
        @if (total > _limit)
        {
            <button class="btn btn-sm" @onclick="() => _limit += PageSize">Show more</button>
        }
    </div>
}

@code {
    private static string ShowUrl(LibraryShow show) => $"library/show?id={Uri.EscapeDataString(show.Id)}";
    private const int PageSize = 120;

    [SupplyParameterFromQuery(Name = "view")] public string? ViewMode { get; set; }

    private IReadOnlyList<LibraryShow> _shows = [];
    private HashSet<string> _duplicateNames = new(StringComparer.OrdinalIgnoreCase);
    private readonly LibraryTableSort _sort = new();
    private readonly HashSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);
    private string _filter = "";
    private string _targetCollection = "";
    private string? _message;
    private bool _loading = true;
    private bool _refreshing;
    private int _limit = PageSize;

    private bool Grid => !string.Equals(ViewMode, "list", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Library.Changed += OnLibraryChanged;
        Load(await Library.GetShowsAsync());
        _loading = false;
    }

    public void Dispose() => Library.Changed -= OnLibraryChanged;

    /// <summary>A show was added or renamed (a plugin's channel saved, say): shown without leaving the page.</summary>
    private void OnLibraryChanged() => _ = InvokeAsync(async () =>
    {
        if (!Library.Updating && !_refreshing)
        {
            Load(await Library.GetShowsAsync());
        }

        StateHasChanged();
    });

    private void Load(IReadOnlyList<LibraryShow> shows)
    {
        _shows = shows;
        _duplicateNames = shows
            .GroupBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
            .Where(g => g.Count() > 1)
            .Select(g => g.Key)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private void SetView(string view) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("view", view == "grid" ? null : view), replace: true);

    private IEnumerable<LibraryShow> VisibleShows
    {
        get
        {
            (string name, string network) = ParseFilter(_filter);

            return _sort.Apply(_shows
                .Where(s => name.Length == 0 || s.Name.Contains(name, StringComparison.OrdinalIgnoreCase)
                    || Editor.Working.Titles.TryGetValue(s.Name, out var defaults)
                    && defaults.Aliases.Concat(defaults.Seasons.Values.SelectMany(season => season.Aliases))
                        .Any(alias => alias.Name.Contains(name, StringComparison.OrdinalIgnoreCase)))
                .Where(s => network.Length == 0 || s.Networks.Any(n => n.Contains(network, StringComparison.OrdinalIgnoreCase))));
        }
    }

    /// <summary>
    /// <c>network:abc</c> searches networks by substring, so one term finds ABC, ABC (US) and ABC
    /// Family without having to know which variant a show is filed under. Anything else is a name.
    /// </summary>
    private static (string Name, string Network) ParseFilter(string filter)
    {
        const string prefix = "network:";
        string text = filter.Trim();

        if (!text.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            return (text, "");
        }

        string term = text[prefix.Length..].Trim();

        if (term.Length >= 2 && (term[0] == '\'' || term[0] == '"') && term[^1] == term[0])
        {
            term = term[1..^1];
        }

        return ("", term);
    }

    private void OnCardKey(KeyboardEventArgs e, string id)
    {
        if (e.Key is " " or "Enter") Toggle(id);
    }

    private void Toggle(string id)
    {
        if (!_selected.Add(id))
        {
            _selected.Remove(id);
        }
    }

    private bool AllShownSelected => VisibleShows.Take(_limit).All(s => _selected.Contains(s.Id)) && VisibleShows.Any();

    private void SelectShown(bool select)
    {
        foreach (LibraryShow show in VisibleShows.Take(_limit))
        {
            if (select)
            {
                _selected.Add(show.Id);
            }
            else
            {
                _selected.Remove(show.Id);
            }
        }
    }

    private void SelectVisible() => SelectShown(true);

    /// <summary>Matches by id, falling back to the name for entries written before ids were stored.</summary>
    private static bool Matches(ContentInclude include, LibraryShow show) =>
        string.IsNullOrWhiteSpace(include.ShowId)
            ? string.Equals(include.Show, show.Name, StringComparison.OrdinalIgnoreCase)
            : string.Equals(include.ShowId, show.Id, StringComparison.Ordinal);

    private IEnumerable<string> Membership(LibraryShow show) =>
        Editor.Working.GlobalCollections
            .Select(c => new
            {
                c.Key,
                Entry = c.Value.Include.FirstOrDefault(i => Matches(i, show))
            })
            .Where(x => x.Entry is not null)
            .Select(x => x.Entry!.Episodes.Count > 0 ? $"{x.Key} · episodes" : x.Entry.Seasons.Count > 0
                ? $"{x.Key} · S{string.Join(" S", x.Entry.Seasons)}"
                : x.Key);

    private void AddSelected()
    {
        if (!Editor.Working.GlobalCollections.TryGetValue(_targetCollection, out ContentSelector? target))
        {
            return;
        }

        int added = 0;
        foreach (LibraryShow show in _shows.Where(s => _selected.Contains(s.Id)))
        {
            if (target.Include.Any(i => Matches(i, show) && i.Seasons.Count == 0 && i.Episodes.Count == 0))
            {
                continue;
            }

            ShowCollectionEditor.Add(target, show);
            added++;
        }

        _message = $"Added {added} show(s) to \"{_targetCollection}\".";
        _selected.Clear();
        Editor.MarkDirty();
    }

    private async Task Refresh()
    {
        _refreshing = true;
        _message = null;

        try
        {
            await Library.RefreshAsync();
            Load(await Library.GetShowsAsync());
            _message = "Library rescanned.";
        }
        finally
        {
            _refreshing = false;
        }
    }

}
