@page "/library/show"
@implements IDisposable
@using SchedularrTV.Core.Media
@inject ConfigEditor Editor
@inject LibraryBrowser Library
@inject LibraryMetadata Metadata
@inject NavigationManager Nav

@if (_loading)
{
    <a class="back-link" href="library/shows"><Icon Name="arrow-left" Size="14" />All TV shows</a>
    <LibraryProgress />
}
else if (_show is not { } show)
{
    <a class="back-link" href="library/shows"><Icon Name="arrow-left" Size="14" />All TV shows</a>
    <PageHeader Title="Show not found" Eyebrow="TV show" />
    <div class="empty"><div class="empty-title">Show not found</div><div>Return to TV shows or rescan your library.</div></div>
}
else
{
    <a class="back-link" href="library/shows"><Icon Name="arrow-left" Size="14" />All TV shows</a>
    <PageHeader Title="@show.Name" Eyebrow="TV show">
        <Leading>
            <div class="library-detail-poster"><Artwork Id="@show.Id" Title="@show.Name" Width="160" /></div>
        </Leading>
        <ChildContent>
            <span class="row row-wrap">
                <span class="pill pill-muted">@(show.Year?.ToString() ?? "Unknown year")</span>
                <span class="pill pill-muted">@show.Seasons.Count @(show.Seasons.Count == 1 ? "season" : "seasons")</span>
                <span class="pill pill-muted">@show.EpisodeCount episodes</span>
                <span class="pill pill-muted">@show.Runtime</span>
                @foreach (string network in show.Networks.Take(3))
                {
                    <span class="pill pill-network">@network</span>
                }
                @if (Metadata.EditorFor(show.Id) is { } source)
                {
                    <span class="pill pill-accent" title="Where its metadata is kept">@source.Name</span>
                }
            </span>
        </ChildContent>
    </PageHeader>

    @if (_message is not null)
    {
        <div class="banner banner-ok" role="status">@_message</div>
    }

    <div @key="show.Id">
    <nav class="tabs channel-tabs" aria-label="Show sections">
        @foreach ((string key, string label, string icon) in Tabs)
        {
            <a class="tab @(_tab == key ? "active" : "")" aria-current="@(_tab == key ? "page" : null)"
               href="@Nav.GetUriWithQueryParameter("tab", key == "overview" ? null : key)"><Icon Name="@icon" Size="15" />@label@TabCount(key)</a>
        }
    </nav>

    <div @key="_tab">
    @if (_tab == "overview")
    {
        <MetadataEditorCard Id="@show.Id" Kind="MetadataItemKind.Show" Fallback="Fallback(show)" Written="Written" />

        <div class="card">
            <div class="card-head"><h2>Show aliases</h2></div>
            <p class="hint">Alternate names match promo folders in Ad Breaks. Choose a preferred name for generated promo TTS, Up Next text and variable images. A season's preferred name takes precedence.</p>
            <TitleAliasEditor Aliases="_defaults.Aliases" Changed="Save" />
        </div>

        <div class="card">
            <div class="card-head"><h2>Recordings</h2></div>
            <label class="check">
                <input type="checkbox" checked="@(_defaults.ScreenBug == true)" @onchange="e => { _defaults.ScreenBug = e.Value is true ? true : null; Save(); }" />
                <span>Recordings have a screen bug burned in</span>
            </label>
            <p class="hint" style="margin-top:0;">
                Overlays marked as screen bugs stand down while these air, so two bugs aren't on screen at once. Override it for
                a season or a single episode on the Seasons &amp; episodes tab.
            </p>
        </div>
    }
    else if (_tab == "episodes")
    {
        <div class="card">
            <div class="card-head">
                <h2>Seasons &amp; episodes</h2>
                <div class="spacer"></div>
                <select aria-label="Collection to add to" @bind="_target">
                    <option value="">Add to a collection…</option>
                    @foreach (string key in Editor.Working.GlobalCollections.Keys.OrderBy(key => key))
                    {
                        <option value="@key">@key</option>
                    }
                </select>
            </div>
            @if (Editor.Working.GlobalCollections.Count == 0)
            {
                <p class="hint">Create a collection on the <a href="collections">Collections</a> page to add seasons or episodes to it.</p>
            }
            else if (!HasTarget)
            {
                <p class="hint">Choose a collection above to add a season or single episodes to it.</p>
            }

            @foreach (var season in _episodes.GroupBy(episode => episode.Season).OrderBy(group => group.Key))
            {
                SeasonDefaults settings = Season(season.Key);
                <details class="show-season" @key="season.Key">
                    <summary>@(season.Key == 0 ? "Specials" : $"Season {season.Key}") @SeasonName(settings) <span class="muted">· @season.Count() episodes</span></summary>
                    <div class="show-season-body">
                        <div class="row"><h3>Season aliases</h3><div class="spacer"></div>
                            <button class="btn btn-sm btn-primary" disabled="@(!HasTarget)" @onclick="() => Add(season.Key, null)">Add season to collection</button>
                        </div>
                        <TitleAliasEditor Aliases="settings.Aliases" Changed="Save" />
                        <label class="field" style="max-width:320px;"><span>Screen bug burned in</span>
                            <select value="@BugValue(settings.ScreenBug)" @onchange="e => { settings.ScreenBug = ParseBug(e); Save(); }">
                                <option value="">Same as show (@YesNo(_defaults.ScreenBug == true))</option>
                                <option value="yes">Yes</option>
                                <option value="no">No</option>
                            </select>
                        </label>
                        <div class="media-table-wrap">
                            <table class="media-table">
                                <thead><tr><th>Episode</th><th>Title</th><th>Runtime</th><th>Screen bug</th><th>Add to collection</th></tr></thead>
                                <tbody>
                                    @foreach (LibraryEpisode episode in season.OrderBy(episode => episode.Episode))
                                    {
                                        bool? own = settings.Episodes.TryGetValue(episode.Episode, out EpisodeDefaults? episodeSettings) ? episodeSettings.ScreenBug : null;
                                        bool inherited = (settings.ScreenBug ?? _defaults.ScreenBug) == true;
                                        <tr @key="episode.Code"><td>@episode.Code</td><td>@episode.Title</td><td>@((int)episode.Duration.TotalMinutes)m</td>
                                            <td><select value="@BugValue(own)" aria-label="@($"Screen bug in {episode.Code}")"
                                                        @onchange="e => SetEpisodeBug(settings, episode.Episode, ParseBug(e))">
                                                    <option value="">Same as season (@YesNo(inherited))</option>
                                                    <option value="yes">Yes</option>
                                                    <option value="no">No</option>
                                                </select></td>
                                            <td><button class="btn btn-sm" disabled="@(!HasTarget)" @onclick="() => Add(season.Key, episode.Code)" aria-label="@($"Add {episode.Code} to collection")">Add episode</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </details>
            }
            @if (_episodes.Count == 0)
            {
                <p class="hint">No episodes are available for this show.</p>
            }
        </div>
    }
    else if (_tab == "intros")
    {
        <div class="card">
            <div class="card-head">
                <h2>Intros &amp; outros</h2>
                <div class="spacer"></div>
                <button class="btn btn-primary" type="button" @onclick="() => _bumpers = new ContentInclude { Show = show.Name, ShowId = show.Id }">
                    <Icon Name="film" Size="15" />Edit intros &amp; outros
                </button>
            </div>
            <p class="hint">Theme songs and end cards played around every episode of this show, on every channel. A collection can set its own for the show instead.</p>
            @if (_defaults.Bumpers.Count == 0)
            {
                <div class="empty"><Icon Name="film" Size="28" StrokeWidth="1.5" /><div class="empty-title">No intros or outros</div></div>
            }
            else
            {
                <div class="media-table-wrap">
                    <table class="media-table">
                        <thead><tr><th>Name</th><th>Plays</th><th>Picks</th><th>Clips</th><th>Seasons</th></tr></thead>
                        <tbody>
                            @foreach (BumperBlock block in _defaults.Bumpers)
                            {
                                <tr><td>@(string.IsNullOrWhiteSpace(block.Name) ? "Untitled" : block.Name)</td>
                                    <td>@block.Position</td>
                                    <td>@block.Selection</td>
                                    <td class="num">@block.Clips.Count</td>
                                    <td class="muted">@(block.Seasons.Count == 0 ? "All" : string.Join(", ", block.Seasons))</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (_tab == "collections")
    {
        <div class="card">
            <div class="card-head">
                <h2>Collections</h2>
                <div class="spacer"></div>
                <select aria-label="Collection to add to" @bind="_target">
                    <option value="">Choose a collection…</option>
                    @foreach (string key in Editor.Working.GlobalCollections.Keys.OrderBy(key => key))
                    {
                        <option value="@key">@key</option>
                    }
                </select>
                <button class="btn btn-primary" disabled="@(!HasTarget)" @onclick="() => Add(null, null)"><Icon Name="plus" Size="15" />Add whole show</button>
            </div>
            @if (Memberships(show) is { Count: > 0 } memberships)
            {
                <div class="media-table-wrap">
                    <table class="media-table">
                        <thead><tr><th>Collection</th><th>Includes</th><th style="width:120px;"></th></tr></thead>
                        <tbody>
                            @foreach ((string collection, string includes) in memberships)
                            {
                                <tr @key="collection">
                                    <td><a href="collections">@collection</a></td>
                                    <td class="muted">@includes</td>
                                    <td><button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveFrom(collection)">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="hint">Only collections that list the show by name are here; one that finds it by a query can't have it taken out from this page.</p>
            }
            else
            {
                <div class="empty"><Icon Name="layers" Size="28" StrokeWidth="1.5" /><div class="empty-title">Not in any collection</div></div>
            }
        </div>
    }
    else if (_tab == "history")
    {
        <MetadataHistoryCard Id="@show.Id" Kind="MetadataItemKind.Show" Written="Written" />
    }
    </div>
    </div>
}

@if (_bumpers is { } bumpers)
{
    <BumperEditor Include="bumpers" ShowWide="true" Changed="BumpersChanged" OnClose="() => _bumpers = null" />
}

@code {
    [SupplyParameterFromQuery(Name = "id")] public string? Id { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private static readonly (string Key, string Label, string Icon)[] Tabs =
    [
        ("overview", "Overview", "tv"),
        ("episodes", "Seasons & episodes", "list"),
        ("intros", "Intros & outros", "film"),
        ("collections", "Collections", "layers"),
        ("history", "History", "history")
    ];

    private string _tab => Tabs.Any(tab => tab.Key == Tab) ? Tab! : "overview";

    private LibraryShow? _show;
    private IReadOnlyList<LibraryEpisode> _episodes = [];
    private TitleDefaults _defaults = new();
    private Dictionary<int, SeasonDefaults> _seasonSettings = [];
    private ContentInclude? _bumpers;
    private string _target = "";
    private string? _message;
    private bool _loading = true;
    private string? _loadedId;
    private bool HasTarget => Editor.Working.GlobalCollections.ContainsKey(_target);

    protected override void OnInitialized() => Library.Changed += LibraryChanged;

    protected override async Task OnParametersSetAsync()
    {
        // Switching tabs keeps what's loaded; only another show reads the library again.
        if (_loadedId == Id && !_loading)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _bumpers = null;
        _message = null;
        string? requested = Id;
        var shows = await Library.GetShowsAsync();
        if (requested != Id) return;
        _show = shows.FirstOrDefault(show => show.Id == requested);
        var episodes = _show is null ? Array.Empty<LibraryEpisode>() : await Library.GetEpisodesAsync(_show.Id);
        if (requested != Id) return;
        _episodes = episodes.DistinctBy(episode => episode.Code).ToList();
        _defaults = _show is not null && Editor.Working.Titles.TryGetValue(_show.Name, out var defaults) ? defaults : new();
        _seasonSettings = new(_defaults.Seasons);
        _loadedId = requested;
        _loading = false;
    }

    private string TabCount(string key) => key switch
    {
        "intros" when _defaults.Bumpers.Count > 0 => $" ({_defaults.Bumpers.Count})",
        "collections" when _show is not null && Memberships(_show).Count is > 0 and var count => $" ({count})",
        _ => ""
    };

    private static EditableMetadata Fallback(LibraryShow show) => new() { Title = show.Name, Year = show.Year, Studios = show.Networks };

    /// <summary>
    /// After a change is written. The schedule keeps a show's own settings under its name and its collection entries
    /// with its name, so a new title moves them with it (once the library has been rescanned it goes by the new name).
    /// </summary>
    private void Written(MetadataHistoryEntry entry)
    {
        if (_show is null || !entry.Fields.HasFlag(MetadataFields.Title) || entry.After.Title is not { } renamed
            || string.Equals(renamed, _show.Name, StringComparison.Ordinal))
        {
            return;
        }

        string old = _show.Name;
        bool moved = false;
        if (Editor.Working.Titles.Remove(old, out TitleDefaults? settings) && !Editor.Working.Titles.ContainsKey(renamed))
        {
            Editor.Working.Titles[renamed] = settings;
            moved = true;
        }
        else if (settings is not null)
        {
            Editor.Working.Titles[old] = settings;
        }

        int entries = 0;
        foreach (ContentInclude include in Editor.Working.GlobalCollections.Values.SelectMany(collection => collection.Include)
                     .Where(include => include.ShowId == _show.Id || string.IsNullOrWhiteSpace(include.ShowId) && string.Equals(include.Show, old, StringComparison.OrdinalIgnoreCase)))
        {
            include.Show = renamed;
            entries++;
        }

        if (moved || entries > 0)
        {
            Editor.MarkDirty();
            _message = $"Renamed to “{renamed}”. Its show settings and {entries} collection {(entries == 1 ? "entry" : "entries")} were moved to the new name; save changes to keep them. Rescan the library to see the new name everywhere.";
        }
    }

    private void LibraryChanged() => _ = InvokeAsync(async () => { if (!Library.Updating) await LoadAsync(); StateHasChanged(); });
    public void Dispose() => Library.Changed -= LibraryChanged;

    private SeasonDefaults Season(int number)
    {
        if (!_seasonSettings.TryGetValue(number, out var season)) _seasonSettings[number] = season = new();
        return season;
    }

    private static string SeasonName(SeasonDefaults season) => season.Aliases.FirstOrDefault(alias => alias.Preferred)?.Name
        ?? season.Aliases.FirstOrDefault()?.Name ?? "";

    private void Save()
    {
        if (_show is null) return;
        foreach (SeasonDefaults season in _seasonSettings.Values)
        {
            foreach (int number in season.Episodes.Where(pair => !pair.Value.HasSettings).Select(pair => pair.Key).ToList())
                season.Episodes.Remove(number);
        }
        _defaults.Seasons = _seasonSettings.Where(pair => pair.Value.HasSettings).ToDictionary();
        Editor.Working.Titles[_show.Name] = _defaults;
        Editor.MarkDirty();
    }

    private void SetEpisodeBug(SeasonDefaults season, int episode, bool? value)
    {
        if (!season.Episodes.TryGetValue(episode, out var settings)) season.Episodes[episode] = settings = new();
        settings.ScreenBug = value;
        Save();
    }

    private static string BugValue(bool? value) => value switch { true => "yes", false => "no", null => "" };
    private static bool? ParseBug(ChangeEventArgs e) => e.Value?.ToString() switch { "yes" => true, "no" => false, _ => null };
    private static string YesNo(bool value) => value ? "yes" : "no";

    private void BumpersChanged()
    {
        if (_show is not null && Editor.Working.Titles.TryGetValue(_show.Name, out var defaults)) _defaults = defaults;
        Editor.MarkDirty();
    }

    private void Add(int? season, string? episode)
    {
        if (_show is null || !Editor.Working.GlobalCollections.TryGetValue(_target, out var target)) return;
        ShowCollectionEditor.Add(target, _show, season, episode);
        _message = $"Added {(episode ?? (season is { } number ? $"Season {number}" : "the whole show"))} to \"{_target}\".";
        Editor.MarkDirty();
    }

    // ---- Collections ----

    private static bool Matches(ContentInclude include, LibraryShow show) =>
        string.IsNullOrWhiteSpace(include.ShowId)
            ? string.Equals(include.Show, show.Name, StringComparison.OrdinalIgnoreCase)
            : string.Equals(include.ShowId, show.Id, StringComparison.Ordinal);

    /// <summary>The collections listing the show, and what of it each takes (the whole show, seasons, episodes).</summary>
    private List<(string Collection, string Includes)> Memberships(LibraryShow show) =>
        [.. Editor.Working.GlobalCollections
            .Select(collection => (collection.Key, Entries: collection.Value.Include.Where(include => Matches(include, show)).ToList()))
            .Where(pair => pair.Entries.Count > 0)
            .OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .Select(pair => (pair.Key, pair.Entries.Any(include => include.IsWholeShow)
                ? "The whole show"
                : string.Join(", ", pair.Entries.SelectMany(Takes))))];

    /// <summary>What one entry takes of a show: its episodes, its seasons, or every season but some.</summary>
    private static IEnumerable<string> Takes(ContentInclude include)
    {
        if (include.Episodes.Count > 0)
        {
            return include.Episodes;
        }

        return include.Seasons.Count > 0
            ? include.Seasons.Select(SeasonName)
            : [$"Every season but {string.Join(", ", include.ExcludeSeasons.Select(SeasonName))}"];
    }

    private static string SeasonName(int season) => season == 0 ? "Specials" : $"Season {season}";

    private void RemoveFrom(string collection)
    {
        if (_show is null || !Editor.Working.GlobalCollections.TryGetValue(collection, out ContentSelector? selector)) return;
        LibraryShow show = _show;
        if (selector.Include.RemoveAll(include => Matches(include, show)) > 0)
        {
            _message = $"Removed “{show.Name}” from \"{collection}\".";
            Editor.MarkDirty();
        }
    }
}
