@page "/channels/{ChannelId}"
@inherits EditorPage
@inject NavigationManager Nav
@inject RotationResetter Rotation
@inject LogoStore Logos
@inject SchedulerConfigProvider SavedConfig
@inject IEnumerable<PluginEditorSection> EditorSections
@inject AlwaysOnKeeper AlwaysOn
@inject ScheduleCoordinator Coordinator
@inject Microsoft.Extensions.Options.IOptions<SchedularrTV.Providers.ErsatzTv.ErsatzTvOptions> ErsatzOptions
@using SchedularrTV.Providers.ErsatzTv

@if (_channel is null)
{
    <PageHeader Title="Channel not found" Eyebrow="Channels">
        <a class="back-link" href="channels"><Icon Name="arrow-left" Size="14" />Back to channels</a>
    </PageHeader>
}
else
{
    <a class="back-link" href="channels"><Icon Name="arrow-left" Size="14" />All channels</a>
    <PageHeader Title="@_channel.Name" Eyebrow="@($"Channel {_channel.Number}")">
        <Leading>
            <div class="logo-tile lg">
                @if (!string.IsNullOrWhiteSpace(_channel.Logo))
                {
                    <img src="@_channel.Logo" alt="" />
                }
                else
                {
                    <Icon Name="tv" Size="26" StrokeWidth="1.6" />
                }
            </div>
        </Leading>
        <ChildContent>
            <span class="row row-wrap">
                <span class="pill pill-muted">@_channel.TvgId</span>
                <span class="pill pill-muted">@_channel.Blocks.Count @(_channel.Blocks.Count == 1 ? "block" : "blocks")</span>
                @if (!string.IsNullOrWhiteSpace(_channel.Group))
                {
                    <span class="pill pill-muted">@_channel.Group</span>
                }
                @if (_channel.AlwaysOn == true)
                {
                    <span class="pill pill-accent" title="Plays around the clock">24/7</span>
                }
            </span>
        </ChildContent>
        <Actions>
            <button class="btn" type="button" disabled="@(Editor.Working.Channels.Count < 2)"
                    aria-expanded="@(_copyOpen ? "true" : "false")" @onclick="OpenCopy"><Icon Name="copy" Size="15" />Copy From</button>
        </Actions>
    </PageHeader>

    <PluginFaultBanner Faults="Coordinator.PluginFaultsFor(_channel.Id)" ChannelName="@_channel.Name" />

    @if (_copyOpen)
    {
        <div class="banner banner-warn">
            <label class="field">
                <span>Source channel</span>
                <select @bind="_copySourceId">
                    <option value="">-- pick a channel --</option>
                    @foreach (var source in Editor.Working.Channels.Where(channel => channel.Id != _channel.Id).OrderBy(channel => channel.Number))
                    {
                        <option value="@source.Id">@source.Number - @source.Name</option>
                    }
                </select>
            </label>
            <p class="hint">Replaces this channel's settings. Its name, number, ID, and logo are kept.</p>
            <div class="row">
                <button class="btn btn-primary btn-sm" type="button" disabled="@string.IsNullOrWhiteSpace(_copySourceId)" @onclick="CopyFrom">Copy settings</button>
                <button class="btn btn-sm" type="button" @onclick="() => _copyOpen = false">Cancel</button>
            </div>
            @if (_copyError is not null)
            {
                <span class="field-error" role="alert">@_copyError</span>
            }
        </div>
    }
    @if (_copyMessage is not null)
    {
        <div class="banner banner-ok" role="status">@_copyMessage</div>
    }

    <div @key="_channel">
    <nav class="tabs channel-tabs" aria-label="Channel sections">
        @foreach ((string key, string label, string icon) in AllTabs)
        {
            <a class="tab @(_tab == key ? "active" : "")" aria-current="@(_tab == key ? "page" : null)"
               href="@Nav.GetUriWithQueryParameter("tab", key == "general" ? null : key)"><Icon Name="@icon" Size="15" />@label</a>
        }
    </nav>

    <div @key="_tab">
    @if (_tab == "general")
    {
        <div class="card">
            <div class="grid grid-3">
                <label class="field">
                    <span>Name</span>
                    <input type="text" value="@_channel.Name"
                           @onchange="e => { _channel.Name = e.Value?.ToString() ?? string.Empty; Editor.MarkDirty(); }" />
                </label>
                <label class="field">
                    <span>Number</span>
                    <input type="number" value="@_channel.Number"
                           @onchange="e => { _channel.Number = int.TryParse(e.Value?.ToString(), out int v) ? v : _channel.Number; Editor.MarkDirty(); }" />
                </label>
                <label class="field">
                    <span>ID <span class="opt">(used in URLs)</span></span>
                    @* Keyed so a rejected rename puts the real id back: the model never changed, so
                       Blazor would otherwise diff no change and leave the typed text in the box. *@
                    <input type="text" @key="_idVersion" value="@_channel.Id"
                           @onchange="e => Rename(e.Value?.ToString())" />
                    @if (_idError is not null)
                    {
                        <span class="field-error" role="alert">@_idError</span>
                    }
                </label>
                <label class="field">
                    <span>Guide ID <span class="opt">(from the channel number)</span></span>
                    <input type="text" value="@_channel.TvgId" readonly disabled />
                </label>
                <label class="field">
                    <span>Group</span>
                    <input type="text" value="@_channel.Group"
                           @onchange="e => { _channel.Group = Text(e); Editor.MarkDirty(); }" />
                </label>
                <label class="field">
                    <span>Time zone <span class="opt">(blank = global)</span></span>
                    <input type="text" value="@_channel.TimeZone" placeholder="@Editor.Working.Settings.TimeZone"
                           @onchange="e => { _channel.TimeZone = Text(e); Editor.MarkDirty(); }" />
                </label>
            </div>

            <div class="field">
                <span>Logo</span>
                <div class="row" style="gap:14px;align-items:flex-start;">
                    <div class="logo-drop">
                        <InputFile OnChange="OnLogoSelected" accept="@LogoStore.Accept" title="Drop an image here, or click to choose one" />
                        @if (string.IsNullOrWhiteSpace(_channel.Logo))
                        {
                            <span>Drop an image here<br />or click to choose</span>
                        }
                        else
                        {
                            <img src="@_channel.Logo" alt="" />
                        }
                    </div>

                    <div style="flex:1;">
                        @if (_logoError is not null)
                        {
                            <p class="field-error" role="alert" style="margin:0 0 6px;">@_logoError</p>
                        }
                        else
                        {
                            <p class="hint" style="margin:0 0 6px;">
                                PNG, JPEG, GIF or WebP, up to @(LogoStore.MaxBytes / (1024 * 1024))MB.
                                Shown in the guide and the channel list.
                            </p>
                        }

                        <input type="text" value="@_channel.Logo" placeholder="…or paste an image URL"
                               @onchange="e => { _channel.Logo = Text(e); Editor.MarkDirty(); }" />

                        @if (!string.IsNullOrWhiteSpace(_channel.Logo))
                        {
                            <button class="btn btn-sm btn-danger" type="button" style="margin-top:8px;" @onclick="RemoveLogo">Remove logo</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        RenderFragment playback = @<div class="card">
            <div class="card-head"><h2>Playback</h2></div>
            <label class="check">
                <input type="checkbox" checked="@(_channel.AlwaysOn ?? false)"
                       @onchange="e => { _channel.AlwaysOn = (bool)(e.Value ?? false) ? true : null; Editor.MarkDirty(); }" />
                <span>Play around the clock (24/7)</span>
            </label>
            <p class="hint">
                24/7 playback tunes in faster but transcodes continuously. See <a href="performance">Performance</a> for resource use.
            </p>
            @if (_channel.AlwaysOn == true)
            {
                <label class="field" style="max-width:420px;">
                    <span>For promos, credit squeezing and chapter scanning, treat it as</span>
                    <select value="@WatchedChoice" @onchange="SetWatchedChoice">
                        <option value="watched">Always watched</option>
                        <option value="unwatched">Never watched</option>
                    </select>
                </label>
                <p class="hint">
                    Choose how watched-only features treat 24/7 playback. Keep-alive playback is excluded from viewing stats.
                </p>
                @if (AlwaysOn.Statuses.FirstOrDefault(candidate => candidate.Number == _channel.Number) is { } status)
                {
                    @if (status.Problem is not null)
                    {
                        <div class="banner banner-warn" role="status">Not playing: @status.Problem</div>
                    }
                    else if (status.LastPlaying is { } playing)
                    {
                        <p class="hint"><span class="status-dot"></span> Playing (last checked @playing.ToLocalTime().ToString("HH:mm:ss")).</p>
                    }
                }
            }
        </div>;

        RenderFragment encoding = @<div class="card">
            <div class="card-head"><h2>Encoding</h2></div>
            <div class="grid grid-3">
                <label class="field">
                    <span>Encode on</span>
                    <select value="@(_channel.Encoding?.Hardware ?? string.Empty)" @onchange="SetEncodingHardware">
                        <option value="">Default (@InheritedHardware)</option>
                        @foreach (ErsatzTvHardware choice in ErsatzTvEncoding.Hardware)
                        {
                            <option value="@choice.Value">@choice.Label</option>
                        }
                    </select>
                </label>
                <EncodingPictureSettings @key="_channel.Id" Value="@(_channel.Encoding ?? new ChannelEncodingConfig())"
                                         Inherited="Inherited" Changed="SetEncodingPicture" />
                <label class="field">
                    <span>Media sizing</span>
                    <select value="@(_channel.Encoding?.ScalingMode ?? string.Empty)" @onchange="SetEncodingScaling">
                        <option value="">Default (@(Inherited.ScalingMode == "crop" ? "Fill" : "Fit"))</option>
                        <option value="scale_and_pad">Fit — entire image, black bars if needed</option>
                        <option value="crop">Fill — crop edges to fill the frame</option>
                    </select>
                </label>
                <label class="field">
                    <span>Bitrate (kbps)</span>
                    <input type="number" min="300" max="100000" value="@(_channel.Encoding?.BitrateKbps)" placeholder="@InheritedBitrate"
                           @onchange="SetEncodingBitrate" />
                </label>
            </div>
            <p class="hint">
                @if (_channel.Encoding?.Width is not null || _channel.Encoding?.Height is not null)
                {
                    <text>Output: @(SelectedEncoding.Width)×@(SelectedEncoding.Height) pixels.</text>
                }
                480p is a height, not an aspect ratio. Use 640×480 for 4:3 or 854×480 for widescreen.
                Dimensions are rounded down to even pixels. Blank dimensions use source size on source-based channels, otherwise app defaults.
            </p>
            <p class="hint">
                Overrides <a href="settings/app">app encoding defaults</a>. Explicit overrides re-encode video, including passthrough channels.
                Saving encoding changes restarts ErsatzTV and briefly interrupts viewers.
            </p>
        </div>;

        RenderFragment tracks = @<div class="card">
            <div class="card-head"><h2>Audio and subtitles</h2></div>
            <div class="grid grid-2">
                <label class="field">
                    <span>Preferred audio languages</span>
                    <input type="text" list="track-languages" value="@LanguageText(_channel.Tracks?.AudioLanguages)"
                           placeholder="Each file's default audio" @onchange="SetAudioLanguages" />
                </label>
                <label class="field">
                    <span>Subtitles</span>
                    <select value="@(_channel.Tracks?.EffectiveSubtitles ?? SubtitleMode.Off)" @onchange="SetSubtitleMode">
                        <option value="@SubtitleMode.Off">Off</option>
                        <option value="@SubtitleMode.Selectable">Include as a track viewers can turn on</option>
                        <option value="@SubtitleMode.BurnIn">Burn into the picture</option>
                    </select>
                </label>
            </div>
            <p class="hint">
                Languages in order of preference, separated by commas: names or codes (English, Japanese or en, ja).
                A programme without any of them plays its default audio.
            </p>
            @if ((_channel.Tracks?.EffectiveSubtitles ?? SubtitleMode.Off) != SubtitleMode.Off)
            {
                <label class="field" style="max-width:420px;">
                    <span>Subtitle languages</span>
                    <input type="text" list="track-languages" value="@LanguageText(_channel.Tracks?.SubtitleLanguages)"
                           placeholder="@SubtitleLanguagePlaceholder" @onchange="SetSubtitleLanguages" />
                </label>
                <label class="check">
                    <input type="checkbox" checked="@(_channel.Tracks?.OnlyForForeignAudio ?? false)"
                           @onchange="e => EditTracks(t => t.OnlyForForeignAudio = (bool)(e.Value ?? false) ? true : null)" />
                    <span>Only when the audio is in another language</span>
                </label>
                <p class="hint">
                    Programmes already in a subtitle language then get only a forced track (signs and foreign dialogue), if they have one.
                </p>
                <label class="check">
                    <input type="checkbox" checked="@(_channel.Tracks?.AvoidHearingImpaired ?? false)"
                           @onchange="e => EditTracks(t => t.AvoidHearingImpaired = (bool)(e.Value ?? false) ? true : null)" />
                    <span>Prefer subtitles without sound descriptions (non-SDH)</span>
                </label>
                <p class="hint">
                    @if (_channel.Tracks?.EffectiveSubtitles == SubtitleMode.Selectable)
                    {
                        <text>Viewers switch the track on in their player. Only text subtitles (SRT, ASS, WebVTT) can be a track;
                            programmes with only picture subtitles (PGS, DVD) go without. </text>
                    }
                    else
                    {
                        <text>Every viewer sees them. Burning in re-encodes the video, including on passthrough channels. </text>
                    }
                    Subtitles inside the file and subtitle files beside it (<code>Episode.en.srt</code>, <code>Episode.en.forced.srt</code>) are both used.
                </p>
            }
            <datalist id="track-languages">
                @foreach ((string languageCode, string languageName) in LanguageCodes.Common)
                {
                    <option value="@languageName">@languageCode</option>
                }
            </datalist>
            <p class="hint">
                Tracks are read from each file before it airs, so the files must be reachable from this computer.
                Changing the subtitle setting restarts ErsatzTV and briefly interrupts viewers.
            </p>
        </div>;

        RenderFragment grid = @<div class="card">
            <div class="card-head"><h2>Scheduling grid</h2></div>
            <div class="grid grid-2">
                <DurationInput Label="Start programmes on a boundary of" Value="_channel.PadToNearest"
                               ValueChanged="v => { _channel.PadToNearest = v; Editor.MarkDirty(); }" />
                <DurationInput Label="Longest advert break" Value="_channel.MaxBreak"
                               ValueChanged="v => { _channel.MaxBreak = v; Editor.MarkDirty(); }" />
            </div>
            <p class="hint">
                Leave the grid blank for back-to-back programming with no advert breaks at all.
            </p>

            <label class="check">
                <input type="checkbox" checked="@(_channel.StackToFill ?? false)"
                       @onchange="e => { _channel.StackToFill = (bool)(e.Value ?? false); Editor.MarkDirty(); }" />
                <span>Fill a slot with more episodes of the same show</span>
            </label>
            <p class="hint">
                Adds whole episodes to fill a slot, with breaks between them.
            </p>

            <label class="field">
                <span>Grid anchor <span class="opt">(blank = local midnight)</span></span>
                <input type="datetime-local" value="@AnchorText()" @onchange="SetAnchor" />
            </label>
            <p class="hint">
                Slot boundaries and rebuilds align to this time.
            </p>

            <p class="hint">
                Reset to start each collection from its first episode.
            </p>
            <div class="row row-wrap">
                <button class="btn btn-sm btn-danger" type="button" disabled="@_resetting" @onclick="ResetRotation">
                    @(_resetting ? "Resetting…" : "Start this channel over")
                </button>
                @if (_resetMessage is not null)
                {
                    <span class="hint inline">@_resetMessage</span>
                }
            </div>
        </div>;

        RenderFragment rotation = @<div class="card">
            <div class="card-head"><h2>Base rotation</h2></div>
            <p class="hint">Plays whenever no block or anchor claims the time.</p>
            @if (_channel.BaseRotation is null)
            {
                <button class="btn btn-sm" @onclick="() => { _channel.BaseRotation = new ContentSelector(); Editor.MarkDirty(); }">
                    Add a base rotation
                </button>
            }
            else
            {
                <SelectorEditor Selector="_channel.BaseRotation" Label="Fallback programming"
                                Changed="Editor.MarkDirty"
                                OnRemove="() => { _channel.BaseRotation = null; Editor.MarkDirty(); }" />
            }
        </div>;
        @rotation
        @grid
        @encoding
        @tracks
        @playback
    }
    else if (_tab == "schedule")
    {
        <div class="card">
            <div class="card-head"><h2>Day at a glance</h2></div>
            <DayTimeline Blocks="_channel.Blocks" AnchorTimes="AnchorTimes" />
        </div>

        <ChannelBlockList Blocks="_channel.Blocks" Changed="Editor.MarkDirty" />

        <AnchorListEditor Anchors="_channel.Anchors" Label="Channel anchors" Changed="Editor.MarkDirty" />
    }
    else if (_tab == "breaks")
    {
        <div class="card">
            <div class="card-head">
                <h2>Ad breaks</h2>
                <span class="muted">Where this channel's ads, bumpers, filler and promos come from</span>
            </div>
            <AdBreakPicker Values="_channel.AdBreaks" ValuesChanged="SetAdBreaks"
                           EmptyText="@(Editor.Working.Settings.DefaultAdBreaks is { Count: > 0 } defaults ? $"None chosen: uses the defaults ({string.Join(", ", defaults)})" : "None chosen: breaks stay empty")" />
            <p class="hint">
                Pick one or more from <a href="ad-breaks">Ad Breaks</a>, e.g. an "Any channel" set and a "Kids channel" set;
                their clips are pooled. Blocks can pick their own on the Blocks &amp; anchors tab.
            </p>
        </div>

        <InterstitialsEditor Interstitials="ChannelBreaks" ShowAds="false" Changed="CommitBreaks"
                             ShowsOverride="_channel.InterstitialShows" ClearShowsOverride="() => _channel.InterstitialShows = null" />

        @if (_channel.MidRoll is null)
        {
            <div class="card">
                <p>Mid-roll breaks are off for this channel.</p>
                <button class="btn btn-primary" @onclick="() => { _channel.MidRoll = new MidRollConfig { Mode = MidRollMode.Auto }; Editor.MarkDirty(); }">
                    Enable mid-rolls
                </button>
            </div>
        }
        else
        {
            <MidRollEditor Config="_channel.MidRoll" Changed="Editor.MarkDirty" />
        }
    }
    else if (_tab == "drops")
    {
        <ChannelDropsTab ChannelId="@_channel.Id" Unsaved="Editor.IsDirty"
                         TimeZoneId="@(string.IsNullOrWhiteSpace(_channel.TimeZone) ? Editor.Working.Settings.TimeZone : _channel.TimeZone)" />
    }
    else if (_tab == "stats")
    {
        <ChannelStatsTab Channel="_channel" Changed="Editor.MarkDirty" TimeZoneId="@(string.IsNullOrWhiteSpace(_channel.TimeZone) ? Editor.Working.Settings.TimeZone : _channel.TimeZone)" />
    }
    else if (ChannelSections.FirstOrDefault(section => SectionTab(section) == _tab) is { } pluginSection)
    {
        @* Promos, Generated Promos, Archive Follow and any installed plugin's channel tab. *@
        <DynamicComponent @key="pluginSection.Id" Type="pluginSection.Component" Parameters="SectionParameters(pluginSection)" />
    }
    </div>
    </div>
}

@code {
    [Parameter] public string ChannelId { get; set; } = "";

    // Plugin tabs slot in among these by their order (Archive Follow 20, Generated Promos 50). Promos have no tab of
    // their own any more: they're part of Ad breaks.
    private static readonly (string Key, string Label, string Icon, int Order)[] CoreTabs =
    [
        ("general", "General", "sliders", 0),
        ("schedule", "Blocks & anchors", "calendar", 10),
        ("drops", "Drops", "calendar-clock", 15),
        ("breaks", "Ad breaks", "megaphone", 30),
        ("stats", "Stats", "chart", 90)
    ];

    private void SetAdBreaks(List<string>? names)
    {
        _channel!.AdBreaks = names;
        Editor.MarkDirty();
    }


    private IEnumerable<PluginEditorSection> ChannelSections =>
        EditorSections.Where(section => section.Surface == EditorSurface.Channel);

    private IEnumerable<(string Key, string Label, string Icon)> AllTabs =>
        CoreTabs
            .Where(tab => tab.Key != "drops" || HasDrops)
            .Concat(ChannelSections.Select(section => (SectionTab(section), section.Title, section.Icon ?? "puzzle", section.Order)))
            .OrderBy(tab => tab.Item4)
            .Select(tab => (tab.Item1, tab.Item2, tab.Item3));

    private static string SectionTab(PluginEditorSection section) => $"plugin:{section.Id}";

    // The Drops tab only shows while some of the channel's programming (as it is on screen) puts a show on drops:
    // its base rotation, a block or an anchor, directly or through a global collection.
    private bool HasDrops => _channel is not null && DropManager.UsesDrops(Editor.Working, _channel);

    private Dictionary<string, object> SectionParameters(PluginEditorSection section) => new()
    {
        ["Context"] = new PluginEditorContext
        {
            PluginId = section.PluginId,
            Config = Editor.Working,
            Channel = _channel,
            Changed = Editor.MarkDirty
        }
    };

    private ChannelConfig? _channel;
    private InterstitialsConfig _emptyBreaks = new();
    private InterstitialsConfig ChannelBreaks => _channel!.Interstitials ?? _emptyBreaks;

    private void CommitBreaks()
    {
        _channel!.Interstitials = ChannelBreaks;
        Editor.MarkDirty();
    }

    private string _tab = "general";
    private bool _resetting;
    private string? _resetMessage;
    private string? _idError;
    private int _idVersion;
    private string? _logoError;
    private bool _copyOpen;
    private string _copySourceId = "";
    private string? _copyError;
    private string? _copyMessage;

    private void OpenCopy()
    {
        _copyOpen = !_copyOpen;
        _copySourceId = "";
        _copyError = null;
        _copyMessage = null;
    }

    private void CopyFrom()
    {
        try
        {
            string sourceName = Editor.FindChannel(_copySourceId)?.Name ?? _copySourceId;
            _channel = Editor.CopyChannelSettings(ChannelId, _copySourceId);
            _copyOpen = false;
            _copyMessage = $"Copied settings from {sourceName}. Save to apply.";
            _idError = null;
            _logoError = null;
            _resetMessage = null;
        }
        catch (InvalidOperationException exception)
        {
            _copyError = exception.Message;
        }
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        _logoError = null;

        IBrowserFile file = e.File;

        if (file.Size > LogoStore.MaxBytes)
        {
            _logoError = $"That image is {file.Size / (1024 * 1024)}MB; the limit is {LogoStore.MaxBytes / (1024 * 1024)}MB.";
            return;
        }

        try
        {
            await using Stream content = file.OpenReadStream(LogoStore.MaxBytes);

            // BaseUri is the origin this browser reached the app on, so the URL recorded here is one
            // a player on the same network can also fetch.
            string? previous = _channel!.Logo;
            _channel.Logo = await Logos.SaveAsync(_channel.Id, file.Name, content, Nav.BaseUri);
            Logos.Release(previous, LogosStillUsed());
            Editor.MarkDirty();
        }
        catch (Exception ex)
        {
            _logoError = ex.Message;
        }
    }

    private void RemoveLogo()
    {
        // An externally hosted logo is not ours to delete, and a stored one another channel uses (or the saved schedule
        // still does) is kept; only the reference is cleared then.
        string? previous = _channel!.Logo;
        _channel.Logo = null;
        Logos.Release(previous, LogosStillUsed());
        _logoError = null;
        Editor.MarkDirty();
    }

    /// <summary>Logos other channels use, and every logo in the saved schedule (a discard goes back to it).</summary>
    private IEnumerable<string?> LogosStillUsed() =>
        Editor.Working.Channels.Where(channel => !ReferenceEquals(channel, _channel)).Select(channel => channel.Logo)
            .Concat(SavedConfig.Current.Channels.Select(channel => channel.Logo))
            .ToList();

    // The app-wide encoding this channel inherits, read live so a setting saved in App settings shows at once.
    private ErsatzTvEncodingOptions GlobalEncoding => ErsatzOptions.Value.Encoding;

    private EffectiveEncoding Inherited => ErsatzTvEncoding.Defaults(GlobalEncoding);

    private string InheritedHardware => ErsatzTvEncoding.Label(Inherited.Hardware);

    private EffectiveEncoding SelectedEncoding => ErsatzTvEncoding.Resolve(GlobalEncoding, _channel?.Encoding);

    private string InheritedBitrate => $"Default ({Inherited.BitrateKbps})";

    private void SetEncodingHardware(ChangeEventArgs e) =>
        EditEncoding(encoding => encoding.Hardware = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString());

    private void SetEncodingPicture(ChannelEncodingConfig value) => EditEncoding(encoding =>
    {
        encoding.Height = value.Height;
        encoding.Width = value.Width;
        encoding.AspectRatio = value.AspectRatio;
        encoding.FrameRate = value.FrameRate;
    });

    private void SetEncodingScaling(ChangeEventArgs e) =>
        EditEncoding(encoding => encoding.ScalingMode = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString());

    private void SetEncodingBitrate(ChangeEventArgs e) =>
        EditEncoding(encoding => encoding.BitrateKbps = int.TryParse(e.Value?.ToString(), out int kbps) && kbps > 0 ? Math.Clamp(kbps, 300, 100_000) : null);

    // An empty section is removed, so a channel that inherits everything has no encoding: key in the YAML.
    private void EditEncoding(Action<ChannelEncodingConfig> edit)
    {
        ChannelEncodingConfig encoding = _channel!.Encoding ?? new ChannelEncodingConfig();
        edit(encoding);
        _channel.Encoding = encoding.IsEmpty ? null : encoding;
        Editor.MarkDirty();
    }

    // Languages are kept as the user's codes, normalized (en -> eng) so files' tags match; shown by name.
    private static string LanguageText(IEnumerable<string>? languages) =>
        string.Join(", ", (languages ?? Enumerable.Empty<string>()).Select(LanguageCodes.Name));

    private static List<string> ParseLanguages(ChangeEventArgs e) =>
        [.. (e.Value?.ToString() ?? string.Empty)
            .Split([',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(LanguageCodes.Normalize).OfType<string>().Distinct(StringComparer.Ordinal)];

    private string SubtitleLanguagePlaceholder =>
        _channel?.Tracks?.AudioLanguages is { Count: > 0 } audio ? $"Same as audio ({LanguageText(audio)})" : "Each file's default subtitles";

    private void SetAudioLanguages(ChangeEventArgs e) => EditTracks(tracks => tracks.AudioLanguages = ParseLanguages(e));

    private void SetSubtitleLanguages(ChangeEventArgs e) => EditTracks(tracks => tracks.SubtitleLanguages = ParseLanguages(e));

    private void SetSubtitleMode(ChangeEventArgs e) => EditTracks(tracks =>
        tracks.Subtitles = Enum.TryParse(e.Value?.ToString(), out SubtitleMode mode) && mode != SubtitleMode.Off ? mode : null);

    // Like encoding, an empty section is removed so a channel on the defaults has no tracks: key in the YAML.
    private void EditTracks(Action<ChannelTracksConfig> edit)
    {
        ChannelTracksConfig tracks = _channel!.Tracks ?? new ChannelTracksConfig();
        edit(tracks);
        _channel.Tracks = tracks.IsEmpty ? null : tracks;
        Editor.MarkDirty();
    }

    // How a 24/7 channel counts for the watched-only features; null (the default) is watched, so only "never" is written.
    private string WatchedChoice => _channel?.AlwaysOnCountsAsWatched ?? true ? "watched" : "unwatched";

    private void SetWatchedChoice(ChangeEventArgs e)
    {
        _channel!.AlwaysOnCountsAsWatched = e.Value?.ToString() == "unwatched" ? false : null;
        Editor.MarkDirty();
    }

    private string AnchorText() =>
        _channel?.ScheduleStart?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") ?? string.Empty;

    private void SetAnchor(ChangeEventArgs e)
    {
        string value = e.Value?.ToString() ?? string.Empty;

        _channel!.ScheduleStart = DateTimeOffset.TryParse(value, out DateTimeOffset parsed)
            ? parsed
            : null;

        Editor.MarkDirty();
    }

    private async Task ResetRotation()
    {
        _resetting = true;
        _resetMessage = null;

        try
        {
            await Rotation.ResetAsync(ChannelId);
            _resetMessage = "Rotation cleared; the channel will start from the top of each collection.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException)
        {
            _resetMessage = ex.Message;
        }
        finally
        {
            _resetting = false;
        }
    }

    /// <summary>The open tab, kept in the address (<c>?tab=stats</c>) so a refresh or a shared link opens the same one.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    protected override void OnParametersSet()
    {
        _channel = Editor.FindChannel(ChannelId);
        _tab = Tab is { Length: > 0 } wanted && AllTabs.Any(tab => tab.Key == wanted) ? wanted : "general";
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _channel = Editor.FindChannel(ChannelId);
    }

    // A discard or an external reload replaces the whole working copy, so the cached channel has to
    // be looked up again or the page keeps editing an object nothing else references.
    protected override void OnEditorChanged()
    {
        _emptyBreaks = new();
        _channel = Editor.FindChannel(ChannelId);
        _copyMessage = null;
        base.OnEditorChanged();
    }

    private List<TimeSpan> AnchorTimes => _channel is null
        ? []
        : _channel.Anchors.Select(a => a.Time)
            .Concat(_channel.Blocks.Where(b => b.IsAnchorSlot && b.Time is not null).Select(b => b.Time!.Value))
            .Concat(_channel.Blocks.SelectMany(b => b.Anchors).Select(a => a.Time))
            .ToList();

    private void Rename(string? id)
    {
        if (_channel is null || string.IsNullOrWhiteSpace(id) || string.Equals(id, _channel.Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (Editor.IsChannelIdTaken(id, ignoring: _channel))
        {
            _idError = $"Another channel already uses the id '{id}'.";
            _idVersion++;
            return;
        }

        _idError = null;
        _channel.Id = id;
        Editor.MarkDirty();
        Nav.NavigateTo($"channels/{id}");
    }

    private static string? Text(ChangeEventArgs e) =>
        string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString();
}
